---
/**
 * Starlight `Hero` override, registered in astro.config.mjs, and the whole
 * landing page. The splash template renders this in place of the page title;
 * index.mdx has no body of its own.
 *
 * Load-bearing details:
 *   - the <h1> is `hero.title` from frontmatter ("Compose Skill"), the search
 *     phrase; "Compose Kit" is the product name in the eyebrow and wordmark;
 *   - every number on this page comes from src/data/site.ts, which copies the
 *     README;
 *   - the copy buttons ship `hidden` and CopyScript reveals them.
 */
import { achieved, agents, headline, license, quickInstall, repoSlug, repoUrl, skills, version } from '../data/site';
import CopyScript from './landing/CopyScript.astro';
import ThemedChart from './ThemedChart.astro';
import AgentWindow from './AgentWindow.astro';
import StudioLine from './StudioLine.astro';
import '../styles/landing.css';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline } = data.hero || {};

const githubIcon =
  'M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21';

// Bodies in site.ts may link to a page of this site with a markdown link whose target starts with a slash.
const achievedHtml = (body: string) => body.replace(/\[([^\]]+)\]\((\/[^)]*)\)/g, '<a href="$2">$1</a>');

// Star history image (third-party, loaded lazily; the site sets no CSP).
const starHistory = `https://api.star-history.com/svg?repos=${repoSlug}&type=Date`;
const starHistoryPage = `https://star-history.com/#${repoSlug}&Date`;

const why = [
  {
    title: 'One consistent style',
    body: 'MVI on a shared BaseViewModel contract, Koin annotations, Navigation 3, feature-owned data/domain/presentation layers, and typed error handling.',
  },
  {
    title: 'Progressive loading',
    body: 'A ~1.3k-token entry tree picks the task path and the exact reference files. The full kit is about 127k tokens; in the v5 test, 35 of 40 kit runs loaded under 20k.',
  },
  {
    title: 'Respects your project',
    body: 'In a coherent existing codebase (Hilt, MVVM, Navigation 2, your own base class), the kit follows your pattern and proposes migration separately.',
  },
  {
    title: 'Checked, not trusted',
    body: '11 shell guard scripts catch drift in CI, backed by 90 fixture tests.',
  },
];

const next = [
  { href: '/install/', label: 'Install', body: 'Project or global, for every agent and channel.' },
  { href: '/skills/', label: 'Skills', body: 'What each of the seven skills owns, and how routing works.' },
  { href: '/results/', label: 'Results', body: 'v6.1 on seven models, task types, the earlier held-out v5 test, limits, erratum.' },
  { href: '/how-we-test/', label: 'How we test', body: 'Sealed tasks, real agent CLIs, blind cross-vendor grading.' },
  { href: '/roadmap/', label: 'Roadmap', body: 'v6.1 released, the cheap-model add-ons, known issues.' },
];
---

<div class="landing">
  <section class="landing-hero" aria-labelledby="_top">
    <div class="landing-hero__lead">
      <p class="landing-eyebrow">
        <span class="landing-pill"><span class="landing-pill__dot" aria-hidden="true"></span>Compose Kit</span>
        <span>{version} · {license}</span>
      </p>
      <h1 id="_top" data-page-title class="landing-hero__title" set:html={title} />
      {tagline && <p class="landing-hero__pitch" set:html={tagline} />}
      <p class="landing-hero__sub">
        Compose Kit is seven agent skills for Jetpack Compose and Compose Multiplatform. One consistent house style,
        measured on seven models in real agent CLIs.
      </p>

      <div class="landing-install">
        <span class="landing-install__prompt" aria-hidden="true">$</span>
        <code class="landing-install__code" tabindex="0">{quickInstall}</code>
        <button class="landing-copy" type="button" hidden data-copy={quickInstall} aria-label="Copy the install command">
          <svg class="landing-copy__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2"></rect><path d="M5 15V5a2 2 0 0 1 2-2h10"></path></svg>
          <svg class="landing-copy__icon landing-copy__icon--done" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg>
        </button>
      </div>
      <p class="landing-hero__hint">
        Swap <code>claude-code</code> for <code>codex</code>, <code>cursor</code>, <code>opencode</code>, <code>github-copilot</code>, <code>gemini-cli</code> or <code>antigravity</code>. Add <code>-g</code> to
        install globally.
      </p>

      <div class="landing-hero__actions">
        <a class="landing-button landing-button--primary" href={repoUrl}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={githubIcon}></path></svg>
          <span>Star on GitHub</span>
        </a>
        <a class="landing-button" href="/install/">
          <span>All install options</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
        </a>
      </div>
    </div>
    <div class="landing-hero__aside">
      <AgentWindow />
    </div>
  </section>

  <section class="landing-stats" aria-label="v6 test in numbers">
    <dl>
      {
        headline.map((item) => (
          <div class="landing-stats__item">
            <dt><span class="landing-count" data-count>{item.value}</span></dt>
            <dd>{item.label}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="landing-section" aria-labelledby="landing-chart-title">
    <div class="landing-section__head">
      <p class="landing-eyebrow">01 · Evidence</p>
      <h2 id="landing-chart-title">With the v6.1 kit vs without</h2>
      <p class="landing-section__lede">
        The v6 test: 5 panel models plus two cheap add-on models got 6 new tasks, in the real agent CLIs, with no kit,
        the v6.0 kit and the v6.1 kit: 90 + 36 runs, graded blind, and an item passes only when both graders pass it.
        Task types, limits and the earlier held-out v5 test are on the <a href="/results/">results page</a>.
      </p>
    </div>
    <div class="landing-figure">
      <figure class="chart-block">
        <ThemedChart
          name="v6-models"
          alt="v6 test: rubric score without the kit, with the v6.0 kit and with the v6.1 kit, as percent of 39 items, for seven models, sorted by lift. Gemini 3.8 Flash 56.4%, 84.6%, 87.2% (+30.8). GPT-6-Luna 71.8%, 89.7%, 94.9% (+23.1). DeepSeek V4.1 Flash 82.1%, 89.7%, 97.4% (+15.4). DeepSeek V4 Pro 74.4%, 76.9%, 87.2% (+12.8). GPT-6-Sol 76.9%, 87.2%, 87.2% (+10.3). Sonnet 5.5 79.5%, 89.7%, 87.2% (+7.7). Muse Spark 1.3 69.2%, 69.2%, 74.4% (+5.1). The two DeepSeek models are add-ons graded by Claude and GPT, so compare across groups with care."
        />
        <figcaption>
          The two DeepSeek models are add-ons, graded by Claude and GPT, while the panel's Claude and GPT answers also
          had Gemini as a grader: compare across the two groups with care. <a href="/results/">The full results</a>,
          including the <a href="/results/#erratum">held-out v5 erratum</a>.
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="landing-section" aria-labelledby="landing-achieved-title">
    <div class="landing-section__head">
      <p class="landing-eyebrow">02 · Progress</p>
      <h2 id="landing-achieved-title">What we achieved</h2>
      <p class="landing-section__lede">Facts only, from the first held-out test to the cheap-model add-ons.</p>
    </div>
    <ul class="landing-skills landing-achieved">
      {
        achieved.map((item) => (
          <li>
            <code>{item.label}</code>
            <span set:html={achievedHtml(item.body)} />
          </li>
        ))
      }
    </ul>
  </section>

  <section class="landing-section" aria-labelledby="landing-why-title">
    <div class="landing-section__head">
      <p class="landing-eyebrow">03 · Why</p>
      <h2 id="landing-why-title">Compose that compiles, then drifts</h2>
      <p class="landing-section__lede">
        AI agents write Compose that compiles and then drifts: state ends up in the wrong place, every screen gets
        its own pattern, error handling changes from file to file, and reviews flag perfectly fine code as blocking.
        Compose Kit gives the agent one house style plus the reasoning behind it, and only loads the parts the
        current task needs.
      </p>
    </div>
    <ul class="landing-grid landing-grid--4">
      {
        why.map((item) => (
          <li class="landing-card">
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="landing-section" aria-labelledby="landing-agents-title">
    <div class="landing-section__head">
      <p class="landing-eyebrow">04 · Install</p>
      <h2 id="landing-agents-title">A Compose skill for your agent</h2>
      <p class="landing-section__lede">
        Install all seven skills, for one project or globally. Each page has the exact commands and paths for that
        agent.
      </p>
    </div>
    <ul class="landing-grid landing-grid--3">
      {
        agents.map((agent) => (
          <li>
            <a class="landing-card landing-card--link" href={agent.href}>
              <h3>{agent.name}</h3>
              <p class="landing-card__ids">
                {agent.ids.map((id) => (
                  <code>{id}</code>
                ))}
              </p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="landing-section" aria-labelledby="landing-skills-title">
    <div class="landing-section__head">
      <p class="landing-eyebrow">05 · Inside</p>
      <h2 id="landing-skills-title">Seven skills, one entry tree</h2>
      <p class="landing-section__lede">
        <code>compose</code> is the entry point, and it hands each task to the other six.{' '}
        <a href="/skills/">How routing works</a>
      </p>
    </div>
    <ul class="landing-skills">
      {
        skills.map((skill) => (
          <li>
            <code>{skill.name}</code>
            <span>{skill.owns}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="landing-section" aria-labelledby="landing-next-title">
    <div class="landing-section__head">
      <p class="landing-eyebrow">06 · Status</p>
      <h2 id="landing-next-title">Where it stands</h2>
      <p class="landing-section__lede">
        v6.1.0 is released as the stable version (2026-10-05). The v6.1 A/B (v6.0 vs the v6.1 fixes vs no kit, on new
        tasks) passed every pre-registered rule, and the cheap-model add-ons (DeepSeek V4.1 Flash and V4 Pro) are
        done. Next: the journey page.
      </p>
    </div>
    <ul class="landing-grid landing-grid--5">
      {
        next.map((item) => (
          <li>
            <a class="landing-card landing-card--link" href={item.href}>
              <h3>{item.label}</h3>
              <p>{item.body}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="landing-cta" aria-labelledby="landing-cta-title">
    <h2 id="landing-cta-title">Install it, then tell us what breaks.</h2>
    <p>
      Found a problem, or want a model benchmarked? <a href={`${repoUrl}/issues`}>Open an issue</a>. A reported
      problem is exactly what kicks off the next test round.
    </p>
    <div class="landing-hero__actions">
      <a class="landing-button landing-button--primary" href={repoUrl}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={githubIcon}></path></svg>
        <span>Star on GitHub</span>
      </a>
      <a class="landing-button" href="/install/claude-code/"><span>Compose skill for Claude Code</span></a>
    </div>
    <a class="landing-star" href={starHistoryPage}>
      <img
        class="landing-star__light"
        src={starHistory}
        alt={`Star history of ${repoSlug}`}
        width="600"
        height="400"
        loading="lazy"
        decoding="async"
        referrerpolicy="no-referrer"
      />
      <img
        class="landing-star__dark"
        src={`${starHistory}&theme=dark`}
        alt=""
        width="600"
        height="400"
        loading="lazy"
        decoding="async"
        referrerpolicy="no-referrer"
      />
    </a>
  </section>

  <footer class="landing-footer">
    <div class="landing-footer__top">
      <div class="landing-footer__identity">
        <p class="landing-footer__brand">
          <svg class="landing-footer__mark" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
            <path d="M46.43 18.57 A19 19 0 1 0 46.43 45.43" fill="none" stroke="currentColor" stroke-width="9" stroke-linecap="round"></path>
            <circle cx="50" cy="32" r="6" fill="var(--kit-accent)"></circle>
          </svg>
          <span translate="no">Compose Kit</span>
        </p>
        <StudioLine />
      </div>
      <nav aria-label="Site">
        <ul class="landing-footer__links">
          <li><a href="/install/">Install</a></li>
          <li><a href="/skills/">Skills</a></li>
          <li><a href="/results/">Results</a></li>
          <li><a href="/how-we-test/">How we test</a></li>
          <li><a href="/roadmap/">Roadmap</a></li>
          <li><a href={repoUrl}>GitHub</a></li>
          <li><a href={`${repoUrl}/blob/main/LICENSE`}>MIT license</a></li>
        </ul>
      </nav>
    </div>
  </footer>
</div>

<CopyScript />
