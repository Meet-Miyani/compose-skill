+package com.example.feature.notes.readinglog.presentation.author
+
+import com.example.feature.notes.readinglog.domain.model.Book
+import com.example.feature.notes.readinglog.domain.repository.BookRepository
+import kotlinx.coroutines.ExperimentalCoroutinesApi
+import kotlinx.coroutines.flow.Flow
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.map
+import kotlinx.coroutines.test.StandardTestDispatcher
+import kotlinx.coroutines.test.advanceUntilIdle
+import kotlinx.coroutines.test.resetMain
+import kotlinx.coroutines.test.runTest
+import kotlinx.coroutines.test.setMain
+import kotlinx.coroutines.Dispatchers
+import kotlin.test.AfterTest
+import kotlin.test.BeforeTest
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertFalse
+
+private class FakeBookRepository(initial: List<Book>) : BookRepository {
+    val books = MutableStateFlow(initial)
+    override fun getBooksStream(): Flow<List<Book>> = books
+    override fun getBooksByAuthorStream(author: String): Flow<List<Book>> =
+        books.map { list -> list.filter { it.author == author } }
+    override suspend fun addBook(title: String, author: String, pages: Int): Long = 0
+    override suspend fun markFinished(id: Long) = Unit
+}
+
+@OptIn(ExperimentalCoroutinesApi::class)
+class AuthorBooksViewModelTest {
+    @BeforeTest fun setUp() = Dispatchers.setMain(StandardTestDispatcher())
+    @AfterTest fun tearDown() = Dispatchers.resetMain()
+
+    private val books = listOf(
+        Book(1, "Dune", "Herbert", 600, false),
+        Book(2, "Emma", "Austen", 400, true),
+        Book(3, "Persuasion", "Austen", 300, false),
+    )
+
+    private fun viewModel(repo: FakeBookRepository, author: String) =
+        AuthorBooksViewModel(repo, AuthorBooksParams(author))
+
+    @Test
+    fun `shows only the requested author's books`() = runTest {
+        val vm = viewModel(FakeBookRepository(books), "Austen")
+        assertEquals(AuthorBooksUiState(), vm.state.value)
+        vm.onAction(AuthorBooksUiAction.OnScreenStarted)
+        advanceUntilIdle()
+        assertEquals(listOf(2L, 3L), vm.state.value.items.map { it.id })
+        assertFalse(vm.state.value.isLoading)
+    }
+
+    @Test
+    fun `unknown author yields empty list`() = runTest {
+        val vm = viewModel(FakeBookRepository(books), "Nobody")
+        vm.onAction(AuthorBooksUiAction.OnScreenStarted)
+        advanceUntilIdle()
+        assertEquals(emptyList(), vm.state.value.items)
+        assertFalse(vm.state.value.isLoading)
+    }
+
+    @Test
+    fun `new book by the author appears while observing`() = runTest {
+        val repo = FakeBookRepository(books)
+        val vm = viewModel(repo, "Herbert")
+        vm.onAction(AuthorBooksUiAction.OnScreenStarted)
+        advanceUntilIdle()
+        repo.books.value = books + Book(4, "Dune Messiah", "Herbert", 330, false)
+        advanceUntilIdle()
+        assertEquals(listOf(1L, 4L), vm.state.value.items.map { it.id })
+    }
+}
