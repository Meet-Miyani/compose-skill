+package com.example.feature.notes.readinglog.domain.model
+
+/** Smallest yearly goal a reader can hold; the goal stepper stops here. */
+const val MIN_YEARLY_GOAL_BOOKS = 1
+
+/** Goal a reader starts from when they first choose to set one. */
+const val DEFAULT_YEARLY_GOAL_BOOKS = 12
+
+/** [goalBooks] is null until the reader sets a goal; [finishedThisYear] counts books finished in the current calendar year. */
+data class ReadingProgress(val goalBooks: Int? = null, val finishedThisYear: Int = 0)
