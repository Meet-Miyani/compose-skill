+package com.example.feature.notes.readinglog.data
+
+import com.example.feature.notes.data.local.NotesDatabase
+import com.example.feature.notes.readinglog.domain.model.ReadingProgress
+import com.example.feature.notes.readinglog.domain.repository.ReadingGoalRepository
+import kotlinx.coroutines.flow.Flow
+import kotlinx.coroutines.flow.combine
+import kotlinx.coroutines.flow.emitAll
+import kotlinx.coroutines.flow.flow
+import kotlinx.datetime.TimeZone
+import org.koin.core.annotation.Factory
+import kotlin.time.Clock
+
+@Factory
+internal class DefaultReadingGoalRepository(
+    private val goals: ReadingGoalDataSource,
+    private val db: NotesDatabase,
+) : ReadingGoalRepository {
+    override fun getReadingProgressStream(): Flow<ReadingProgress> =
+        combine(goals.getGoalStream(), finishedThisYearStream()) { goal, finished -> ReadingProgress(goal, finished) }
+
+    override suspend fun setYearlyGoal(books: Int) = goals.setGoal(books)
+
+    override suspend fun adjustYearlyGoal(delta: Int) = goals.adjustGoal(delta)
+
+    // The year is fixed when collection starts; the screen re-collects on every start, so a new year is picked up then.
+    private fun finishedThisYearStream(): Flow<Int> = flow {
+        val range = yearRangeOf(Clock.System.now(), TimeZone.currentSystemDefault())
+        emitAll(db.bookDao().getFinishedCountStream(range.startMillis, range.endMillis))
+    }
+}
