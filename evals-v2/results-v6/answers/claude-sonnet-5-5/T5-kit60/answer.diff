+package com.example.feature.notes.readinglog
+
+import com.example.core.error.StorageException
+import com.example.feature.notes.readinglog.domain.model.MIN_YEARLY_GOAL_BOOKS
+import com.example.feature.notes.readinglog.domain.model.ReadingProgress
+import com.example.feature.notes.readinglog.domain.repository.ReadingGoalRepository
+import kotlinx.coroutines.flow.Flow
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.flow
+
+/** In-memory fake of the reading goal repository; mirrors the production rules for set and adjust. */
+class FakeReadingGoalRepository : ReadingGoalRepository {
+    private val backing = MutableStateFlow(ReadingProgress())
+
+    /** When set, the progress stream fails with it on collection. */
+    var streamFailure: StorageException? = null
+    var streamCollections: Int = 0
+
+    fun seed(progress: ReadingProgress) { backing.value = progress }
+
+    override fun getReadingProgressStream(): Flow<ReadingProgress> = flow {
+        streamCollections += 1
+        streamFailure?.let { throw it }
+        backing.collect { emit(it) }
+    }
+
+    override suspend fun setYearlyGoal(books: Int) {
+        backing.value = backing.value.copy(goalBooks = books.coerceAtLeast(MIN_YEARLY_GOAL_BOOKS))
+    }
+
+    override suspend fun adjustYearlyGoal(delta: Int) {
+        val current = backing.value.goalBooks ?: return
+        backing.value = backing.value.copy(goalBooks = (current + delta).coerceAtLeast(MIN_YEARLY_GOAL_BOOKS))
+    }
+}
