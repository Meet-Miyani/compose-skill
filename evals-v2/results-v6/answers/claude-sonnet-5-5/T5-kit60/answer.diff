+package com.example.feature.notes.readinglog.data
+
+import androidx.datastore.core.DataStore
+import androidx.datastore.preferences.core.Preferences
+import androidx.datastore.preferences.core.edit
+import androidx.datastore.preferences.core.intPreferencesKey
+import com.example.core.error.StorageException
+import com.example.feature.notes.readinglog.domain.model.MIN_YEARLY_GOAL_BOOKS
+import kotlinx.coroutines.flow.Flow
+import kotlinx.coroutines.flow.catch
+import kotlinx.coroutines.flow.distinctUntilChanged
+import kotlinx.coroutines.flow.map
+import okio.IOException
+import org.koin.core.annotation.Factory
+
+private val YEARLY_GOAL_KEY = intPreferencesKey("yearly_goal_books")
+
+/** Reads and writes the yearly goal; real IO failures leave as [StorageException], never as an empty first launch. */
+@Factory
+internal class ReadingGoalDataSource(private val dataStore: DataStore<Preferences>) {
+    fun getGoalStream(): Flow<Int?> = dataStore.data
+        .catch { throw if (it is IOException) StorageException(it) else it }
+        .map { it[YEARLY_GOAL_KEY] }
+        .distinctUntilChanged()
+
+    suspend fun setGoal(books: Int) = write { edit { it[YEARLY_GOAL_KEY] = books.coerceAtLeast(MIN_YEARLY_GOAL_BOOKS) } }
+
+    suspend fun adjustGoal(delta: Int) = write {
+        edit { prefs ->
+            val current = prefs[YEARLY_GOAL_KEY] ?: return@edit
+            prefs[YEARLY_GOAL_KEY] = (current + delta).coerceAtLeast(MIN_YEARLY_GOAL_BOOKS)
+        }
+    }
+
+    private suspend inline fun write(block: DataStore<Preferences>.() -> Unit) {
+        try {
+            dataStore.block()
+        } catch (e: IOException) {
+            throw StorageException(e)
+        }
+    }
+}
