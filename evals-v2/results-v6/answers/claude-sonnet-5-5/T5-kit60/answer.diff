+package com.example.feature.notes.readinglog.data
+
+import androidx.datastore.core.DataStore
+import androidx.datastore.core.handlers.ReplaceFileCorruptionHandler
+import androidx.datastore.preferences.core.PreferenceDataStoreFactory
+import androidx.datastore.preferences.core.Preferences
+import androidx.datastore.preferences.core.emptyPreferences
+import kotlinx.coroutines.CoroutineScope
+import okio.Path.Companion.toPath
+
+internal const val READING_GOAL_STORE_FILE = "reading_goal.preferences_pb"
+
+/** The one platform seam: where the goal file lives (Android files dir, iOS Documents, JVM app folder). */
+internal expect fun readingGoalStorePath(): String
+
+/**
+ * The single factory for the reading goal store, shared by production and tests.
+ * A corrupt file resets to defaults instead of failing every collector.
+ */
+internal fun createReadingGoalDataStore(
+    scope: CoroutineScope,
+    producePath: () -> String = ::readingGoalStorePath,
+): DataStore<Preferences> = PreferenceDataStoreFactory.createWithPath(
+    corruptionHandler = ReplaceFileCorruptionHandler { emptyPreferences() },
+    scope = scope,
+    produceFile = { producePath().toPath() },
+)
