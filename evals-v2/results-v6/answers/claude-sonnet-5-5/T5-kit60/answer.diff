+package com.example.feature.notes.readinglog
+
+import com.example.core.error.AppErrorType
+import com.example.core.error.StorageException
+import com.example.feature.notes.readinglog.domain.model.DEFAULT_YEARLY_GOAL_BOOKS
+import com.example.feature.notes.readinglog.domain.model.MIN_YEARLY_GOAL_BOOKS
+import com.example.feature.notes.readinglog.domain.model.ReadingProgress
+import com.example.feature.notes.readinglog.presentation.list.BookListUiAction
+import com.example.feature.notes.readinglog.presentation.list.BookListViewModel
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.ExperimentalCoroutinesApi
+import kotlinx.coroutines.flow.toList
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.test.StandardTestDispatcher
+import kotlinx.coroutines.test.TestCoroutineScheduler
+import kotlinx.coroutines.test.UnconfinedTestDispatcher
+import kotlinx.coroutines.test.advanceUntilIdle
+import kotlinx.coroutines.test.resetMain
+import kotlinx.coroutines.test.runTest
+import kotlinx.coroutines.test.setMain
+import kotlin.test.AfterTest
+import kotlin.test.BeforeTest
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertNull
+
+@OptIn(ExperimentalCoroutinesApi::class)
+class BookListViewModelTest {
+    private val scheduler = TestCoroutineScheduler()
+    private val books = FakeBookRepository()
+    private val goals = FakeReadingGoalRepository()
+
+    @BeforeTest fun setUp() { Dispatchers.setMain(StandardTestDispatcher(scheduler)) }
+    @AfterTest fun tearDown() { Dispatchers.resetMain() }
+
+    private fun viewModel() = BookListViewModel(books, goals)
+
+    @Test fun `no goal set leaves progress without a goal`() = runTest(scheduler) {
+        val viewModel = viewModel()
+        viewModel.onAction(BookListUiAction.OnScreenStarted)
+        advanceUntilIdle()
+        assertNull(viewModel.state.value.progress.goalBooks)
+        assertEquals(0, viewModel.state.value.progress.finishedThisYear)
+    }
+
+    @Test fun `stored goal and finished count show in state`() = runTest(scheduler) {
+        goals.seed(ReadingProgress(goalBooks = 20, finishedThisYear = 5))
+        val viewModel = viewModel()
+        viewModel.onAction(BookListUiAction.OnScreenStarted)
+        advanceUntilIdle()
+        assertEquals(ReadingProgress(20, 5), viewModel.state.value.progress)
+    }
+
+    @Test fun `set goal click stores the default goal`() = runTest(scheduler) {
+        val viewModel = viewModel()
+        viewModel.onAction(BookListUiAction.OnScreenStarted)
+        viewModel.onAction(BookListUiAction.OnSetGoalClick)
+        advanceUntilIdle()
+        assertEquals(DEFAULT_YEARLY_GOAL_BOOKS, viewModel.state.value.progress.goalBooks)
+    }
+
+    @Test fun `goal steps move the goal and never go below the minimum`() = runTest(scheduler) {
+        goals.seed(ReadingProgress(goalBooks = 2))
+        val viewModel = viewModel()
+        viewModel.onAction(BookListUiAction.OnScreenStarted)
+        viewModel.onAction(BookListUiAction.OnGoalStepClick(1))
+        viewModel.onAction(BookListUiAction.OnGoalStepClick(1))
+        advanceUntilIdle()
+        assertEquals(4, viewModel.state.value.progress.goalBooks)
+        repeat(10) { viewModel.onAction(BookListUiAction.OnGoalStepClick(-1)) }
+        advanceUntilIdle()
+        assertEquals(MIN_YEARLY_GOAL_BOOKS, viewModel.state.value.progress.goalBooks)
+    }
+
+    @Test fun `step without a goal keeps it unset`() = runTest(scheduler) {
+        val viewModel = viewModel()
+        viewModel.onAction(BookListUiAction.OnScreenStarted)
+        viewModel.onAction(BookListUiAction.OnGoalStepClick(1))
+        advanceUntilIdle()
+        assertNull(viewModel.state.value.progress.goalBooks)
+    }
+
+    @Test fun `repeated start collects progress once`() = runTest(scheduler) {
+        val viewModel = viewModel()
+        viewModel.onAction(BookListUiAction.OnScreenStarted)
+        viewModel.onAction(BookListUiAction.OnScreenStarted)
+        advanceUntilIdle()
+        viewModel.onAction(BookListUiAction.OnScreenStarted)
+        advanceUntilIdle()
+        assertEquals(1, goals.streamCollections)
+    }
+
+    @Test fun `storage failure on progress reaches the popup channel`() = runTest(scheduler) {
+        goals.streamFailure = StorageException(RuntimeException("unreadable"))
+        val viewModel = viewModel()
+        val errors = mutableListOf<com.example.core.error.AppError>()
+        backgroundScope.launch(UnconfinedTestDispatcher(scheduler)) { viewModel.errors.toList(errors) }
+        viewModel.onAction(BookListUiAction.OnScreenStarted)
+        advanceUntilIdle()
+        assertEquals(AppErrorType.Storage, errors.single().type)
+    }
+}
