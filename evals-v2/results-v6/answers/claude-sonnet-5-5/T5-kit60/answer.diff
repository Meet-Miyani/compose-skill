+package com.example.feature.notes.readinglog.data
+
+import kotlinx.datetime.LocalDate
+import kotlinx.datetime.TimeZone
+import kotlinx.datetime.atStartOfDayIn
+import kotlinx.datetime.toLocalDateTime
+import kotlin.time.Instant
+
+/** Epoch-millis bounds of one calendar year: [startMillis] inclusive, [endMillis] exclusive. */
+internal data class YearRange(val startMillis: Long, val endMillis: Long)
+
+internal fun yearRangeOf(now: Instant, zone: TimeZone): YearRange {
+    val year = now.toLocalDateTime(zone).year
+    return YearRange(
+        startMillis = LocalDate(year, 1, 1).atStartOfDayIn(zone).toEpochMilliseconds(),
+        endMillis = LocalDate(year + 1, 1, 1).atStartOfDayIn(zone).toEpochMilliseconds(),
+    )
+}
