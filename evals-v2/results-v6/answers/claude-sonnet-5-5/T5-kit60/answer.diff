+package com.example.feature.notes.readinglog
+
+import com.example.feature.notes.readinglog.data.yearRangeOf
+import kotlinx.datetime.TimeZone
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.time.Instant
+
+class YearRangeTest {
+    @Test fun `utc year spans january first to next january first`() {
+        val range = yearRangeOf(Instant.parse("2026-10-01T12:00:00Z"), TimeZone.UTC)
+        assertEquals(Instant.parse("2026-01-01T00:00:00Z").toEpochMilliseconds(), range.startMillis)
+        assertEquals(Instant.parse("2027-01-01T00:00:00Z").toEpochMilliseconds(), range.endMillis)
+    }
+
+    @Test fun `local new year decides the year, not the utc date`() {
+        val tokyo = TimeZone.of("Asia/Tokyo")
+        // 2026-12-31T20:00Z is already 2027-01-01 05:00 in Tokyo.
+        val range = yearRangeOf(Instant.parse("2026-12-31T20:00:00Z"), tokyo)
+        assertEquals(Instant.parse("2026-12-31T15:00:00Z").toEpochMilliseconds(), range.startMillis)
+        assertEquals(Instant.parse("2027-12-31T15:00:00Z").toEpochMilliseconds(), range.endMillis)
+    }
+}
