+package com.example.feature.notes.readinglog.data
+
+import androidx.room.migration.AutoMigrationSpec
+import androidx.sqlite.SQLiteConnection
+import androidx.sqlite.execSQL
+
+/**
+ * Books finished before `finishedAt` existed have no date. Stamp them with
+ * the migration time so they count toward the current year's goal.
+ */
+internal class Migration2To3 : AutoMigrationSpec {
+    override fun onPostMigrate(connection: SQLiteConnection) {
+        connection.execSQL(
+            "UPDATE books SET finishedAt = CAST(strftime('%s', 'now') AS INTEGER) * 1000 WHERE isFinished = 1",
+        )
+    }
+}
