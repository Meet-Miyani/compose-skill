+package com.example.feature.notes.readinglog.data
+
+import androidx.room.Dao
+import androidx.room.Query
+import kotlinx.coroutines.flow.Flow
+
+/** "This year" is always the device's local year, resolved by SQLite. */
+@Dao
+internal interface ReadingGoalDao {
+    @Query("SELECT * FROM reading_goals WHERE year = CAST(strftime('%Y', 'now', 'localtime') AS INTEGER)")
+    fun getCurrentGoalStream(): Flow<ReadingGoalEntity?>
+
+    @Query(
+        "SELECT COUNT(*) FROM books WHERE finishedAt IS NOT NULL AND " +
+            "CAST(strftime('%Y', finishedAt / 1000, 'unixepoch', 'localtime') AS INTEGER) = " +
+            "CAST(strftime('%Y', 'now', 'localtime') AS INTEGER)",
+    )
+    fun getFinishedThisYearStream(): Flow<Int>
+
+    @Query(
+        "INSERT OR REPLACE INTO reading_goals (year, target) " +
+            "VALUES (CAST(strftime('%Y', 'now', 'localtime') AS INTEGER), :target)",
+    )
+    suspend fun setCurrentGoal(target: Int)
+}
