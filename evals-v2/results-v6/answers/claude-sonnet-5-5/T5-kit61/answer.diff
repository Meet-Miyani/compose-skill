@@ -0,0 +1,31 @@
+package com.example.feature.notes.readinglog.data
+
+import androidx.datastore.core.DataStore
+import androidx.datastore.preferences.core.Preferences
+import androidx.datastore.preferences.core.edit
+import androidx.datastore.preferences.core.intPreferencesKey
+import com.example.core.error.StorageException
+import com.example.feature.notes.readinglog.domain.repository.ReadingGoalRepository
+import kotlinx.coroutines.flow.Flow
+import kotlinx.coroutines.flow.catch
+import kotlinx.coroutines.flow.map
+import okio.IOException
+import org.koin.core.annotation.Factory
+
+private val readingGoalKey = intPreferencesKey("yearly_reading_goal_books")
+
+@Factory
+internal class DefaultReadingGoalRepository(private val dataStore: DataStore<Preferences>) : ReadingGoalRepository {
+    // A real read failure reaches the ViewModel as a StorageException; a missing file is just "no goal".
+    override fun getReadingGoalStream(): Flow<Int?> = dataStore.data
+        .map { it[readingGoalKey] }
+        .catch { if (it is IOException) throw StorageException(it) else throw it }
+
+    override suspend fun setReadingGoal(books: Int) {
+        try {
+            dataStore.edit { it[readingGoalKey] = books }
+        } catch (e: IOException) {
+            throw StorageException(e)
+        }
+    }
+}
