+package com.example.feature.notes.readinglog.data
+
+import androidx.datastore.core.DataStore
+import androidx.datastore.core.handlers.ReplaceFileCorruptionHandler
+import androidx.datastore.preferences.core.PreferenceDataStoreFactory
+import androidx.datastore.preferences.core.Preferences
+import androidx.datastore.preferences.core.emptyPreferences
+import kotlinx.coroutines.CoroutineScope
+import okio.Path.Companion.toPath
+
+/** Platform file location for the reading-goal store; the one expect/actual seam of this store. */
+internal expect fun readingGoalFilePath(): String
+
+/**
+ * Creates the reading-goal store. Call once per process (Koin `single`): two instances on one
+ * file throw. A corrupt file is replaced by empty preferences, which reads as "no goal set".
+ */
+internal fun createReadingGoalDataStore(scope: CoroutineScope, producePath: () -> String): DataStore<Preferences> =
+    PreferenceDataStoreFactory.createWithPath(
+        corruptionHandler = ReplaceFileCorruptionHandler { emptyPreferences() },
+        scope = scope,
+        produceFile = { producePath().toPath() },
+    )
