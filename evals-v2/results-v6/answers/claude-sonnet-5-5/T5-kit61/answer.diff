+package com.example.feature.notes.readinglog.domain.model
+
+/** Largest yearly goal the editor accepts; keeps the draft to a sane, displayable number. */
+const val MAX_READING_GOAL = 1000
+
+/** Books finished in the calendar [year]. */
+data class YearlyProgress(val year: Int, val finishedBooks: Int)
+
+/** Parses a goal draft; null when it is not a whole number in 1..[MAX_READING_GOAL]. */
+fun parseReadingGoal(text: String): Int? = text.trim().toIntOrNull()?.takeIf { it in 1..MAX_READING_GOAL }
