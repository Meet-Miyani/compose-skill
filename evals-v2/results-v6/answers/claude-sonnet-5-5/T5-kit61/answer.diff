@@ -0,0 +1,23 @@
+package com.example.feature.notes.readinglog.presentation.list
+
+import com.example.core.error.StorageException
+import com.example.feature.notes.readinglog.domain.repository.ReadingGoalRepository
+import kotlinx.coroutines.flow.Flow
+import kotlinx.coroutines.flow.MutableStateFlow
+
+/** Hand-written fake of [ReadingGoalRepository]; the stored goal survives across ViewModel instances. */
+class FakeReadingGoalRepository(initialGoal: Int? = null) : ReadingGoalRepository {
+    private val goal = MutableStateFlow(initialGoal)
+    var saveCalls: Int = 0
+
+    /** When set, [setReadingGoal] throws it, like a failed DataStore write. */
+    var writeFailure: StorageException? = null
+
+    override fun getReadingGoalStream(): Flow<Int?> = goal
+
+    override suspend fun setReadingGoal(books: Int) {
+        saveCalls += 1
+        writeFailure?.let { throw it }
+        goal.value = books
+    }
+}
