@@ -0,0 +1,131 @@
+package com.example.feature.notes.readinglog.presentation.list
+
+import androidx.lifecycle.SavedStateHandle
+import com.example.core.error.AppErrorType
+import com.example.core.error.StorageException
+import com.example.feature.notes.readinglog.domain.model.YearlyProgress
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.ExperimentalCoroutinesApi
+import kotlinx.coroutines.flow.toList
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.test.StandardTestDispatcher
+import kotlinx.coroutines.test.TestCoroutineScheduler
+import kotlinx.coroutines.test.UnconfinedTestDispatcher
+import kotlinx.coroutines.test.advanceUntilIdle
+import kotlinx.coroutines.test.resetMain
+import kotlinx.coroutines.test.runTest
+import kotlinx.coroutines.test.setMain
+import kotlin.test.AfterTest
+import kotlin.test.BeforeTest
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertFalse
+import kotlin.test.assertNull
+import kotlin.test.assertTrue
+
+@OptIn(ExperimentalCoroutinesApi::class)
+class BookListViewModelTest {
+    private val scheduler = TestCoroutineScheduler()
+    private val books = FakeBookRepository()
+
+    @BeforeTest fun setUp() { Dispatchers.setMain(StandardTestDispatcher(scheduler)) }
+    @AfterTest fun tearDown() { Dispatchers.resetMain() }
+
+    private fun viewModel(goals: FakeReadingGoalRepository, handle: SavedStateHandle = SavedStateHandle()) =
+        BookListViewModel(books, goals, handle)
+
+    @Test fun `no goal set shows the year without a goal`() = runTest(scheduler) {
+        val vm = viewModel(FakeReadingGoalRepository())
+        vm.onAction(BookListUiAction.OnScreenStarted)
+        advanceUntilIdle()
+        assertNull(vm.state.value.goal)
+        assertEquals(YearlyProgress(2026, 0), vm.state.value.progress)
+        assertEquals("", vm.state.value.goalDraft)
+    }
+
+    @Test fun `stored goal and progress are shown and prefill the draft`() = runTest(scheduler) {
+        books.progress.value = YearlyProgress(2026, 3)
+        val vm = viewModel(FakeReadingGoalRepository(initialGoal = 12))
+        vm.onAction(BookListUiAction.OnScreenStarted)
+        advanceUntilIdle()
+        assertEquals(12, vm.state.value.goal)
+        assertEquals(YearlyProgress(2026, 3), vm.state.value.progress)
+        assertEquals("12", vm.state.value.goalDraft)
+    }
+
+    @Test fun `saving a valid draft persists the goal and it is remembered by a new ViewModel`() = runTest(scheduler) {
+        val goals = FakeReadingGoalRepository()
+        val vm = viewModel(goals)
+        vm.onAction(BookListUiAction.OnScreenStarted)
+        vm.onAction(BookListUiAction.OnGoalDraftChanged("24"))
+        vm.onAction(BookListUiAction.OnGoalSaveClick)
+        advanceUntilIdle()
+        assertEquals(24, vm.state.value.goal)
+
+        // Relaunch: new ViewModel, new handle, same store.
+        val relaunched = viewModel(goals)
+        relaunched.onAction(BookListUiAction.OnScreenStarted)
+        advanceUntilIdle()
+        assertEquals(24, relaunched.state.value.goal)
+        assertEquals("24", relaunched.state.value.goalDraft)
+    }
+
+    @Test fun `invalid drafts are never saved`() = runTest(scheduler) {
+        val goals = FakeReadingGoalRepository()
+        val vm = viewModel(goals)
+        vm.onAction(BookListUiAction.OnScreenStarted)
+        for (draft in listOf("", "0", "-3", "abc", "1.5", "1001")) {
+            vm.onAction(BookListUiAction.OnGoalDraftChanged(draft))
+            assertFalse(vm.state.value.isGoalDraftValid, "draft '$draft'")
+            vm.onAction(BookListUiAction.OnGoalSaveClick)
+        }
+        advanceUntilIdle()
+        assertEquals(0, goals.saveCalls)
+        assertNull(vm.state.value.goal)
+    }
+
+    @Test fun `a typed draft survives a stream emission and process death`() = runTest(scheduler) {
+        val goals = FakeReadingGoalRepository(initialGoal = 12)
+        val handle = SavedStateHandle()
+        val vm = viewModel(goals, handle)
+        vm.onAction(BookListUiAction.OnScreenStarted)
+        advanceUntilIdle()
+        vm.onAction(BookListUiAction.OnGoalDraftChanged("30"))
+        books.progress.value = YearlyProgress(2026, 1)
+        advanceUntilIdle()
+        assertEquals("30", vm.state.value.goalDraft)
+
+        val restored = viewModel(goals, handle)
+        assertEquals("30", restored.state.value.goalDraft)
+    }
+
+    @Test fun `finishing a book advances progress`() = runTest(scheduler) {
+        val vm = viewModel(FakeReadingGoalRepository(initialGoal = 5))
+        vm.onAction(BookListUiAction.OnScreenStarted)
+        val id = books.addBook("T", "A", 10)
+        vm.onAction(BookListUiAction.OnMarkFinishedClick(id))
+        advanceUntilIdle()
+        assertEquals(1, vm.state.value.progress?.finishedBooks)
+    }
+
+    @Test fun `a failed write goes to the error host and keeps the draft`() = runTest(scheduler) {
+        val goals = FakeReadingGoalRepository().apply { writeFailure = StorageException(RuntimeException("disk")) }
+        val vm = viewModel(goals)
+        val errors = mutableListOf<com.example.core.error.AppError>()
+        backgroundScope.launch(UnconfinedTestDispatcher(scheduler)) { vm.errors.toList(errors) }
+        vm.onAction(BookListUiAction.OnScreenStarted)
+        vm.onAction(BookListUiAction.OnGoalDraftChanged("10"))
+        vm.onAction(BookListUiAction.OnGoalSaveClick)
+        advanceUntilIdle()
+        assertEquals(AppErrorType.Storage, errors.single().type)
+        assertEquals("10", vm.state.value.goalDraft)
+        assertNull(vm.state.value.goal)
+    }
+
+    @Test fun `repeated start does not duplicate the stream jobs`() = runTest(scheduler) {
+        val vm = viewModel(FakeReadingGoalRepository(initialGoal = 2))
+        repeat(3) { vm.onAction(BookListUiAction.OnScreenStarted) }
+        advanceUntilIdle()
+        assertTrue(vm.state.value.goal == 2)
+    }
+}
