+package com.example.feature.notes.readinglog.presentation.author
+
+import com.example.core.mvi.BaseViewModel
+import com.example.feature.notes.readinglog.domain.repository.BookRepository
+import kotlinx.coroutines.Job
+import org.koin.core.annotation.InjectedParam
+import org.koin.core.annotation.KoinViewModel
+
+/** Construction bag for the destination's nav arguments. Top-level so entries and tests share it. */
+data class AuthorBooksParams(val author: String)
+
+/** Streams every book by one author, fetched by the author carried in the nav key. */
+@KoinViewModel
+class AuthorBooksViewModel(
+    private val repository: BookRepository,
+    @InjectedParam private val params: AuthorBooksParams,
+) : BaseViewModel<AuthorBooksUiAction, AuthorBooksUiState, AuthorBooksUiEffect>(
+    AuthorBooksUiState(author = params.author),
+) {
+    private var streamJob: Job? = null
+
+    override fun onAction(action: AuthorBooksUiAction) {
+        when (action) {
+            AuthorBooksUiAction.OnScreenStarted -> observeBooks()
+            AuthorBooksUiAction.OnBackClick -> sendEffect(AuthorBooksUiEffect.NavigateBack)
+        }
+    }
+
+    private fun observeBooks() {
+        if (streamJob?.isActive == true) return
+        updateState { copy(isLoading = true) }
+        streamJob = launchGuarded(onError = ::emitError) {
+            repository.getBooksByAuthorStream(params.author).collect { books ->
+                updateState { copy(items = books, isLoading = false) }
+            }
+        }
+    }
+}
