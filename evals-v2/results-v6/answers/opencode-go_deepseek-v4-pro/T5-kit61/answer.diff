+package com.example.feature.notes.readinglog.presentation.list
+
+import androidx.lifecycle.SavedStateHandle
+import com.example.feature.notes.readinglog.domain.model.Book
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.ExperimentalCoroutinesApi
+import kotlinx.coroutines.test.StandardTestDispatcher
+import kotlinx.coroutines.test.TestCoroutineScheduler
+import kotlinx.coroutines.test.advanceUntilIdle
+import kotlinx.coroutines.test.resetMain
+import kotlinx.coroutines.test.runTest
+import kotlinx.coroutines.test.setMain
+import kotlin.test.AfterTest
+import kotlin.test.BeforeTest
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertFalse
+import kotlin.test.assertNull
+
+@OptIn(ExperimentalCoroutinesApi::class)
+class BookListViewModelTest {
+    private val scheduler = TestCoroutineScheduler()
+
+    @BeforeTest fun setUp() { Dispatchers.setMain(StandardTestDispatcher(scheduler)) }
+    @AfterTest fun tearDown() { Dispatchers.resetMain() }
+
+    private fun book(id: Long) = Book(id, "Title", "Author", 100, isFinished = false)
+
+    @Test fun `cold load observes books and goal`() = runTest(scheduler) {
+        val fake = FakeBookRepository().apply {
+            seedBooks(listOf(book(1)))
+            seedGoal(24)
+        }
+        val viewModel = BookListViewModel(fake, SavedStateHandle())
+        viewModel.onAction(BookListUiAction.OnScreenStarted)
+        advanceUntilIdle()
+        assertFalse(viewModel.state.value.isLoading)
+        assertEquals(1, viewModel.state.value.items.size)
+        assertEquals(24, viewModel.state.value.goalTarget)
+    }
+
+    @Test fun `mark finished reaches repository`() = runTest(scheduler) {
+        val fake = FakeBookRepository().apply { seedBooks(listOf(book(1))) }
+        val viewModel = BookListViewModel(fake, SavedStateHandle())
+        viewModel.onAction(BookListUiAction.OnMarkFinishedClick(1))
+        advanceUntilIdle()
+        assertEquals(1L, fake.lastMarkFinishedId)
+    }
+
+    @Test fun `save goal persists target`() = runTest(scheduler) {
+        val fake = FakeBookRepository()
+        val viewModel = BookListViewModel(fake, SavedStateHandle())
+        viewModel.onAction(BookListUiAction.OnGoalDraftChanged("12"))
+        viewModel.onAction(BookListUiAction.OnGoalSaved)
+        advanceUntilIdle()
+        assertEquals(12, fake.lastSetGoal)
+    }
+
+    @Test fun `invalid goal draft is ignored`() = runTest(scheduler) {
+        val fake = FakeBookRepository()
+        val viewModel = BookListViewModel(fake, SavedStateHandle())
+        viewModel.onAction(BookListUiAction.OnGoalDraftChanged("abc"))
+        viewModel.onAction(BookListUiAction.OnGoalSaved)
+        advanceUntilIdle()
+        assertNull(fake.lastSetGoal)
+    }
+
+    @Test fun `goal draft restored from saved state`() = runTest(scheduler) {
+        val handle = SavedStateHandle().apply { this["goalDraft"] = "7" }
+        val viewModel = BookListViewModel(FakeBookRepository(), handle)
+        assertEquals("7", viewModel.state.value.goalDraft)
+    }
+}
diff --git a/feature/notes/src/commonTest/kotlin/com/example/feature/notes/readinglog/presentation/list/FakeBookRepository.kt b/feature/notes/src/commonTest/kotlin/com/example/feature/notes/readinglog/presentation/list/FakeBookRepository.kt
