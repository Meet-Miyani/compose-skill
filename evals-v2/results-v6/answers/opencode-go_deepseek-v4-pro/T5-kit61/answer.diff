@@ -0,0 +1,39 @@
+package com.example.feature.notes.readinglog.presentation.list
+
+import com.example.feature.notes.readinglog.domain.model.Book
+import com.example.feature.notes.readinglog.domain.model.ReadingGoal
+import com.example.feature.notes.readinglog.domain.repository.BookRepository
+import kotlinx.coroutines.flow.Flow
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.update
+
+class FakeBookRepository : BookRepository {
+    private val books = MutableStateFlow<List<Book>>(emptyList())
+    private val goal = MutableStateFlow<ReadingGoal?>(null)
+
+    var lastMarkFinishedId: Long? = null
+    var lastSetGoal: Int? = null
+
+    fun seedBooks(items: List<Book>) { books.value = items }
+    fun seedGoal(target: Int?) { goal.value = target?.let { ReadingGoal(it) } }
+
+    override fun getBooksStream(): Flow<List<Book>> = books
+
+    override suspend fun addBook(title: String, author: String, pages: Int): Long {
+        val id = (books.value.maxOfOrNull { it.id } ?: 0L) + 1L
+        books.update { it + Book(id, title, author, pages, isFinished = false) }
+        return id
+    }
+
+    override suspend fun markFinished(id: Long) {
+        lastMarkFinishedId = id
+        books.update { list -> list.map { if (it.id == id) it.copy(isFinished = true) else it } }
+    }
+
+    override fun getReadingGoalStream(): Flow<ReadingGoal?> = goal
+
+    override suspend fun setReadingGoal(target: Int) {
+        lastSetGoal = target
+        goal.value = ReadingGoal(target)
+    }
+}
