+import kotlinx.coroutines.Job
+import org.koin.core.annotation.KoinViewModel
+
+@KoinViewModel
+class BookDetailViewModel(private val repository: BookRepository) :
+    BaseViewModel<BookDetailUiAction, BookDetailUiState, BookDetailUiEffect>(BookDetailUiState()) {
+
+    private var loadJob: Job? = null
+    private var requestedId: Long = 0L
+
+    override fun onAction(action: BookDetailUiAction) {
+        when (action) {
+            is BookDetailUiAction.OnScreenStarted -> {
+                requestedId = action.id
+                load()
             }
+            is BookDetailUiAction.OnRetryClick -> retry()
         }
     }
+
+    private fun load() {
+        if (loadJob?.isActive == true) return
+        updateState { copy(isLoading = true, error = null) }
+        loadJob = launchGuarded(onError = { error ->
+            updateState { copy(isLoading = false, error = error) }
+        }) {
+            val book = repository.getBook(requestedId)
+            updateState { copy(book = book, isLoading = false) }
+        }
+    }
+
+    private fun retry() {
+        updateState { copy(error = null) }
+        load()
+    }
 }
