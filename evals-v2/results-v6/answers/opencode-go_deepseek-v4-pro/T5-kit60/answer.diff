+package com.example.feature.notes.readinglog.presentation.list
+
+import com.example.feature.notes.readinglog.domain.model.ReadingGoal
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.ExperimentalCoroutinesApi
+import kotlinx.coroutines.test.StandardTestDispatcher
+import kotlinx.coroutines.test.TestCoroutineScheduler
+import kotlinx.coroutines.test.advanceUntilIdle
+import kotlinx.coroutines.test.resetMain
+import kotlinx.coroutines.test.runTest
+import kotlinx.coroutines.test.setMain
+import kotlin.test.AfterTest
+import kotlin.test.BeforeTest
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertFalse
+import kotlin.test.assertNull
+import kotlin.test.assertTrue
+
+@OptIn(ExperimentalCoroutinesApi::class)
+class BookListViewModelTest {
+    private val scheduler = TestCoroutineScheduler()
+
+    @BeforeTest fun setUp() { Dispatchers.setMain(StandardTestDispatcher(scheduler)) }
+    @AfterTest fun tearDown() { Dispatchers.resetMain() }
+
+    @Test fun `observes goal and later changes`() = runTest(scheduler) {
+        val goalRepo = FakeReadingGoalRepository()
+        val viewModel = BookListViewModel(FakeBookRepository(), goalRepo)
+        viewModel.onAction(BookListUiAction.OnScreenStarted)
+        advanceUntilIdle()
+        assertNull(viewModel.state.value.goal)
+        goalRepo.seed(ReadingGoal(30))
+        advanceUntilIdle()
+        assertEquals(30, viewModel.state.value.goal)
+    }
+
+    @Test fun `edit goal opens dialog prefilled with current goal`() = runTest(scheduler) {
+        val goalRepo = FakeReadingGoalRepository().apply { seed(ReadingGoal(30)) }
+        val viewModel = BookListViewModel(FakeBookRepository(), goalRepo)
+        viewModel.onAction(BookListUiAction.OnScreenStarted)
+        advanceUntilIdle()
+        viewModel.onAction(BookListUiAction.OnEditGoalClick)
+        advanceUntilIdle()
+        assertTrue(viewModel.state.value.isGoalDialogVisible)
+        assertEquals("30", viewModel.state.value.goalDraft)
+    }
+
+    @Test fun `draft change keeps only digits`() = runTest(scheduler) {
+        val viewModel = BookListViewModel(FakeBookRepository(), FakeReadingGoalRepository())
+        viewModel.onAction(BookListUiAction.OnEditGoalClick)
+        viewModel.onAction(BookListUiAction.OnGoalDraftChanged("a1b2c"))
+        advanceUntilIdle()
+        assertEquals("12", viewModel.state.value.goalDraft)
+    }
+
+    @Test fun `save goal persists target and closes dialog`() = runTest(scheduler) {
+        val goalRepo = FakeReadingGoalRepository()
+        val viewModel = BookListViewModel(FakeBookRepository(), goalRepo)
+        viewModel.onAction(BookListUiAction.OnEditGoalClick)
+        viewModel.onAction(BookListUiAction.OnGoalDraftChanged("25"))
+        viewModel.onAction(BookListUiAction.OnSaveGoalClick)
+        advanceUntilIdle()
+        assertEquals(25, goalRepo.lastSavedTarget)
+        assertFalse(viewModel.state.value.isGoalDialogVisible)
+    }
+
+    @Test fun `empty draft is not saved`() = runTest(scheduler) {
+        val goalRepo = FakeReadingGoalRepository()
+        val viewModel = BookListViewModel(FakeBookRepository(), goalRepo)
+        viewModel.onAction(BookListUiAction.OnEditGoalClick)
+        viewModel.onAction(BookListUiAction.OnGoalDraftChanged(""))
+        viewModel.onAction(BookListUiAction.OnSaveGoalClick)
+        advanceUntilIdle()
+        assertNull(goalRepo.lastSavedTarget)
+        assertTrue(viewModel.state.value.isGoalDialogVisible)
+    }
+
+    @Test fun `dismiss closes dialog without saving`() = runTest(scheduler) {
+        val goalRepo = FakeReadingGoalRepository()
+        val viewModel = BookListViewModel(FakeBookRepository(), goalRepo)
+        viewModel.onAction(BookListUiAction.OnEditGoalClick)
+        viewModel.onAction(BookListUiAction.OnGoalDraftChanged("25"))
+        viewModel.onAction(BookListUiAction.OnDismissGoalClick)
+        advanceUntilIdle()
+        assertNull(goalRepo.lastSavedTarget)
+        assertFalse(viewModel.state.value.isGoalDialogVisible)
+    }
+}
