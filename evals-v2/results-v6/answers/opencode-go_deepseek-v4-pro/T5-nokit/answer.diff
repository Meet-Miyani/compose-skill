+        val fake = FakeBookRepository().apply {
+            seedGoal(ReadingGoal(2026, 5))
+            seedBooks(listOf(finished(1, 2026), finished(2, 2025), unfinished(3)))
+        }
+        val viewModel = BookListViewModel(fake)
+        viewModel.onAction(BookListUiAction.OnScreenStarted)
+        advanceUntilIdle()
+
+        assertEquals(5, viewModel.state.value.goal?.target)
+        assertEquals(1, viewModel.state.value.progress)
+    }
+
+    @Test fun `no goal shows zero progress`() = runTest(scheduler) {
+        val fake = FakeBookRepository().apply { seedBooks(listOf(finished(1, 2026))) }
+        val viewModel = BookListViewModel(fake)
+        viewModel.onAction(BookListUiAction.OnScreenStarted)
+        advanceUntilIdle()
+
+        assertNull(viewModel.state.value.goal)
+        assertEquals(0, viewModel.state.value.progress)
+    }
+
+    @Test fun `mark finished updates progress`() = runTest(scheduler) {
+        val fake = FakeBookRepository().apply {
+            seedGoal(ReadingGoal(2026, 5))
+            seedBooks(listOf(unfinished(1)))
+        }
+        val viewModel = BookListViewModel(fake)
+        viewModel.onAction(BookListUiAction.OnScreenStarted)
+        advanceUntilIdle()
+        assertEquals(0, viewModel.state.value.progress)
+
+        viewModel.onAction(BookListUiAction.OnMarkFinishedClick(1))
+        advanceUntilIdle()
+
+        assertEquals(1, viewModel.state.value.progress)
+    }
+
+    @Test fun `set goal persists target`() = runTest(scheduler) {
+        val fake = FakeBookRepository()
+        val viewModel = BookListViewModel(fake)
+        viewModel.onAction(BookListUiAction.OnScreenStarted)
+        advanceUntilIdle()
+
+        viewModel.onAction(BookListUiAction.OnGoalInputChanged("12"))
+        viewModel.onAction(BookListUiAction.OnGoalSaveClick)
+        advanceUntilIdle()
+
+        assertEquals(12, fake.lastGoalTarget)
+        assertEquals(12, viewModel.state.value.goal?.target)
+        assertEquals("", viewModel.state.value.goalInput)
+    }
+
+    @Test fun `invalid goal input is ignored`() = runTest(scheduler) {
+        val fake = FakeBookRepository()
+        val viewModel = BookListViewModel(fake)
+        viewModel.onAction(BookListUiAction.OnScreenStarted)
+        advanceUntilIdle()
+
+        viewModel.onAction(BookListUiAction.OnGoalInputChanged("abc"))
+        viewModel.onAction(BookListUiAction.OnGoalSaveClick)
+        advanceUntilIdle()
+
+        assertNull(fake.lastGoalTarget)
+        assertNull(viewModel.state.value.goal)
+    }
+}
