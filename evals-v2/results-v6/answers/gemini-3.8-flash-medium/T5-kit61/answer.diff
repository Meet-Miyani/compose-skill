+package com.example.feature.notes.readinglog.presentation.list
+
+import com.example.feature.notes.readinglog.domain.model.Book
+import com.example.feature.notes.readinglog.domain.model.ReadingGoal
+import com.example.feature.notes.readinglog.domain.repository.BookRepository
+import kotlinx.coroutines.flow.Flow
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.map
+import kotlinx.coroutines.flow.update
+
+class FakeBookRepository : BookRepository {
+    private val booksFlow = MutableStateFlow<List<Book>>(emptyList())
+    private val goalsFlow = MutableStateFlow<Map<Int, ReadingGoal>>(emptyMap())
+
+    fun seedBooks(items: List<Book>) {
+        booksFlow.value = items
+    }
+
+    fun seedGoal(year: Int, target: Int) {
+        goalsFlow.update { it + (year to ReadingGoal(year, target)) }
+    }
+
+    override fun getBooksStream(): Flow<List<Book>> = booksFlow
+
+    override suspend fun addBook(title: String, author: String, pages: Int): Long {
+        val nextId = (booksFlow.value.maxOfOrNull { it.id } ?: 0L) + 1L
+        booksFlow.update { it + Book(nextId, title, author, pages, isFinished = false) }
+        return nextId
+    }
+
+    override suspend fun markFinished(id: Long) {
+        booksFlow.update { list ->
+            list.map { if (it.id == id) it.copy(isFinished = true) else it }
+        }
+    }
+
+    override fun getGoalStream(year: Int): Flow<ReadingGoal?> = goalsFlow.map { it[year] }
+
+    override suspend fun setGoal(year: Int, targetBooks: Int) {
+        goalsFlow.update { it + (year to ReadingGoal(year, targetBooks)) }
+    }
+}
