+import kotlinx.coroutines.test.runTest
+import kotlinx.coroutines.test.setMain
+import kotlin.test.AfterTest
+import kotlin.test.BeforeTest
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertFalse
+import kotlin.test.assertTrue
+
+@OptIn(ExperimentalCoroutinesApi::class)
+class AuthorBooksViewModelTest {
+    private val scheduler = TestCoroutineScheduler()
+
+    @BeforeTest fun setUp() { Dispatchers.setMain(StandardTestDispatcher(scheduler)) }
+    @AfterTest fun tearDown() { Dispatchers.resetMain() }
+
+    @Test fun `observes books filtered by specific author`() = runTest(scheduler) {
+        val fake = FakeBookRepository()
+        fake.seed(
+            listOf(
+                Book(1, "The Hobbit", "J.R.R. Tolkien", 310, false),
+                Book(2, "1984", "George Orwell", 328, false),
+                Book(3, "The Fellowship of the Ring", "J.R.R. Tolkien", 423, false),
+            )
+        )
+        val viewModel = AuthorBooksViewModel(fake, AuthorBooksParams("J.R.R. Tolkien"))
+        viewModel.onAction(AuthorBooksUiAction.OnScreenStarted)
+        advanceUntilIdle()
+
+        assertFalse(viewModel.state.value.isLoading)
+        assertEquals("J.R.R. Tolkien", viewModel.state.value.author)
+        val items = viewModel.state.value.items
+        assertEquals(2, items.size)
+        assertTrue(items.all { it.author == "J.R.R. Tolkien" })
+        assertEquals(listOf("The Hobbit", "The Fellowship of the Ring"), items.map { it.title })
+    }
+
+    @Test fun `markFinished marks book as finished for author`() = runTest(scheduler) {
+        val fake = FakeBookRepository()
+        fake.seed(
+            listOf(
+                Book(1, "The Hobbit", "J.R.R. Tolkien", 310, false),
+            )
+        )
+        val viewModel = AuthorBooksViewModel(fake, AuthorBooksParams("J.R.R. Tolkien"))
+        viewModel.onAction(AuthorBooksUiAction.OnScreenStarted)
+        advanceUntilIdle()
+
+        assertFalse(viewModel.state.value.items.single().isFinished)
+
+        viewModel.onAction(AuthorBooksUiAction.OnMarkFinishedClick(1L))
+        advanceUntilIdle()
+
+        assertTrue(viewModel.state.value.items.single().isFinished)
+    }
+
+    @Test fun `onBackClick sends NavigateBack effect`() = runTest(scheduler) {
+        val fake = FakeBookRepository()
+        val viewModel = AuthorBooksViewModel(fake, AuthorBooksParams("J.R.R. Tolkien"))
+        val effects = mutableListOf<AuthorBooksUiEffect>()
+        backgroundScope.launch(UnconfinedTestDispatcher(scheduler)) { viewModel.effect.toList(effects) }
+
+        viewModel.onAction(AuthorBooksUiAction.OnBackClick)
+        advanceUntilIdle()
+
+        assertEquals(AuthorBooksUiEffect.NavigateBack, effects.single())
+    }
+}
