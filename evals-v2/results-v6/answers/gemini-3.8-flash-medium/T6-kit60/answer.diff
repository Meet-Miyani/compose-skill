+    @Test fun `clicking author emits OpenAuthorBooks effect`() = runTest(scheduler) {
+        val fake = FakeBookRepository()
+        val viewModel = BookListViewModel(fake)
+        val effects = mutableListOf<BookListUiEffect>()
+        backgroundScope.launch(UnconfinedTestDispatcher(scheduler)) { viewModel.effect.toList(effects) }
+
+        viewModel.onAction(BookListUiAction.OnAuthorClick("J.R.R. Tolkien"))
+        advanceUntilIdle()
+
+        assertEquals(BookListUiEffect.OpenAuthorBooks("J.R.R. Tolkien"), effects.single())
+    }
+}
