+import org.koin.core.annotation.KoinViewModel
+
+@KoinViewModel
+class BookDetailViewModel(
+    private val repository: BookRepository,
+) : BaseViewModel<BookDetailUiAction, BookDetailUiState, BookDetailUiEffect>(
+    BookDetailUiState(),
+) {
+    private var loadJob: Job? = null
+
+    override fun onAction(action: BookDetailUiAction) {
+        when (action) {
+            is BookDetailUiAction.OnScreenStarted -> loadBook(action.id)
+        }
+    }
+
+    private fun loadBook(id: Long) {
+        if (loadJob?.isActive == true) return
+        loadJob = launchGuarded(
+            onError = ::emitError,
+            onStart = { updateState { copy(isLoading = true) } },
+            onComplete = { updateState { copy(isLoading = false) } },
+        ) {
+            val books = repository.getBooksStream().first()
+            val book = books.find { it.id == id }
+            updateState { copy(book = book) }
         }
     }
 }
