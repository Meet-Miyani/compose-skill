+package com.example.feature.notes.readinglog.presentation.list
+
+import com.example.feature.notes.readinglog.domain.model.Book
+import com.example.feature.notes.readinglog.domain.model.ReadingGoal
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.ExperimentalCoroutinesApi
+import kotlinx.coroutines.flow.toList
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.test.StandardTestDispatcher
+import kotlinx.coroutines.test.TestCoroutineScheduler
+import kotlinx.coroutines.test.UnconfinedTestDispatcher
+import kotlinx.coroutines.test.advanceUntilIdle
+import kotlinx.coroutines.test.resetMain
+import kotlinx.coroutines.test.runTest
+import kotlinx.coroutines.test.setMain
+import kotlin.test.AfterTest
+import kotlin.test.BeforeTest
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertFalse
+
+@OptIn(ExperimentalCoroutinesApi::class)
+class BookListViewModelTest {
+    private val scheduler = TestCoroutineScheduler()
+
+    @BeforeTest
+    fun setUp() {
+        Dispatchers.setMain(StandardTestDispatcher(scheduler))
+    }
+
+    @AfterTest
+    fun tearDown() {
+        Dispatchers.resetMain()
+    }
+
+    @Test
+    fun `observes books and reading goal on screen started`() = runTest(scheduler) {
+        val fake = FakeBookRepository()
+        fake.seedBooks(
+            listOf(
+                Book(id = 1L, title = "Atomic Habits", author = "James Clear", pages = 300, isFinished = true),
+                Book(id = 2L, title = "Deep Work", author = "Cal Newport", pages = 250, isFinished = false),
+            )
+        )
+        fake.seedGoal(ReadingGoal(targetBooks = 12, year = 2026))
+
+        val viewModel = BookListViewModel(fake)
+        viewModel.onAction(BookListUiAction.OnScreenStarted)
+        advanceUntilIdle()
+
+        assertFalse(viewModel.state.value.isLoading)
+        assertEquals(2, viewModel.state.value.items.size)
+        assertEquals(12, viewModel.state.value.yearlyGoal)
+        assertEquals("12", viewModel.state.value.goalInput)
+    }
+
+    @Test
+    fun `setting goal updates repository and state`() = runTest(scheduler) {
+        val fake = FakeBookRepository()
+        val viewModel = BookListViewModel(fake)
+        viewModel.onAction(BookListUiAction.OnScreenStarted)
+        advanceUntilIdle()
+
+        viewModel.onAction(BookListUiAction.OnGoalInputChanged("20"))
+        assertEquals("20", viewModel.state.value.goalInput)
+
+        viewModel.onAction(BookListUiAction.OnSetGoalClick)
+        advanceUntilIdle()
+
+        assertEquals(20, viewModel.state.value.yearlyGoal)
+    }
+
+    @Test
+    fun `marking book finished updates state`() = runTest(scheduler) {
+        val fake = FakeBookRepository()
+        fake.seedBooks(
+            listOf(
+                Book(id = 1L, title = "Atomic Habits", author = "James Clear", pages = 300, isFinished = false),
+            )
+        )
+        val viewModel = BookListViewModel(fake)
+        viewModel.onAction(BookListUiAction.OnScreenStarted)
+        advanceUntilIdle()
+
+        assertFalse(viewModel.state.value.items.single().isFinished)
+
+        viewModel.onAction(BookListUiAction.OnMarkFinishedClick(1L))
+        advanceUntilIdle()
+
+        assertEquals(true, viewModel.state.value.items.single().isFinished)
+    }
+
+    @Test
+    fun `add click emits OpenAddSheet effect`() = runTest(scheduler) {
+        val fake = FakeBookRepository()
+        val viewModel = BookListViewModel(fake)
+        val effects = mutableListOf<BookListUiEffect>()
+        backgroundScope.launch(UnconfinedTestDispatcher(scheduler)) {
+            viewModel.effect.toList(effects)
+        }
+
+        viewModel.onAction(BookListUiAction.OnAddClick)
+        advanceUntilIdle()
+
+        assertEquals(BookListUiEffect.OpenAddSheet, effects.single())
+    }
+}
