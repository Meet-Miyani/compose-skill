+package com.example.feature.notes.readinglog.presentation.list
+
+import com.example.feature.notes.readinglog.domain.model.Book
+import com.example.feature.notes.readinglog.domain.model.ReadingGoal
+import com.example.feature.notes.readinglog.domain.repository.BookRepository
+import kotlinx.coroutines.flow.Flow
+import kotlinx.coroutines.flow.MutableStateFlow
+
+class FakeBookRepository : BookRepository {
+    private val booksFlow = MutableStateFlow<List<Book>>(emptyList())
+    private val goalFlow = MutableStateFlow<ReadingGoal?>(null)
+
+    override fun getBooksStream(): Flow<List<Book>> = booksFlow
+
+    override suspend fun addBook(title: String, author: String, pages: Int): Long {
+        val newId = (booksFlow.value.size + 1).toLong()
+        val newBook = Book(id = newId, title = title, author = author, pages = pages, isFinished = false)
+        booksFlow.value = booksFlow.value + newBook
+        return newId
+    }
+
+    override suspend fun markFinished(id: Long) {
+        booksFlow.value = booksFlow.value.map {
+            if (it.id == id) it.copy(isFinished = true) else it
+        }
+    }
+
+    override fun getReadingGoalStream(year: Int): Flow<ReadingGoal?> = goalFlow
+
+    override suspend fun setReadingGoal(targetBooks: Int, year: Int) {
+        goalFlow.value = ReadingGoal(targetBooks = targetBooks, year = year)
+    }
+
+    fun seedBooks(books: List<Book>) {
+        booksFlow.value = books
+    }
+
+    fun seedGoal(goal: ReadingGoal?) {
+        goalFlow.value = goal
+    }
+}
