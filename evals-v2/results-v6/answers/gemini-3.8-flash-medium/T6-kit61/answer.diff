+    val items: List<Book> = emptyList(),
+    val isLoading: Boolean = false,
+    val error: AppError? = null,
+) : UiState
+
+sealed interface AuthorBooksUiAction : UiAction {
+    data object OnScreenStarted : AuthorBooksUiAction
