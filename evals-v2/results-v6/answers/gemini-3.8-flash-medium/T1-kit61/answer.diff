+package com.example.feature.notes.readinglog.presentation.stats
+
+import com.example.feature.notes.readinglog.FakeBookRepository
+import com.example.feature.notes.readinglog.domain.model.Book
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.ExperimentalCoroutinesApi
+import kotlinx.coroutines.test.StandardTestDispatcher
+import kotlinx.coroutines.test.TestCoroutineScheduler
+import kotlinx.coroutines.test.advanceUntilIdle
+import kotlinx.coroutines.test.resetMain
+import kotlinx.coroutines.test.runTest
+import kotlinx.coroutines.test.setMain
+import kotlin.test.AfterTest
+import kotlin.test.BeforeTest
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertFalse
+
+@OptIn(ExperimentalCoroutinesApi::class)
+class ReadingStatsViewModelTest {
+    private val scheduler = TestCoroutineScheduler()
+
+    @BeforeTest
+    fun setUp() {
+        Dispatchers.setMain(StandardTestDispatcher(scheduler))
+    }
+
+    @AfterTest
+    fun tearDown() {
+        Dispatchers.resetMain()
+    }
+
+    @Test
+    fun `calculates total pages for finished books`() = runTest(scheduler) {
+        val fake = FakeBookRepository()
+        fake.seed(
+            listOf(
+                Book(id = 1L, title = "Book 1", author = "Author 1", pages = 120, isFinished = true),
+                Book(id = 2L, title = "Book 2", author = "Author 2", pages = 300, isFinished = false),
+                Book(id = 3L, title = "Book 3", author = "Author 3", pages = 80, isFinished = true),
+            ),
+        )
+        val viewModel = ReadingStatsViewModel(fake)
+        viewModel.onAction(ReadingStatsUiAction.OnScreenStarted)
+        advanceUntilIdle()
+
+        assertFalse(viewModel.state.value.isLoading)
+        assertEquals(200, viewModel.state.value.totalPages)
+    }
+
+    @Test
+    fun `empty books returns zero pages`() = runTest(scheduler) {
+        val fake = FakeBookRepository()
+        val viewModel = ReadingStatsViewModel(fake)
+        viewModel.onAction(ReadingStatsUiAction.OnScreenStarted)
+        advanceUntilIdle()
+
+        assertFalse(viewModel.state.value.isLoading)
+        assertEquals(0, viewModel.state.value.totalPages)
+    }
+}
