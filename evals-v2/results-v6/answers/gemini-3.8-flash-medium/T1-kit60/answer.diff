+package com.example.feature.notes.readinglog.presentation.stats
+
+import com.example.core.error.NetworkException
+import com.example.feature.notes.readinglog.FakeBookRepository
+import com.example.feature.notes.readinglog.domain.model.Book
+import kotlinx.coroutines.CompletableDeferred
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.ExperimentalCoroutinesApi
+import kotlinx.coroutines.test.StandardTestDispatcher
+import kotlinx.coroutines.test.TestCoroutineScheduler
+import kotlinx.coroutines.test.advanceUntilIdle
+import kotlinx.coroutines.test.resetMain
+import kotlinx.coroutines.test.runTest
+import kotlinx.coroutines.test.setMain
+import kotlin.test.AfterTest
+import kotlin.test.BeforeTest
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertFalse
+import kotlin.test.assertNotNull
+import kotlin.test.assertNull
+import kotlin.test.assertTrue
+
+@OptIn(ExperimentalCoroutinesApi::class)
+class ReadingStatsViewModelTest {
+    private val scheduler = TestCoroutineScheduler()
+
+    @BeforeTest
+    fun setUp() {
+        Dispatchers.setMain(StandardTestDispatcher(scheduler))
+    }
+
+    @AfterTest
+    fun tearDown() {
+        Dispatchers.resetMain()
+    }
+
+    @Test
+    fun `cold load shows total pages read for finished books`() = runTest(scheduler) {
+        val fake = FakeBookRepository()
+        fake.seed(
+            listOf(
+                Book(id = 1L, title = "Finished Book", author = "Author A", pages = 120, isFinished = true),
+                Book(id = 2L, title = "Unfinished Book", author = "Author B", pages = 80, isFinished = false),
+                Book(id = 3L, title = "Another Finished", author = "Author C", pages = 200, isFinished = true),
+            ),
+        )
+        val viewModel = ReadingStatsViewModel(fake)
+
+        viewModel.onAction(ReadingStatsUiAction.OnScreenStarted)
+        advanceUntilIdle()
+
+        assertEquals(320, viewModel.state.value.totalPages)
+        assertFalse(viewModel.state.value.isLoading)
+        assertNull(viewModel.state.value.error)
+    }
+
+    @Test
+    fun `loading state is true during in flight fetch`() = runTest(scheduler) {
+        val fake = FakeBookRepository()
+        val gate = CompletableDeferred<Unit>()
+        fake.gate = gate
+        val viewModel = ReadingStatsViewModel(fake)
+
+        viewModel.onAction(ReadingStatsUiAction.OnScreenStarted)
+        advanceUntilIdle()
+
+        assertTrue(viewModel.state.value.isLoading)
+
+        gate.complete(Unit)
+        advanceUntilIdle()
+
+        assertFalse(viewModel.state.value.isLoading)
+    }
+
+    @Test
+    fun `load failure sets inline error and stops loading`() = runTest(scheduler) {
+        val fake = FakeBookRepository()
+        fake.shouldThrow = NetworkException.Connection()
+        val viewModel = ReadingStatsViewModel(fake)
+
+        viewModel.onAction(ReadingStatsUiAction.OnScreenStarted)
+        advanceUntilIdle()
+
+        assertNotNull(viewModel.state.value.error)
+        assertFalse(viewModel.state.value.isLoading)
+    }
+
+    @Test
+    fun `overlapping loads only fetch once`() = runTest(scheduler) {
+        val fake = FakeBookRepository()
+        val gate = CompletableDeferred<Unit>()
+        fake.gate = gate
+        val viewModel = ReadingStatsViewModel(fake)
+
+        viewModel.onAction(ReadingStatsUiAction.OnScreenStarted)
+        viewModel.onAction(ReadingStatsUiAction.OnScreenStarted)
+        advanceUntilIdle()
+
+        gate.complete(Unit)
+        advanceUntilIdle()
+
+        assertEquals(1, fake.getCalls)
+    }
+}
