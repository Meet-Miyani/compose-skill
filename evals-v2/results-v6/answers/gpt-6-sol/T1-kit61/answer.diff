+import kotlinx.coroutines.flow.catch
+import kotlinx.coroutines.flow.firstOrNull
+import org.koin.core.annotation.KoinViewModel
+
+@KoinViewModel
+class ReadingStatsViewModel(private val repository: BookRepository) :
+    BaseViewModel<ReadingStatsUiAction, ReadingStatsUiState, ReadingStatsUiEffect>(ReadingStatsUiState()) {
+
+    override fun onAction(action: ReadingStatsUiAction) {
+        when (action) {
+            ReadingStatsUiAction.OnScreenStarted -> loadStats()
+        }
+    }
+
+    private fun loadStats() {
+        updateState { copy(isLoading = true) }
+        launchGuarded(
+            onError = { error -> updateState { copy(error = error.serverMessage ?: error.type.name) } },
+            onComplete = { updateState { copy(isLoading = false) } },
+        ) {
+            val books = repository.getBooksStream()
+                .catch { error -> updateState { copy(error = error.message) } }
+                .firstOrNull()
+            if (books != null) {
+                val pages = books.filter { it.isFinished }.sumOf { it.pages }
+                updateState { copy(totalPages = pages) }
             }
         }
     }
