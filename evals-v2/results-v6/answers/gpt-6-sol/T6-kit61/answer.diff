+import notes.feature.notes.generated.resources.book_finished
+import notes.feature.notes.generated.resources.book_pages
+import notes.feature.notes.generated.resources.book_unfinished
+import notes.feature.notes.generated.resources.error_message
+import notes.feature.notes.generated.resources.no_author_books
+import notes.feature.notes.generated.resources.retry
+import org.jetbrains.compose.resources.stringResource
+
+@Composable
+fun AuthorBooksScreen(state: AuthorBooksUiState, onRetry: () -> Unit) {
+    Column(Modifier.fillMaxSize().padding(16.dp)) {
+        Text(stringResource(Res.string.author_books_title, state.author))
+        if (state.error != null) {
+            Text(stringResource(Res.string.error_message))
+            Button(onClick = onRetry) { Text(stringResource(Res.string.retry)) }
+        }
+        if (state.isLoading && state.items.isEmpty()) {
+            CircularProgressIndicator()
+        } else if (!state.isLoading && state.items.isEmpty() && state.error == null) {
+            Text(stringResource(Res.string.no_author_books))
+        } else {
+            LazyColumn {
+                items(state.items, key = { it.id }) { book ->
+                    ListItem(
+                        headlineContent = { Text(book.title) },
+                        supportingContent = {
+                            Text(stringResource(Res.string.book_pages, book.pages))
+                        },
+                        trailingContent = {
+                            Text(stringResource(if (book.isFinished) Res.string.book_finished else Res.string.book_unfinished))
+                        },
+                    )
+                }
+            }
+        }
+    }
+}
