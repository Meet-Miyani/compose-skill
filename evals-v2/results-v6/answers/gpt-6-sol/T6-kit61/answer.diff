+package com.example.feature.notes.readinglog.presentation.author
+
+import com.example.core.error.StorageException
+import com.example.feature.notes.readinglog.domain.model.Book
+import com.example.feature.notes.readinglog.domain.repository.BookRepository
+import com.example.feature.notes.readinglog.presentation.list.BookListUiAction
+import com.example.feature.notes.readinglog.presentation.list.BookListUiEffect
+import com.example.feature.notes.readinglog.presentation.list.BookListViewModel
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.ExperimentalCoroutinesApi
+import kotlinx.coroutines.flow.Flow
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.flow
+import kotlinx.coroutines.flow.toList
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.test.StandardTestDispatcher
+import kotlinx.coroutines.test.TestCoroutineScheduler
+import kotlinx.coroutines.test.UnconfinedTestDispatcher
+import kotlinx.coroutines.test.advanceUntilIdle
+import kotlinx.coroutines.test.resetMain
+import kotlinx.coroutines.test.runTest
+import kotlinx.coroutines.test.setMain
+import kotlin.test.AfterTest
+import kotlin.test.BeforeTest
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertFalse
+import kotlin.test.assertNotNull
+import kotlin.test.assertTrue
+
+@OptIn(ExperimentalCoroutinesApi::class)
+class AuthorBooksViewModelTest {
+    private val scheduler = TestCoroutineScheduler()
+
+    @BeforeTest fun setUp() { Dispatchers.setMain(StandardTestDispatcher(scheduler)) }
+    @AfterTest fun tearDown() { Dispatchers.resetMain() }
+
+    @Test fun `shows only selected author's books and follows updates`() = runTest(scheduler) {
+        val repository = FakeBookRepository()
+        repository.books.value = listOf(
+            Book(1, "First", "Ada", 120, false),
+            Book(2, "Other", "Bob", 90, false),
+        )
+        val viewModel = AuthorBooksViewModel(repository, AuthorBooksParams("Ada"))
+        viewModel.onAction(AuthorBooksUiAction.OnScreenStarted)
+        advanceUntilIdle()
+        assertEquals(listOf("First"), viewModel.state.value.items.map { it.title })
+        assertFalse(viewModel.state.value.isLoading)
+
+        repository.books.value = repository.books.value + Book(3, "Second", "Ada", 200, true)
+        advanceUntilIdle()
+        assertEquals(listOf("First", "Second"), viewModel.state.value.items.map { it.title })
+    }
+
+    @Test fun `restored author with no books shows empty state`() = runTest(scheduler) {
+        val viewModel = AuthorBooksViewModel(FakeBookRepository(), AuthorBooksParams("Ada"))
+        viewModel.onAction(AuthorBooksUiAction.OnScreenStarted)
+        advanceUntilIdle()
+        assertTrue(viewModel.state.value.items.isEmpty())
+        assertFalse(viewModel.state.value.isLoading)
+        assertEquals("Ada", viewModel.state.value.author)
+    }
+
+    @Test fun `failed load can retry`() = runTest(scheduler) {
+        val repository = FakeBookRepository()
+        repository.fail = true
+        val viewModel = AuthorBooksViewModel(repository, AuthorBooksParams("Ada"))
+        viewModel.onAction(AuthorBooksUiAction.OnScreenStarted)
+        advanceUntilIdle()
+        assertNotNull(viewModel.state.value.error)
+        assertFalse(viewModel.state.value.isLoading)
+
+        repository.fail = false
+        repository.books.value = listOf(Book(4, "Recovered", "Ada", 150, false))
+        viewModel.onAction(AuthorBooksUiAction.OnRetryClick)
+        advanceUntilIdle()
+        assertEquals("Recovered", viewModel.state.value.items.single().title)
+        assertEquals(null, viewModel.state.value.error)
+    }
+
+    @Test fun `author click requests the selected author's page`() = runTest(scheduler) {
+        val viewModel = BookListViewModel(FakeBookRepository())
+        val effects = mutableListOf<BookListUiEffect>()
+        backgroundScope.launch(UnconfinedTestDispatcher(scheduler)) { viewModel.effect.toList(effects) }
+        viewModel.onAction(BookListUiAction.OnAuthorClick("Ada"))
+        advanceUntilIdle()
+        assertEquals(BookListUiEffect.OpenAuthorBooks("Ada"), effects.single())
+    }
+}
+
+private class FakeBookRepository : BookRepository {
+    val books = MutableStateFlow<List<Book>>(emptyList())
+    var fail = false
+
+    override fun getBooksStream(): Flow<List<Book>> = if (fail) {
+        flow { throw StorageException(IllegalStateException("Unavailable")) }
+    } else books
+
+    override suspend fun addBook(title: String, author: String, pages: Int): Long = error("unused")
+    override suspend fun markFinished(id: Long) = error("unused")
+}
