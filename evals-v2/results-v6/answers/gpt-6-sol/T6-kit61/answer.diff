+import androidx.lifecycle.compose.collectAsStateWithLifecycle
+import com.example.designsystem.error.HandleAppErrors
+
+@Composable
+fun AuthorBooksRoute(viewModel: AuthorBooksViewModel, author: String) {
+    LifecycleStartEffect(author) {
+        viewModel.onAction(AuthorBooksUiAction.OnScreenStarted)
+        onStopOrDispose {}
