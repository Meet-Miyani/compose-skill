+package com.example.feature.notes.readinglog.data
+
+import androidx.room.Room
+import androidx.sqlite.driver.bundled.BundledSQLiteDriver
+import com.example.feature.notes.data.local.NotesDatabase
+import kotlinx.coroutines.flow.first
+import kotlinx.coroutines.runBlocking
+import java.nio.file.Files
+import kotlin.test.Test
+import kotlin.test.assertEquals
+
+class ReadingGoalPersistenceTest {
+    @Test fun `goal and finish year remain after database reopens`() = runBlocking {
+        val directory = Files.createTempDirectory("reading-goal-test")
+        val path = directory.resolve("notes.db").toString()
+        fun open() = Room.databaseBuilder<NotesDatabase>(name = path).setDriver(BundledSQLiteDriver()).build()
+        val first = open()
+        try {
+            first.bookDao().upsertGoal(ReadingGoalEntity(2026, 12))
+            val id = first.bookDao().insert(BookEntity(title = "A book", author = "Author", pages = 100, isFinished = false))
+            first.bookDao().markFinishedInYear(id, 2026)
+        } finally {
+            first.close()
+        }
+        val second = open()
+        try {
+            assertEquals(12, second.bookDao().getGoalStream(2026).first()?.targetBooks)
+            assertEquals(1, second.bookDao().getFinishedCountStream(2026).first())
+            assertEquals(0, second.bookDao().getFinishedCountStream(2027).first())
+        } finally {
+            second.close()
+        }
+    }
+}
