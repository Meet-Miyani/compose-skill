+import kotlinx.coroutines.test.StandardTestDispatcher
+import kotlinx.coroutines.test.TestCoroutineScheduler
+import kotlinx.coroutines.test.advanceUntilIdle
+import kotlinx.coroutines.test.resetMain
+import kotlinx.coroutines.test.runTest
+import kotlinx.coroutines.test.setMain
+import kotlin.test.AfterTest
+import kotlin.test.BeforeTest
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertFalse
+import kotlin.test.assertTrue
+
+@OptIn(ExperimentalCoroutinesApi::class)
+class BookListViewModelTest {
+    private val scheduler = TestCoroutineScheduler()
+    @BeforeTest fun setUp() { Dispatchers.setMain(StandardTestDispatcher(scheduler)) }
+    @AfterTest fun tearDown() { Dispatchers.resetMain() }
+
+    @Test fun `saved goal and finished count survive a new view model`() = runTest(scheduler) {
+        val repository = FakeBookRepository()
+        val first = BookListViewModel(repository, SavedStateHandle())
+        first.onAction(BookListUiAction.OnScreenStarted)
+        advanceUntilIdle()
+        first.onAction(BookListUiAction.OnGoalChanged("12"))
+        first.onAction(BookListUiAction.OnSaveGoalClick)
+        advanceUntilIdle()
+        assertEquals(12, first.state.value.goal)
+
+        val second = BookListViewModel(repository, SavedStateHandle())
+        second.onAction(BookListUiAction.OnScreenStarted)
+        advanceUntilIdle()
+        assertEquals(12, second.state.value.goal)
+        assertEquals("12", second.state.value.goalDraft)
+        second.onAction(BookListUiAction.OnMarkFinishedClick(1))
+        advanceUntilIdle()
+        assertEquals(1, second.state.value.finishedCount)
+        assertEquals(second.state.value.year, repository.finishedYear)
+    }
+
+    @Test fun `invalid goal leaves saved goal intact`() = runTest(scheduler) {
+        val repository = FakeBookRepository()
+        val viewModel = BookListViewModel(repository, SavedStateHandle())
+        viewModel.onAction(BookListUiAction.OnScreenStarted)
+        advanceUntilIdle()
+        viewModel.onAction(BookListUiAction.OnGoalChanged("0"))
+        viewModel.onAction(BookListUiAction.OnSaveGoalClick)
+        advanceUntilIdle()
+        assertTrue(viewModel.state.value.goalError)
+        assertEquals(null, viewModel.state.value.goal)
+        viewModel.onAction(BookListUiAction.OnGoalChanged("5"))
+        assertFalse(viewModel.state.value.goalError)
+    }
+}
+
+private class FakeBookRepository : BookRepository {
+    private val books = MutableStateFlow(listOf(Book(1, "Book", "Author", 100, false)))
+    private val count = MutableStateFlow(0)
+    private val goal = MutableStateFlow<Int?>(null)
+    var finishedYear: Int? = null
+    override fun getBooksStream(): Flow<List<Book>> = books
+    override fun getFinishedCountStream(year: Int): Flow<Int> = count
+    override fun getGoalStream(year: Int): Flow<Int?> = goal
+    override suspend fun addBook(title: String, author: String, pages: Int): Long = 2
+    override suspend fun markFinished(id: Long, year: Int) {
+        finishedYear = year
+        books.update { list -> list.map { if (it.id == id) it.copy(isFinished = true) else it } }
+        count.value = 1
+    }
+    override suspend fun saveGoal(year: Int, targetBooks: Int) { goal.value = targetBooks }
+}
