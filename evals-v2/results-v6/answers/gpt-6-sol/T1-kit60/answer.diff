+import org.koin.core.annotation.KoinViewModel
+
+@KoinViewModel
+class ReadingStatsViewModel(private val repository: BookRepository) :
+    BaseViewModel<ReadingStatsUiAction, ReadingStatsUiState, ReadingStatsUiEffect>(ReadingStatsUiState()) {
+    private var loadJob: Job? = null
+    private var hasLoaded = false
+
+    override fun onAction(action: ReadingStatsUiAction) {
+        when (action) {
+            ReadingStatsUiAction.OnScreenStarted -> loadStats()
+            is ReadingStatsUiAction.OnRetryClick -> {
+                if (currentState.error == action.error) loadStats()
             }
         }
     }
+
+    private fun loadStats() {
+        if (loadJob?.isActive == true) return
+        updateState { copy(isLoading = true, error = null) }
+        loadJob = launchGuarded(
+            onError = { error ->
+                if (hasLoaded) emitError(error)
+                else updateState { copy(error = error) }
+            },
+            onComplete = { updateState { copy(isLoading = false) } },
+        ) {
+            val books = repository.getBooksStream().first()
+            val pages = books.filter { it.isFinished }.sumOf { it.pages }
+            updateState { copy(totalPages = pages, error = null) }
+            hasLoaded = true
+        }
+    }
 }
