+package com.example.feature.notes.readinglog.presentation.stats
+
+import com.example.core.error.AppError
+import com.example.core.error.AppErrorType
+import com.example.core.error.StorageException
+import com.example.feature.notes.readinglog.domain.model.Book
+import com.example.feature.notes.readinglog.domain.repository.BookRepository
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.ExperimentalCoroutinesApi
+import kotlinx.coroutines.flow.Flow
+import kotlinx.coroutines.flow.flow
+import kotlinx.coroutines.flow.toList
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.test.StandardTestDispatcher
+import kotlinx.coroutines.test.TestCoroutineScheduler
+import kotlinx.coroutines.test.UnconfinedTestDispatcher
+import kotlinx.coroutines.test.advanceUntilIdle
+import kotlinx.coroutines.test.resetMain
+import kotlinx.coroutines.test.runTest
+import kotlinx.coroutines.test.setMain
+import kotlin.test.AfterTest
+import kotlin.test.BeforeTest
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertFalse
+import kotlin.test.assertNull
+
+@OptIn(ExperimentalCoroutinesApi::class)
+class ReadingStatsViewModelTest {
+    private val scheduler = TestCoroutineScheduler()
+
+    @BeforeTest fun setUp() { Dispatchers.setMain(StandardTestDispatcher(scheduler)) }
+    @AfterTest fun tearDown() { Dispatchers.resetMain() }
+
+    @Test fun `counts finished pages from first emission only`() = runTest(scheduler) {
+        val repository = FakeBookRepository()
+        repository.books = listOf(
+            Book(1, "Finished", "A", 120, true),
+            Book(2, "Unfinished", "B", 300, false),
+            Book(3, "Also finished", "C", 40, true),
+        )
+        val viewModel = ReadingStatsViewModel(repository)
+
+        viewModel.onAction(ReadingStatsUiAction.OnScreenStarted)
+        advanceUntilIdle()
+
+        assertEquals(160, viewModel.state.value.totalPages)
+        assertFalse(viewModel.state.value.isLoading)
+        assertNull(viewModel.state.value.error)
+    }
+
+    @Test fun `failed first load retains error and retry loads stats`() = runTest(scheduler) {
+        val repository = FakeBookRepository()
+        repository.failure = StorageException(IllegalStateException("database unavailable"))
+        val viewModel = ReadingStatsViewModel(repository)
+
+        viewModel.onAction(ReadingStatsUiAction.OnScreenStarted)
+        advanceUntilIdle()
+        val error = viewModel.state.value.error!!
+        assertEquals(AppErrorType.Storage, error.type)
+        assertFalse(viewModel.state.value.isLoading)
+
+        repository.failure = null
+        repository.books = listOf(Book(1, "Finished", "A", 90, true))
+        viewModel.onAction(ReadingStatsUiAction.OnRetryClick(error))
+        advanceUntilIdle()
+
+        assertEquals(90, viewModel.state.value.totalPages)
+        assertNull(viewModel.state.value.error)
+    }
+
+    @Test fun `next screen start recalculates the snapshot`() = runTest(scheduler) {
+        val repository = FakeBookRepository()
+        val viewModel = ReadingStatsViewModel(repository)
+        viewModel.onAction(ReadingStatsUiAction.OnScreenStarted)
+        advanceUntilIdle()
+        assertEquals(0, viewModel.state.value.totalPages)
+
+        repository.books = listOf(Book(1, "Finished", "A", 25, true))
+        viewModel.onAction(ReadingStatsUiAction.OnScreenStarted)
+        advanceUntilIdle()
+        assertEquals(25, viewModel.state.value.totalPages)
+    }
+
+    @Test fun `failed later load keeps the last total`() = runTest(scheduler) {
+        val repository = FakeBookRepository()
+        repository.books = listOf(Book(1, "Finished", "A", 25, true))
+        val viewModel = ReadingStatsViewModel(repository)
+        val errors = mutableListOf<AppError>()
+        backgroundScope.launch(UnconfinedTestDispatcher(scheduler)) { viewModel.errors.toList(errors) }
+        viewModel.onAction(ReadingStatsUiAction.OnScreenStarted)
+        advanceUntilIdle()
+
+        repository.failure = StorageException(IllegalStateException("database unavailable"))
+        viewModel.onAction(ReadingStatsUiAction.OnScreenStarted)
+        advanceUntilIdle()
+
+        assertEquals(25, viewModel.state.value.totalPages)
+        assertNull(viewModel.state.value.error)
+        assertFalse(viewModel.state.value.isLoading)
+        assertEquals(AppErrorType.Storage, errors.single().type)
+    }
+
+    private class FakeBookRepository : BookRepository {
+        var books: List<Book> = emptyList()
+        var failure: StorageException? = null
+
+        override fun getBooksStream(): Flow<List<Book>> = flow {
+            failure?.let { throw it }
+            emit(books)
+        }
+
+        override suspend fun addBook(title: String, author: String, pages: Int): Long =
+            error("Not used by reading stats")
+
+        override suspend fun markFinished(id: Long) {
+            error("Not used by reading stats")
+        }
+    }
+}
