+package com.example.feature.notes.readinglog.presentation.detail
+
+import com.example.core.error.AppError
+import com.example.core.error.NetworkException
+import com.example.feature.notes.readinglog.domain.model.Book
+import com.example.feature.notes.readinglog.domain.repository.BookRepository
+import kotlinx.coroutines.CompletableDeferred
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.ExperimentalCoroutinesApi
+import kotlinx.coroutines.flow.Flow
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.flow
+import kotlinx.coroutines.flow.toList
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.test.StandardTestDispatcher
+import kotlinx.coroutines.test.TestCoroutineScheduler
+import kotlinx.coroutines.test.UnconfinedTestDispatcher
+import kotlinx.coroutines.test.advanceUntilIdle
+import kotlinx.coroutines.test.resetMain
+import kotlinx.coroutines.test.runTest
+import kotlinx.coroutines.test.setMain
+import kotlin.test.AfterTest
+import kotlin.test.BeforeTest
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertFalse
+import kotlin.test.assertNotNull
+import kotlin.test.assertNull
+import kotlin.test.assertTrue
+
+@OptIn(ExperimentalCoroutinesApi::class)
+class BookDetailViewModelTest {
+    private val scheduler = TestCoroutineScheduler()
+    private val mainDispatcher = StandardTestDispatcher(scheduler)
+
+    @BeforeTest
+    fun setUp() {
+        Dispatchers.setMain(mainDispatcher)
+    }
+
+    @AfterTest
+    fun tearDown() {
+        Dispatchers.resetMain()
+    }
+
+    private class FakeBookRepository : BookRepository {
+        val books = MutableStateFlow<List<Book>>(emptyList())
+        var gate: CompletableDeferred<Unit>? = null
+        var failure: Throwable? = null
+        var calls = 0
+
+        override fun getBooksStream(): Flow<List<Book>> = flow {
+            calls++
+            gate?.await()
+            failure?.let { throw it }
+            emit(books.value)
+        }
+
+        override suspend fun addBook(title: String, author: String, pages: Int): Long = error("unused")
+        override suspend fun markFinished(id: Long) = error("unused")
+    }
+
+    private fun book(id: Long = 1L, title: String = "Title") =
+        Book(id = id, title = title, author = "Author", pages = 100, isFinished = false)
+
+    private fun viewModel(fake: FakeBookRepository, id: Long = 1L) =
+        BookDetailViewModel(fake, BookDetailParams(id))
+
+    @Test
+    fun `cold load shows matching book and loading transition`() = runTest(scheduler) {
+        val fake = FakeBookRepository().apply {
+            books.value = listOf(book(1L), book(2L, "Other"))
+            gate = CompletableDeferred()
+        }
+        val vm = viewModel(fake)
+        vm.onAction(BookDetailUiAction.OnScreenStarted)
+        advanceUntilIdle()
+        assertTrue(vm.state.value.isLoading)
+        assertNull(vm.state.value.book)
+
+        fake.gate!!.complete(Unit)
+        advanceUntilIdle()
+        assertEquals("Title", vm.state.value.book?.title)
+        assertFalse(vm.state.value.isLoading)
+        assertFalse(vm.state.value.isMissing)
+    }
+
+    @Test
+    fun `missing id stays a business state`() = runTest(scheduler) {
+        val fake = FakeBookRepository().apply { books.value = listOf(book(2L)) }
+        val vm = viewModel(fake)
+        vm.onAction(BookDetailUiAction.OnScreenStarted)
+        advanceUntilIdle()
+        assertTrue(vm.state.value.isMissing)
+        assertNull(vm.state.value.error)
+    }
+
+    @Test
+    fun `cold error can retry`() = runTest(scheduler) {
+        val fake = FakeBookRepository().apply { failure = NetworkException.Connection() }
+        val vm = viewModel(fake)
+        vm.onAction(BookDetailUiAction.OnScreenStarted)
+        advanceUntilIdle()
+        val error = assertNotNull(vm.state.value.error)
+        assertFalse(vm.state.value.isLoading)
+
+        fake.failure = null
+        fake.books.value = listOf(book())
+        vm.onAction(BookDetailUiAction.OnRetryClick(error))
+        advanceUntilIdle()
+        assertNull(vm.state.value.error)
+        assertEquals("Title", vm.state.value.book?.title)
+    }
+
+    @Test
+    fun `refresh failure keeps the title and reports popup error`() = runTest(scheduler) {
+        val fake = FakeBookRepository().apply { books.value = listOf(book()) }
+        val vm = viewModel(fake)
+        val errors = mutableListOf<AppError>()
+        backgroundScope.launch(UnconfinedTestDispatcher(scheduler)) { vm.errors.toList(errors) }
+        vm.onAction(BookDetailUiAction.OnScreenStarted)
+        advanceUntilIdle()
+
+        fake.failure = NetworkException.Connection()
+        vm.onAction(BookDetailUiAction.OnScreenStarted)
+        advanceUntilIdle()
+        assertEquals("Title", vm.state.value.book?.title)
+        assertFalse(vm.state.value.isLoading)
+        assertEquals(1, errors.size)
+    }
+
+    @Test
+    fun `overlap loads once and restored destination refetches by id`() = runTest(scheduler) {
+        val fake = FakeBookRepository().apply { books.value = listOf(book(2L, "Restored")) }
+        val vm = viewModel(fake, id = 2L)
+        vm.onAction(BookDetailUiAction.OnScreenStarted)
+        vm.onAction(BookDetailUiAction.OnScreenStarted)
+        advanceUntilIdle()
+        assertEquals(1, fake.calls)
+        assertEquals("Restored", vm.state.value.book?.title)
+    }
+}
