+package com.example.feature.notes.readinglog.presentation.detail
+
+import com.example.core.error.StorageException
+import com.example.feature.notes.readinglog.domain.model.Book
+import com.example.feature.notes.readinglog.domain.repository.BookRepository
+import kotlinx.coroutines.CompletableDeferred
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.ExperimentalCoroutinesApi
+import kotlinx.coroutines.flow.Flow
+import kotlinx.coroutines.flow.flow
+import kotlinx.coroutines.test.StandardTestDispatcher
+import kotlinx.coroutines.test.TestCoroutineScheduler
+import kotlinx.coroutines.test.advanceUntilIdle
+import kotlinx.coroutines.test.resetMain
+import kotlinx.coroutines.test.runTest
+import kotlinx.coroutines.test.setMain
+import kotlin.test.AfterTest
+import kotlin.test.BeforeTest
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertFalse
+import kotlin.test.assertNotNull
+import kotlin.test.assertNull
+import kotlin.test.assertTrue
+
+@OptIn(ExperimentalCoroutinesApi::class)
+class BookDetailViewModelTest {
+    private val scheduler = TestCoroutineScheduler()
+    private val mainDispatcher = StandardTestDispatcher(scheduler)
+
+    @BeforeTest
+    fun setUp() {
+        Dispatchers.setMain(mainDispatcher)
+    }
+
+    @AfterTest
+    fun tearDown() {
+        Dispatchers.resetMain()
+    }
+
+    @Test
+    fun `start loads the matching book and clears loading`() = runTest(scheduler) {
+        val book = Book(2L, "Second", "Author", 100, false)
+        val fake = FakeBookRepository(listOf(Book(1L, "First", "Author", 50, false), book))
+        val gate = CompletableDeferred<Unit>()
+        fake.gate = gate
+        val viewModel = BookDetailViewModel(fake)
+
+        viewModel.onAction(BookDetailUiAction.OnScreenStarted(2L))
+        advanceUntilIdle()
+        assertTrue(viewModel.state.value.isLoading)
+        assertNull(viewModel.state.value.book)
+
+        gate.complete(Unit)
+        advanceUntilIdle()
+        assertEquals(book, viewModel.state.value.book)
+        assertFalse(viewModel.state.value.isLoading)
+        assertNull(viewModel.state.value.error)
+    }
+
+    @Test
+    fun `missing book stays empty after loading`() = runTest(scheduler) {
+        val viewModel = BookDetailViewModel(FakeBookRepository(emptyList()))
+
+        viewModel.onAction(BookDetailUiAction.OnScreenStarted(9L))
+        advanceUntilIdle()
+
+        assertNull(viewModel.state.value.book)
+        assertFalse(viewModel.state.value.isLoading)
+    }
+
+    @Test
+    fun `failed load keeps the existing error state`() = runTest(scheduler) {
+        val fake = FakeBookRepository(emptyList())
+        fake.failure = StorageException(IllegalStateException("database unavailable"))
+        val viewModel = BookDetailViewModel(fake)
+
+        viewModel.onAction(BookDetailUiAction.OnScreenStarted(1L))
+        advanceUntilIdle()
+
+        assertNull(viewModel.state.value.book)
+        assertFalse(viewModel.state.value.isLoading)
+        assertNotNull(viewModel.state.value.error)
+    }
+
+    @Test
+    fun `overlapping starts use the first lookup`() = runTest(scheduler) {
+        val fake = FakeBookRepository(listOf(Book(1L, "First", "Author", 50, false)))
+        val gate = CompletableDeferred<Unit>()
+        fake.gate = gate
+        val viewModel = BookDetailViewModel(fake)
+
+        viewModel.onAction(BookDetailUiAction.OnScreenStarted(1L))
+        advanceUntilIdle()
+        viewModel.onAction(BookDetailUiAction.OnScreenStarted(1L))
+        advanceUntilIdle()
+        assertEquals(1, fake.readCount)
+
+        gate.complete(Unit)
+        advanceUntilIdle()
+        assertEquals(1L, viewModel.state.value.book?.id)
+    }
+}
+
+private class FakeBookRepository(private val books: List<Book>) : BookRepository {
+    var gate: CompletableDeferred<Unit>? = null
+    var failure: Throwable? = null
+    var readCount = 0
+
+    override fun getBooksStream(): Flow<List<Book>> = flow {
+        readCount++
+        gate?.await()
+        failure?.let { throw it }
+        emit(books)
+    }
+
+    override suspend fun addBook(title: String, author: String, pages: Int): Long =
+        error("Not used by book detail")
+
+    override suspend fun markFinished(id: Long) {
+        error("Not used by book detail")
+    }
+}
