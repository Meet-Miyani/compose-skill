+import androidx.compose.runtime.Composable
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.unit.dp
+import org.jetbrains.compose.resources.stringResource
+import notes.feature.notes.generated.resources.Res
+import notes.feature.notes.generated.resources.books_by_author
+import notes.feature.notes.generated.resources.error_message
+import notes.feature.notes.generated.resources.finished_book
+import notes.feature.notes.generated.resources.loading_books
+import notes.feature.notes.generated.resources.no_books_by_author
+import notes.feature.notes.generated.resources.retry
+import notes.feature.notes.generated.resources.unfinished_book
+
+@Composable
+fun AuthorBooksScreen(author: String, state: AuthorBooksUiState, onRetry: () -> Unit) {
+    Column(Modifier.fillMaxSize().padding(16.dp)) {
+        Text(stringResource(Res.string.books_by_author, author))
+        if (state.isLoading) {
+            CircularProgressIndicator()
+            Text(stringResource(Res.string.loading_books))
+        }
+        if (state.error != null) {
+            Text(stringResource(Res.string.error_message))
+            Button(onClick = onRetry) { Text(stringResource(Res.string.retry)) }
+        }
+        if (!state.isLoading && state.error == null && state.items.isEmpty()) {
+            Text(stringResource(Res.string.no_books_by_author))
+        }
+        if (state.items.isNotEmpty()) {
+            LazyColumn {
+                items(state.items, key = { it.id }, contentType = { "book" }) { book ->
+                    ListItem(
+                        headlineContent = { Text(book.title) },
+                        supportingContent = {
+                            Text(stringResource(if (book.isFinished) Res.string.finished_book else Res.string.unfinished_book))
+                        },
+                    )
+                }
+            }
+        }
+    }
+}
