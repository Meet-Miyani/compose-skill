+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.ExperimentalCoroutinesApi
+import kotlinx.coroutines.flow.Flow
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.map
+import kotlinx.coroutines.flow.toList
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.test.StandardTestDispatcher
+import kotlinx.coroutines.test.TestCoroutineScheduler
+import kotlinx.coroutines.test.UnconfinedTestDispatcher
+import kotlinx.coroutines.test.advanceUntilIdle
+import kotlinx.coroutines.test.resetMain
+import kotlinx.coroutines.test.runTest
+import kotlinx.coroutines.test.setMain
+import kotlin.test.AfterTest
+import kotlin.test.BeforeTest
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertFalse
+
+@OptIn(ExperimentalCoroutinesApi::class)
+class AuthorBooksViewModelTest {
+    private val scheduler = TestCoroutineScheduler()
+
+    @BeforeTest fun setUp() { Dispatchers.setMain(StandardTestDispatcher(scheduler)) }
+    @AfterTest fun tearDown() { Dispatchers.resetMain() }
+
+    @Test fun `author destination loads only that author's books and observes updates`() = runTest(scheduler) {
+        val fake = FakeBookRepository()
+        fake.books.value = listOf(
+            Book(1, "One", "Ada", 100, false),
+            Book(2, "Two", "Grace", 200, true),
+        )
+        val viewModel = AuthorBooksViewModel(fake, AuthorBooksParams("Ada"))
+        viewModel.onAction(AuthorBooksUiAction.OnScreenStarted)
+        advanceUntilIdle()
+        assertEquals(listOf(1L), viewModel.state.value.items.map { it.id })
+        assertFalse(viewModel.state.value.isLoading)
+
+        fake.books.value = fake.books.value + Book(3, "Three", "Ada", 150, true)
+        advanceUntilIdle()
+        assertEquals(listOf(1L, 3L), viewModel.state.value.items.map { it.id })
+    }
+
+    @Test fun `author click opens selected author`() = runTest(scheduler) {
+        val viewModel = BookListViewModel(FakeBookRepository())
+        val effects = mutableListOf<BookListUiEffect>()
+        backgroundScope.launch(UnconfinedTestDispatcher(scheduler)) { viewModel.effect.toList(effects) }
+        viewModel.onAction(BookListUiAction.OnAuthorClick("Ada"))
+        advanceUntilIdle()
+        assertEquals(BookListUiEffect.OpenAuthorBooks("Ada"), effects.single())
+    }
+
+    @Test fun `restored author destination loads from an empty cache`() = runTest(scheduler) {
+        val fake = FakeBookRepository()
+        val viewModel = AuthorBooksViewModel(fake, AuthorBooksParams("Ada"))
+        viewModel.onAction(AuthorBooksUiAction.OnScreenStarted)
+        advanceUntilIdle()
+        assertEquals(emptyList(), viewModel.state.value.items)
+        assertFalse(viewModel.state.value.isLoading)
+
+        fake.books.value = listOf(Book(9, "Later", "Ada", 120, false))
+        advanceUntilIdle()
+        assertEquals(9L, viewModel.state.value.items.single().id)
+    }
+}
+
+private class FakeBookRepository : BookRepository {
+    val books = MutableStateFlow<List<Book>>(emptyList())
+    override fun getBooksStream(): Flow<List<Book>> = books
+    override fun getBooksByAuthorStream(author: String): Flow<List<Book>> =
+        books.map { items -> items.filter { it.author == author } }
+    override suspend fun addBook(title: String, author: String, pages: Int): Long {
+        val id = (books.value.maxOfOrNull { it.id } ?: 0L) + 1
+        books.value = books.value + Book(id, title, author, pages, false)
+        return id
+    }
+    override suspend fun markFinished(id: Long) {
+        books.value = books.value.map { if (it.id == id) it.copy(isFinished = true) else it }
+    }
+}
