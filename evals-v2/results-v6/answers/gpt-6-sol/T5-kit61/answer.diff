+package com.example.feature.notes.readinglog.presentation.list
+
+import androidx.lifecycle.SavedStateHandle
+import com.example.feature.notes.readinglog.domain.model.Book
+import com.example.feature.notes.readinglog.domain.model.currentReadingYear
+import com.example.feature.notes.readinglog.domain.repository.BookRepository
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.ExperimentalCoroutinesApi
+import kotlinx.coroutines.flow.Flow
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.test.StandardTestDispatcher
+import kotlinx.coroutines.test.TestCoroutineScheduler
+import kotlinx.coroutines.test.advanceUntilIdle
+import kotlinx.coroutines.test.resetMain
+import kotlinx.coroutines.test.runTest
+import kotlinx.coroutines.test.setMain
+import kotlin.test.AfterTest
+import kotlin.test.BeforeTest
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertFalse
+import kotlin.test.assertTrue
+
+@OptIn(ExperimentalCoroutinesApi::class)
+class BookListViewModelTest {
+    private val scheduler = TestCoroutineScheduler()
+
+    @BeforeTest fun setUp() { Dispatchers.setMain(StandardTestDispatcher(scheduler)) }
+    @AfterTest fun tearDown() { Dispatchers.resetMain() }
+
+    @Test fun `saved goal restores and progress counts only books finished this year`() = runTest(scheduler) {
+        val repository = FakeBookRepository()
+        val first = BookListViewModel(repository, SavedStateHandle())
+        first.onAction(BookListUiAction.OnScreenStarted)
+        first.onAction(BookListUiAction.OnGoalDraftChanged("12"))
+        first.onAction(BookListUiAction.OnSaveGoalClick)
+        advanceUntilIdle()
+        assertEquals(12, first.state.value.goal)
+
+        val relaunched = BookListViewModel(repository, SavedStateHandle())
+        relaunched.onAction(BookListUiAction.OnScreenStarted)
+        advanceUntilIdle()
+        assertEquals(12, relaunched.state.value.goal)
+        assertEquals("12", relaunched.state.value.goalDraft)
+        assertEquals(0, relaunched.state.value.finishedThisYear)
+
+        repository.books.value = listOf(
+            Book(1, "Current", "Writer", 100, true, currentReadingYear()),
+            Book(2, "Old", "Writer", 100, true, currentReadingYear() - 1),
+            Book(3, "Legacy", "Writer", 100, true, null)
+        )
+        advanceUntilIdle()
+        assertEquals(1, relaunched.state.value.finishedThisYear)
+    }
+
+    @Test fun `invalid goal stays unsaved with inline error`() = runTest(scheduler) {
+        val repository = FakeBookRepository()
+        val viewModel = BookListViewModel(repository, SavedStateHandle())
+        viewModel.onAction(BookListUiAction.OnScreenStarted)
+        viewModel.onAction(BookListUiAction.OnGoalDraftChanged("0"))
+        viewModel.onAction(BookListUiAction.OnSaveGoalClick)
+        advanceUntilIdle()
+        assertTrue(viewModel.state.value.goalInputError)
+        assertEquals(null, viewModel.state.value.goal)
+        viewModel.onAction(BookListUiAction.OnGoalDraftChanged("4"))
+        assertFalse(viewModel.state.value.goalInputError)
+    }
+}
+
+private class FakeBookRepository : BookRepository {
+    val books = MutableStateFlow<List<Book>>(emptyList())
+    private val goals = mutableMapOf<Int, MutableStateFlow<Int?>>()
+    override fun getBooksStream(): Flow<List<Book>> = books
+    override suspend fun addBook(title: String, author: String, pages: Int): Long = error("Unused")
+    override suspend fun markFinished(id: Long) = error("Unused")
+    override fun getGoalStream(year: Int): Flow<Int?> = goals.getOrPut(year) { MutableStateFlow(null) }
+    override suspend fun setGoal(year: Int, count: Int) {
+        goals.getOrPut(year) { MutableStateFlow(null) }.value = count
+    }
+}
