+import org.koin.core.annotation.InjectedParam
+import org.koin.core.annotation.KoinViewModel
+
+data class BookDetailParams(val bookId: Long)
+
+@KoinViewModel
+class BookDetailViewModel(
+    private val repository: BookRepository,
+    @InjectedParam private val params: BookDetailParams,
+) : BaseViewModel<BookDetailUiAction, BookDetailUiState, BookDetailUiEffect>(BookDetailUiState()) {
+
+    private var hasStarted = false
+
+    override fun onAction(action: BookDetailUiAction) {
+        when (action) {
+            BookDetailUiAction.OnScreenStarted -> load()
+        }
+    }
+
+    private fun load() {
+        if (hasStarted || currentState.isLoading) return
+        launchGuarded(
+            onError = {},
+            onStart = { updateState { copy(isLoading = true) } },
+            onComplete = { updateState { copy(isLoading = false) } },
+        ) {
+            val book = repository.getBooksStream().first().find { it.id == params.bookId }
+            updateState { copy(book = book) }
+            hasStarted = true
         }
     }
 }
