+import org.koin.core.annotation.KoinViewModel
+
+@KoinViewModel
+class BookDetailViewModel(private val repository: BookRepository) :
+    BaseViewModel<BookDetailUiAction, BookDetailUiState, BookDetailUiEffect>(BookDetailUiState()) {
+
+    private var loadJob: Job? = null
+
+    override fun onAction(action: BookDetailUiAction) {
+        when (action) {
+            is BookDetailUiAction.OnScreenStarted -> loadBook(action.id)
+            is BookDetailUiAction.OnRetryClick -> retry(action)
+        }
+    }
+
+    private fun retry(action: BookDetailUiAction.OnRetryClick) {
+        if (currentState.error != action.error) return
+
+        updateState { copy(error = null) }
+        loadBook(action.id)
+    }
+
+    private fun loadBook(id: Long) {
+        if (loadJob?.isActive == true) return
+
+        val hasContent = currentState.book != null
+        val onError: (AppError) -> Unit = if (hasContent) {
+            { error -> emitError(error) }
+        } else {
+            { error -> updateState { copy(error = error) } }
+        }
+
+        loadJob = launchGuarded(
+            onError = onError,
+            onStart = { updateState { copy(isLoading = true) } },
+            onComplete = { updateState { copy(isLoading = false) } },
+        ) {
+            val books = repository.getBooksStream().first()
+            val book = books.find { it.id == id }
+            updateState { copy(book = book, error = null) }
         }
     }
 }
