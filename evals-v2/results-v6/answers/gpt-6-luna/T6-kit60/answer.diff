+
+@Composable
+fun AuthorBooksRoute(viewModel: AuthorBooksViewModel, author: String) {
+    LifecycleStartEffect(author) {
+        viewModel.onAction(AuthorBooksUiAction.OnScreenStarted)
+        onStopOrDispose {}
+    }
+    val state by viewModel.state.collectAsStateWithLifecycle()
+    HandleAppErrors(viewModel.errors)
+    AuthorBooksScreen(state = state, onRetry = { viewModel.onAction(AuthorBooksUiAction.OnRetryClick) })
+}
