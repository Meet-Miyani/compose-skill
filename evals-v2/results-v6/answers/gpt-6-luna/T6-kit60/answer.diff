+package com.example.feature.notes.readinglog.presentation.author
+
+import com.example.core.mvi.BaseViewModel
+import com.example.feature.notes.readinglog.domain.repository.BookRepository
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.flow.collect
+import org.koin.core.annotation.InjectedParam
+import org.koin.core.annotation.KoinViewModel
+
+@KoinViewModel
+class AuthorBooksViewModel(
+    private val repository: BookRepository,
+    @InjectedParam params: AuthorBooksParams,
+) : BaseViewModel<AuthorBooksUiAction, AuthorBooksUiState, AuthorBooksUiEffect>(AuthorBooksUiState(params.author)) {
+    private val author = params.author
+    private var streamJob: Job? = null
+
+    override fun onAction(action: AuthorBooksUiAction) {
+        when (action) {
+            AuthorBooksUiAction.OnScreenStarted, AuthorBooksUiAction.OnRetryClick -> observeBooks()
+        }
+    }
+
+    private fun observeBooks() {
+        if (streamJob?.isActive == true) return
+        updateState { copy(isLoading = items.isEmpty(), error = null) }
+        streamJob = launchGuarded(
+            onError = { updateState { copy(isLoading = false, error = it) } },
+        ) {
+            repository.getBooksStream().collect { books ->
+                updateState {
+                    copy(items = books.filter { it.author.equals(author, ignoreCase = true) }, isLoading = false, error = null)
+                }
+            }
+        }
+    }
+}
