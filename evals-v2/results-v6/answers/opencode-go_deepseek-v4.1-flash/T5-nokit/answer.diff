+package com.example.feature.notes.readinglog.presentation.list
+
+import com.example.feature.notes.readinglog.domain.model.ReadingGoal
+import com.example.feature.notes.readinglog.domain.repository.ReadingGoalRepository
+import kotlinx.coroutines.flow.Flow
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.map
+import kotlinx.coroutines.flow.update
+
+/** Test-only fake of the reading-goal repository. */
+class FakeReadingGoalRepository : ReadingGoalRepository {
+    private val goals = MutableStateFlow<Map<Int, ReadingGoal>>(emptyMap())
+
+    /** Last `(year, targetBooks)` passed to [setGoal]. */
+    var lastSet: Pair<Int, Int>? = null
+
+    override fun getGoalStream(year: Int): Flow<ReadingGoal?> = goals.map { it[year] }
+
+    override suspend fun setGoal(year: Int, targetBooks: Int) {
+        lastSet = year to targetBooks
+        goals.update { it + (year to ReadingGoal(year, targetBooks)) }
+    }
+
+    fun seed(goal: ReadingGoal) {
+        goals.update { it + (goal.year to goal) }
+    }
+}
