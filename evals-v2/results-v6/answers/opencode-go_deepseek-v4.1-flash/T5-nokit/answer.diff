+            OutlinedTextField(
+                value = state.goalInput,
+                onValueChange = onGoalInputChanged,
+                label = { Text("Books") },
+                singleLine = true,
+                keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Number),
+                modifier = Modifier.weight(1f),
+            )
+            Spacer(Modifier.width(8.dp))
+            Button(onClick = onSaveGoal) { Text("Save") }
+        }
+    } else {
+        val goal = state.goal
+        if (goal == null) {
+            Text("No goal set yet.")
+            Button(onClick = onEditGoal) { Text("Set Goal") }
+        } else {
+            Text("${state.finishedThisYear} of ${goal.targetBooks} books (${state.progressPercent}%)")
+            LinearProgressIndicator(
+                progress = { state.progressFraction },
+                modifier = Modifier.fillMaxWidth(),
+            )
+            if (state.finishedThisYear >= goal.targetBooks) {
+                Text("Goal reached!")
+            }
+            Button(onClick = onEditGoal) { Text("Edit Goal") }
+        }
+    }
+}
