+package com.example.feature.notes.readinglog.data
+
+import com.example.feature.notes.data.local.NotesDatabase
+import com.example.feature.notes.readinglog.domain.model.ReadingGoal
+import com.example.feature.notes.readinglog.domain.repository.ReadingGoalRepository
+import kotlinx.coroutines.flow.Flow
+import kotlinx.coroutines.flow.map
+import org.koin.core.annotation.Factory
+
+@Factory
+internal class DefaultReadingGoalRepository(private val db: NotesDatabase) : ReadingGoalRepository {
+    override fun getGoalStream(year: Int): Flow<ReadingGoal?> =
+        db.readingGoalDao().getGoalStream(year).map { entity ->
+            entity?.let { ReadingGoal(year = it.year, targetBooks = it.targetBooks) }
+        }
+
+    override suspend fun setGoal(year: Int, targetBooks: Int) {
+        db.readingGoalDao().upsert(ReadingGoalEntity(year = year, targetBooks = targetBooks))
+    }
+}
