+package com.example.feature.notes.readinglog.data
+
+import com.example.feature.notes.readinglog.domain.YearProvider
+import kotlin.time.Clock
+
+/** [YearProvider] backed by the system clock, computed in UTC. */
+internal object SystemYear : YearProvider {
+    override fun currentYear(): Int = yearOfEpochMilliseconds(Clock.System.now().toEpochMilliseconds())
+}
+
+/** Calendar year (UTC) containing [epochMilliseconds]. */
+internal fun yearOfEpochMilliseconds(epochMilliseconds: Long): Int {
+    if (epochMilliseconds <= 0L) return 1970
+    var year = 1970
+    var remaining = epochMilliseconds
+    while (true) {
+        val millisInYear = (if (isLeapYear(year)) 366L else 365L) * MILLIS_PER_DAY
+        if (remaining < millisInYear) return year
+        remaining -= millisInYear
+        year += 1
+    }
+}
+
+private fun isLeapYear(year: Int): Boolean =
+    year % 4 == 0 && (year % 100 != 0 || year % 400 == 0)
+
+private const val MILLIS_PER_DAY = 86_400_000L
