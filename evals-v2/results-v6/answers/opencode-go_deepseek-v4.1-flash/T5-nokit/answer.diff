+package com.example.feature.notes.readinglog.presentation.list
+
+import com.example.feature.notes.readinglog.domain.YearProvider
+import com.example.feature.notes.readinglog.domain.model.Book
+import com.example.feature.notes.readinglog.domain.model.ReadingGoal
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.ExperimentalCoroutinesApi
+import kotlinx.coroutines.test.StandardTestDispatcher
+import kotlinx.coroutines.test.TestCoroutineScheduler
+import kotlinx.coroutines.test.advanceUntilIdle
+import kotlinx.coroutines.test.resetMain
+import kotlinx.coroutines.test.runTest
+import kotlinx.coroutines.test.setMain
+import kotlin.test.AfterTest
+import kotlin.test.BeforeTest
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertFalse
+import kotlin.test.assertNull
+import kotlin.test.assertTrue
+
+@OptIn(ExperimentalCoroutinesApi::class)
+class BookListViewModelTest {
+    private val testScheduler = TestCoroutineScheduler()
+    private val mainDispatcher = StandardTestDispatcher(testScheduler)
+
+    @BeforeTest
+    fun setUp() {
+        Dispatchers.setMain(mainDispatcher)
+    }
+
+    @AfterTest
+    fun tearDown() {
+        Dispatchers.resetMain()
+    }
+
+    private fun viewModel(
+        books: FakeBookRepository,
+        goals: FakeReadingGoalRepository,
+        year: Int = 2026,
+    ): BookListViewModel = BookListViewModel(books, goals, YearProvider { year })
+
+    @Test
+    fun `progress counts only books finished this year`() = runTest(testScheduler) {
+        val books = FakeBookRepository().apply {
+            seed(
+                listOf(
+                    Book(1, "This year", "A", 100, isFinished = true, finishedYear = 2026),
+                    Book(2, "Last year", "B", 100, isFinished = true, finishedYear = 2025),
+                    Book(3, "Reading", "C", 100, isFinished = false),
+                ),
+            )
+        }
+        val goals = FakeReadingGoalRepository().apply { seed(ReadingGoal(year = 2026, targetBooks = 4)) }
+        val viewModel = viewModel(books, goals)
+
+        viewModel.onAction(BookListUiAction.OnScreenStarted)
+        advanceUntilIdle()
+
+        assertEquals(2026, viewModel.state.value.year)
+        assertEquals(1, viewModel.state.value.finishedThisYear)
+        assertEquals(4, viewModel.state.value.goal?.targetBooks)
+        assertEquals(0.25f, viewModel.state.value.progressFraction)
+        assertEquals(25, viewModel.state.value.progressPercent)
+        assertFalse(viewModel.state.value.isLoading)
+    }
+
+    @Test
+    fun `saving a goal persists it for the current year and leaves edit mode`() = runTest(testScheduler) {
+        val books = FakeBookRepository()
+        val goals = FakeReadingGoalRepository()
+        val viewModel = viewModel(books, goals)
+
+        viewModel.onAction(BookListUiAction.OnScreenStarted)
+        advanceUntilIdle()
+        viewModel.onAction(BookListUiAction.OnEditGoalClick)
+        assertTrue(viewModel.state.value.isEditingGoal)
+
+        viewModel.onAction(BookListUiAction.OnGoalInputChanged("12"))
+        viewModel.onAction(BookListUiAction.OnSaveGoalClick)
+        advanceUntilIdle()
+
+        assertEquals(2026 to 12, goals.lastSet)
+        assertFalse(viewModel.state.value.isEditingGoal)
+        assertEquals(12, viewModel.state.value.goal?.targetBooks)
+    }
+
+    @Test
+    fun `edit goal prefills the current target`() = runTest(testScheduler) {
+        val goals = FakeReadingGoalRepository().apply { seed(ReadingGoal(year = 2026, targetBooks = 8)) }
+        val viewModel = viewModel(FakeBookRepository(), goals)
+
+        viewModel.onAction(BookListUiAction.OnScreenStarted)
+        advanceUntilIdle()
+        viewModel.onAction(BookListUiAction.OnEditGoalClick)
+
+        assertEquals("8", viewModel.state.value.goalInput)
+        assertTrue(viewModel.state.value.isEditingGoal)
+    }
+
+    @Test
+    fun `invalid goal input is ignored`() = runTest(testScheduler) {
+        val goals = FakeReadingGoalRepository()
+        val viewModel = viewModel(FakeBookRepository(), goals)
+
+        viewModel.onAction(BookListUiAction.OnScreenStarted)
+        advanceUntilIdle()
+        viewModel.onAction(BookListUiAction.OnEditGoalClick)
+        viewModel.onAction(BookListUiAction.OnGoalInputChanged("abc"))
+        viewModel.onAction(BookListUiAction.OnSaveGoalClick)
+        advanceUntilIdle()
+
+        assertNull(goals.lastSet)
+        assertTrue(viewModel.state.value.isEditingGoal)
+    }
+
+    @Test
+    fun `marking finished stamps the current year`() = runTest(testScheduler) {
+        val books = FakeBookRepository().apply {
+            seed(listOf(Book(1, "Reading", "A", 10, isFinished = false)))
+        }
+        val goals = FakeReadingGoalRepository().apply { seed(ReadingGoal(year = 2026, targetBooks = 3)) }
+        val viewModel = viewModel(books, goals)
+
+        viewModel.onAction(BookListUiAction.OnScreenStarted)
+        advanceUntilIdle()
+        viewModel.onAction(BookListUiAction.OnMarkFinishedClick(1L))
+        advanceUntilIdle()
+
+        assertEquals(1L to 2026, books.lastFinished)
+        assertEquals(1, viewModel.state.value.finishedThisYear)
+    }
+
+    @Test
+    fun `a goal from a previous year does not carry over`() = runTest(testScheduler) {
+        val goals = FakeReadingGoalRepository().apply { seed(ReadingGoal(year = 2025, targetBooks = 20)) }
+        val viewModel = viewModel(FakeBookRepository(), goals)
+
+        viewModel.onAction(BookListUiAction.OnScreenStarted)
+        advanceUntilIdle()
+
+        assertNull(viewModel.state.value.goal)
+        assertEquals(0f, viewModel.state.value.progressFraction)
+    }
+}
