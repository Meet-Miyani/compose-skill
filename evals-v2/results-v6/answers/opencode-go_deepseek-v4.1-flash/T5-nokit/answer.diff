+package com.example.feature.notes.readinglog.data
+
+import kotlin.test.Test
+import kotlin.test.assertEquals
+
+class SystemYearTest {
+    @Test
+    fun `epoch start is 1970`() {
+        assertEquals(1970, yearOfEpochMilliseconds(0L))
+    }
+
+    @Test
+    fun `year rolls over at the January first boundary`() {
+        assertEquals(2025, yearOfEpochMilliseconds(1_767_225_599_999L))
+        assertEquals(2026, yearOfEpochMilliseconds(1_767_225_600_000L))
+    }
+
+    @Test
+    fun `leap year does not shift the following new year`() {
+        assertEquals(2024, yearOfEpochMilliseconds(1_704_067_200_000L))
+        assertEquals(2025, yearOfEpochMilliseconds(1_735_689_600_000L))
+    }
+}
