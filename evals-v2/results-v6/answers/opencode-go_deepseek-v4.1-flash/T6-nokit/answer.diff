+@OptIn(ExperimentalCoroutinesApi::class)
+class BookListViewModelTest {
+    private val scheduler = TestCoroutineScheduler()
+
+    @BeforeTest fun setUp() { Dispatchers.setMain(StandardTestDispatcher(scheduler)) }
+    @AfterTest fun tearDown() { Dispatchers.resetMain() }
+
+    @Test fun `author click opens author books`() = runTest(scheduler) {
+        val viewModel = BookListViewModel(FakeBookRepository())
+        val effects = mutableListOf<BookListUiEffect>()
+        backgroundScope.launch(UnconfinedTestDispatcher(scheduler)) { viewModel.effect.toList(effects) }
+
+        viewModel.onAction(BookListUiAction.OnAuthorClick("Alice"))
+        advanceUntilIdle()
+
+        assertEquals(BookListUiEffect.OpenAuthor("Alice"), effects.single())
+    }
+
+    @Test fun `add click opens add sheet`() = runTest(scheduler) {
+        val viewModel = BookListViewModel(FakeBookRepository())
+        val effects = mutableListOf<BookListUiEffect>()
+        backgroundScope.launch(UnconfinedTestDispatcher(scheduler)) { viewModel.effect.toList(effects) }
+
+        viewModel.onAction(BookListUiAction.OnAddClick)
+        advanceUntilIdle()
+
+        assertEquals(BookListUiEffect.OpenAddSheet, effects.single())
+    }
+}
