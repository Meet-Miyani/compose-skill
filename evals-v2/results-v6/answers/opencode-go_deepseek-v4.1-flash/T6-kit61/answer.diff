+package com.example.feature.notes.readinglog.presentation.author
+
+import com.example.core.error.NetworkException
+import com.example.feature.notes.readinglog.domain.model.Book
+import com.example.feature.notes.readinglog.domain.repository.BookRepository
+import kotlinx.coroutines.CompletableDeferred
+import kotlinx.coroutines.flow.Flow
+import kotlinx.coroutines.flow.MutableStateFlow
+
+/**
+ * Hand-written fake of the Book repository for `commonTest`.
+ *
+ * Tests own this fake's behaviour through [seed] and [shouldThrow].
+ * Never a mocking library; swap fakes via constructor injection.
+ */
+class FakeBookRepository : BookRepository {
+    // One mutation path only: tests assign this directly.
+    var shouldThrow: NetworkException? = null
+
+    /** When set, reads suspend until the test completes it, so in-flight states stay observable. */
+    var gate: CompletableDeferred<Unit>? = null
+
+    /** Counts by-author reads; the overlap test asserts the guard keeps this at one. */
+    var getCalls: Int = 0
+
+    private val backing = MutableStateFlow<List<Book>>(emptyList())
+
+    /** Test-only helper that replaces the stored books. */
+    fun seed(items: List<Book>) {
+        backing.value = items
+    }
+
+    override fun getBooksStream(): Flow<List<Book>> = backing
+
+    override suspend fun getBooksByAuthor(author: String): List<Book> {
+        gate?.await()
+        getCalls += 1
+        shouldThrow?.let { throw it }
+        return backing.value.filter { it.author == author }
+    }
+
+    override suspend fun addBook(title: String, author: String, pages: Int): Long {
+        val id = (backing.value.maxOfOrNull { it.id } ?: 0L) + 1L
+        backing.value = backing.value + Book(id, title, author, pages, false)
+        return id
+    }
+
+    override suspend fun markFinished(id: Long) {
+        backing.value = backing.value.map { if (it.id == id) it.copy(isFinished = true) else it }
+    }
+}
