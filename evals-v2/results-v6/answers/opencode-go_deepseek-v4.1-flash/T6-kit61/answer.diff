+package com.example.feature.notes.readinglog.presentation.author
+import com.example.core.mvi.BaseViewModel
+import com.example.feature.notes.readinglog.domain.repository.BookRepository
+import kotlinx.coroutines.Job
+import org.koin.core.annotation.InjectedParam
+import org.koin.core.annotation.KoinViewModel
+/** Construction bag for the destination's nav argument. Top-level so entries and tests share it. */
+data class AuthorBooksParams(val author: String)
+@KoinViewModel
+class AuthorBooksViewModel(
+    private val repository: BookRepository,
+    @InjectedParam private val params: AuthorBooksParams,
+) : BaseViewModel<AuthorBooksUiAction, AuthorBooksUiState, AuthorBooksUiEffect>(
+    AuthorBooksUiState(author = params.author),
+) {
+    private var loadJob: Job? = null
+    private var hasStarted: Boolean = false
+    override fun onAction(action: AuthorBooksUiAction) {
+        when (action) {
+            AuthorBooksUiAction.OnScreenStarted -> load()
+            is AuthorBooksUiAction.OnRetryClick -> retry()
+            AuthorBooksUiAction.OnBackClick -> sendEffect(AuthorBooksUiEffect.NavigateBack)
+        }
+    }
+    private fun load() {
+        // Overlap guard: the first load owns the response; later overlapping loads return early.
+        if (loadJob?.isActive == true) return
+        loadJob = launchGuarded(
+            onError = { error ->
+                if (hasStarted) emitError(error) else updateState { copy(error = error) }
+            },
+            onStart = { updateState { copy(isLoading = !hasStarted, isRefreshing = hasStarted) } },
+            onComplete = { updateState { copy(isLoading = false, isRefreshing = false) } },
+        ) {
+            val books = repository.getBooksByAuthor(params.author)
+            updateState { copy(items = books, error = null) }
+            hasStarted = true
+        }
+    }
+    private fun retry() {
+        updateState { copy(error = null) }
+        load()
+    }
+}
