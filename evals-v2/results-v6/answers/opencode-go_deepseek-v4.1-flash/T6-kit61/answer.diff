+import kotlin.test.assertFalse
+import kotlin.test.assertNotNull
+import kotlin.test.assertNull
+import kotlin.test.assertTrue
+
+@OptIn(ExperimentalCoroutinesApi::class)
+class AuthorBooksViewModelTest {
+    private val testScheduler = TestCoroutineScheduler()
+    private val mainDispatcher = StandardTestDispatcher(testScheduler)
+
+    @BeforeTest
+    fun setUp() {
+        Dispatchers.setMain(mainDispatcher)
+    }
+
+    @AfterTest
+    fun tearDown() {
+        Dispatchers.resetMain()
+    }
+
+    private fun book(
+        id: Long,
+        author: String = "Austen",
+        title: String = "Title",
+        isFinished: Boolean = false,
+    ): Book = Book(id = id, title = title, author = author, pages = 100, isFinished = isFinished)
+
+    private fun viewModel(fake: FakeBookRepository, author: String = "Austen"): AuthorBooksViewModel =
+        AuthorBooksViewModel(repository = fake, params = AuthorBooksParams(author = author))
+
+    @Test
+    fun `cold load pins loading then shows books by author`() = runTest(testScheduler) {
+        val fake = FakeBookRepository().apply { seed(listOf(book(1), book(2, author = "Other"))) }
+        val viewModel = viewModel(fake)
+        val effects = mutableListOf<AuthorBooksUiEffect>()
+        // Unconfined collector: trySend delivery resumes it without waiting on the queue.
+        backgroundScope.launch(UnconfinedTestDispatcher(testScheduler)) { viewModel.effect.toList(effects) }
+
+        val gate = CompletableDeferred<Unit>().also { fake.gate = it }
+        viewModel.onAction(AuthorBooksUiAction.OnScreenStarted)
+        advanceUntilIdle()
+        assertTrue(viewModel.state.value.isLoading)
+
+        gate.complete(Unit)
+        advanceUntilIdle()
+
+        assertEquals("Austen", viewModel.state.value.author)
+        assertEquals(listOf(1L), viewModel.state.value.items.map { it.id })
+        assertFalse(viewModel.state.value.isLoading)
+        assertNull(viewModel.state.value.error)
+        assertTrue(effects.isEmpty())
+    }
+
+    @Test
+    fun `reconcile keeps content and refetches`() = runTest(testScheduler) {
+        val fake = FakeBookRepository().apply { seed(listOf(book(1))) }
+        val viewModel = viewModel(fake)
+
+        viewModel.onAction(AuthorBooksUiAction.OnScreenStarted)
+        advanceUntilIdle()
+
+        fake.seed(listOf(book(1, title = "Updated")))
+        viewModel.onAction(AuthorBooksUiAction.OnScreenStarted)
+        advanceUntilIdle()
+
+        assertEquals("Updated", viewModel.state.value.items.single().title)
+    }
+
+    @Test
+    fun `refresh keeps content and flags refreshing`() = runTest(testScheduler) {
+        val fake = FakeBookRepository().apply { seed(listOf(book(1))) }
+        val viewModel = viewModel(fake)
+
+        viewModel.onAction(AuthorBooksUiAction.OnScreenStarted)
+        advanceUntilIdle()
+
+        fake.seed(listOf(book(1, title = "New")))
+        val gate = CompletableDeferred<Unit>().also { fake.gate = it }
+        viewModel.onAction(AuthorBooksUiAction.OnScreenStarted)
+        advanceUntilIdle()
+        assertTrue(viewModel.state.value.isRefreshing)
+        assertEquals("Title", viewModel.state.value.items.single().title)
+
+        gate.complete(Unit)
+        advanceUntilIdle()
+
+        assertFalse(viewModel.state.value.isRefreshing)
+        assertEquals("New", viewModel.state.value.items.single().title)
+    }
+
+    @Test
+    fun `reconcile failure keeps content and emits popup error`() = runTest(testScheduler) {
+        val fake = FakeBookRepository().apply { seed(listOf(book(1))) }
+        val viewModel = viewModel(fake)
+        val errors = mutableListOf<AppError>()
+        backgroundScope.launch(UnconfinedTestDispatcher(testScheduler)) { viewModel.errors.toList(errors) }
+
+        viewModel.onAction(AuthorBooksUiAction.OnScreenStarted)
+        advanceUntilIdle()
+        fake.shouldThrow = NetworkException.Connection()
+        viewModel.onAction(AuthorBooksUiAction.OnScreenStarted)
+        advanceUntilIdle()
+
+        assertEquals("Title", viewModel.state.value.items.single().title)
+        assertNull(viewModel.state.value.error)
+        assertFalse(viewModel.state.value.isRefreshing)
+        assertFalse(viewModel.state.value.isLoading)
+        assertEquals(1, errors.size)
+    }
+
+    @Test
+    fun `inline error on first load then retry succeeds`() = runTest(testScheduler) {
+        val fake = FakeBookRepository().apply { shouldThrow = NetworkException.Connection() }
+        val viewModel = viewModel(fake)
+
+        viewModel.onAction(AuthorBooksUiAction.OnScreenStarted)
+        advanceUntilIdle()
+
+        assertNotNull(viewModel.state.value.error)
+        assertTrue(viewModel.state.value.items.isEmpty())
+
+        fake.shouldThrow = null
+        fake.seed(listOf(book(1)))
+        viewModel.onAction(AuthorBooksUiAction.OnRetryClick(viewModel.state.value.error!!))
+        advanceUntilIdle()
+
+        assertNull(viewModel.state.value.error)
+        assertEquals(1, viewModel.state.value.items.size)
+    }
+
+    @Test
+    fun `empty author shows empty list without error`() = runTest(testScheduler) {
+        val fake = FakeBookRepository().apply { seed(listOf(book(1, author = "Other"))) }
+        val viewModel = viewModel(fake)
+
+        viewModel.onAction(AuthorBooksUiAction.OnScreenStarted)
+        advanceUntilIdle()
+
+        assertTrue(viewModel.state.value.items.isEmpty())
+        assertNull(viewModel.state.value.error)
+    }
+
+    @Test
+    fun `overlapping loads never let stale win`() = runTest(testScheduler) {
+        val fake = FakeBookRepository().apply { seed(listOf(book(1))) }
+        val viewModel = viewModel(fake)
+
+        viewModel.onAction(AuthorBooksUiAction.OnScreenStarted)
+        viewModel.onAction(AuthorBooksUiAction.OnScreenStarted)
+        advanceUntilIdle()
+
+        assertEquals(1, fake.getCalls)
+        assertEquals(1, viewModel.state.value.items.size)
+    }
+
+    @Test
+    fun `restore refetches by author identity from a cold cache`() = runTest(testScheduler) {
+        val fake = FakeBookRepository().apply { seed(listOf(book(9, author = "Austen"))) }
+        val viewModel = viewModel(fake, author = "Austen")
+
+        viewModel.onAction(AuthorBooksUiAction.OnScreenStarted)
+        advanceUntilIdle()
+
+        assertEquals(1, fake.getCalls)
+        assertEquals(listOf(9L), viewModel.state.value.items.map { it.id })
+    }
+
+    @Test
+    fun `back emits navigate back`() = runTest(testScheduler) {
+        val viewModel = viewModel(FakeBookRepository())
+        val effects = mutableListOf<AuthorBooksUiEffect>()
+        backgroundScope.launch(UnconfinedTestDispatcher(testScheduler)) { viewModel.effect.toList(effects) }
+
+        viewModel.onAction(AuthorBooksUiAction.OnBackClick)
+        advanceUntilIdle()
+
+        assertEquals(AuthorBooksUiEffect.NavigateBack, effects.single())
+    }
+}
