+import notes.feature.notes.generated.resources.retry
+import org.jetbrains.compose.resources.stringResource
+@Composable
+fun AuthorBooksScreen(
+    state: AuthorBooksUiState,
+    onRetry: () -> Unit,
+    onBack: () -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    Column(modifier = modifier.fillMaxSize().padding(16.dp)) {
+        Button(onClick = onBack) { Text(stringResource(Res.string.back)) }
+        Text(stringResource(Res.string.author_books_title, state.author))
+        when {
+            state.isLoading -> CircularProgressIndicator()
+            state.error != null -> {
+                Text(stringResource(Res.string.error_message))
+                Button(onClick = onRetry) { Text(stringResource(Res.string.retry)) }
+            }
+            state.items.isEmpty() -> Text(stringResource(Res.string.empty_author_books))
+            else -> Column {
+                if (state.isRefreshing) Text(stringResource(Res.string.refreshing))
+                LazyColumn {
+                    items(state.items, key = { it.id }) { book ->
+                        ListItem(
+                            headlineContent = { Text(book.title) },
+                            supportingContent = {
+                                Column {
+                                    Text(stringResource(Res.string.book_pages, book.pages))
+                                    Text(
+                                        stringResource(
+                                            if (book.isFinished) Res.string.book_finished
+                                            else Res.string.book_not_finished
+                                        )
+                                    )
+                                }
+                            },
+                        )
+                    }
+                }
+            }
+        }
+    }
+}
