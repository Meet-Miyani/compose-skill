+import androidx.lifecycle.compose.collectAsStateWithLifecycle
+import com.example.designsystem.error.HandleAppErrors
+@Composable
+fun BooksByAuthorRoute(viewModel: BooksByAuthorViewModel, author: String) {
+    LifecycleStartEffect(author) {
+        viewModel.onAction(BooksByAuthorUiAction.OnScreenStarted)
+        onStopOrDispose {}
+    }
