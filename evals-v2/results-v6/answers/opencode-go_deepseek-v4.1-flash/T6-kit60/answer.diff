+package com.example.feature.notes.readinglog
+
+import com.example.core.error.StorageException
+import com.example.feature.notes.readinglog.domain.model.Book
+import com.example.feature.notes.readinglog.domain.repository.BookRepository
+import kotlinx.coroutines.flow.Flow
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.emitAll
+import kotlinx.coroutines.flow.flow
+import kotlinx.coroutines.flow.map
+import kotlinx.coroutines.flow.update
+
+/** Hand-written fake of the Book repository; tests own it through [seed] and [shouldThrow]. */
+class FakeBookRepository : BookRepository {
+    var shouldThrow: StorageException? = null
+    private val backing = MutableStateFlow<List<Book>>(emptyList())
+
+    /** Counts per-author stream collections; the overlap test asserts the guard keeps this at one. */
+    var getByAuthorCalls: Int = 0
+
+    /** Test-only helper that replaces the stored books. */
+    fun seed(items: List<Book>) {
+        backing.value = items
+    }
+
+    override fun getBooksStream(): Flow<List<Book>> = backing
+
+    override fun getBooksByAuthorStream(author: String): Flow<List<Book>> = flow {
+        getByAuthorCalls += 1
+        shouldThrow?.let { throw it }
+        emitAll(backing.map { books -> books.filter { it.author == author } })
+    }
+
+    override suspend fun addBook(title: String, author: String, pages: Int): Long {
+        val id = (backing.value.maxOfOrNull { it.id } ?: 0L) + 1L
+        backing.update { it + Book(id, title, author, pages, false) }
+        return id
+    }
+
+    override suspend fun markFinished(id: Long) {
+        backing.update { books -> books.map { if (it.id == id) it.copy(isFinished = true) else it } }
+    }
+}
