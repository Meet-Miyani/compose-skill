+package com.example.feature.notes.readinglog.presentation.author
+import com.example.core.mvi.BaseViewModel
+import com.example.feature.notes.readinglog.domain.repository.BookRepository
+import kotlinx.coroutines.Job
+import org.koin.core.annotation.InjectedParam
+import org.koin.core.annotation.KoinViewModel
+
+/** Construction bag for the destination's nav argument. Top-level so entries and tests share it. */
+data class BooksByAuthorParams(val author: String)
+
+/** Lists every book whose author matches [BooksByAuthorParams.author]. */
+@KoinViewModel
+class BooksByAuthorViewModel(
+    private val repository: BookRepository,
+    @InjectedParam private val params: BooksByAuthorParams,
+) : BaseViewModel<BooksByAuthorUiAction, BooksByAuthorUiState, BooksByAuthorUiEffect>(BooksByAuthorUiState()) {
+    private var streamJob: Job? = null
+    override fun onAction(action: BooksByAuthorUiAction) {
+        when (action) {
+            BooksByAuthorUiAction.OnScreenStarted -> observeBooks()
+            BooksByAuthorUiAction.OnRetryClick -> observeBooks()
+        }
+    }
+    private fun observeBooks() {
+        if (streamJob?.isActive == true) return
+        updateState { copy(isLoading = true, error = null) }
+        streamJob = launchGuarded(onError = { updateState { copy(isLoading = false, error = it) } }) {
+            repository.getBooksByAuthorStream(params.author).collect { books ->
+                updateState { copy(items = books, isLoading = false, error = null) }
+            }
+        }
+    }
+}
