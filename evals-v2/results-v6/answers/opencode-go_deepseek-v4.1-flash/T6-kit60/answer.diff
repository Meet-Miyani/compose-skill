+import kotlin.test.assertNotNull
+import kotlin.test.assertNull
+import kotlin.test.assertTrue
+
+/** State-matrix tests for the Books-by-author ViewModel. */
+@OptIn(ExperimentalCoroutinesApi::class)
+class BooksByAuthorViewModelTest {
+    private val scheduler = TestCoroutineScheduler()
+
+    @BeforeTest
+    fun setUp() {
+        Dispatchers.setMain(StandardTestDispatcher(scheduler))
+    }
+
+    @AfterTest
+    fun tearDown() {
+        Dispatchers.resetMain()
+    }
+
+    private fun book(id: Long, author: String, title: String = "Title") =
+        Book(id = id, title = title, author = author, pages = 100, isFinished = false)
+
+    private fun viewModel(fake: FakeBookRepository, author: String = "Austen") =
+        BooksByAuthorViewModel(repository = fake, params = BooksByAuthorParams(author = author))
+
+    @Test
+    fun `cold load shows only the author's books`() = runTest(scheduler) {
+        val fake = FakeBookRepository().apply {
+            seed(listOf(book(1L, "Austen"), book(2L, "Orwell", "1984")))
+        }
+        val viewModel = viewModel(fake)
+
+        viewModel.onAction(BooksByAuthorUiAction.OnScreenStarted)
+        advanceUntilIdle()
+
+        assertEquals(listOf(1L), viewModel.state.value.items.map { it.id })
+        assertFalse(viewModel.state.value.isLoading)
+        assertNull(viewModel.state.value.error)
+    }
+
+    @Test
+    fun `later emissions update the list`() = runTest(scheduler) {
+        val fake = FakeBookRepository().apply { seed(listOf(book(1L, "Austen"))) }
+        val viewModel = viewModel(fake)
+
+        viewModel.onAction(BooksByAuthorUiAction.OnScreenStarted)
+        advanceUntilIdle()
+
+        fake.seed(listOf(book(1L, "Austen"), book(3L, "Austen", "Emma")))
+        advanceUntilIdle()
+
+        assertEquals(listOf(1L, 3L), viewModel.state.value.items.map { it.id })
+    }
+
+    @Test
+    fun `empty backing shows empty list`() = runTest(scheduler) {
+        val fake = FakeBookRepository()
+        val viewModel = viewModel(fake)
+
