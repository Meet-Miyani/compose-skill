+package com.example.feature.notes.readinglog.presentation.list
+
+import com.example.core.error.StorageException
+import com.example.feature.notes.readinglog.domain.model.Book
+import com.example.feature.notes.readinglog.domain.repository.BookRepository
+import com.example.feature.notes.readinglog.domain.repository.ReadingGoalRepository
+import com.example.feature.notes.readinglog.domain.model.ReadingGoal
+import kotlinx.coroutines.flow.Flow
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.flow
+import kotlinx.coroutines.flow.update
+import kotlin.time.Instant
+
+/** Hand-written fake of the book repository; tests own its state. */
+class FakeBookRepository : BookRepository {
+    private val backing = MutableStateFlow<List<Book>>(emptyList())
+
+    /** When set, the stream fails with this error instead of emitting. */
+    var streamError: StorageException? = null
+
+    /** Instant stamped on markFinished; lets a test drive yearly progress. */
+    var finishedAt: Instant? = null
+
+    var markFinishedCalls: Int = 0
+    var lastMarkedId: Long? = null
+
+    fun seed(items: List<Book>) {
+        backing.value = items
+    }
+
+    override fun getBooksStream(): Flow<List<Book>> =
+        streamError?.let { error -> flow { throw error } } ?: backing
+
+    override suspend fun addBook(title: String, author: String, pages: Int): Long {
+        val id = (backing.value.maxOfOrNull { it.id } ?: 0L) + 1L
+        backing.update { it + Book(id, title, author, pages, isFinished = false) }
+        return id
+    }
+
+    override suspend fun markFinished(id: Long) {
+        markFinishedCalls += 1
+        lastMarkedId = id
+        backing.update { list ->
+            list.map { if (it.id == id) it.copy(isFinished = true, finishedAt = finishedAt) else it }
+        }
+    }
+}
+
+/** Hand-written fake of the reading-goal repository; tests own its state. */
+class FakeReadingGoalRepository : ReadingGoalRepository {
+    private val backing = MutableStateFlow<ReadingGoal?>(null)
+    var lastSetTarget: Int? = null
+    var setGoalCalls: Int = 0
+
+    fun seed(goal: ReadingGoal?) {
+        backing.value = goal
+    }
+
+    override fun getGoalStream(): Flow<ReadingGoal?> = backing
+
+    override suspend fun setGoal(targetBooks: Int) {
+        setGoalCalls += 1
+        lastSetTarget = targetBooks
+        backing.value = ReadingGoal(targetBooks)
+    }
+}
