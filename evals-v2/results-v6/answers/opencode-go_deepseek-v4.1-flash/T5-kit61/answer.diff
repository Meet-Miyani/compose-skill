+package com.example.feature.notes.readinglog.data
+
+import androidx.datastore.core.DataStore
+import androidx.datastore.preferences.core.Preferences
+import androidx.datastore.preferences.core.edit
+import androidx.datastore.preferences.core.intPreferencesKey
+import com.example.core.error.StorageException
+import com.example.feature.notes.readinglog.domain.model.ReadingGoal
+import com.example.feature.notes.readinglog.domain.repository.ReadingGoalRepository
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.flow.Flow
+import kotlinx.coroutines.flow.catch
+import kotlinx.coroutines.flow.map
+import org.koin.core.annotation.Factory
+
+@Factory
+internal class DefaultReadingGoalRepository(
+    private val dataStore: DataStore<Preferences>,
+) : ReadingGoalRepository {
+
+    override fun getGoalStream(): Flow<ReadingGoal?> = dataStore.data
+        .catch { cause ->
+            // A missing file already emits defaults; anything else is a real
+            // storage failure the ViewModel surfaces instead of hiding it as
+            // "no goal set".
+            if (cause is CancellationException) throw cause
+            throw StorageException(cause)
+        }
+        .map { preferences -> preferences[GoalTargetKey]?.let(::ReadingGoal) }
+
+    override suspend fun setGoal(targetBooks: Int) {
+        try {
+            // One atomic read-modify-write; the goal stream re-emits on success.
+            dataStore.edit { preferences -> preferences[GoalTargetKey] = targetBooks }
+        } catch (cause: CancellationException) {
+            throw cause
+        } catch (cause: Exception) {
+            throw StorageException(cause)
+        }
+    }
+
+    private companion object {
+        val GoalTargetKey = intPreferencesKey("reading_goal_target")
+    }
+}
