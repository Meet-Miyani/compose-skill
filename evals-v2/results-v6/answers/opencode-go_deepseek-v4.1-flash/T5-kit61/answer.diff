+import kotlinx.datetime.TimeZone
+import kotlinx.datetime.atStartOfDayIn
+import kotlin.test.AfterTest
+import kotlin.test.BeforeTest
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertFalse
+import kotlin.test.assertNull
+import kotlin.time.Clock
+import kotlin.time.Instant
+
+@OptIn(ExperimentalCoroutinesApi::class)
+class BookListViewModelTest {
+    private val scheduler = TestCoroutineScheduler()
+
+    @BeforeTest
+    fun setUp() {
+        Dispatchers.setMain(StandardTestDispatcher(scheduler))
+    }
+
+    @AfterTest
+    fun tearDown() {
+        Dispatchers.resetMain()
+    }
+
+    private val zone = TimeZone.UTC
+    private val now = LocalDate(2026, 6, 1).atStartOfDayIn(zone)
+
+    private class FixedClock(private val instant: Instant) : Clock {
+        override fun now(): Instant = instant
+    }
+
+    private fun instant(year: Int, month: Int, day: Int): Instant =
+        LocalDate(year, month, day).atStartOfDayIn(zone)
+
+    private fun book(id: Long, finishedAt: Instant? = null): Book =
+        Book(
+            id = id,
+            title = "Book $id",
+            author = "Author",
+            pages = 100,
+            isFinished = finishedAt != null,
+            finishedAt = finishedAt,
+        )
+
+    private fun viewModel(
+        books: FakeBookRepository = FakeBookRepository(),
+        goals: FakeReadingGoalRepository = FakeReadingGoalRepository(),
+        handle: SavedStateHandle = SavedStateHandle(),
+    ): BookListViewModel = BookListViewModel(
+        repository = books,
+        goalRepository = goals,
+        savedStateHandle = handle,
+        clock = FixedClock(now),
+        timeZone = zone,
+    )
+
+    @Test
+    fun `observes books and counts only this year's finishes`() = runTest(scheduler) {
+        val books = FakeBookRepository().apply {
+            seed(
+                listOf(
+                    book(1, instant(2026, 2, 1)),
+                    book(2, instant(2026, 3, 1)),
+                    book(3, instant(2025, 12, 31)),
+                ),
+            )
+        }
+        val goals = FakeReadingGoalRepository().apply { seed(ReadingGoal(12)) }
+        val viewModel = viewModel(books, goals)
+
+        viewModel.onAction(BookListUiAction.OnScreenStarted)
+        advanceUntilIdle()
+
+        assertFalse(viewModel.state.value.isLoading)
+        assertEquals(3, viewModel.state.value.items.size)
+        assertEquals(12, viewModel.state.value.goalTarget)
+        assertEquals(2, viewModel.state.value.booksFinishedThisYear)
+    }
+
+    @Test
+    fun `no goal leaves target null but still counts progress`() = runTest(scheduler) {
+        val books = FakeBookRepository().apply { seed(listOf(book(1, instant(2026, 2, 1)))) }
+        val viewModel = viewModel(books)
+
+        viewModel.onAction(BookListUiAction.OnScreenStarted)
+        advanceUntilIdle()
+
+        assertNull(viewModel.state.value.goalTarget)
+        assertEquals(1, viewModel.state.value.booksFinishedThisYear)
+    }
+
+    @Test
+    fun `goal change is kept in saved state`() = runTest(scheduler) {
+        val handle = SavedStateHandle()
+        val viewModel = viewModel(handle = handle)
+
+        viewModel.onAction(BookListUiAction.OnGoalChanged("20"))
+
+        assertEquals("20", viewModel.state.value.goalDraft)
+        assertEquals("20", handle.get<String>("goalDraft"))
+    }
+
+    @Test
+    fun `process death restores the goal draft`() = runTest(scheduler) {
+        val handle = SavedStateHandle(mapOf("goalDraft" to "15"))
+        val viewModel = viewModel(handle = handle)
+
+        assertEquals("15", viewModel.state.value.goalDraft)
+    }
+
+    @Test
+    fun `set goal persists target and clears the draft`() = runTest(scheduler) {
+        val goals = FakeReadingGoalRepository()
+        val viewModel = viewModel(goals = goals)
+
+        viewModel.onAction(BookListUiAction.OnScreenStarted)
+        viewModel.onAction(BookListUiAction.OnGoalChanged("24"))
+        viewModel.onAction(BookListUiAction.OnSetGoalClick)
+        advanceUntilIdle()
+
+        assertEquals(24, goals.lastSetTarget)
+        assertEquals(24, viewModel.state.value.goalTarget)
+        assertEquals("", viewModel.state.value.goalDraft)
+    }
+
+    @Test
+    fun `invalid goal draft is ignored`() = runTest(scheduler) {
+        val goals = FakeReadingGoalRepository()
+        val viewModel = viewModel(goals = goals)
+
+        viewModel.onAction(BookListUiAction.OnGoalChanged("zero"))
+        viewModel.onAction(BookListUiAction.OnSetGoalClick)
+        viewModel.onAction(BookListUiAction.OnGoalChanged("0"))
+        viewModel.onAction(BookListUiAction.OnSetGoalClick)
+        advanceUntilIdle()
+
+        assertNull(goals.lastSetTarget)
+        assertEquals(0, goals.setGoalCalls)
+    }
+
+    @Test
+    fun `double set makes one repository write`() = runTest(scheduler) {
+        val goals = FakeReadingGoalRepository()
+        val viewModel = viewModel(goals = goals)
+
+        viewModel.onAction(BookListUiAction.OnGoalChanged("18"))
+        viewModel.onAction(BookListUiAction.OnSetGoalClick)
+        viewModel.onAction(BookListUiAction.OnSetGoalClick)
+        advanceUntilIdle()
+
+        assertEquals(1, goals.setGoalCalls)
+    }
+
+    @Test
+    fun `add click opens the add sheet`() = runTest(scheduler) {
+        val viewModel = viewModel()
+        val effects = mutableListOf<BookListUiEffect>()
+        backgroundScope.launch(UnconfinedTestDispatcher(scheduler)) { viewModel.effect.toList(effects) }
+
+        viewModel.onAction(BookListUiAction.OnAddClick)
+        advanceUntilIdle()
+
+        assertEquals(BookListUiEffect.OpenAddSheet, effects.single())
+    }
+
+    @Test
+    fun `mark finished updates the yearly count`() = runTest(scheduler) {
+        val books = FakeBookRepository().apply {
+            seed(listOf(book(1)))
+            finishedAt = instant(2026, 4, 1)
+        }
+        val viewModel = viewModel(books)
+
+        viewModel.onAction(BookListUiAction.OnScreenStarted)
+        advanceUntilIdle()
+        assertEquals(0, viewModel.state.value.booksFinishedThisYear)
+
+        viewModel.onAction(BookListUiAction.OnMarkFinishedClick(1))
+        advanceUntilIdle()
+
+        assertEquals(1, books.markFinishedCalls)
+        assertEquals(1L, books.lastMarkedId)
+        assertEquals(1, viewModel.state.value.booksFinishedThisYear)
+    }
+
+    @Test
+    fun `stream failure emits an error and clears loading`() = runTest(scheduler) {
+        val books = FakeBookRepository().apply { streamError = StorageException(RuntimeException("io")) }
+        val viewModel = viewModel(books)
+        val errors = mutableListOf<AppError>()
+        backgroundScope.launch(UnconfinedTestDispatcher(scheduler)) { viewModel.errors.toList(errors) }
+
+        viewModel.onAction(BookListUiAction.OnScreenStarted)
+        advanceUntilIdle()
+
+        assertEquals(1, errors.size)
+        assertFalse(viewModel.state.value.isLoading)
+    }
+}
