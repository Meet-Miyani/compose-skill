+package com.example.feature.notes.readinglog.data
+
+import androidx.datastore.core.DataStore
+import androidx.datastore.core.handlers.ReplaceFileCorruptionHandler
+import androidx.datastore.preferences.core.PreferenceDataStoreFactory
+import androidx.datastore.preferences.core.Preferences
+import androidx.datastore.preferences.core.emptyPreferences
+import okio.Path.Companion.toPath
+
+/**
+ * The single Preferences DataStore for reading-log settings. Created once and
+ * bound as a Koin `single`; the factory's default scope lives for the process
+ * and runs store IO off the main thread.
+ */
+internal fun createReadingGoalDataStore(): DataStore<Preferences> =
+    PreferenceDataStoreFactory.createWithPath(
+        // De-serialization failure resets to defaults instead of surfacing
+        // CorruptionException to every collector.
+        corruptionHandler = ReplaceFileCorruptionHandler { emptyPreferences() },
+        produceFile = { readingGoalStorePath().toPath() },
+    )
+
+/** File path for the goal store; the only per-platform part of the store. */
+internal expect fun readingGoalStorePath(): String
