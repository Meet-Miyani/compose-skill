+/**
+ * Reading-goal settings contract owned by the reading log domain.
+ *
+ * The presentation layer observes the goal and writes new targets through
+ * this port; persistence details stay in the data layer.
+ */
+package com.example.feature.notes.readinglog.domain.repository
+
+import com.example.feature.notes.readinglog.domain.model.ReadingGoal
+import kotlinx.coroutines.flow.Flow
+
+interface ReadingGoalRepository {
+    /** Emits the saved goal, or null when the user has not set one. */
+    fun getGoalStream(): Flow<ReadingGoal?>
+
+    /** Persists the yearly target; the goal stream re-emits after this completes. */
+    suspend fun setGoal(targetBooks: Int)
+}
