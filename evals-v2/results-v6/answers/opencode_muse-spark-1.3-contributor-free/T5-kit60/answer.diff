@@ -0,0 +1,80 @@
+package com.example.feature.notes.readinglog
+
+import androidx.lifecycle.SavedStateHandle
+import com.example.feature.notes.readinglog.domain.model.Book
+import com.example.feature.notes.readinglog.presentation.list.BookListUiAction
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.ExperimentalCoroutinesApi
+import kotlinx.coroutines.test.StandardTestDispatcher
+import kotlinx.coroutines.test.TestCoroutineScheduler
+import kotlinx.coroutines.test.advanceUntilIdle
+import kotlinx.coroutines.test.resetMain
+import kotlinx.coroutines.test.runTest
+import kotlinx.coroutines.test.setMain
+import kotlin.test.AfterTest
+import kotlin.test.BeforeTest
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertNull
+import kotlin.test.assertTrue
+
+@OptIn(ExperimentalCoroutinesApi::class)
+class BookListViewModelTest {
+    private val scheduler = TestCoroutineScheduler()
+
+    @BeforeTest fun setUp() { Dispatchers.setMain(StandardTestDispatcher(scheduler)) }
+    @AfterTest fun tearDown() { Dispatchers.resetMain() }
+
+    @Test fun `cold load shows books and saved goal`() = runTest(scheduler) {
+        val fake = FakeBookRepository().apply {
+            seedBooks(listOf(Book(1, "Dune", "Herbert", 412, true), Book(2, "Emma", "Austen", 300, false)))
+            seedGoal(12)
+        }
+        val viewModel = bookListViewModel(fake)
+        viewModel.onAction(BookListUiAction.OnScreenStarted)
+        advanceUntilIdle()
+        assertEquals(2, viewModel.state.value.items.size)
+        assertEquals(12, viewModel.state.value.readingGoal)
+    }
+
+    @Test fun `goal unset stays null`() = runTest(scheduler) {
+        val viewModel = bookListViewModel(FakeBookRepository())
+        viewModel.onAction(BookListUiAction.OnScreenStarted)
+        advanceUntilIdle()
+        assertNull(viewModel.state.value.readingGoal)
+        assertTrue(viewModel.state.value.items.isEmpty())
+    }
+
+    @Test fun `save persists goal`() = runTest(scheduler) {
+        val fake = FakeBookRepository()
+        val viewModel = bookListViewModel(fake)
+        viewModel.onAction(BookListUiAction.OnScreenStarted)
+        advanceUntilIdle()
+        viewModel.onAction(BookListUiAction.OnGoalDraftChanged("20"))
+        viewModel.onAction(BookListUiAction.OnSaveGoalClick)
+        advanceUntilIdle()
+        assertEquals(20, fake.lastSavedGoal)
+        assertEquals(20, viewModel.state.value.readingGoal)
+    }
+
+    @Test fun `invalid goal sets error and never writes`() = runTest(scheduler) {
+        val fake = FakeBookRepository()
+        val viewModel = bookListViewModel(fake)
+        viewModel.onAction(BookListUiAction.OnScreenStarted)
+        advanceUntilIdle()
+        viewModel.onAction(BookListUiAction.OnGoalDraftChanged("zero"))
+        viewModel.onAction(BookListUiAction.OnSaveGoalClick)
+        advanceUntilIdle()
+        assertEquals(0, fake.saveGoalCalls)
+        assertEquals("Enter a goal of 1 or more books", viewModel.state.value.goalError)
+    }
+
+    @Test fun `process death restores goal draft`() = runTest(scheduler) {
+        val handle = SavedStateHandle().apply { this["goalDraft"] = "15" }
+        val viewModel = bookListViewModel(FakeBookRepository(), handle = handle)
+        assertEquals("15", viewModel.state.value.goalDraft)
+        viewModel.onAction(BookListUiAction.OnScreenStarted)
+        advanceUntilIdle()
+        assertEquals("15", viewModel.state.value.goalDraft)
+    }
+}
