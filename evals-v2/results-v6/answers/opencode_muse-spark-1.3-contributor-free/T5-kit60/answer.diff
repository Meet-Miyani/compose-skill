+package com.example.feature.notes.readinglog
+
+import androidx.lifecycle.SavedStateHandle
+import com.example.feature.notes.readinglog.domain.model.Book
+import com.example.feature.notes.readinglog.domain.repository.BookRepository
+import kotlinx.coroutines.flow.Flow
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.update
+
+class FakeBookRepository : BookRepository {
+    private val booksBacking = MutableStateFlow<List<Book>>(emptyList())
+    private val goalBacking = MutableStateFlow<Int?>(null)
+    var lastSavedGoal: Int? = null
+    var saveGoalCalls: Int = 0
+
+    fun seedBooks(items: List<Book>) {
+        booksBacking.value = items
+    }
+
+    fun seedGoal(target: Int?) {
+        goalBacking.value = target
+    }
+
+    override fun getBooksStream(): Flow<List<Book>> = booksBacking
+
+    override suspend fun addBook(title: String, author: String, pages: Int): Long {
+        val id = (booksBacking.value.maxOfOrNull { it.id } ?: 0L) + 1L
+        booksBacking.update { it + Book(id, title, author, pages, false) }
+        return id
+    }
+
+    override suspend fun markFinished(id: Long) {
+        booksBacking.update { list -> list.map { if (it.id == id) it.copy(isFinished = true) else it } }
+    }
+
+    override fun getReadingGoalStream(): Flow<Int?> = goalBacking
+
+    override suspend fun setReadingGoal(target: Int) {
+        saveGoalCalls += 1
+        lastSavedGoal = target
+        goalBacking.value = target
+    }
+}
+
+fun bookListViewModel(
+    fake: FakeBookRepository,
+    handle: SavedStateHandle = SavedStateHandle(),
+): com.example.feature.notes.readinglog.presentation.list.BookListViewModel =
+    com.example.feature.notes.readinglog.presentation.list.BookListViewModel(
+        repository = fake,
+        savedStateHandle = handle,
+    )
