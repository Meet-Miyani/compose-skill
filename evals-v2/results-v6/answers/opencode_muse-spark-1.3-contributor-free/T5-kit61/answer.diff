+package com.example.feature.notes.readinglog.presentation.list
+
+import androidx.lifecycle.SavedStateHandle
+import com.example.feature.notes.readinglog.domain.model.Book
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.ExperimentalCoroutinesApi
+import kotlinx.coroutines.flow.toList
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.test.StandardTestDispatcher
+import kotlinx.coroutines.test.TestCoroutineScheduler
+import kotlinx.coroutines.test.UnconfinedTestDispatcher
+import kotlinx.coroutines.test.advanceUntilIdle
+import kotlinx.coroutines.test.resetMain
+import kotlinx.coroutines.test.runTest
+import kotlinx.coroutines.test.setMain
+import kotlin.test.AfterTest
+import kotlin.test.BeforeTest
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertFalse
+import kotlin.test.assertNull
+import kotlin.test.assertTrue
+
+@OptIn(ExperimentalCoroutinesApi::class)
+class BookListViewModelTest {
+    private val scheduler = TestCoroutineScheduler()
+    @BeforeTest fun setUp() { Dispatchers.setMain(StandardTestDispatcher(scheduler)) }
+    @AfterTest fun tearDown() { Dispatchers.resetMain() }
+    private fun book(id: Long = 1L, finished: Boolean = false): Book =
+        Book(id, "Title $id", "Author", 100, finished)
+    private fun viewModel(fake: FakeBookRepository, handle: SavedStateHandle = SavedStateHandle()): BookListViewModel =
+        BookListViewModel(fake, handle)
+    @Test fun `cold load shows books goal and progress` () = runTest(scheduler) {
+        val fake = FakeBookRepository().apply {
+            seedBooks(listOf(book(1, true), book(2, false), book(3, true)))
+            seedGoal(10)
+        }
+        val vm = viewModel(fake)
+        vm.onAction(BookListUiAction.OnScreenStarted)
+        advanceUntilIdle()
+        assertFalse(vm.state.value.isLoading)
+        assertEquals(3, vm.state.value.items.size)
+        assertEquals(10, vm.state.value.yearlyGoal)
+        assertEquals(2, vm.state.value.finishedCount)
+    }
+    @Test fun `empty books with no goal` () = runTest(scheduler) {
+        val vm = viewModel(FakeBookRepository())
+        vm.onAction(BookListUiAction.OnScreenStarted)
+        advanceUntilIdle()
+        assertTrue(vm.state.value.items.isEmpty())
+        assertNull(vm.state.value.yearlyGoal)
+        assertEquals(0, vm.state.value.finishedCount)
+        assertFalse(vm.state.value.isLoading)
+    }
+    @Test fun `reconcile keeps content on second start` () = runTest(scheduler) {
+        val fake = FakeBookRepository().apply {
+            seedBooks(listOf(book()))
+            seedGoal(5)
+        }
+        val vm = viewModel(fake)
+        vm.onAction(BookListUiAction.OnScreenStarted)
+        advanceUntilIdle()
+        vm.onAction(BookListUiAction.OnScreenStarted)
+        advanceUntilIdle()
+        assertEquals(1, vm.state.value.items.size)
+        assertEquals(5, vm.state.value.yearlyGoal)
+    }
+    @Test fun `goal draft change updates state` () = runTest(scheduler) {
+        val vm = viewModel(FakeBookRepository())
+        vm.onAction(BookListUiAction.OnGoalDraftChanged("12"))
+        advanceUntilIdle()
+        assertEquals("12", vm.state.value.goalDraft)
+    }
+    @Test fun `save goal persists and updates progress` () = runTest(scheduler) {
+        val fake = FakeBookRepository().apply { seedBooks(listOf(book(1, true))) }
+        val vm = viewModel(fake)
+        vm.onAction(BookListUiAction.OnScreenStarted)
+        advanceUntilIdle()
+        vm.onAction(BookListUiAction.OnGoalDraftChanged("20"))
+        vm.onAction(BookListUiAction.OnSaveGoalClick)
+        advanceUntilIdle()
+        assertEquals(20, fake.lastSavedGoal)
+        assertEquals(20, vm.state.value.yearlyGoal)
+        assertEquals(1, vm.state.value.finishedCount)
+    }
+    @Test fun `invalid goal does not save` () = runTest(scheduler) {
+        val fake = FakeBookRepository()
+        val vm = viewModel(fake)
+        vm.onAction(BookListUiAction.OnScreenStarted)
+        advanceUntilIdle()
+        vm.onAction(BookListUiAction.OnGoalDraftChanged("zero"))
+        vm.onAction(BookListUiAction.OnSaveGoalClick)
+        advanceUntilIdle()
+        assertEquals(0, fake.saveCalls)
+        assertNull(vm.state.value.yearlyGoal)
+        vm.onAction(BookListUiAction.OnGoalDraftChanged("0"))
+        vm.onAction(BookListUiAction.OnSaveGoalClick)
+        advanceUntilIdle()
+        assertEquals(0, fake.saveCalls)
+    }
+    @Test fun `double save makes one repository write` () = runTest(scheduler) {
+        val fake = FakeBookRepository()
+        val vm = viewModel(fake)
+        vm.onAction(BookListUiAction.OnScreenStarted)
+        advanceUntilIdle()
+        vm.onAction(BookListUiAction.OnGoalDraftChanged("7"))
+        vm.onAction(BookListUiAction.OnSaveGoalClick)
+        vm.onAction(BookListUiAction.OnSaveGoalClick)
+        advanceUntilIdle()
+        assertEquals(1, fake.saveCalls)
+    }
+    @Test fun `mark finished updates finished count` () = runTest(scheduler) {
+        val fake = FakeBookRepository().apply {
+            seedBooks(listOf(book(1, false), book(2, false)))
+            seedGoal(4)
+        }
+        val vm = viewModel(fake)
+        vm.onAction(BookListUiAction.OnScreenStarted)
+        advanceUntilIdle()
+        assertEquals(0, vm.state.value.finishedCount)
+        vm.onAction(BookListUiAction.OnMarkFinishedClick(1L))
+        advanceUntilIdle()
+        assertEquals(1, vm.state.value.finishedCount)
+        assertEquals(4, vm.state.value.yearlyGoal)
+    }
+    @Test fun `process death restores goal draft` () = runTest(scheduler) {
+        val handle = SavedStateHandle().apply { this["goalDraft"] = "15" }
+        val vm = viewModel(FakeBookRepository(), handle)
+        assertEquals("15", vm.state.value.goalDraft)
+        vm.onAction(BookListUiAction.OnScreenStarted)
+        advanceUntilIdle()
+        assertEquals("15", vm.state.value.goalDraft)
+    }
+    @Test fun `add opens sheet effect` () = runTest(scheduler) {
+        val vm = viewModel(FakeBookRepository())
+        val effects = mutableListOf<BookListUiEffect>()
+        backgroundScope.launch(UnconfinedTestDispatcher(scheduler)) { vm.effect.toList(effects) }
+        vm.onAction(BookListUiAction.OnScreenStarted)
+        vm.onAction(BookListUiAction.OnAddClick)
+        advanceUntilIdle()
+        assertEquals(BookListUiEffect.OpenAddSheet, effects.single())
+    }
+}
