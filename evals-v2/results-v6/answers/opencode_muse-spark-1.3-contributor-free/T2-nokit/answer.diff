+fun BookDetailScreen(
+    state: BookDetailUiState,
+    onRetry: () -> Unit,
+    onBack: () -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    when {
+        state.isLoading -> CircularProgressIndicator(modifier = modifier)
+        state.error != null && state.book == null -> Column(modifier = modifier) {
+            Text(stringResource(Res.string.error_message))
+            Button(onClick = onRetry) { Text(stringResource(Res.string.retry)) }
+            Button(onClick = onBack) { Text(stringResource(Res.string.back)) }
+        }
+        state.isMissing -> Column(modifier = modifier) {
+            Text(stringResource(Res.string.missing_book))
+            Button(onClick = onBack) { Text(stringResource(Res.string.back)) }
+        }
+        else -> Column(modifier = modifier) {
+            if (state.isRefreshing) {
+                Text(stringResource(Res.string.refreshing))
+            }
+            state.book?.let {
+                Text(it.title)
+            }
+            Button(onClick = onBack) { Text(stringResource(Res.string.back)) }
         }
     }
