+import kotlinx.coroutines.Job
+import org.koin.core.annotation.KoinViewModel
+
+/** ViewModel behind the Reading stats destination; owns its UiState and book-stream load. */
+@KoinViewModel
+class ReadingStatsViewModel(
+    private val repository: BookRepository,
+) : BaseViewModel<ReadingStatsUiAction, ReadingStatsUiState, ReadingStatsUiEffect>(ReadingStatsUiState()) {
+
+    private var loadJob: Job? = null
+
+    override fun onAction(action: ReadingStatsUiAction) {
+        when (action) {
+            ReadingStatsUiAction.OnScreenStarted -> load()
+            is ReadingStatsUiAction.OnRetryClick -> retry()
+        }
+    }
+
+    private fun load() {
+        // Overlap guard: the first load owns the response; later overlapping loads return early.
+        if (loadJob?.isActive == true) return
+        loadJob = launchGuarded(
+            onError = { updateState { copy(isLoading = false, error = it) } },
+            onStart = { updateState { copy(isLoading = true, error = null) } },
+        ) {
+            repository.getBooksStream().collect { books ->
+                // Keep finished books only; the total is the sum of their pages.
+                val pages = books
+                    .filter { it.isFinished }
+                    .sumOf { it.pages }
+                updateState { copy(totalPages = pages, isLoading = false, error = null) }
             }
         }
     }
+
+    private fun retry() {
+        updateState { copy(error = null) }
+        load()
+    }
 }
