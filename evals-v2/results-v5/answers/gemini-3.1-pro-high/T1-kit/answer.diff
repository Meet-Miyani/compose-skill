@@ -0,0 +1,110 @@
+/**
+ * ViewModel for the Workouts destination in the Workouts example.
+ *
+ * Owns the UiState, the draft title (via SavedStateHandle), and the
+ * cold-load/reconcile split. Effects carry navigation intent outward.
+ */
+package com.example.feature.workouts.presentation.workouts
+
+import com.example.feature.workouts.domain.repository.WorkoutsRepository
+import androidx.lifecycle.SavedStateHandle
+import com.example.core.mvi.BaseViewModel
+import kotlinx.coroutines.CoroutineDispatcher
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.withContext
+import org.koin.core.annotation.KoinViewModel
+import org.koin.core.annotation.InjectedParam
+
+/** Construction bag for the destination's nav arguments. Top-level so entries and tests share it. */
+data class WorkoutsParams(val workoutId: Long)
+
+
+/** ViewModel behind the Workouts destination; owns its UiState, draft title, and cold-load/reconcile split. */
+@KoinViewModel
+class WorkoutsViewModel(
+    private val repository: WorkoutsRepository,
+    private val photoStorage: PhotoStorage,
+    @InjectedParam private val params: WorkoutsParams,
+    private val savedStateHandle: SavedStateHandle,
+    // Inject the dispatcher; Default is the commonMain default across targets.
+    private val ioDispatcher: CoroutineDispatcher = Dispatchers.Default,
+) : BaseViewModel<WorkoutsUiAction, WorkoutsUiState, WorkoutsUiEffect>(
+    WorkoutsUiState(
+        draftTitle = savedStateHandle["draftTitle"] ?: "",
+        photoPath = savedStateHandle["photoPath"]
+    ),
+) {
+
+    private var loadJob: Job? = null
+    private var saveJob: Job? = null
+    private var hasStarted: Boolean = false
+
+    override fun onAction(action: WorkoutsUiAction) {
+        when (action) {
+            WorkoutsUiAction.OnScreenStarted -> load()
+            is WorkoutsUiAction.OnTitleChanged -> {
+                savedStateHandle["draftTitle"] = action.title
+                updateState { copy(draftTitle = action.title) }
+            }
+            WorkoutsUiAction.OnAttachPhotoClick -> {
+                // UI handles launching picker
+            }
+            is WorkoutsUiAction.OnPhotoPicked -> attachPhoto(action.bytes)
+            WorkoutsUiAction.OnSaveClick -> save()
+            is WorkoutsUiAction.OnRetryClick -> retry()
+            WorkoutsUiAction.OnBackClick -> sendEffect(WorkoutsUiEffect.NavigateBack)
+        }
+    }
+
+    private fun attachPhoto(bytes: ByteArray?) {
+        if (bytes == null) return
+        launchGuarded(onError = ::emitError) {
+            val path = withContext(ioDispatcher) { photoStorage.savePhoto(bytes) }
+            savedStateHandle["photoPath"] = path
+            updateState { copy(photoPath = path) }
+        }
+    }
+
+    private fun load() {
+        // Overlap guard: the first load owns the response; later overlapping loads return early.
+        if (loadJob?.isActive == true) return
+        loadJob = launchGuarded(
+            onError = { error ->
+                if (hasStarted) emitError(error) else updateState { copy(error = error) }
+            },
+            onStart = { updateState { copy(isLoading = !hasStarted, isRefreshing = hasStarted) } },
+            onComplete = { updateState { copy(isLoading = false, isRefreshing = false) } },
+        ) {
+            val item = withContext(ioDispatcher) { repository.getWorkout(params.workoutId) }
+            updateState {
+                copy(
+                    isLoading = false,
+                    isRefreshing = false,
+                    isMissing = item == null,
+                    items = listOfNotNull(item),
+                    draftTitle = if (savedStateHandle.contains("draftTitle")) draftTitle else item?.title.orEmpty(),
+                    photoPath = if (savedStateHandle.contains("photoPath")) photoPath else item?.photoPath,
+                )
+            }
+            hasStarted = true
+        }
+    }
+
+    private fun save() {
+        if (saveJob?.isActive == true) return
+        val draftTitle = currentState.draftTitle
+        val photoPath = currentState.photoPath
+        saveJob = launchGuarded(onError = ::emitError) {
+            withContext(ioDispatcher) {
+                repository.saveWorkoutDraft(params.workoutId, draftTitle, photoPath)
+            }
+            sendEffect(WorkoutsUiEffect.Saved)
+        }
+    }
+
+    private fun retry() {
+        updateState { copy(error = null) }
+        load()
+    }
+}
