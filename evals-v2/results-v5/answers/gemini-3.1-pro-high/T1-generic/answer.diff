@@ -0,0 +1,36 @@
+package com.example.feature.workouts.presentation.workouts
+
+import androidx.activity.compose.rememberLauncherForActivityResult
+import androidx.activity.result.contract.ActivityResultContracts
+import androidx.compose.runtime.Composable
+import androidx.compose.ui.platform.LocalContext
+import java.io.File
+import java.util.UUID
+
+@Composable
+actual fun rememberPhotoPicker(onPhotoPicked: (String?) -> Unit): () -> Unit {
+    val context = LocalContext.current
+    val launcher = rememberLauncherForActivityResult(
+        contract = ActivityResultContracts.GetContent()
+    ) { uri ->
+        if (uri == null) {
+            onPhotoPicked(null)
+            return@rememberLauncherForActivityResult
+        }
+        try {
+            // Save to local storage
+            val inputStream = context.contentResolver.openInputStream(uri)
+            val file = File(context.filesDir, "photo_${UUID.randomUUID()}.jpg")
+            inputStream?.use { input ->
+                file.outputStream().use { output ->
+                    input.copyTo(output)
+                }
+            }
+            onPhotoPicked(file.absolutePath)
+        } catch (e: Exception) {
+            e.printStackTrace()
+            onPhotoPicked(null)
+        }
+    }
+    return { launcher.launch("image/*") }
+}
