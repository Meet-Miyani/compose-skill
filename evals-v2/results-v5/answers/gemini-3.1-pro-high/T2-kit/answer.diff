+package com.example.feature.workouts.presentation.type
+
+import androidx.compose.runtime.Composable
+import com.example.core.mvi.CollectEffect
+import com.example.designsystem.error.HandleAppErrors
+
+@Composable
+fun WorkoutTypeSelectionRoute(
+    viewModel: WorkoutTypeSelectionViewModel,
+    onEffect: suspend (WorkoutTypeSelectionUiEffect) -> Unit
+) {
+    CollectEffect(viewModel.effect) { onEffect(it) }
+    HandleAppErrors(viewModel.errors)
+    WorkoutTypeSelectionScreen(
+        onTypeSelected = { viewModel.onAction(WorkoutTypeSelectionUiAction.OnTypeSelected(it)) },
+        onBack = { viewModel.onAction(WorkoutTypeSelectionUiAction.OnBackClick) }
+    )
+}
