+package com.example.feature.workouts.presentation.type
+
+import com.example.core.mvi.BaseViewModel
+import com.example.feature.workouts.domain.model.WorkoutType
+import com.example.feature.workouts.domain.repository.WorkoutsRepository
+import kotlinx.coroutines.Job
+import org.koin.core.annotation.KoinViewModel
+
+@KoinViewModel
+class WorkoutTypeSelectionViewModel(
+    private val repository: WorkoutsRepository,
+) : BaseViewModel<WorkoutTypeSelectionUiAction, WorkoutTypeSelectionUiState, WorkoutTypeSelectionUiEffect>(WorkoutTypeSelectionUiState()) {
+    
+    private var addJob: Job? = null
+
+    override fun onAction(action: WorkoutTypeSelectionUiAction) {
+        when (action) {
+            is WorkoutTypeSelectionUiAction.OnTypeSelected -> {
+                if (addJob?.isActive == true) return
+                addJob = launchGuarded(onError = ::emitError) {
+                    val id = repository.addWorkout(action.type)
+                    sendEffect(WorkoutTypeSelectionUiEffect.OpenWorkout(id))
+                }
+            }
+            WorkoutTypeSelectionUiAction.OnBackClick -> sendEffect(WorkoutTypeSelectionUiEffect.NavigateBack)
+        }
+    }
+}
