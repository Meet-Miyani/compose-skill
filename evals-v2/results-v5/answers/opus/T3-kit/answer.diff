+package com.example.app.adapter
+
+import android.content.Context
+import androidx.work.CoroutineWorker
+import androidx.work.WorkerParameters
+import androidx.work.workDataOf
+import com.example.core.error.StorageException
+import com.example.feature.workouts.data.export.WorkoutsCsvExport
+import org.koin.core.component.KoinComponent
+import org.koin.core.component.get
+
+/** Runs the shared workouts CSV export as WorkManager work. */
+class WorkoutsExportWorker(
+    context: Context,
+    params: WorkerParameters,
+) : CoroutineWorker(context, params), KoinComponent {
+    override suspend fun doWork(): Result {
+        val location = try {
+            get<WorkoutsCsvExport>().run()
+        } catch (e: StorageException) {
+            return Result.failure()
+        }
+        return Result.success(workDataOf(KEY_LOCATION to location))
+    }
+
+    companion object {
+        const val UNIQUE_NAME = "workouts-csv-export"
+        const val KEY_LOCATION = "location"
+    }
+}
