+/** CSV encoding for the workouts export (RFC 4180). */
+package com.example.feature.workouts.data.export
+
+import com.example.feature.workouts.domain.model.Workout
+
+private val HEADER = listOf("id", "title", "body", "updated_at", "archived")
+
+/** Characters a spreadsheet treats as the start of a formula. */
+private val FORMULA_PREFIXES = charArrayOf('=', '+', '-', '@', '\t', '\r')
+
+/** Encodes [workouts] as CSV with a header row and CRLF line endings. */
+internal fun buildWorkoutsCsv(workouts: List<Workout>): String = buildString {
+    appendRow(HEADER)
+    workouts.forEach { workout ->
+        appendRow(
+            listOf(
+                workout.id.toString(),
+                workout.title.orEmpty(),
+                workout.body.orEmpty(),
+                workout.updatedAt?.toString().orEmpty(),
+                workout.isArchived.toString(),
+            ),
+        )
+    }
+}
+
+private fun StringBuilder.appendRow(fields: List<String>) {
+    fields.joinTo(this, separator = ",", transform = ::escapeField)
+    append("\r\n")
+}
+
+private fun escapeField(raw: String): String {
+    // Neutralise spreadsheet formulas in user text (OWASP CSV injection).
+    val value = if (raw.isNotEmpty() && raw[0] in FORMULA_PREFIXES) "'$raw" else raw
+    val needsQuotes = value.any { it == ',' || it == '"' || it == '\n' || it == '\r' }
+    return if (needsQuotes) "\"" + value.replace("\"", "\"\"") + "\"" else value
+}
