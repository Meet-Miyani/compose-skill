+/** Background CSV export port owned by the Workouts domain. */
+package com.example.feature.workouts.domain.export
+
+import kotlinx.coroutines.flow.Flow
+
+/**
+ * Starts the workouts CSV export off the screen and reports its progress.
+ *
+ * Platform implementations are bound in the composition root: Android runs
+ * the export as WorkManager work, iOS and desktop on an app-lifetime scope.
+ * The export outlives the screen that started it.
+ */
+public interface WorkoutsExportScheduler {
+    /** Latest export status; replays the current value to new collectors. */
+    public val status: Flow<WorkoutsExportStatus>
+
+    /** Starts an export; a no-op while one is already running. */
+    public fun startExport()
+}
+
+/** Progress of the most recent workouts CSV export. */
+public sealed interface WorkoutsExportStatus {
+    public data object Idle : WorkoutsExportStatus
+    public data object Running : WorkoutsExportStatus
+
+    /** [location] is the user-facing place the file was saved to. */
+    public data class Saved(val location: String) : WorkoutsExportStatus
+    public data object Failed : WorkoutsExportStatus
+}
