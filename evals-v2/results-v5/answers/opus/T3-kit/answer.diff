+package com.example.app.adapter
+
+import com.example.feature.workouts.data.export.WorkoutsCsvExport
+import com.example.feature.workouts.domain.export.WorkoutsExportFileSink
+import com.example.feature.workouts.domain.export.WorkoutsExportScheduler
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.SupervisorJob
+import org.koin.core.annotation.Module
+import org.koin.core.annotation.Single
+import platform.UIKit.UIApplication
+import platform.UIKit.UIBackgroundTaskInvalid
+
+@Module
+actual class ExportAdapterModule {
+    @Single
+    fun exportFileSink(): WorkoutsExportFileSink = DocumentsWorkoutsExportFileSink()
+
+    @Single
+    fun exportScheduler(export: WorkoutsCsvExport): WorkoutsExportScheduler =
+        CoroutineWorkoutsExportScheduler(
+            export = export,
+            scope = CoroutineScope(SupervisorJob() + Dispatchers.Default),
+            keepAlive = ::withBackgroundTask,
+        )
+}
+
+/**
+ * Asks iOS for extra run time so an export started just before the app is
+ * backgrounded can finish. iOS may still end it at expiry.
+ */
+private suspend fun withBackgroundTask(block: suspend () -> Unit) {
+    val application = UIApplication.sharedApplication
+    var taskId = UIBackgroundTaskInvalid
+    taskId = application.beginBackgroundTaskWithName("workouts-csv-export") {
+        application.endBackgroundTask(taskId)
+        taskId = UIBackgroundTaskInvalid
+    }
+    try {
+        block()
+    } finally {
+        if (taskId != UIBackgroundTaskInvalid) application.endBackgroundTask(taskId)
+    }
+}
