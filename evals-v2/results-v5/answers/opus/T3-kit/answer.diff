+package com.example.app.adapter
+
+import com.example.core.error.StorageException
+import com.example.feature.workouts.data.export.WorkoutsCsvExport
+import com.example.feature.workouts.domain.export.WorkoutsExportScheduler
+import com.example.feature.workouts.domain.export.WorkoutsExportStatus
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.launch
+
+/**
+ * In-process export scheduler for iOS and desktop: runs the export on an
+ * app-lifetime [scope], so it continues after the screen is left.
+ * [keepAlive] lets a platform hold the process awake around the export.
+ */
+class CoroutineWorkoutsExportScheduler(
+    private val export: WorkoutsCsvExport,
+    private val scope: CoroutineScope,
+    private val keepAlive: suspend (block: suspend () -> Unit) -> Unit = { it() },
+) : WorkoutsExportScheduler {
+    private val _status = MutableStateFlow<WorkoutsExportStatus>(WorkoutsExportStatus.Idle)
+    override val status: StateFlow<WorkoutsExportStatus> = _status.asStateFlow()
+
+    override fun startExport() {
+        // Atomic claim: a second tap while running is ignored.
+        while (true) {
+            val current = _status.value
+            if (current == WorkoutsExportStatus.Running) return
+            if (_status.compareAndSet(current, WorkoutsExportStatus.Running)) break
+        }
+        scope.launch {
+            keepAlive {
+                _status.value = try {
+                    WorkoutsExportStatus.Saved(export.run())
+                } catch (e: StorageException) {
+                    WorkoutsExportStatus.Failed
+                }
+            }
+        }
+    }
+}
