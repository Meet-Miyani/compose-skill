+package com.example.app.adapter
+
+import android.content.ContentValues
+import android.content.Context
+import android.os.Build
+import android.os.Environment
+import android.provider.MediaStore
+import com.example.core.error.StorageException
+import com.example.feature.workouts.domain.export.WorkoutsExportFileSink
+import java.io.File
+import java.io.IOException
+
+/**
+ * Android sink. API 29+: public Downloads through MediaStore, no permission
+ * needed. API 24-28: the app's own Documents folder, which needs no
+ * storage permission either.
+ */
+class MediaStoreWorkoutsExportFileSink(private val context: Context) : WorkoutsExportFileSink {
+    override suspend fun writeCsv(fileName: String, content: String): String = try {
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q) writeToDownloads(fileName, content) else writeToAppFiles(fileName, content)
+    } catch (e: IOException) {
+        throw StorageException(e)
+    }
+
+    private fun writeToDownloads(fileName: String, content: String): String {
+        val resolver = context.contentResolver
+        val values = ContentValues().apply {
+            put(MediaStore.Downloads.DISPLAY_NAME, fileName)
+            put(MediaStore.Downloads.MIME_TYPE, "text/csv")
+            put(MediaStore.Downloads.IS_PENDING, 1)
+        }
+        val uri = resolver.insert(MediaStore.Downloads.EXTERNAL_CONTENT_URI, values)
+            ?: throw IOException("MediaStore refused $fileName")
+        try {
+            val stream = resolver.openOutputStream(uri) ?: throw IOException("No output stream for $uri")
+            stream.use { it.write(content.toByteArray()) }
+            resolver.update(uri, ContentValues().apply { put(MediaStore.Downloads.IS_PENDING, 0) }, null, null)
+        } catch (e: IOException) {
+            resolver.delete(uri, null, null)
+            throw e
+        }
+        return "Downloads/$fileName"
+    }
+
+    private fun writeToAppFiles(fileName: String, content: String): String {
+        val directory = context.getExternalFilesDir(Environment.DIRECTORY_DOCUMENTS) ?: context.filesDir
+        val file = File(directory, fileName)
+        file.writeText(content)
+        return file.absolutePath
+    }
+}
