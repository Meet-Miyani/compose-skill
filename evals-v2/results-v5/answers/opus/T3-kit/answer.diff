+/** File-writing port for the workouts CSV export. */
+package com.example.feature.workouts.domain.export
+
+/**
+ * Writes an exported file to a user-reachable place on the current platform.
+ *
+ * Implementations wrap expected IO failures as `StorageException`.
+ */
+public interface WorkoutsExportFileSink {
+    /** Writes [content] as [fileName] and returns the user-facing location. */
