+package com.example.app.adapter
+
+import com.example.core.error.StorageException
+import com.example.feature.workouts.domain.export.WorkoutsExportFileSink
+import java.io.File
+import java.io.IOException
+
+/** Desktop sink: writes into ~/Downloads, or the home folder when it is missing. */
+class DownloadsWorkoutsExportFileSink : WorkoutsExportFileSink {
+    override suspend fun writeCsv(fileName: String, content: String): String {
+        val home = File(System.getProperty("user.home"))
+        val directory = File(home, "Downloads").takeIf(File::isDirectory) ?: home
+        val file = File(directory, fileName)
+        try {
+            file.writeText(content)
+        } catch (e: IOException) {
+            throw StorageException(e)
+        }
+        return file.absolutePath
+    }
+}
