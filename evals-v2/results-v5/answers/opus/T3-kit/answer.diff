@@ -0,0 +1,69 @@
+package com.example.feature.workouts.data.export
+
+import com.example.feature.workouts.domain.export.WorkoutsExportFileSink
+import com.example.feature.workouts.domain.model.Workout
+import com.example.feature.workouts.presentation.workouts.FakeWorkoutsRepository
+import kotlinx.coroutines.test.StandardTestDispatcher
+import kotlinx.coroutines.test.runTest
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.time.Clock
+import kotlin.time.Instant
+
+class WorkoutsCsvExportTest {
+    private class RecordingSink : WorkoutsExportFileSink {
+        val written = mutableListOf<Pair<String, String>>()
+        override suspend fun writeCsv(fileName: String, content: String): String {
+            written += fileName to content
+            return "Downloads/$fileName"
+        }
+    }
+
+    private val fixedClock = object : Clock {
+        override fun now(): Instant = Instant.fromEpochSeconds(1_700_000_000)
+    }
+
+    @Test fun `csv has a header and one row per workout`() {
+        val csv = buildWorkoutsCsv(
+            listOf(
+                Workout(1, "Leg day", "Squats", Instant.fromEpochSeconds(0)),
+                Workout(2, null, null, null, isArchived = true),
+            ),
+        )
+        assertEquals(
+            "id,title,body,updated_at,archived\r\n" +
+                "1,Leg day,Squats,1970-01-01T00:00:00Z,false\r\n" +
+                "2,,,,true\r\n",
+            csv,
+        )
+    }
+
+    @Test fun `fields with commas quotes or newlines are quoted`() {
+        val csv = buildWorkoutsCsv(listOf(Workout(1, "Run, then \"swim\"", "line1\nline2", null)))
+        assertEquals(
+            "id,title,body,updated_at,archived\r\n" +
+                "1,\"Run, then \"\"swim\"\"\",\"line1\nline2\",,false\r\n",
+            csv,
+        )
+    }
+
+    @Test fun `formula-like text is neutralised`() {
+        val csv = buildWorkoutsCsv(listOf(Workout(1, "=SUM(A1)", "-5 reps", null)))
+        assertEquals("1,'=SUM(A1),'-5 reps,,false", csv.lines()[1])
+    }
+
+    @Test fun `run writes every workout through the sink`() = runTest {
+        val repository = FakeWorkoutsRepository().apply {
+            seed(listOf(Workout(1, "A", "", null), Workout(2, "B", "", null)))
+        }
+        val sink = RecordingSink()
+        val export = WorkoutsCsvExport(repository, sink, StandardTestDispatcher(testScheduler), fixedClock)
+
+        val location = export.run()
+
+        val (fileName, content) = sink.written.single()
+        assertEquals("workouts-1700000000.csv", fileName)
+        assertEquals("Downloads/workouts-1700000000.csv", location)
+        assertEquals(3, content.trimEnd().lines().size)
+    }
+}
