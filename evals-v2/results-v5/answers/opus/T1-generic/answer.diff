diff --git a/feature/workouts/src/jvmTest/kotlin/com/example/feature/workouts/data/local/WorkoutPhotoStorageTest.kt b/feature/workouts/src/jvmTest/kotlin/com/example/feature/workouts/data/local/WorkoutPhotoStorageTest.kt
new file mode 100644
index 0000000..8ac2673
--- /dev/null
+++ b/feature/workouts/src/jvmTest/kotlin/com/example/feature/workouts/data/local/WorkoutPhotoStorageTest.kt
@@ -0,0 +1,75 @@
+package com.example.feature.workouts.data.local
+
+import com.example.core.error.StorageException
+import io.github.vinceglb.filekit.PlatformFile
+import kotlinx.coroutines.test.runTest
+import java.io.File
+import kotlin.io.path.createTempDirectory
+import kotlin.test.AfterTest
+import kotlin.test.Test
+import kotlin.test.assertContentEquals
+import kotlin.test.assertEquals
+import kotlin.test.assertFailsWith
+import kotlin.test.assertFalse
+import kotlin.test.assertNotEquals
+import kotlin.test.assertTrue
+
+/** Real-filesystem tests for [WorkoutPhotoStorage] against a temp directory. */
+class WorkoutPhotoStorageTest {
+    private val root: File = createTempDirectory("workout-photos-test").toFile()
+    private val photos = File(root, WorkoutPhotoStorage.DIRECTORY_NAME)
+    private val storage = WorkoutPhotoStorage(PlatformFile(photos))
+
+    @AfterTest
+    fun tearDown() {
+        root.deleteRecursively()
+    }
+
+    private fun source(name: String, bytes: ByteArray = byteArrayOf(1, 2, 3)): PlatformFile =
+        PlatformFile(File(root, name).apply { writeBytes(bytes) })
+
+    @Test
+    fun `save copies bytes into the photo directory`() = runTest {
+        val bytes = byteArrayOf(9, 8, 7, 6)
+
+        val fileName = storage.save(workoutId = 4L, source = source("picked.PNG", bytes))
+
+        assertTrue(fileName.startsWith("workout-4-"))
+        assertTrue(fileName.endsWith(".png"))
+        assertContentEquals(bytes, File(photos, fileName).readBytes())
+        assertEquals(File(photos, fileName).absolutePath, File(storage.absolutePath(fileName)).absolutePath)
+    }
+
+    @Test
+    fun `save falls back to jpg for a missing or unsafe extension`() = runTest {
+        assertTrue(storage.save(1L, source("no-extension")).endsWith(".jpg"))
+        assertTrue(storage.save(1L, source("weird.p ng")).endsWith(".jpg"))
+    }
+
+    @Test
+    fun `each save gets its own file`() = runTest {
+        val first = storage.save(1L, source("a.jpg"))
+        Thread.sleep(2)
+        val second = storage.save(1L, source("b.jpg"))
+
+        assertNotEquals(first, second)
+    }
+
+    @Test
+    fun `delete removes the file and tolerates a missing one`() = runTest {
+        val fileName = storage.save(1L, source("a.jpg"))
+
+        storage.delete(fileName)
+        storage.delete(fileName)
+
+        assertFalse(File(photos, fileName).exists())
+    }
+
+    @Test
+    fun `unreadable source surfaces as StorageException and leaves no partial file`() = runTest {
+        assertFailsWith<StorageException> {
+            storage.save(1L, PlatformFile(File(root, "does-not-exist.jpg")))
+        }
+        assertTrue(photos.listFiles().orEmpty().isEmpty())
+    }
+}
