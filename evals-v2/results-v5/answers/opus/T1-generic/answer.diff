@@ -0,0 +1,70 @@
+package com.example.feature.workouts.data.local
+
+import com.example.core.error.StorageException
+import io.github.vinceglb.filekit.PlatformFile
+import io.github.vinceglb.filekit.copyTo
+import io.github.vinceglb.filekit.createDirectories
+import io.github.vinceglb.filekit.delete
+import io.github.vinceglb.filekit.div
+import io.github.vinceglb.filekit.name
+import io.github.vinceglb.filekit.path
+import kotlinx.coroutines.CancellationException
+import kotlin.time.Clock
+
+/**
+ * Copies picked photos into app-private storage and owns their lifecycle.
+ *
+ * The picked source (an Android content URI, an iOS picker temp file) is only
+ * readable for a short time, so the bytes are copied here instead of keeping a
+ * reference to the source. Files are streamed, never decoded, so large photos
+ * cannot exhaust memory. Expected IO failures surface as [StorageException].
+ */
+internal class WorkoutPhotoStorage(private val directory: PlatformFile) {
+
+    /** Copies [source] into storage and returns the new file name to persist. */
+    suspend fun save(workoutId: Long, source: PlatformFile): String = storageCall {
+        directory.createDirectories()
+        val extension = source.name.substringAfterLast('.', missingDelimiterValue = "").lowercase()
+            .takeIf { it.isNotBlank() && it.length <= MAX_EXTENSION_LENGTH && it.all(Char::isLetterOrDigit) }
+            ?: DEFAULT_EXTENSION
+        // Unique per attach, so a replaced photo never reuses a name an image cache still holds.
+        val fileName = "workout-$workoutId-${Clock.System.now().toEpochMilliseconds()}.$extension"
+        val target = directory / fileName
+        try {
+            source.copyTo(target)
+        } catch (e: Throwable) {
+            deleteQuietly(target)
+            throw e
+        }
+        fileName
+    }
+
+    /** Absolute path of a stored photo, for display. */
+    fun absolutePath(fileName: String): String = (directory / fileName).path
+
+    /** Best-effort removal; a leftover file is harmless, a crash while cleaning up is not. */
+    suspend fun delete(fileName: String) = deleteQuietly(directory / fileName)
+
+    private suspend fun deleteQuietly(file: PlatformFile) {
+        try {
+            file.delete(mustExist = false)
+        } catch (e: CancellationException) {
+            throw e
+        } catch (_: Exception) {
+        }
+    }
+
+    private suspend fun <T> storageCall(block: suspend () -> T): T = try {
+        block()
+    } catch (e: CancellationException) {
+        throw e
+    } catch (e: Exception) {
+        throw StorageException(e)
+    }
+
+    companion object {
+        const val DIRECTORY_NAME = "workout_photos"
+        private const val DEFAULT_EXTENSION = "jpg"
+        private const val MAX_EXTENSION_LENGTH = 5
+    }
+}
