+/**
+ * State-matrix tests for the workout type picker ViewModel.
+ *
+ * Each test drives the public event API and asserts the public state API.
+ */
+package com.example.feature.workouts.presentation.type
+
+import com.example.core.error.AppError
+import com.example.core.error.NetworkException
+import com.example.feature.workouts.domain.model.Workout
+import com.example.feature.workouts.domain.model.WorkoutType
+import com.example.feature.workouts.presentation.workouts.FakeWorkoutsRepository
+import kotlinx.coroutines.CompletableDeferred
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.ExperimentalCoroutinesApi
+import kotlinx.coroutines.flow.toList
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.test.StandardTestDispatcher
+import kotlinx.coroutines.test.TestCoroutineScheduler
+import kotlinx.coroutines.test.UnconfinedTestDispatcher
+import kotlinx.coroutines.test.advanceUntilIdle
+import kotlinx.coroutines.test.resetMain
+import kotlinx.coroutines.test.runTest
+import kotlinx.coroutines.test.setMain
+import kotlin.test.AfterTest
+import kotlin.test.BeforeTest
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertFalse
+import kotlin.test.assertNotNull
+import kotlin.test.assertNull
+import kotlin.test.assertTrue
+
+@OptIn(ExperimentalCoroutinesApi::class)
+class WorkoutTypeViewModelTest {
+    private val testScheduler = TestCoroutineScheduler()
+
+    @BeforeTest fun setUp() { Dispatchers.setMain(StandardTestDispatcher(testScheduler)) }
+    @AfterTest fun tearDown() { Dispatchers.resetMain() }
+
+    private fun workout(id: Long = 1L, type: WorkoutType? = null) = Workout(id, "Title", "", null, type = type)
+
+    // Separate instance on the shared scheduler, so withContext(ioDispatcher) suspends.
+    private fun viewModel(fake: FakeWorkoutsRepository, id: Long = 1L) =
+        WorkoutTypeViewModel(fake, WorkoutTypeParams(workoutId = id), StandardTestDispatcher(testScheduler))
+
+    @Test fun `cold load shows current type`() = runTest(testScheduler) {
+        val fake = FakeWorkoutsRepository().apply { seed(listOf(workout(type = WorkoutType.Strength))) }
+        val vm = viewModel(fake)
+        val gate = CompletableDeferred<Unit>().also { fake.gate = it }
+
+        vm.onAction(WorkoutTypeUiAction.OnScreenStarted)
+        advanceUntilIdle()
+        assertTrue(vm.state.value.isLoading)
+
+        gate.complete(Unit)
+        advanceUntilIdle()
+        assertFalse(vm.state.value.isLoading)
+        assertEquals(WorkoutType.Strength, vm.state.value.selectedType)
+    }
+
+    @Test fun `untyped workout shows no selection`() = runTest(testScheduler) {
+        val fake = FakeWorkoutsRepository().apply { seed(listOf(workout())) }
+        val vm = viewModel(fake)
+
+        vm.onAction(WorkoutTypeUiAction.OnScreenStarted)
+        advanceUntilIdle()
+
+        assertNull(vm.state.value.selectedType)
+        assertFalse(vm.state.value.isMissing)
+    }
+
+    @Test fun `picking a type persists it and emits saved`() = runTest(testScheduler) {
+        val fake = FakeWorkoutsRepository().apply { seed(listOf(workout())) }
+        val vm = viewModel(fake)
+        val effects = mutableListOf<WorkoutTypeUiEffect>()
+        backgroundScope.launch(UnconfinedTestDispatcher(testScheduler)) { vm.effect.toList(effects) }
+        vm.onAction(WorkoutTypeUiAction.OnScreenStarted)
+        advanceUntilIdle()
+
+        val gate = CompletableDeferred<Unit>().also { fake.setTypeGate = it }
+        vm.onAction(WorkoutTypeUiAction.OnTypeClick(WorkoutType.Cardio))
+        advanceUntilIdle()
+        assertTrue(vm.state.value.isSaving)
+
+        gate.complete(Unit)
+        advanceUntilIdle()
+        assertFalse(vm.state.value.isSaving)
+        assertEquals(WorkoutType.Cardio, vm.state.value.selectedType)
+        assertEquals(WorkoutType.Cardio, fake.getWorkout(1L)?.type)
+        assertEquals(listOf<WorkoutTypeUiEffect>(WorkoutTypeUiEffect.TypeSaved), effects)
+    }
+
+    @Test fun `double tap makes one type write`() = runTest(testScheduler) {
+        val fake = FakeWorkoutsRepository().apply { seed(listOf(workout())) }
+        val vm = viewModel(fake)
+
+        vm.onAction(WorkoutTypeUiAction.OnTypeClick(WorkoutType.Cardio))
+        vm.onAction(WorkoutTypeUiAction.OnTypeClick(WorkoutType.Flexibility))
+        advanceUntilIdle()
+
+        assertEquals(1, fake.setTypeCalls)
+        assertEquals(WorkoutType.Cardio, fake.getWorkout(1L)?.type)
+    }
+
+    @Test fun `failed write pops error keeps selection and stays open`() = runTest(testScheduler) {
+        val fake = FakeWorkoutsRepository().apply { seed(listOf(workout(type = WorkoutType.Strength))) }
+        val vm = viewModel(fake)
+        val effects = mutableListOf<WorkoutTypeUiEffect>()
+        val errors = mutableListOf<AppError>()
+        backgroundScope.launch(UnconfinedTestDispatcher(testScheduler)) { vm.effect.toList(effects) }
+        backgroundScope.launch(UnconfinedTestDispatcher(testScheduler)) { vm.errors.toList(errors) }
+        vm.onAction(WorkoutTypeUiAction.OnScreenStarted)
+        advanceUntilIdle()
+
+        fake.setTypeShouldThrow = NetworkException.Connection()
+        vm.onAction(WorkoutTypeUiAction.OnTypeClick(WorkoutType.Cardio))
+        advanceUntilIdle()
+
+        assertEquals(WorkoutType.Strength, vm.state.value.selectedType)
+        assertFalse(vm.state.value.isSaving)
+        assertEquals(1, errors.size)
+        assertTrue(effects.isEmpty())
+    }
+
+    @Test fun `inline error on cold load then retry succeeds`() = runTest(testScheduler) {
+        val fake = FakeWorkoutsRepository().apply { shouldThrow = NetworkException.Connection() }
+        val vm = viewModel(fake)
+
+        vm.onAction(WorkoutTypeUiAction.OnScreenStarted)
+        advanceUntilIdle()
+        val error = assertNotNull(vm.state.value.error)
+
+        fake.shouldThrow = null
+        fake.seed(listOf(workout(type = WorkoutType.Flexibility)))
+        vm.onAction(WorkoutTypeUiAction.OnRetryClick(error))
+        advanceUntilIdle()
+
+        assertNull(vm.state.value.error)
+        assertEquals(WorkoutType.Flexibility, vm.state.value.selectedType)
+    }
+
+    @Test fun `reconcile failure keeps selection and pops error`() = runTest(testScheduler) {
+        val fake = FakeWorkoutsRepository().apply { seed(listOf(workout(type = WorkoutType.Cardio))) }
+        val vm = viewModel(fake)
+        val errors = mutableListOf<AppError>()
+        backgroundScope.launch(UnconfinedTestDispatcher(testScheduler)) { vm.errors.toList(errors) }
+        vm.onAction(WorkoutTypeUiAction.OnScreenStarted)
+        advanceUntilIdle()
+
+        fake.shouldThrow = NetworkException.Connection()
+        vm.onAction(WorkoutTypeUiAction.OnScreenStarted)
+        advanceUntilIdle()
+
+        assertEquals(WorkoutType.Cardio, vm.state.value.selectedType)
+        assertNull(vm.state.value.error)
+        assertEquals(1, errors.size)
+    }
+
+    @Test fun `not found sets isMissing with no AppError`() = runTest(testScheduler) {
+        val fake = FakeWorkoutsRepository().apply { seed(listOf(workout(id = 2L))) }
+        val vm = viewModel(fake, id = 1L)
+
+        vm.onAction(WorkoutTypeUiAction.OnScreenStarted)
+        advanceUntilIdle()
+
+        assertTrue(vm.state.value.isMissing)
+        assertNull(vm.state.value.error)
+    }
+
+    @Test fun `overlapping loads fetch once`() = runTest(testScheduler) {
+        val fake = FakeWorkoutsRepository().apply { seed(listOf(workout())) }
+        val vm = viewModel(fake)
+
+        vm.onAction(WorkoutTypeUiAction.OnScreenStarted)
+        vm.onAction(WorkoutTypeUiAction.OnScreenStarted)
+        advanceUntilIdle()
+
+        assertEquals(1, fake.getCalls)
+    }
+
+    @Test fun `back emits navigate back`() = runTest(testScheduler) {
+        val vm = viewModel(FakeWorkoutsRepository())
+        val effects = mutableListOf<WorkoutTypeUiEffect>()
+        backgroundScope.launch(UnconfinedTestDispatcher(testScheduler)) { vm.effect.toList(effects) }
+
+        vm.onAction(WorkoutTypeUiAction.OnBackClick)
+        advanceUntilIdle()
+
+        assertEquals(listOf<WorkoutTypeUiEffect>(WorkoutTypeUiEffect.NavigateBack), effects)
+    }
+}
