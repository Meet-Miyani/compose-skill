+/**
+ * ViewModel for the workout type picker.
+ *
+ * Loads the workout by identity to show its current type, then writes the
+ * chosen type through the repository; the editor picks it up on reconcile.
+ */
+package com.example.feature.workouts.presentation.type
+
+import com.example.core.mvi.BaseViewModel
+import com.example.feature.workouts.domain.model.WorkoutType
+import com.example.feature.workouts.domain.repository.WorkoutsRepository
+import kotlinx.coroutines.CoroutineDispatcher
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.withContext
+import org.koin.core.annotation.InjectedParam
+import org.koin.core.annotation.KoinViewModel
+
+/** Construction bag for the picker's nav arguments. Top-level so entries and tests share it. */
+data class WorkoutTypeParams(val workoutId: Long)
+
+/** ViewModel behind the type picker; owns the current selection and the type write. */
+@KoinViewModel
+class WorkoutTypeViewModel(
+    private val repository: WorkoutsRepository,
+    @InjectedParam private val params: WorkoutTypeParams,
+    // Inject the dispatcher; Default is the commonMain default across targets.
+    private val ioDispatcher: CoroutineDispatcher = Dispatchers.Default,
+) : BaseViewModel<WorkoutTypeUiAction, WorkoutTypeUiState, WorkoutTypeUiEffect>(WorkoutTypeUiState()) {
+
+    private var loadJob: Job? = null
+    private var saveJob: Job? = null
+    private var hasStarted: Boolean = false
+
+    override fun onAction(action: WorkoutTypeUiAction) {
+        when (action) {
+            WorkoutTypeUiAction.OnScreenStarted -> load()
+            is WorkoutTypeUiAction.OnTypeClick -> select(action.type)
+            is WorkoutTypeUiAction.OnRetryClick -> retry()
+            WorkoutTypeUiAction.OnBackClick -> sendEffect(WorkoutTypeUiEffect.NavigateBack)
+        }
+    }
+
+    private fun load() {
+        if (loadJob?.isActive == true) return
+        loadJob = launchGuarded(
+            onError = { error ->
+                if (hasStarted) emitError(error) else updateState { copy(error = error) }
+            },
+            onStart = { updateState { copy(isLoading = !hasStarted) } },
+            onComplete = { updateState { copy(isLoading = false) } },
+        ) {
+            val workout = withContext(ioDispatcher) { repository.getWorkout(params.workoutId) }
+            updateState { copy(selectedType = workout?.type, isMissing = workout == null) }
+            hasStarted = true
+        }
+    }
+
+    private fun select(type: WorkoutType) {
+        if (saveJob?.isActive == true) return
+        saveJob = launchGuarded(
+            onError = ::emitError,
+            onStart = { updateState { copy(isSaving = true) } },
+            onComplete = { updateState { copy(isSaving = false) } },
+        ) {
+            withContext(ioDispatcher) { repository.setWorkoutType(params.workoutId, type) }
+            updateState { copy(selectedType = type) }
+            sendEffect(WorkoutTypeUiEffect.TypeSaved)
+        }
+    }
+
+    private fun retry() {
+        updateState { copy(error = null) }
+        load()
+    }
+}
