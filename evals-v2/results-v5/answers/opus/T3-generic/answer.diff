+package com.example.feature.workouts.data.export
+
+import com.example.core.error.StorageException
+import com.example.feature.workouts.domain.export.WorkoutsExportScheduler
+import com.example.feature.workouts.domain.export.WorkoutsExportStatus
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.launch
+
+/**
+ * Runs the export in an app-lifetime [scope], so it outlives the screen that
+ * started it. Used where WorkManager is unavailable (iOS, desktop); the export
+ * does not survive the process ending.
+ */
+internal class CoroutineWorkoutsExportScheduler(
+    private val scope: CoroutineScope,
+    private val export: suspend () -> String,
+) : WorkoutsExportScheduler {
+    private val _status = MutableStateFlow<WorkoutsExportStatus>(WorkoutsExportStatus.Idle)
+    override val status: StateFlow<WorkoutsExportStatus> = _status.asStateFlow()
+
+    private var job: Job? = null
+
+    override fun start() {
+        if (job?.isActive == true) return
+        _status.value = WorkoutsExportStatus.Running
+        job = scope.launch {
+            // CancellationException is not caught, so cancellation propagates.
+            _status.value = try {
+                WorkoutsExportStatus.Succeeded(export())
+            } catch (e: StorageException) {
+                WorkoutsExportStatus.Failed
+            }
+        }
+    }
+}
