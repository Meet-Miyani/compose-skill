+import kotlinx.coroutines.test.runTest
+import kotlin.test.Test
+import kotlin.test.assertEquals
+
+class CoroutineWorkoutsExportSchedulerTest {
+    // Stands in for the app-lifetime scope. backgroundScope would not do: advanceUntilIdle skips its tasks.
+    private fun TestScope.appScope() = CoroutineScope(SupervisorJob() + StandardTestDispatcher(testScheduler))
+
+    @Test fun `start reports running then the written location`() = runTest {
+        val gate = CompletableDeferred<Unit>()
+        val scheduler = CoroutineWorkoutsExportScheduler(appScope()) { gate.await(); "/tmp/w.csv" }
+
+        scheduler.start()
+        advanceUntilIdle()
+        assertEquals(WorkoutsExportStatus.Running, scheduler.status.value)
+
+        gate.complete(Unit)
+        advanceUntilIdle()
+        assertEquals(WorkoutsExportStatus.Succeeded("/tmp/w.csv"), scheduler.status.value)
+    }
+
+    @Test fun `storage failure reports failed`() = runTest {
+        val scheduler = CoroutineWorkoutsExportScheduler(appScope()) { throw StorageException(Exception("disk full")) }
+
+        scheduler.start()
+        advanceUntilIdle()
+
+        assertEquals(WorkoutsExportStatus.Failed, scheduler.status.value)
+    }
+
+    @Test fun `start while running does not export twice`() = runTest {
+        var exports = 0
+        val gate = CompletableDeferred<Unit>()
+        val scheduler = CoroutineWorkoutsExportScheduler(appScope()) { exports++; gate.await(); "f.csv" }
+
+        scheduler.start()
+        advanceUntilIdle()
+        scheduler.start()
+        gate.complete(Unit)
+        advanceUntilIdle()
+
+        assertEquals(1, exports)
+    }
+
+    @Test fun `start after failure retries`() = runTest {
+        var fail = true
+        val scheduler = CoroutineWorkoutsExportScheduler(appScope()) {
+            if (fail) throw StorageException(Exception("disk full")) else "f.csv"
+        }
+
+        scheduler.start()
+        advanceUntilIdle()
+        fail = false
+        scheduler.start()
+        advanceUntilIdle()
+
+        assertEquals(WorkoutsExportStatus.Succeeded("f.csv"), scheduler.status.value)
+    }
+}
