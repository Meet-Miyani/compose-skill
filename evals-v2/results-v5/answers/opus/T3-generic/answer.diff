+package com.example.feature.workouts.data.export
+
+import com.example.feature.workouts.domain.model.Workout
+
+private const val CSV_HEADER = "id,title,body"
+private const val CRLF = "\r\n"
+
+/** RFC 4180 CSV of [workouts], one row per workout, CRLF line endings. */
+internal fun workoutsToCsv(workouts: List<Workout>): String = buildString {
+    append(CSV_HEADER).append(CRLF)
+    workouts.forEach { workout ->
+        append(workout.id).append(',')
+        append(csvField(workout.title.orEmpty())).append(',')
+        append(csvField(workout.body.orEmpty())).append(CRLF)
+    }
+}
+
+private fun csvField(value: String): String {
+    // Spreadsheets run cells starting with these as formulas (CSV injection);
+    // a leading apostrophe makes them plain text.
+    val safe = if (value.isNotEmpty() && value[0] in "=+-@\t\r") "'$value" else value
+    val needsQuotes = safe.any { it == ',' || it == '"' || it == '\n' || it == '\r' }
+    return if (needsQuotes) "\"" + safe.replace("\"", "\"\"") + "\"" else safe
+}
