+/** Background CSV export contract owned by the Workouts domain. */
+package com.example.feature.workouts.domain.export
+
+import kotlinx.coroutines.flow.Flow
+
+/** Observable state of the most recent workouts export. */
+sealed interface WorkoutsExportStatus {
+    data object Idle : WorkoutsExportStatus
+    data object Running : WorkoutsExportStatus
+
+    /** [location] is a user-facing description of where the file was written. */
+    data class Succeeded(val location: String) : WorkoutsExportStatus
+    data object Failed : WorkoutsExportStatus
+}
+
+/**
+ * Runs the workouts CSV export outside any screen's lifetime, so leaving the
+ * screen never cancels it. Android backs this with WorkManager, which also
+ * survives process death.
+ */
+interface WorkoutsExportScheduler {
+    val status: Flow<WorkoutsExportStatus>
+
+    /** Starts an export; no-op while one is already running. */
+    fun start()
+}
