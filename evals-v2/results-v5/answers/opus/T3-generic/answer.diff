+package com.example.feature.workouts.data.export
+
+import com.example.feature.workouts.domain.export.WorkoutsExportScheduler
+import com.example.feature.workouts.domain.repository.WorkoutsRepository
+import kotlinx.coroutines.flow.first
+import org.koin.core.annotation.Factory
+import kotlin.time.Clock
+
+/** Writes every workout to a new CSV file; platform code picks the directory. */
+@Factory
+internal class WorkoutsCsvExporter(
+    private val repository: WorkoutsRepository,
+) {
+    /**
+     * Returns a user-facing description of the written file's location.
+     * Throws [com.example.core.error.StorageException] when the file cannot be written.
+     */
+    suspend fun export(): String {
+        val csv = workoutsToCsv(repository.getWorkoutsStream().first())
+        return writeExportFile(
+            fileName = "workouts-${Clock.System.now().toEpochMilliseconds()}.csv",
+            content = csv,
+        )
+    }
+}
+
+/**
+ * Writes [content] to a new file the user can reach and returns where it went.
+ * Wraps platform IO failures in [com.example.core.error.StorageException].
+ */
+internal expect suspend fun writeExportFile(fileName: String, content: String): String
+
+/** Android schedules through WorkManager; other targets use an app-lifetime coroutine scope. */
+internal expect fun createWorkoutsExportScheduler(exporter: WorkoutsCsvExporter): WorkoutsExportScheduler
