+package com.example.feature.workouts.data.export
+
+import com.example.feature.workouts.domain.model.Workout
+import kotlin.test.Test
+import kotlin.test.assertEquals
+
+class WorkoutsCsvTest {
+    private fun workout(id: Long, title: String?, body: String?) = Workout(id, title, body, updatedAt = null)
+
+    @Test fun `empty list writes header only`() {
+        assertEquals("id,title,body\r\n", workoutsToCsv(emptyList()))
+    }
+
+    @Test fun `plain values are unquoted and nulls are empty`() {
+        assertEquals(
+            "id,title,body\r\n1,Legs,Squats\r\n2,,\r\n",
+            workoutsToCsv(listOf(workout(1, "Legs", "Squats"), workout(2, null, null))),
+        )
+    }
+
+    @Test fun `commas quotes and newlines are quoted and escaped`() {
+        assertEquals(
+            "id,title,body\r\n1,\"Push, pull\",\"Say \"\"go\"\"\nthen rest\"\r\n",
+            workoutsToCsv(listOf(workout(1, "Push, pull", "Say \"go\"\nthen rest"))),
+        )
+    }
+
+    @Test fun `formula-like cells are neutralised`() {
+        assertEquals(
+            "id,title,body\r\n1,'=HYPERLINK(1),'@x\r\n",
+            workoutsToCsv(listOf(workout(1, "=HYPERLINK(1)", "@x"))),
+        )
+    }
+}
