+package com.example.feature.workouts.data.export
+
+import android.content.ContentValues
+import android.content.Context
+import android.os.Build
+import android.os.Environment
+import android.provider.MediaStore
+import androidx.work.CoroutineWorker
+import androidx.work.ExistingWorkPolicy
+import androidx.work.OneTimeWorkRequestBuilder
+import androidx.work.WorkInfo
+import androidx.work.WorkManager
+import androidx.work.WorkerParameters
+import androidx.work.workDataOf
+import com.example.core.error.StorageException
+import com.example.feature.workouts.data.local.applicationContext
+import com.example.feature.workouts.domain.export.WorkoutsExportScheduler
+import com.example.feature.workouts.domain.export.WorkoutsExportStatus
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.flow.Flow
+import kotlinx.coroutines.flow.map
+import kotlinx.coroutines.withContext
+import org.koin.core.component.KoinComponent
+import org.koin.core.component.inject
+import java.io.File
+import java.io.IOException
+
+private const val EXPORT_WORK_NAME = "workouts-csv-export"
+private const val KEY_LOCATION = "location"
+
+/**
+ * API 29+: a new file in the shared Downloads collection (no permission needed).
+ * Older versions: the app-specific Documents directory, which needs no permission either.
+ */
+internal actual suspend fun writeExportFile(fileName: String, content: String): String =
+    withContext(Dispatchers.IO) {
+        try {
+            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q) {
+                writeToDownloads(applicationContext, fileName, content.encodeToByteArray())
+            } else {
+                val directory = applicationContext.getExternalFilesDir(Environment.DIRECTORY_DOCUMENTS)
+                    ?: applicationContext.filesDir
+                File(directory, fileName).apply { writeText(content) }.absolutePath
+            }
+        } catch (e: IOException) {
+            throw StorageException(e)
+        }
+    }
+
+@androidx.annotation.RequiresApi(Build.VERSION_CODES.Q)
+private fun writeToDownloads(context: Context, fileName: String, bytes: ByteArray): String {
+    val resolver = context.contentResolver
+    val pending = ContentValues().apply {
+        put(MediaStore.Downloads.DISPLAY_NAME, fileName)
+        put(MediaStore.Downloads.MIME_TYPE, "text/csv")
+        put(MediaStore.Downloads.IS_PENDING, 1)
+    }
+    val uri = resolver.insert(MediaStore.Downloads.EXTERNAL_CONTENT_URI, pending)
+        ?: throw IOException("MediaStore refused $fileName")
+    try {
+        resolver.openOutputStream(uri)?.use { it.write(bytes) } ?: throw IOException("No output stream for $uri")
+        resolver.update(uri, ContentValues().apply { put(MediaStore.Downloads.IS_PENDING, 0) }, null, null)
+    } catch (e: IOException) {
+        // Never leave a half-written pending entry behind.
+        resolver.delete(uri, null, null)
+        throw e
+    }
+    return "${Environment.DIRECTORY_DOWNLOADS}/$fileName"
+}
+
+/** WorkManager keeps the export running after the screen closes and across process death. */
+internal class WorkoutsExportWorker(
+    context: Context,
+    params: WorkerParameters,
+) : CoroutineWorker(context, params), KoinComponent {
+    private val exporter: WorkoutsCsvExporter by inject()
+
+    override suspend fun doWork(): Result = try {
+        Result.success(workDataOf(KEY_LOCATION to exporter.export()))
+    } catch (e: StorageException) {
+        Result.failure()
+    }
+}
+
+private class WorkManagerWorkoutsExportScheduler(context: Context) : WorkoutsExportScheduler {
+    private val workManager = WorkManager.getInstance(context)
+
+    override val status: Flow<WorkoutsExportStatus> =
+        workManager.getWorkInfosForUniqueWorkFlow(EXPORT_WORK_NAME).map { infos ->
+            val info = infos.lastOrNull() ?: return@map WorkoutsExportStatus.Idle
+            when (info.state) {
+                WorkInfo.State.ENQUEUED, WorkInfo.State.RUNNING, WorkInfo.State.BLOCKED -> WorkoutsExportStatus.Running
+                WorkInfo.State.SUCCEEDED -> info.outputData.getString(KEY_LOCATION)
+                    ?.let(WorkoutsExportStatus::Succeeded) ?: WorkoutsExportStatus.Failed
+                WorkInfo.State.FAILED -> WorkoutsExportStatus.Failed
+                WorkInfo.State.CANCELLED -> WorkoutsExportStatus.Idle
+            }
+        }
+
+    override fun start() {
+        // KEEP: a second tap while an export is queued or running does not start another.
+        workManager.enqueueUniqueWork(
+            EXPORT_WORK_NAME,
+            ExistingWorkPolicy.KEEP,
+            OneTimeWorkRequestBuilder<WorkoutsExportWorker>().build(),
+        )
+    }
+}
+
+// The worker resolves the exporter from Koin itself, since WorkManager constructs it.
+internal actual fun createWorkoutsExportScheduler(exporter: WorkoutsCsvExporter): WorkoutsExportScheduler =
+    WorkManagerWorkoutsExportScheduler(applicationContext)
