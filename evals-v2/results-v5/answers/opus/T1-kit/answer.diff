@@ -0,0 +1,47 @@
+package com.example.feature.workouts.data.local
+
+import com.example.core.error.StorageException
+import com.example.feature.workouts.domain.model.PickedPhoto
+import io.github.vinceglb.filekit.PlatformFile
+import io.github.vinceglb.filekit.createDirectories
+import io.github.vinceglb.filekit.delete
+import io.github.vinceglb.filekit.exceptions.FileKitException
+import io.github.vinceglb.filekit.exists
+import io.github.vinceglb.filekit.path
+import io.github.vinceglb.filekit.write
+import kotlin.time.Clock
+import kotlinx.io.IOException
+
+/** Platform app-storage directory for workout photos; never a shared temp folder. */
+internal expect fun workoutPhotosDirectory(): String
+
+/**
+ * Writes picked workout photos into app storage and deletes them with their row.
+ * IO failures leave as [StorageException] so the ViewModel's guarded launch picks the tier.
+ */
+internal class WorkoutPhotoStore(private val directory: String) {
+
+    /** Copies the picked photo into app storage and returns its absolute path. */
+    suspend fun save(workoutId: Long, photo: PickedPhoto): String = storageCall {
+        val bytes = photo.readBytes()
+        val dir = PlatformFile(directory).apply { createDirectories() }
+        // Unique name, so a replacement never overwrites the file the row still points at.
+        val file = PlatformFile(dir, "workout-$workoutId-${Clock.System.now().toEpochMilliseconds()}")
+        file.write(bytes)
+        file.path
+    }
+
+    /** Deletes a stored photo; a file that is already gone is not a failure. */
+    suspend fun delete(path: String) = storageCall {
+        val file = PlatformFile(path)
+        if (file.exists()) file.delete()
+    }
+
+    private inline fun <T> storageCall(block: () -> T): T = try {
+        block()
+    } catch (e: IOException) {
+        throw StorageException(e)
+    } catch (e: FileKitException) {
+        throw StorageException(e)
+    }
+}
