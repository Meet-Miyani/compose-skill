+
+class WorkoutsCsvTest {
+    @Test fun `empty list writes header only`() {
+        assertEquals("id,title,body,updated_at,is_archived\r\n", emptyList<Workout>().toCsv())
+    }
+
+    @Test fun `plain fields are written as is and nulls as empty`() {
+        val csv = listOf(Workout(1, "Legs", null, null)).toCsv()
+        assertEquals("id,title,body,updated_at,is_archived\r\n1,Legs,,,false\r\n", csv)
+    }
+
+    @Test fun `commas quotes and newlines are quoted and escaped`() {
+        val csv = listOf(Workout(2, "Push, pull", "Say \"hi\"\nthen rest", null)).toCsv()
+        assertEquals(
+            "id,title,body,updated_at,is_archived\r\n" +
+                "2,\"Push, pull\",\"Say \"\"hi\"\"\nthen rest\",,false\r\n",
+            csv,
+        )
+    }
+}
