+package com.example.feature.workouts.data.export
+
+import android.os.Environment
+import com.example.core.error.StorageException
+import com.example.feature.workouts.data.local.workoutsAppContext
+import java.io.File
+import java.io.IOException
+
+// App-specific Documents dir: no storage permission needed; falls back to
+// internal storage when external storage is unavailable.
+internal actual fun platformExportFileWriter(): ExportFileWriter = ExportFileWriter { fileName, content ->
+    val directory = workoutsAppContext.getExternalFilesDir(Environment.DIRECTORY_DOCUMENTS)
+        ?: File(workoutsAppContext.filesDir, "exports")
+    try {
+        directory.mkdirs()
+        File(directory, fileName).apply { writeText(content) }.absolutePath
+    } catch (e: IOException) {
+        throw StorageException(e)
+    }
+}
