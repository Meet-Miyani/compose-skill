+++ b/feature/workouts/src/jvmMain/kotlin/com/example/feature/workouts/data/export/ExportFileWriter.jvm.kt
@@ -0,0 +1,18 @@
+package com.example.feature.workouts.data.export
+
+import com.example.core.error.StorageException
+import java.io.File
+import java.io.IOException
+
+// Downloads when present, otherwise next to the desktop database.
+internal actual fun platformExportFileWriter(): ExportFileWriter = ExportFileWriter { fileName, content ->
+    val home = System.getProperty("user.home")
+    val directory = File(home, "Downloads").takeIf(File::isDirectory)
+        ?: File(home, ".workouts-app/exports")
+    try {
+        directory.mkdirs()
+        File(directory, fileName).apply { writeText(content) }.absolutePath
+    } catch (e: IOException) {
+        throw StorageException(e)
+    }
+}
