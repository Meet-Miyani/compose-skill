+package com.example.feature.workouts.data.export
+
+import com.example.core.error.StorageException
+import com.example.feature.workouts.domain.export.WorkoutsExportStatus
+import com.example.feature.workouts.domain.model.Workout
+import com.example.feature.workouts.presentation.workouts.FakeWorkoutsRepository
+import kotlinx.coroutines.ExperimentalCoroutinesApi
+import kotlinx.coroutines.test.StandardTestDispatcher
+import kotlinx.coroutines.test.advanceUntilIdle
+import kotlinx.coroutines.test.runTest
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertTrue
+
+@OptIn(ExperimentalCoroutinesApi::class)
+class DefaultWorkoutsExporterTest {
+    private class RecordingWriter(private val failure: Exception? = null) : ExportFileWriter {
+        val writes = mutableListOf<Pair<String, String>>()
+        override fun write(fileName: String, content: String): String {
+            failure?.let { throw it }
+            writes += fileName to content
+            return "/exports/$fileName"
+        }
+    }
+
+    @Test fun `export writes every workout and reports done`() = runTest {
+        val repository = FakeWorkoutsRepository().apply {
+            seed(listOf(Workout(1, "Legs", "", null), Workout(2, "Arms", "", null)))
+        }
+        val writer = RecordingWriter()
+        val exporter = DefaultWorkoutsExporter(repository, writer, StandardTestDispatcher(testScheduler))
+
+        exporter.startExport()
+        assertEquals(WorkoutsExportStatus.Running, exporter.status.value)
+        advanceUntilIdle()
+
+        val (fileName, content) = writer.writes.single()
+        assertTrue(fileName.startsWith("workouts-") && fileName.endsWith(".csv"))
+        assertEquals(3, content.trimEnd().lines().size)
+        assertEquals(WorkoutsExportStatus.Done(path = "/exports/$fileName", count = 2), exporter.status.value)
+    }
+
+    @Test fun `start while running does not start a second export`() = runTest {
+        val writer = RecordingWriter()
+        val exporter = DefaultWorkoutsExporter(FakeWorkoutsRepository(), writer, StandardTestDispatcher(testScheduler))
+
+        exporter.startExport()
+        exporter.startExport()
+        advanceUntilIdle()
+
+        assertEquals(1, writer.writes.size)
+    }
+
+    @Test fun `storage failure reports failed and allows retry`() = runTest {
+        val exporter = DefaultWorkoutsExporter(
+            FakeWorkoutsRepository(),
+            RecordingWriter(failure = StorageException(IllegalStateException("disk full"))),
+            StandardTestDispatcher(testScheduler),
+        )
+
+        exporter.startExport()
+        advanceUntilIdle()
+        assertEquals(WorkoutsExportStatus.Failed, exporter.status.value)
+
+        exporter.startExport()
+        assertEquals(WorkoutsExportStatus.Running, exporter.status.value)
+    }
+}
