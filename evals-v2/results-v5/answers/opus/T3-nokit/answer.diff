+package com.example.feature.workouts.data.export
+
+import com.example.feature.workouts.domain.model.Workout
+
+private const val CSV_HEADER = "id,title,body,updated_at,is_archived"
+
+/** Renders workouts as RFC 4180 CSV with a header row and CRLF line endings. */
+internal fun List<Workout>.toCsv(): String = buildString {
+    append(CSV_HEADER).append("\r\n")
+    for (workout in this@toCsv) {
+        append(
+            listOf(
+                workout.id.toString(),
+                workout.title.orEmpty(),
+                workout.body.orEmpty(),
+                workout.updatedAt?.toString().orEmpty(),
+                workout.isArchived.toString(),
+            ).joinToString(",", transform = ::escapeCsvField),
+        )
+        append("\r\n")
+    }
+}
+
+private fun escapeCsvField(value: String): String =
+    if (value.any { it == ',' || it == '"' || it == '\n' || it == '\r' }) {
+        "\"" + value.replace("\"", "\"\"") + "\""
+    } else {
+        value
+    }
