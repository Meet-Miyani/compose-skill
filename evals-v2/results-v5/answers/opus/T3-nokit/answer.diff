+/**
+ * Export port owned by the Workouts domain.
+ *
+ * Exports run outside any screen, so the caller fires and forgets; the
+ * outcome is observed through [WorkoutsExporter.status].
+ */
+package com.example.feature.workouts.domain.export
+
+import kotlinx.coroutines.flow.StateFlow
+
+/**
+ * Background CSV export of every workout.
+ */
+public interface WorkoutsExporter {
+    /** Latest export outcome; survives the screen that started the export. */
+    public val status: StateFlow<WorkoutsExportStatus>
+
+    /**
+     * Starts an export in the background and returns immediately.
+     * No-op while an export is already running.
+     */
+    public fun startExport()
+}
+
+/** Lifecycle of the most recent export. */
+public sealed interface WorkoutsExportStatus {
+    public data object Idle : WorkoutsExportStatus
+    public data object Running : WorkoutsExportStatus
+    public data class Done(val path: String, val count: Int) : WorkoutsExportStatus
+    public data object Failed : WorkoutsExportStatus
+}
