+/**
+ * App-scoped CSV exporter for the Workouts feature.
+ *
+ * Runs on its own scope rather than a ViewModel's, so leaving the screen
+ * does not cancel an export in flight.
+ */
+package com.example.feature.workouts.data.export
+
+import com.example.core.error.StorageException
+import com.example.feature.workouts.domain.export.WorkoutsExportStatus
+import com.example.feature.workouts.domain.export.WorkoutsExporter
+import com.example.feature.workouts.domain.repository.WorkoutsRepository
+import kotlinx.coroutines.CoroutineDispatcher
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.flow.first
+import kotlinx.coroutines.launch
+import org.koin.core.annotation.Single
+import kotlin.time.Clock
+
+/**
+ * Default exporter: snapshots every workout and writes one CSV file.
+ */
+@Single
+internal class DefaultWorkoutsExporter(
+    private val repository: WorkoutsRepository,
+    private val fileWriter: ExportFileWriter,
+    // Inject the dispatcher; Default is the commonMain default across targets.
+    private val ioDispatcher: CoroutineDispatcher = Dispatchers.Default,
+) : WorkoutsExporter {
+
+    // Process-lifetime scope: the export outlives the screen that started it.
+    private val scope = CoroutineScope(SupervisorJob() + ioDispatcher)
+
+    private val _status = MutableStateFlow<WorkoutsExportStatus>(WorkoutsExportStatus.Idle)
+    override val status: StateFlow<WorkoutsExportStatus> = _status.asStateFlow()
+
+    override fun startExport() {
+        // Overlap guard: the running export owns the status; later starts return early.
+        while (true) {
+            val current = _status.value
+            if (current == WorkoutsExportStatus.Running) return
+            if (_status.compareAndSet(current, WorkoutsExportStatus.Running)) break
+        }
+        scope.launch {
+            _status.value = try {
+                val workouts = repository.getWorkoutsStream().first()
+                val fileName = "workouts-${Clock.System.now().toEpochMilliseconds()}.csv"
+                val path = fileWriter.write(fileName, workouts.toCsv())
+                WorkoutsExportStatus.Done(path = path, count = workouts.size)
+            } catch (e: StorageException) {
+                WorkoutsExportStatus.Failed
+            }
+        }
+    }
+}
