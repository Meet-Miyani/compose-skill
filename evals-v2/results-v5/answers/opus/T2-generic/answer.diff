diff --git a/feature/workouts/src/commonTest/kotlin/com/example/feature/workouts/presentation/type/WorkoutTypeViewModelTest.kt b/feature/workouts/src/commonTest/kotlin/com/example/feature/workouts/presentation/type/WorkoutTypeViewModelTest.kt
