+/**
+ * Stateless content for the workout type picker.
+ *
+ * Options are a radio group: selection is conveyed by the radio mark and
+ * screen-reader semantics, never by colour alone.
+ */
+package com.example.feature.workouts.presentation.type
+
+import androidx.compose.foundation.layout.Column
+import androidx.compose.foundation.layout.Row
+import androidx.compose.foundation.layout.fillMaxSize
+import androidx.compose.foundation.layout.fillMaxWidth
+import androidx.compose.foundation.layout.heightIn
+import androidx.compose.foundation.layout.padding
+import androidx.compose.foundation.selection.selectable
+import androidx.compose.foundation.selection.selectableGroup
+import androidx.compose.material3.Button
+import androidx.compose.material3.CircularProgressIndicator
+import androidx.compose.material3.MaterialTheme
+import androidx.compose.material3.RadioButton
+import androidx.compose.material3.Text
+import androidx.compose.runtime.Composable
+import androidx.compose.ui.Alignment
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.semantics.Role
+import androidx.compose.ui.semantics.heading
+import androidx.compose.ui.semantics.semantics
+import androidx.compose.ui.unit.dp
+import com.example.feature.workouts.domain.model.WorkoutType
+import org.jetbrains.compose.resources.stringResource
+import workouts.feature.workouts.generated.resources.Res
+import workouts.feature.workouts.generated.resources.back
+import workouts.feature.workouts.generated.resources.choose_workout_type
+import workouts.feature.workouts.generated.resources.error_message
+import workouts.feature.workouts.generated.resources.missing_workout
+import workouts.feature.workouts.generated.resources.retry
+
+@Composable
+fun WorkoutTypeScreen(
+    state: WorkoutTypeUiState,
+    onTypeClick: (WorkoutType) -> Unit,
+    onRetry: () -> Unit,
+    onBack: () -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    Column(modifier = modifier.fillMaxSize().padding(16.dp)) {
+        Text(
+            text = stringResource(Res.string.choose_workout_type),
+            style = MaterialTheme.typography.titleLarge,
+            modifier = Modifier.semantics { heading() },
+        )
+        when {
+            state.isLoading -> CircularProgressIndicator()
+            state.error != null -> {
+                Text(stringResource(Res.string.error_message))
+                Button(onClick = onRetry) { Text(stringResource(Res.string.retry)) }
+            }
+            state.isMissing -> Text(stringResource(Res.string.missing_workout))
+            else -> Column(Modifier.selectableGroup()) {
+                WorkoutType.entries.forEach { type ->
+                    WorkoutTypeOption(
+                        label = stringResource(type.labelRes),
+                        selected = type == state.selectedType,
+                        enabled = !state.isSaving,
+                        onClick = { onTypeClick(type) },
+                    )
+                }
+            }
+        }
+        Button(onClick = onBack) { Text(stringResource(Res.string.back)) }
+    }
+}
+
+@Composable
+private fun WorkoutTypeOption(label: String, selected: Boolean, enabled: Boolean, onClick: () -> Unit) {
+    // The whole row is one radio target, at least 56dp tall.
+    Row(
+        verticalAlignment = Alignment.CenterVertically,
+        modifier = Modifier
+            .fillMaxWidth()
+            .heightIn(min = 56.dp)
+            .selectable(selected = selected, enabled = enabled, role = Role.RadioButton, onClick = onClick),
+    ) {
+        RadioButton(selected = selected, onClick = null, enabled = enabled)
+        Text(text = label, modifier = Modifier.padding(start = 16.dp))
+    }
+}
