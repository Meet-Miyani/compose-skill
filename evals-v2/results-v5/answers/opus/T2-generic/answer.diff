+    val isLoading: Boolean = true,
+    val isSaving: Boolean = false,
+    val isMissing: Boolean = false,
+    val error: AppError? = null,
+) : UiState
+
+sealed interface WorkoutTypeUiAction : UiAction {
+    data object OnScreenStarted : WorkoutTypeUiAction
+    data class OnTypeClick(val type: WorkoutType) : WorkoutTypeUiAction
