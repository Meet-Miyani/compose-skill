@@ -0,0 +1,167 @@
+/**
+ * State-matrix tests for the workout type picker ViewModel.
+ */
+package com.example.feature.workouts.presentation.type
+
+import com.example.core.error.AppError
+import com.example.core.error.NetworkException
+import com.example.feature.workouts.domain.model.Workout
+import com.example.feature.workouts.domain.model.WorkoutType
+import com.example.feature.workouts.presentation.workouts.FakeWorkoutsRepository
+import kotlinx.coroutines.CompletableDeferred
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.ExperimentalCoroutinesApi
+import kotlinx.coroutines.flow.first
+import kotlinx.coroutines.flow.toList
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.test.StandardTestDispatcher
+import kotlinx.coroutines.test.TestCoroutineScheduler
+import kotlinx.coroutines.test.UnconfinedTestDispatcher
+import kotlinx.coroutines.test.advanceUntilIdle
+import kotlinx.coroutines.test.resetMain
+import kotlinx.coroutines.test.runTest
+import kotlinx.coroutines.test.setMain
+import kotlin.test.AfterTest
+import kotlin.test.BeforeTest
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertFalse
+import kotlin.test.assertNotNull
+import kotlin.test.assertNull
+import kotlin.test.assertTrue
+
+@OptIn(ExperimentalCoroutinesApi::class)
+class WorkoutTypeViewModelTest {
+    private val scheduler = TestCoroutineScheduler()
+
+    @BeforeTest fun setUp() { Dispatchers.setMain(StandardTestDispatcher(scheduler)) }
+    @AfterTest fun tearDown() { Dispatchers.resetMain() }
+
+    private fun fakeWith(type: WorkoutType? = null) =
+        FakeWorkoutsRepository().apply { seed(listOf(Workout(1L, "Run", "", null, type = type))) }
+
+    private fun viewModel(fake: FakeWorkoutsRepository, id: Long = 1L) = WorkoutTypeViewModel(
+        repository = fake,
+        params = WorkoutTypeParams(workoutId = id),
+        ioDispatcher = StandardTestDispatcher(scheduler),
+    )
+
+    @Test fun `load shows stored type`() = runTest(scheduler) {
+        val viewModel = viewModel(fakeWith(WorkoutType.Strength))
+        viewModel.onAction(WorkoutTypeUiAction.OnScreenStarted)
+        advanceUntilIdle()
+        assertFalse(viewModel.state.value.isLoading)
+        assertEquals(WorkoutType.Strength, viewModel.state.value.selectedType)
+    }
+
+    @Test fun `pick persists type and emits picked`() = runTest(scheduler) {
+        val fake = fakeWith()
+        val viewModel = viewModel(fake)
+        val effects = mutableListOf<WorkoutTypeUiEffect>()
+        backgroundScope.launch(UnconfinedTestDispatcher(scheduler)) { viewModel.effect.toList(effects) }
+        viewModel.onAction(WorkoutTypeUiAction.OnScreenStarted)
+        advanceUntilIdle()
+
+        viewModel.onAction(WorkoutTypeUiAction.OnTypeClick(WorkoutType.Cardio))
+        advanceUntilIdle()
+
+        assertEquals(WorkoutType.Cardio, fake.getWorkoutsStream().first().single().type)
+        assertEquals(WorkoutType.Cardio, viewModel.state.value.selectedType)
+        assertFalse(viewModel.state.value.isSaving)
+        assertEquals(listOf<WorkoutTypeUiEffect>(WorkoutTypeUiEffect.TypePicked), effects)
+    }
+
+    @Test fun `picking the current type skips the write`() = runTest(scheduler) {
+        val fake = fakeWith(WorkoutType.Flexibility)
+        val viewModel = viewModel(fake)
+        viewModel.onAction(WorkoutTypeUiAction.OnScreenStarted)
+        advanceUntilIdle()
+
+        viewModel.onAction(WorkoutTypeUiAction.OnTypeClick(WorkoutType.Flexibility))
+        advanceUntilIdle()
+
+        assertEquals(0, fake.setTypeCalls)
+    }
+
+    @Test fun `failed pick rolls back and shows error`() = runTest(scheduler) {
+        val fake = fakeWith(WorkoutType.Strength).apply { typeShouldThrow = NetworkException.Connection() }
+        val viewModel = viewModel(fake)
+        val effects = mutableListOf<WorkoutTypeUiEffect>()
+        val errors = mutableListOf<AppError>()
+        backgroundScope.launch(UnconfinedTestDispatcher(scheduler)) { viewModel.effect.toList(effects) }
+        backgroundScope.launch(UnconfinedTestDispatcher(scheduler)) { viewModel.errors.toList(errors) }
+        viewModel.onAction(WorkoutTypeUiAction.OnScreenStarted)
+        advanceUntilIdle()
+
+        viewModel.onAction(WorkoutTypeUiAction.OnTypeClick(WorkoutType.Cardio))
+        advanceUntilIdle()
+
+        assertEquals(WorkoutType.Strength, viewModel.state.value.selectedType)
+        assertFalse(viewModel.state.value.isSaving)
+        assertEquals(1, errors.size)
+        assertTrue(effects.isEmpty())
+    }
+
+    @Test fun `double tap makes one write`() = runTest(scheduler) {
+        val fake = fakeWith()
+        val viewModel = viewModel(fake)
+        viewModel.onAction(WorkoutTypeUiAction.OnScreenStarted)
+        advanceUntilIdle()
+
+        val gate = CompletableDeferred<Unit>().also { fake.gate = it }
+        viewModel.onAction(WorkoutTypeUiAction.OnTypeClick(WorkoutType.Cardio))
+        advanceUntilIdle()
+        assertTrue(viewModel.state.value.isSaving)
+        viewModel.onAction(WorkoutTypeUiAction.OnTypeClick(WorkoutType.Strength))
+        gate.complete(Unit)
+        advanceUntilIdle()
+
+        assertEquals(1, fake.setTypeCalls)
+        assertEquals(WorkoutType.Cardio, viewModel.state.value.selectedType)
+    }
+
+    @Test fun `pick before load is ignored`() = runTest(scheduler) {
+        val fake = fakeWith()
+        val viewModel = viewModel(fake)
+        viewModel.onAction(WorkoutTypeUiAction.OnTypeClick(WorkoutType.Cardio))
+        advanceUntilIdle()
+        assertEquals(0, fake.setTypeCalls)
+    }
+
+    @Test fun `missing workout sets isMissing and ignores picks`() = runTest(scheduler) {
+        val fake = fakeWith()
+        val viewModel = viewModel(fake, id = 99L)
+        viewModel.onAction(WorkoutTypeUiAction.OnScreenStarted)
+        advanceUntilIdle()
+        viewModel.onAction(WorkoutTypeUiAction.OnTypeClick(WorkoutType.Cardio))
+        advanceUntilIdle()
+
+        assertTrue(viewModel.state.value.isMissing)
+        assertEquals(0, fake.setTypeCalls)
+    }
+
+    @Test fun `load error is inline and retry recovers`() = runTest(scheduler) {
+        val fake = fakeWith(WorkoutType.Cardio).apply { shouldThrow = NetworkException.Connection() }
+        val viewModel = viewModel(fake)
+        viewModel.onAction(WorkoutTypeUiAction.OnScreenStarted)
+        advanceUntilIdle()
+        assertNotNull(viewModel.state.value.error)
+        assertFalse(viewModel.state.value.isLoading)
+
+        fake.shouldThrow = null
+        viewModel.onAction(WorkoutTypeUiAction.OnRetryClick)
+        advanceUntilIdle()
+
+        assertNull(viewModel.state.value.error)
+        assertEquals(WorkoutType.Cardio, viewModel.state.value.selectedType)
+    }
+
+    @Test fun `back emits navigate back`() = runTest(scheduler) {
+        val viewModel = viewModel(fakeWith())
+        val effects = mutableListOf<WorkoutTypeUiEffect>()
+        backgroundScope.launch(UnconfinedTestDispatcher(scheduler)) { viewModel.effect.toList(effects) }
+        viewModel.onAction(WorkoutTypeUiAction.OnBackClick)
+        advanceUntilIdle()
+        assertEquals(listOf<WorkoutTypeUiEffect>(WorkoutTypeUiEffect.NavigateBack), effects)
+    }
+}
