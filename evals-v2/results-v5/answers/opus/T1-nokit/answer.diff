+package com.example.feature.workouts.data.local
+
+import com.example.core.error.StorageException
+import io.github.vinceglb.filekit.PlatformFile
+import io.github.vinceglb.filekit.createDirectories
+import io.github.vinceglb.filekit.delete
+import io.github.vinceglb.filekit.path
+import io.github.vinceglb.filekit.write
+import kotlinx.io.IOException
+import org.koin.core.annotation.Factory
+import kotlin.time.Clock
+
+/** App-private directory that holds attached workout photos; lives next to the database. */
+internal expect fun workoutPhotosDirectory(): String
+
+/**
+ * Writes workout photos into app-private storage. IO failures surface as
+ * [StorageException] so the ViewModel reports them instead of crashing.
+ */
+@Factory
+internal class WorkoutPhotoStorage {
+    /** Writes what [readPhoto] yields to a new file for the workout and returns its absolute path. */
+    suspend fun save(workoutId: Long, readPhoto: suspend () -> ByteArray): String = storageIo {
+        val bytes = readPhoto()
+        val directory = PlatformFile(workoutPhotosDirectory()).apply { createDirectories() }
+        // Timestamped so a replacement never overwrites the file the UI is still showing.
+        val file = PlatformFile(directory, "workout_${workoutId}_${Clock.System.now().toEpochMilliseconds()}")
+        file.write(bytes)
+        file.path
+    }
+
+    /** Deletes a stored photo; a file that is already gone is not an error. */
+    suspend fun delete(path: String) = storageIo {
+        PlatformFile(path).delete(mustExist = false)
+    }
+
+    private suspend fun <T> storageIo(block: suspend () -> T): T =
+        try {
+            block()
+        } catch (e: IOException) {
+            throw StorageException(e)
+        }
+}
