+    @Test
+    fun `typing title saves to savedStateHandle and survives screen restart`() = runTest(testScheduler) {
+        val fake = FakeWorkoutsRepository().apply { seed(listOf(workout())) }
+        val handle = SavedStateHandle()
+        val viewModel = viewModel(fake, handle = handle)
+
+        viewModel.onAction(WorkoutsUiAction.OnScreenStarted)
+        advanceUntilIdle()
+        assertEquals("Title", viewModel.state.value.draftTitle)
+
+        viewModel.onAction(WorkoutsUiAction.OnTitleChanged("Typed draft"))
+        assertEquals("Typed draft", handle["draftTitle"])
+        assertEquals("Typed draft", viewModel.state.value.draftTitle)
+
+        // Simulating app switch / lifecycle restart:
+        viewModel.onAction(WorkoutsUiAction.OnScreenStarted)
+        advanceUntilIdle()
+
+        assertEquals("Typed draft", viewModel.state.value.draftTitle)
+    }
