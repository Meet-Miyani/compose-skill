+package com.example.feature.workouts.presentation.list
+
+import androidx.lifecycle.SavedStateHandle
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.ExperimentalCoroutinesApi
+import kotlinx.coroutines.test.StandardTestDispatcher
+import kotlinx.coroutines.test.TestCoroutineScheduler
+import kotlinx.coroutines.test.advanceUntilIdle
+import kotlinx.coroutines.test.resetMain
+import kotlinx.coroutines.test.runTest
+import kotlinx.coroutines.test.setMain
+import kotlin.test.AfterTest
+import kotlin.test.BeforeTest
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertFalse
+
+@OptIn(ExperimentalCoroutinesApi::class)
+class QuickAddViewModelTest {
+    private val scheduler = TestCoroutineScheduler()
+
+    @BeforeTest
+    fun setUp() {
+        Dispatchers.setMain(StandardTestDispatcher(scheduler))
+    }
+
+    @AfterTest
+    fun tearDown() {
+        Dispatchers.resetMain()
+    }
+
+    @Test
+    fun `initial state has empty text and not loading`() {
+        val viewModel = QuickAddViewModel()
+        assertEquals("", viewModel.state.value.text)
+        assertEquals("", viewModel.state.value.workoutName)
+        assertFalse(viewModel.state.value.isLoading)
+    }
+
+    @Test
+    fun `onTextChanged updates state text`() {
+        val viewModel = QuickAddViewModel()
+        viewModel.onAction(QuickAddUiAction.OnTextChanged("Bench Press"))
+        assertEquals("Bench Press", viewModel.state.value.text)
+        assertEquals("Bench Press", viewModel.state.value.workoutName)
+    }
+
+    @Test
+    fun `onWorkoutNameChanged updates state text`() {
+        val viewModel = QuickAddViewModel()
+        viewModel.onAction(QuickAddUiAction.OnWorkoutNameChanged("Squats"))
+        assertEquals("Squats", viewModel.state.value.text)
+    }
+
+    @Test
+    fun `onAddClick sets loading then completes and clears input`() = runTest(scheduler) {
+        val viewModel = QuickAddViewModel()
+        viewModel.onAction(QuickAddUiAction.OnTextChanged("Deadlift"))
+        assertEquals("Deadlift", viewModel.state.value.text)
+
+        viewModel.onAction(QuickAddUiAction.OnAddClick)
+        advanceUntilIdle()
+
+        assertFalse(viewModel.state.value.isLoading)
+        assertEquals("", viewModel.state.value.text)
+    }
+
+    @Test
+    fun `onAddClicked with workout name updates text then clears input`() = runTest(scheduler) {
+        val viewModel = QuickAddViewModel()
+        viewModel.onAction(QuickAddUiAction.OnAddClicked("Pullups"))
+        advanceUntilIdle()
+
+        assertFalse(viewModel.state.value.isLoading)
+        assertEquals("", viewModel.state.value.text)
+    }
+
+    @Test
+    fun `overlapping add clicks are guarded`() = runTest(scheduler) {
+        val viewModel = QuickAddViewModel()
+        viewModel.onAction(QuickAddUiAction.OnTextChanged("Running"))
+        viewModel.onAction(QuickAddUiAction.OnAddClick)
+        viewModel.onAction(QuickAddUiAction.OnAddClick)
+        advanceUntilIdle()
+
+        assertFalse(viewModel.state.value.isLoading)
+        assertEquals("", viewModel.state.value.text)
+    }
+
+    @Test
+    fun `process death restores draft text`() {
+        val handle = SavedStateHandle().apply {
+            set("text", "Overhead Press")
+        }
+        val viewModel = QuickAddViewModel(handle)
+        assertEquals("Overhead Press", viewModel.state.value.text)
+    }
+}
