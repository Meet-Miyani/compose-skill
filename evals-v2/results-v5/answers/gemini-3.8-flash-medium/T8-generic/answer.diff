+package com.example.feature.workouts.presentation.list
+
+import androidx.lifecycle.SavedStateHandle
+import com.example.core.mvi.BaseViewModel
+import kotlinx.coroutines.Job
+import org.koin.core.annotation.KoinViewModel
+
+@KoinViewModel
+class QuickAddViewModel(
+    private val savedStateHandle: SavedStateHandle = SavedStateHandle(),
+) : BaseViewModel<QuickAddUiAction, QuickAddUiState, QuickAddUiEffect>(
+    QuickAddUiState(text = savedStateHandle["text"] ?: savedStateHandle["workoutName"] ?: ""),
+) {
+    private var addJob: Job? = null
+
+    override fun onAction(action: QuickAddUiAction) {
+        when (action) {
+            is QuickAddUiAction.OnTextChanged -> onTextChanged(action.text)
+            is QuickAddUiAction.OnWorkoutNameChanged -> onTextChanged(action.name)
+            QuickAddUiAction.OnAddClick -> addWorkout()
+            is QuickAddUiAction.OnAddClicked -> {
+                onTextChanged(action.workoutName)
+                addWorkout()
+            }
+        }
+    }
+
+    private fun onTextChanged(text: String) {
+        savedStateHandle["text"] = text
+        savedStateHandle["workoutName"] = text
+        updateState { copy(text = text) }
+    }
+
+    private fun addWorkout() {
+        if (addJob?.isActive == true) return
+        addJob = launchGuarded(
+            onError = ::emitError,
+            onStart = { updateState { copy(isLoading = true) } },
+            onComplete = { updateState { copy(isLoading = false) } },
+        ) {
+            // save logic...
+            savedStateHandle["text"] = ""
+            savedStateHandle["workoutName"] = ""
+            updateState { copy(text = "") }
+        }
+    }
+}
