+package com.example.feature.workouts.presentation.workouts
+
+import com.example.feature.workouts.presentation.list.QuickAddUiAction
+import com.example.feature.workouts.presentation.list.QuickAddViewModel
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.ExperimentalCoroutinesApi
+import kotlinx.coroutines.test.StandardTestDispatcher
+import kotlinx.coroutines.test.TestCoroutineScheduler
+import kotlinx.coroutines.test.resetMain
+import kotlinx.coroutines.test.setMain
+import kotlin.test.AfterTest
+import kotlin.test.BeforeTest
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertFalse
+
+@OptIn(ExperimentalCoroutinesApi::class)
+class QuickAddViewModelTest {
+    private val scheduler = TestCoroutineScheduler()
+
+    @BeforeTest
+    fun setUp() {
+        Dispatchers.setMain(StandardTestDispatcher(scheduler))
+    }
+
+    @AfterTest
+    fun tearDown() {
+        Dispatchers.resetMain()
+    }
+
+    @Test
+    fun `initial state has empty text and not loading`() {
+        val viewModel = QuickAddViewModel()
+        assertEquals("", viewModel.state.value.text)
+        assertEquals("", viewModel.state.value.workoutName)
+        assertFalse(viewModel.state.value.isLoading)
+    }
+
+    @Test
+    fun `on text changed updates state`() {
+        val viewModel = QuickAddViewModel()
+        viewModel.onAction(QuickAddUiAction.OnTextChanged("Bench Press"))
+        assertEquals("Bench Press", viewModel.state.value.text)
+    }
+
+    @Test
+    fun `on title changed updates state`() {
+        val viewModel = QuickAddViewModel()
+        viewModel.onAction(QuickAddUiAction.OnTitleChanged("Bench Press"))
+        assertEquals("Bench Press", viewModel.state.value.text)
+    }
+
+    @Test
+    fun `on add clicked clears text and finishes loading`() {
+        val viewModel = QuickAddViewModel()
+        viewModel.onAction(QuickAddUiAction.OnTextChanged("Bench Press"))
+        viewModel.onAction(QuickAddUiAction.OnAddClicked("Bench Press"))
+        assertEquals("", viewModel.state.value.text)
+        assertFalse(viewModel.state.value.isLoading)
+    }
+
+    @Test
+    fun `on add click clears text and finishes loading`() {
+        val viewModel = QuickAddViewModel()
+        viewModel.onAction(QuickAddUiAction.OnTextChanged("Bench Press"))
+        viewModel.onAction(QuickAddUiAction.OnAddClick)
+        assertEquals("", viewModel.state.value.text)
+        assertFalse(viewModel.state.value.isLoading)
+    }
+}
