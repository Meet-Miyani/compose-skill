+package com.example.feature.workouts.presentation.list
+
+import com.example.core.mvi.BaseViewModel
+import org.koin.core.annotation.KoinViewModel
+
+@KoinViewModel
+class QuickAddViewModel :
+    BaseViewModel<QuickAddUiAction, QuickAddUiState, QuickAddUiEffect>(QuickAddUiState()) {
+
+    override fun onAction(action: QuickAddUiAction) {
+        when (action) {
+            is QuickAddUiAction.OnTextChanged -> updateState { copy(text = action.text) }
+            is QuickAddUiAction.OnTitleChanged -> updateState { copy(text = action.title) }
+            is QuickAddUiAction.OnAddClicked -> addWorkout(action.workoutName)
+            QuickAddUiAction.OnAddClick -> addWorkout(currentState.text)
+        }
+    }
+
+    private fun addWorkout(workoutName: String) {
+        updateState { copy(isLoading = true) }
+        // save logic...
+        updateState { copy(isLoading = false, text = "") }
+    }
+}
