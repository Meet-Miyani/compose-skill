+@OptIn(ExperimentalCoroutinesApi::class)
+class WorkoutTypeViewModelTest {
+    private val testScheduler = TestCoroutineScheduler()
+    private val mainDispatcher = StandardTestDispatcher(testScheduler)
+
+    @BeforeTest
+    fun setUp() {
+        Dispatchers.setMain(mainDispatcher)
+    }
+
+    @AfterTest
+    fun tearDown() {
+        Dispatchers.resetMain()
+    }
+
+    private fun workout(id: Long = 1L, type: WorkoutType? = WorkoutType.Cardio): Workout = Workout(
+        id = id,
+        title = "Title",
+        body = "Body",
+        updatedAt = Clock.System.now(),
+        type = type,
+    )
+
+    private fun viewModel(
+        fake: FakeWorkoutsRepository,
+        handle: SavedStateHandle = SavedStateHandle(),
+        id: Long = 1L,
+        ioDispatcher: CoroutineDispatcher = StandardTestDispatcher(testScheduler),
+    ): WorkoutTypeViewModel = WorkoutTypeViewModel(
+        repository = fake,
+        params = WorkoutTypeParams(workoutId = id),
+        savedStateHandle = handle,
+        ioDispatcher = ioDispatcher,
+    )
+
+    @Test
+    fun `cold load shows initial type`() = runTest(testScheduler) {
+        val fake = FakeWorkoutsRepository().apply { seed(listOf(workout(type = WorkoutType.Strength))) }
+        val viewModel = viewModel(fake)
+        val gate = CompletableDeferred<Unit>().also { fake.gate = it }
+
+        viewModel.onAction(WorkoutTypeUiAction.OnScreenStarted)
+        advanceUntilIdle()
+        assertTrue(viewModel.state.value.isLoading)
+
+        gate.complete(Unit)
+        advanceUntilIdle()
+
+        assertEquals(WorkoutType.Strength, viewModel.state.value.initialType)
+        assertEquals(WorkoutType.Strength, viewModel.state.value.selectedType)
+        assertFalse(viewModel.state.value.isLoading)
+    }
+
+    @Test
+    fun `select type updates draft and state`() = runTest(testScheduler) {
+        val fake = FakeWorkoutsRepository().apply { seed(listOf(workout(type = WorkoutType.Cardio))) }
+        val handle = SavedStateHandle()
+        val viewModel = viewModel(fake, handle = handle)
+
+        viewModel.onAction(WorkoutTypeUiAction.OnScreenStarted)
+        advanceUntilIdle()
+
+        viewModel.onAction(WorkoutTypeUiAction.OnTypeSelected(WorkoutType.Flexibility))
+        advanceUntilIdle()
+
+        assertEquals(WorkoutType.Flexibility, viewModel.state.value.selectedType)
+        assertEquals("Flexibility", handle.get<String>("selectedType"))
+    }
+
+    @Test
+    fun `save persists selected type to repository and sends Saved effect`() = runTest(testScheduler) {
+        val fake = FakeWorkoutsRepository().apply { seed(listOf(workout(id = 1L, type = WorkoutType.Cardio))) }
+        val viewModel = viewModel(fake)
+        val effects = mutableListOf<UiEffect>()
+        backgroundScope.launch(UnconfinedTestDispatcher(testScheduler)) { viewModel.effect.toList(effects) }
+
+        viewModel.onAction(WorkoutTypeUiAction.OnScreenStarted)
+        advanceUntilIdle()
+
+        viewModel.onAction(WorkoutTypeUiAction.OnTypeSelected(WorkoutType.Strength))
+        viewModel.onAction(WorkoutTypeUiAction.OnSaveClick)
+        advanceUntilIdle()
+
+        assertEquals(1L to WorkoutType.Strength, fake.lastSavedType)
+        assertEquals(1, fake.saveTypeCalls)
+        assertEquals(listOf<UiEffect>(WorkoutTypeUiEffect.Saved), effects)
+    }
+
+    @Test
+    fun `double save makes one repository write`() = runTest(testScheduler) {
+        val fake = FakeWorkoutsRepository().apply { seed(listOf(workout())) }
+        val viewModel = viewModel(fake)
+
+        viewModel.onAction(WorkoutTypeUiAction.OnTypeSelected(WorkoutType.Cardio))
+        viewModel.onAction(WorkoutTypeUiAction.OnSaveClick)
+        viewModel.onAction(WorkoutTypeUiAction.OnSaveClick)
+        advanceUntilIdle()
+
+        assertEquals(1, fake.saveTypeCalls)
+    }
+
+    @Test
+    fun `inline error on throw then retry succeeds`() = runTest(testScheduler) {
+        val fake = FakeWorkoutsRepository().apply { shouldThrow = NetworkException.Connection() }
+        val viewModel = viewModel(fake)
+
+        viewModel.onAction(WorkoutTypeUiAction.OnScreenStarted)
+        advanceUntilIdle()
+
+        assertNotNull(viewModel.state.value.error)
+        assertNull(viewModel.state.value.initialType)
+
+        fake.shouldThrow = null
+        fake.seed(listOf(workout(type = WorkoutType.Flexibility)))
+        viewModel.onAction(WorkoutTypeUiAction.OnRetryClick(viewModel.state.value.error!!))
+        advanceUntilIdle()
+
+        assertNull(viewModel.state.value.error)
+        assertEquals(WorkoutType.Flexibility, viewModel.state.value.selectedType)
+    }
+
+    @Test
+    fun `not found sets isMissing with no AppError`() = runTest(testScheduler) {
+        val fake = FakeWorkoutsRepository().apply { seed(listOf(workout(id = 2L))) }
+        val viewModel = viewModel(fake, id = 1L)
+
+        viewModel.onAction(WorkoutTypeUiAction.OnScreenStarted)
+        advanceUntilIdle()
+
+        assertTrue(viewModel.state.value.isMissing)
+        assertNull(viewModel.state.value.error)
+    }
+
+    @Test
+    fun `back click sends NavigateBack effect`() = runTest(testScheduler) {
+        val fake = FakeWorkoutsRepository()
+        val viewModel = viewModel(fake)
+        val effects = mutableListOf<UiEffect>()
+        backgroundScope.launch(UnconfinedTestDispatcher(testScheduler)) { viewModel.effect.toList(effects) }
+
+        viewModel.onAction(WorkoutTypeUiAction.OnBackClick)
+        advanceUntilIdle()
+
+        assertEquals(listOf<UiEffect>(WorkoutTypeUiEffect.NavigateBack), effects)
+    }
+
+    @Test
+    fun `process death restores selected draft type`() = runTest(testScheduler) {
+        val fake = FakeWorkoutsRepository().apply { seed(listOf(workout(type = WorkoutType.Cardio))) }
+        val handle = SavedStateHandle()
+        handle["selectedType"] = "Strength"
+        val viewModel = viewModel(fake, handle = handle)
+
+        assertEquals(WorkoutType.Strength, viewModel.state.value.selectedType)
+
+        viewModel.onAction(WorkoutTypeUiAction.OnScreenStarted)
+        advanceUntilIdle()
+
+        assertEquals(WorkoutType.Strength, viewModel.state.value.selectedType)
+        assertEquals(WorkoutType.Cardio, viewModel.state.value.initialType)
+    }
+}
