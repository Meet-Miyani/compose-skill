+ * saves the chosen type through the repository.
+ */
+package com.example.feature.workouts.presentation.type
+
+import androidx.lifecycle.SavedStateHandle
+import com.example.core.mvi.BaseViewModel
+import com.example.feature.workouts.domain.model.WorkoutType
+import com.example.feature.workouts.domain.repository.WorkoutsRepository
+import kotlinx.coroutines.CoroutineDispatcher
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.withContext
+import org.koin.core.annotation.InjectedParam
+import org.koin.core.annotation.KoinViewModel
+
+/** Construction bag for the destination's nav arguments. Top-level so entries and tests share it. */
+data class WorkoutTypeParams(val workoutId: Long)
+
+/** ViewModel behind the WorkoutType destination; owns selection state and persistence. */
+@KoinViewModel
+class WorkoutTypeViewModel(
+    private val repository: WorkoutsRepository,
+    @InjectedParam private val params: WorkoutTypeParams,
+    private val savedStateHandle: SavedStateHandle,
+    private val ioDispatcher: CoroutineDispatcher = Dispatchers.Default,
+) : BaseViewModel<WorkoutTypeUiAction, WorkoutTypeUiState, WorkoutTypeUiEffect>(
+    WorkoutTypeUiState(
+        selectedType = savedStateHandle.get<String>("selectedType")?.let {
+            runCatching { WorkoutType.valueOf(it) }.getOrNull()
+        },
+    ),
+) {
+    private var loadJob: Job? = null
+    private var saveJob: Job? = null
+    private var hasStarted: Boolean = false
+
+    override fun onAction(action: WorkoutTypeUiAction) {
+        when (action) {
+            WorkoutTypeUiAction.OnScreenStarted -> load()
+            is WorkoutTypeUiAction.OnTypeSelected -> {
+                savedStateHandle["selectedType"] = action.type.name
+                updateState { copy(selectedType = action.type) }
+            }
+            WorkoutTypeUiAction.OnSaveClick -> save()
+            is WorkoutTypeUiAction.OnRetryClick -> retry()
+            WorkoutTypeUiAction.OnBackClick -> sendEffect(WorkoutTypeUiEffect.NavigateBack)
+        }
+    }
+
+    private fun load() {
+        if (loadJob?.isActive == true) return
+        loadJob = launchGuarded(
+            onError = { error ->
+                if (hasStarted) emitError(error) else updateState { copy(error = error) }
+            },
+            onStart = { updateState { copy(isLoading = !hasStarted, isRefreshing = hasStarted) } },
+            onComplete = { updateState { copy(isLoading = false, isRefreshing = false) } },
+        ) {
+            val item = withContext(ioDispatcher) { repository.getWorkout(params.workoutId) }
+            val draftTypeName = savedStateHandle.get<String>("selectedType")
+            val effectiveSelected = if (draftTypeName != null) {
+                runCatching { WorkoutType.valueOf(draftTypeName) }.getOrNull()
+            } else {
+                item?.type
+            }
+            updateState {
+                copy(
+                    isLoading = false,
+                    isRefreshing = false,
+                    isMissing = item == null,
+                    initialType = item?.type,
+                    selectedType = effectiveSelected,
+                )
+            }
+            hasStarted = true
+        }
+    }
+
+    private fun save() {
+        if (saveJob?.isActive == true) return
+        val typeToSave = currentState.selectedType ?: return
+        saveJob = launchGuarded(onError = ::emitError) {
+            withContext(ioDispatcher) {
+                repository.saveWorkoutType(params.workoutId, typeToSave)
+            }
+            sendEffect(WorkoutTypeUiEffect.Saved)
+        }
+    }
+
+    private fun retry() {
+        updateState { copy(error = null) }
+        load()
+    }
+}
