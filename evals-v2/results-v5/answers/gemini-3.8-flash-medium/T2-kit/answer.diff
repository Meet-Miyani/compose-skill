+/**
+ * Stateless content for the WorkoutType destination.
+ *
+ * Renders selection state only. Every UiState field is read below.
+ */
+package com.example.feature.workouts.presentation.type
+
+import androidx.compose.foundation.layout.Column
+import androidx.compose.foundation.layout.Row
+import androidx.compose.foundation.layout.fillMaxSize
+import androidx.compose.foundation.layout.fillMaxWidth
+import androidx.compose.foundation.layout.padding
+import androidx.compose.foundation.selection.selectable
+import androidx.compose.foundation.selection.selectableGroup
+import androidx.compose.material3.Button
+import androidx.compose.material3.CircularProgressIndicator
+import androidx.compose.material3.MaterialTheme
+import androidx.compose.material3.RadioButton
+import androidx.compose.material3.Text
+import androidx.compose.runtime.Composable
+import androidx.compose.ui.Alignment
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.semantics.Role
+import androidx.compose.ui.unit.dp
+import com.example.feature.workouts.domain.model.WorkoutType
+import org.jetbrains.compose.resources.stringResource
+import workouts.feature.workouts.generated.resources.Res
+import workouts.feature.workouts.generated.resources.back
+import workouts.feature.workouts.generated.resources.error_message
+import workouts.feature.workouts.generated.resources.missing_workout
+import workouts.feature.workouts.generated.resources.refreshing
+import workouts.feature.workouts.generated.resources.retry
+import workouts.feature.workouts.generated.resources.save
+import workouts.feature.workouts.generated.resources.workout_type_cardio
+import workouts.feature.workouts.generated.resources.workout_type_flexibility
+import workouts.feature.workouts.generated.resources.workout_type_strength
+import workouts.feature.workouts.generated.resources.workout_type_title
+
+@Composable
+fun WorkoutTypeScreen(
+    state: WorkoutTypeUiState,
+    onTypeSelect: (WorkoutType) -> Unit,
+    onSave: () -> Unit,
+    onRetry: () -> Unit,
+    onBack: () -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    when {
+        state.isLoading -> CircularProgressIndicator(modifier = modifier)
+        state.error != null && state.initialType == null -> Column(modifier = modifier.padding(16.dp)) {
+            Text(stringResource(Res.string.error_message))
+            Button(onClick = onRetry) { Text(stringResource(Res.string.retry)) }
+            Button(onClick = onBack) { Text(stringResource(Res.string.back)) }
+        }
+        state.isMissing -> Column(modifier = modifier.padding(16.dp)) {
+            Text(stringResource(Res.string.missing_workout))
+            Button(onClick = onBack) { Text(stringResource(Res.string.back)) }
+        }
+        else -> Column(modifier = modifier.fillMaxSize().padding(16.dp)) {
+            if (state.isRefreshing) {
+                Text(stringResource(Res.string.refreshing))
+            }
+            Text(
+                text = stringResource(Res.string.workout_type_title),
+                style = MaterialTheme.typography.titleLarge,
+                modifier = Modifier.padding(bottom = 16.dp),
+            )
+            Column(modifier = Modifier.selectableGroup()) {
+                val types = listOf(
+                    WorkoutType.Cardio to Res.string.workout_type_cardio,
+                    WorkoutType.Strength to Res.string.workout_type_strength,
+                    WorkoutType.Flexibility to Res.string.workout_type_flexibility,
+                )
+                types.forEach { (type, labelRes) ->
+                    val isSelected = state.selectedType == type
+                    Row(
+                        modifier = Modifier
+                            .fillMaxWidth()
+                            .selectable(
+                                selected = isSelected,
+                                onClick = { onTypeSelect(type) },
+                                role = Role.RadioButton,
+                            )
+                            .padding(vertical = 12.dp),
+                        verticalAlignment = Alignment.CenterVertically,
+                    ) {
+                        RadioButton(
+                            selected = isSelected,
+                            onClick = null,
+                        )
+                        Text(
+                            text = stringResource(labelRes),
+                            style = MaterialTheme.typography.bodyLarge,
+                            modifier = Modifier.padding(start = 12.dp),
+                        )
+                    }
+                }
+            }
+            Button(
+                onClick = onSave,
+                enabled = state.selectedType != null,
+                modifier = Modifier.padding(top = 16.dp),
+            ) {
+                Text(stringResource(Res.string.save))
+            }
+            Button(onClick = onBack, modifier = Modifier.padding(top = 8.dp)) {
+                Text(stringResource(Res.string.back))
+            }
+        }
+    }
+}
