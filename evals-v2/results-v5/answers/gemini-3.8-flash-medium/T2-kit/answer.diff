+/**
+ * Lifecycle-aware wrapper for the WorkoutType destination.
+ *
+ * Koin-free: the composition root resolves the ViewModel and passes it in.
+ * This wrapper owns lifecycle, effect collection, and error forwarding only.
+ */
+package com.example.feature.workouts.presentation.type
+
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.getValue
+import androidx.lifecycle.compose.LifecycleStartEffect
+import androidx.lifecycle.compose.collectAsStateWithLifecycle
+import com.example.core.mvi.CollectEffect
+import com.example.designsystem.error.HandleAppErrors
+
+/** Entry for the WorkoutType destination; owns lifecycle, effect collection, and error forwarding. */
+@Composable
+fun WorkoutTypeRoute(
+    viewModel: WorkoutTypeViewModel,
+    workoutId: Long,
+    onEffect: suspend (WorkoutTypeUiEffect) -> Unit,
+) {
+    LifecycleStartEffect(workoutId) {
+        viewModel.onAction(WorkoutTypeUiAction.OnScreenStarted)
+        onStopOrDispose {}
+    }
+    val state by viewModel.state.collectAsStateWithLifecycle()
+    CollectEffect(viewModel.effect) { effect -> onEffect(effect) }
+    HandleAppErrors(viewModel.errors)
+    WorkoutTypeScreen(
+        state = state,
+        onTypeSelect = { viewModel.onAction(WorkoutTypeUiAction.OnTypeSelected(it)) },
+        onSave = { viewModel.onAction(WorkoutTypeUiAction.OnSaveClick) },
+        onRetry = {
+            viewModel.onAction(WorkoutTypeUiAction.OnRetryClick(state.error ?: return@WorkoutTypeScreen))
+        },
+        onBack = { viewModel.onAction(WorkoutTypeUiAction.OnBackClick) },
+    )
+}
