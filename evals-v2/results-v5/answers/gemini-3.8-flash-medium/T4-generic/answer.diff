+
+    @Test
+    fun `typing title updates savedStateHandle`() = runTest(testScheduler) {
+        val fake = FakeWorkoutsRepository().apply { seed(listOf(workout())) }
+        val handle = SavedStateHandle()
+        val viewModel = viewModel(fake, handle = handle)
+
+        viewModel.onAction(WorkoutsUiAction.OnTitleChanged("user typed text"))
+
+        assertEquals("user typed text", handle["draftTitle"])
+    }
+
+    @Test
+    fun `typed text survives app switch and reload`() = runTest(testScheduler) {
+        val fake = FakeWorkoutsRepository().apply { seed(listOf(workout().copy(title = "Original Title"))) }
+        val handle = SavedStateHandle()
+        val viewModel = viewModel(fake, handle = handle)
+
+        viewModel.onAction(WorkoutsUiAction.OnScreenStarted)
+        advanceUntilIdle()
+        assertEquals("Original Title", viewModel.state.value.draftTitle)
+
+        viewModel.onAction(WorkoutsUiAction.OnTitleChanged("Modified Title"))
+        assertEquals("Modified Title", viewModel.state.value.draftTitle)
+
+        // Simulating app switch and return: LifecycleStartEffect triggers OnScreenStarted
+        viewModel.onAction(WorkoutsUiAction.OnScreenStarted)
+        advanceUntilIdle()
+
+        assertEquals("Modified Title", viewModel.state.value.draftTitle)
+        assertEquals("Modified Title", handle["draftTitle"])
+    }
