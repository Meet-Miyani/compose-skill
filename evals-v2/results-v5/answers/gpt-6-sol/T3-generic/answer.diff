+package com.example.feature.workouts.domain.export
+
+import android.content.Context
+import android.content.Intent
+import androidx.core.content.FileProvider
+import androidx.work.CoroutineWorker
+import androidx.work.ExistingWorkPolicy
+import androidx.work.OneTimeWorkRequestBuilder
+import androidx.work.WorkInfo
+import androidx.work.WorkManager
+import androidx.work.WorkerParameters
+import androidx.work.workDataOf
+import com.example.feature.workouts.data.local.createWorkoutsDatabase
+import com.example.feature.workouts.data.local.toDomain
+import com.example.feature.workouts.data.local.workoutsApplicationContext
+import com.example.feature.workouts.domain.repository.WorkoutsRepository
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.flow.Flow
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.first
+import kotlinx.coroutines.flow.flatMapLatest
+import kotlinx.coroutines.flow.map
+import kotlinx.coroutines.flow.flowOf
+import kotlinx.coroutines.withContext
+import java.io.File
+import java.util.UUID
+
+private const val EXPORT_WORK_NAME = "workouts_csv_export"
+private const val OUTPUT_PATH = "output_path"
+private const val EXPORT_PREFS = "workout_export"
+private const val REQUEST_ID = "request_id"
+
+actual fun createWorkoutExport(repository: WorkoutsRepository): WorkoutExport =
+    AndroidWorkoutExport(workoutsApplicationContext())
+
+private class AndroidWorkoutExport(context: Context) : WorkoutExport {
+    private val workManager = WorkManager.getInstance(context)
+    private val preferences = context.getSharedPreferences(EXPORT_PREFS, Context.MODE_PRIVATE)
+    private val requestId = MutableStateFlow(preferences.getString(REQUEST_ID, null))
+
+    @OptIn(kotlinx.coroutines.ExperimentalCoroutinesApi::class)
+    override val status: Flow<ExportStatus> = requestId
+        .flatMapLatest { id ->
+            if (id == null) flowOf(null) else workManager.getWorkInfoByIdFlow(UUID.fromString(id))
+        }
+        .map { info ->
+            when (info?.state) {
+                null -> ExportStatus.Idle
+                WorkInfo.State.ENQUEUED, WorkInfo.State.BLOCKED -> ExportStatus.Queued
+                WorkInfo.State.RUNNING -> ExportStatus.Running
+                WorkInfo.State.SUCCEEDED -> info.outputData.getString(OUTPUT_PATH)?.let(ExportStatus::Ready) ?: ExportStatus.Failed
+                WorkInfo.State.FAILED, WorkInfo.State.CANCELLED -> ExportStatus.Failed
+            }
+        }
+
+    override suspend fun enqueue() {
+        val request = OneTimeWorkRequestBuilder<WorkoutExportWorker>().build()
+        withContext(Dispatchers.IO) {
+            workManager.enqueueUniqueWork(EXPORT_WORK_NAME, ExistingWorkPolicy.REPLACE, request)
+                .result.get()
+            check(preferences.edit().putString(REQUEST_ID, request.id.toString()).commit())
+            requestId.value = request.id.toString()
+        }
+    }
+}
+
+/** WorkManager owns the job, so it can resume after screen and process recreation. */
+class WorkoutExportWorker(context: Context, params: WorkerParameters) : CoroutineWorker(context, params) {
+    override suspend fun doWork(): Result {
+        val database = createWorkoutsDatabase()
+        return try {
+            val workouts = database.workoutsDao().getWorkoutsStream().first().map { it.toDomain() }
+            val path = withContext(Dispatchers.IO) {
+                val directory = File(applicationContext.filesDir, "exports").apply { mkdirs() }
+                val target = File(directory, "workouts.csv")
+                val temporary = File(directory, "workouts.csv.tmp")
+                try {
+                    temporary.writeText(workoutsCsv(workouts), Charsets.UTF_8)
+                    if (!temporary.renameTo(target)) error("Could not finish CSV export")
+                } finally {
+                    temporary.delete()
+                }
+                target.absolutePath
+            }
+            Result.success(workDataOf(OUTPUT_PATH to path))
+        } catch (e: CancellationException) {
+            throw e
+        } catch (_: Exception) {
+            Result.failure()
+        } finally {
+            database.close()
+        }
+    }
+}
+
+actual fun shareWorkoutExport(path: String) {
+    val context = workoutsApplicationContext()
+    val uri = FileProvider.getUriForFile(context, "${context.packageName}.workouts.files", File(path))
+    val send = Intent(Intent.ACTION_SEND).apply {
+        type = "text/csv"
+        putExtra(Intent.EXTRA_STREAM, uri)
+        addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
+    }
+    context.startActivity(Intent.createChooser(send, null).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK))
+}
