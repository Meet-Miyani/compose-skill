@@ -0,0 +1,45 @@
+package com.example.feature.workouts.domain.export
+
+import com.example.feature.workouts.domain.repository.WorkoutsRepository
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+import java.awt.Desktop
+import java.io.File
+
+private val exportDirectory: File get() = File(System.getProperty("user.home"), ".workouts-app/exports")
+private val pendingFile: File get() = File(exportDirectory, "export.pending")
+private val csvFile: File get() = File(exportDirectory, "workouts.csv")
+
+actual fun createWorkoutExport(repository: WorkoutsRepository): WorkoutExport = LocalWorkoutExport(
+    repository,
+    initiallyPending = pendingFile.exists(),
+    initialReadyPath = csvFile.takeIf(File::exists)?.absolutePath,
+    setPending = { pending ->
+        withContext(Dispatchers.IO) {
+            if (pending) {
+                exportDirectory.mkdirs()
+                pendingFile.writeText("pending")
+            } else {
+                check(!pendingFile.exists() || pendingFile.delete())
+            }
+        }
+    },
+    write = { csv ->
+        withContext(Dispatchers.IO) {
+            val directory = exportDirectory.apply { mkdirs() }
+            val target = File(directory, "workouts.csv")
+            val temporary = File(directory, "workouts.csv.tmp")
+            try {
+                temporary.writeText(csv, Charsets.UTF_8)
+                if (!temporary.renameTo(target)) error("Could not finish CSV export")
+            } finally {
+                temporary.delete()
+            }
+            target.absolutePath
+        }
+    },
+)
+
+actual fun shareWorkoutExport(path: String) {
+    Desktop.getDesktop().open(File(path).parentFile)
+}
