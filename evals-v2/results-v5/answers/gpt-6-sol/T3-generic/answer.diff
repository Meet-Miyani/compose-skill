+package com.example.feature.workouts.domain.export
+
+import com.example.feature.workouts.domain.model.Workout
+
+/** CSV is generated from domain records, never from Room entities. */
+fun workoutsCsv(workouts: List<Workout>): String = buildString {
+    append("id,title,body,updated_at,is_archived\r\n")
+    for (workout in workouts) {
+        append(workout.id)
+        append(',')
+        append(csvField(workout.title.orEmpty()))
+        append(',')
+        append(csvField(workout.body.orEmpty()))
+        append(',')
+        append(csvField(workout.updatedAt?.toString().orEmpty()))
+        append(',')
+        append(workout.isArchived)
+        append("\r\n")
+    }
+}
+
+private fun csvField(value: String): String {
+    // Quote all text fields so commas, line breaks and double quotes round-trip.
+    // Prefix formula markers for spreadsheet consumers.
+    val first = value.firstOrNull()
+    val formula = value.trimStart(' ', '\t', '\r', '\n').firstOrNull() in listOf('=', '+', '-', '@')
+    val safe = if (formula || first == '\t' || first == '\r') "'$value" else value
+    return "\"${safe.replace("\"", "\"\"")}\""
+}
