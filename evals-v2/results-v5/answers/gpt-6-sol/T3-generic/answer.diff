@@ -0,0 +1,55 @@
+package com.example.feature.workouts.domain.export
+
+import com.example.feature.workouts.domain.repository.WorkoutsRepository
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+import platform.Foundation.NSDocumentDirectory
+import platform.Foundation.NSFileManager
+import platform.Foundation.NSString
+import platform.Foundation.NSUTF8StringEncoding
+import platform.Foundation.NSURL
+import platform.Foundation.NSUserDomainMask
+import platform.Foundation.create
+import platform.Foundation.writeToFile
+import platform.UIKit.UIActivityViewController
+import platform.UIKit.UIApplication
+import platform.UIKit.UIModalPresentationFormSheet
+import platform.UIKit.UIWindow
+import kotlinx.cinterop.ExperimentalForeignApi
+import kotlinx.cinterop.BetaInteropApi
+
+@OptIn(ExperimentalForeignApi::class, BetaInteropApi::class)
+private fun exportDirectory(): String = NSFileManager.defaultManager.URLForDirectory(
+    NSDocumentDirectory, NSUserDomainMask, null, true, null,
+)?.path ?: error("Documents directory unavailable")
+
+@OptIn(ExperimentalForeignApi::class, BetaInteropApi::class)
+actual fun createWorkoutExport(repository: WorkoutsRepository): WorkoutExport = LocalWorkoutExport(
+    repository,
+    initiallyPending = NSFileManager.defaultManager.fileExistsAtPath("${exportDirectory()}/export.pending"),
+    initialReadyPath = "${exportDirectory()}/workouts.csv".takeIf { NSFileManager.defaultManager.fileExistsAtPath(it) },
+    setPending = { pending ->
+        val path = "${exportDirectory()}/export.pending"
+        if (pending) {
+            check(NSString.create(string = "pending").writeToFile(path, true, NSUTF8StringEncoding, null))
+        } else if (NSFileManager.defaultManager.fileExistsAtPath(path)) {
+            check(NSFileManager.defaultManager.removeItemAtPath(path, null))
+        }
+    },
+    write = { csv ->
+        withContext(Dispatchers.Default) {
+            val path = "${exportDirectory()}/workouts.csv"
+            check(NSString.create(string = csv).writeToFile(path, true, NSUTF8StringEncoding, null))
+            path
+        }
+    },
+)
+
+actual fun shareWorkoutExport(path: String) {
+    val app = UIApplication.sharedApplication
+    val window = app.keyWindow ?: app.windows.firstOrNull() as? UIWindow
+    val controller = window?.rootViewController ?: return
+    val sheet = UIActivityViewController(listOf(NSURL.fileURLWithPath(path)), null)
+    sheet.modalPresentationStyle = UIModalPresentationFormSheet
+    controller.presentViewController(sheet, animated = true, completion = null)
+}
