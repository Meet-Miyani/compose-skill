+package com.example.feature.workouts.domain.export
+
+import com.example.feature.workouts.domain.repository.WorkoutsRepository
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.first
+import kotlinx.coroutines.launch
+
+/** Process-lifetime export for desktop and iOS. Android uses persistent WorkManager instead. */
+class LocalWorkoutExport(
+    private val repository: WorkoutsRepository,
+    private val write: suspend (String) -> String,
+    private val initiallyPending: Boolean = false,
+    private val initialReadyPath: String? = null,
+    private val setPending: suspend (Boolean) -> Unit = {},
+    private val scope: CoroutineScope = CoroutineScope(SupervisorJob() + Dispatchers.Default),
+) : WorkoutExport {
+    private val mutableStatus = MutableStateFlow<ExportStatus>(
+        if (initiallyPending) ExportStatus.Queued else initialReadyPath?.let(ExportStatus::Ready) ?: ExportStatus.Idle,
+    )
+    override val status: StateFlow<ExportStatus> = mutableStatus
+    private var job: Job? = null
+
+    init {
+        if (initiallyPending) startExport()
+    }
+
+    override suspend fun enqueue() {
+        if (job?.isActive == true) return
+        setPending(true)
+        mutableStatus.value = ExportStatus.Queued
+        startExport()
+    }
+
+    private fun startExport() {
+        job = scope.launch {
+            mutableStatus.value = ExportStatus.Running
+            try {
+                val csv = workoutsCsv(repository.getWorkoutsStream().first())
+                val path = write(csv)
+                setPending(false)
+                mutableStatus.value = ExportStatus.Ready(path)
+            } catch (e: CancellationException) {
+                throw e
+            } catch (_: Exception) {
+                mutableStatus.value = ExportStatus.Failed
+            }
+        }
+    }
+}
