+package com.example.feature.workouts.presentation.workouts
+
+import com.example.feature.workouts.domain.export.ExportStatus
+import com.example.feature.workouts.domain.export.LocalWorkoutExport
+import com.example.feature.workouts.domain.model.Workout
+import kotlinx.coroutines.ExperimentalCoroutinesApi
+import kotlinx.coroutines.test.advanceUntilIdle
+import kotlinx.coroutines.test.runTest
+import kotlin.test.Test
+import kotlin.test.assertEquals
+
+@OptIn(ExperimentalCoroutinesApi::class)
+class LocalWorkoutExportTest {
+    @Test fun `enqueue returns before export finishes and writes all workouts`() = runTest {
+        val repository = FakeWorkoutsRepository().apply {
+            seed(listOf(Workout(1, "Run", "", null), Workout(2, "Ride", "", null)))
+        }
+        var written = ""
+        val export = LocalWorkoutExport(repository, write = {
+            written = it
+            "/exports/workouts.csv"
+        }, scope = this)
+
+        export.enqueue()
+        assertEquals(ExportStatus.Queued, export.status.value)
+        advanceUntilIdle()
+        assertEquals(ExportStatus.Ready("/exports/workouts.csv"), export.status.value)
+        assertEquals(3, written.lines().count { it.isNotEmpty() })
+    }
+
+    @Test fun `write failure is visible and a later tap can retry`() = runTest {
+        var attempts = 0
+        val export = LocalWorkoutExport(FakeWorkoutsRepository(), write = {
+            attempts++
+            if (attempts == 1) error("disk full")
+            "/exports/workouts.csv"
+        }, scope = this)
+
+        export.enqueue()
+        advanceUntilIdle()
+        assertEquals(ExportStatus.Failed, export.status.value)
+        export.enqueue()
+        advanceUntilIdle()
+        assertEquals(ExportStatus.Ready("/exports/workouts.csv"), export.status.value)
+    }
+
+    @Test fun `pending export resumes after state holder is recreated`() = runTest {
+        var pending = true
+        val export = LocalWorkoutExport(
+            FakeWorkoutsRepository(),
+            write = { "/exports/workouts.csv" },
+            initiallyPending = pending,
+            setPending = { pending = it },
+            scope = this,
+        )
+
+        assertEquals(ExportStatus.Queued, export.status.value)
+        advanceUntilIdle()
+        assertEquals(ExportStatus.Ready("/exports/workouts.csv"), export.status.value)
+        assertEquals(false, pending)
+    }
+}
