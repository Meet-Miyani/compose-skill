+package com.example.feature.workouts.presentation.type
+
+import androidx.compose.foundation.layout.Column
+import androidx.compose.foundation.clickable
+import androidx.compose.foundation.layout.fillMaxSize
+import androidx.compose.foundation.layout.padding
+import androidx.compose.material3.Button
+import androidx.compose.material3.CircularProgressIndicator
+import androidx.compose.material3.ListItem
+import androidx.compose.material3.RadioButton
+import androidx.compose.material3.Text
+import androidx.compose.runtime.Composable
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.unit.dp
+import com.example.feature.workouts.domain.model.WorkoutType
+import org.jetbrains.compose.resources.stringResource
+import workouts.feature.workouts.generated.resources.Res
+import workouts.feature.workouts.generated.resources.back
+import workouts.feature.workouts.generated.resources.cardio
+import workouts.feature.workouts.generated.resources.error_message
+import workouts.feature.workouts.generated.resources.flexibility
+import workouts.feature.workouts.generated.resources.missing_workout
+import workouts.feature.workouts.generated.resources.retry
+import workouts.feature.workouts.generated.resources.strength
+import workouts.feature.workouts.generated.resources.workout_type
+
+@Composable
+fun WorkoutTypeScreen(
+    state: WorkoutTypeUiState,
+    onTypeSelected: (WorkoutType) -> Unit,
+    onRetry: () -> Unit,
+    onBack: () -> Unit,
+) {
+    Column(Modifier.fillMaxSize().padding(16.dp)) {
+        Text(stringResource(Res.string.workout_type))
+        when {
+            state.isLoading || state.isSaving -> CircularProgressIndicator()
+            state.isMissing -> Text(stringResource(Res.string.missing_workout))
+            state.error != null -> {
+                Text(stringResource(Res.string.error_message))
+                Button(onClick = onRetry) { Text(stringResource(Res.string.retry)) }
+            }
+            else -> {
+                WorkoutTypeOption(WorkoutType.Cardio, stringResource(Res.string.cardio), state.selected, onTypeSelected)
+                WorkoutTypeOption(WorkoutType.Strength, stringResource(Res.string.strength), state.selected, onTypeSelected)
+                WorkoutTypeOption(WorkoutType.Flexibility, stringResource(Res.string.flexibility), state.selected, onTypeSelected)
+            }
+        }
+        Button(onClick = onBack) { Text(stringResource(Res.string.back)) }
+    }
+}
+
+@Composable
+private fun WorkoutTypeOption(
+    type: WorkoutType,
+    label: String,
+    selected: WorkoutType?,
+    onTypeSelected: (WorkoutType) -> Unit,
+) {
+    ListItem(
+        headlineContent = { Text(label) },
+        leadingContent = { RadioButton(selected = selected == type, onClick = null) },
+        modifier = Modifier.clickable { onTypeSelected(type) },
+    )
+}
