+package com.example.feature.workouts.presentation.workouts
+
+import com.example.feature.workouts.domain.model.Workout
+import com.example.feature.workouts.domain.model.WorkoutType
+import com.example.feature.workouts.presentation.typepicker.WorkoutTypePickerParams
+import com.example.feature.workouts.presentation.typepicker.WorkoutTypePickerUiAction
+import com.example.feature.workouts.presentation.typepicker.WorkoutTypePickerUiEffect
+import com.example.feature.workouts.presentation.typepicker.WorkoutTypePickerViewModel
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.ExperimentalCoroutinesApi
+import kotlinx.coroutines.flow.toList
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.test.StandardTestDispatcher
+import kotlinx.coroutines.test.TestCoroutineScheduler
+import kotlinx.coroutines.test.UnconfinedTestDispatcher
+import kotlinx.coroutines.test.advanceUntilIdle
+import kotlinx.coroutines.test.resetMain
+import kotlinx.coroutines.test.runTest
+import kotlinx.coroutines.test.setMain
+import kotlin.test.AfterTest
+import kotlin.test.BeforeTest
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertFalse
+import kotlin.test.assertNull
+import kotlin.test.assertTrue
+
+@OptIn(ExperimentalCoroutinesApi::class)
+class WorkoutTypePickerViewModelTest {
+    private val scheduler = TestCoroutineScheduler()
+
+    @BeforeTest fun setUp() { Dispatchers.setMain(StandardTestDispatcher(scheduler)) }
+    @AfterTest fun tearDown() { Dispatchers.resetMain() }
+
+    @Test fun `selecting a type persists it and returns`() = runTest(scheduler) {
+        val repository = FakeWorkoutsRepository().apply {
+            seed(listOf(Workout(1L, "Run", null, null)))
+        }
+        val viewModel = WorkoutTypePickerViewModel(repository, WorkoutTypePickerParams(1L))
+        val effects = mutableListOf<WorkoutTypePickerUiEffect>()
+        backgroundScope.launch(UnconfinedTestDispatcher(scheduler)) { viewModel.effect.toList(effects) }
+
+        viewModel.onAction(WorkoutTypePickerUiAction.OnScreenStarted)
+        advanceUntilIdle()
+        assertFalse(viewModel.state.value.isLoading)
+        viewModel.onAction(WorkoutTypePickerUiAction.OnTypeClick(WorkoutType.Strength))
+        advanceUntilIdle()
+
+        assertEquals(WorkoutType.Strength, repository.getWorkout(1L)?.type)
+        assertEquals(WorkoutTypePickerUiEffect.NavigateBack, effects.single())
+    }
+
+    @Test fun `missing workout cannot be changed`() = runTest(scheduler) {
+        val repository = FakeWorkoutsRepository()
+        val viewModel = WorkoutTypePickerViewModel(repository, WorkoutTypePickerParams(1L))
+        viewModel.onAction(WorkoutTypePickerUiAction.OnScreenStarted)
+        advanceUntilIdle()
+
+        assertTrue(viewModel.state.value.isMissing)
+        viewModel.onAction(WorkoutTypePickerUiAction.OnTypeClick(WorkoutType.Cardio))
+        advanceUntilIdle()
+        assertNull(repository.getWorkout(1L))
+    }
+}
