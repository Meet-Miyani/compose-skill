+package com.example.feature.workouts.presentation.workouts
+
+import androidx.lifecycle.SavedStateHandle
+import com.example.core.error.NetworkException
+import com.example.feature.workouts.domain.model.Workout
+import com.example.feature.workouts.domain.model.WorkoutType
+import com.example.feature.workouts.presentation.type.WorkoutTypeParams
+import com.example.feature.workouts.presentation.type.WorkoutTypeUiAction
+import com.example.feature.workouts.presentation.type.WorkoutTypeUiEffect
+import com.example.feature.workouts.presentation.type.WorkoutTypeViewModel
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.ExperimentalCoroutinesApi
+import kotlinx.coroutines.flow.toList
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.test.StandardTestDispatcher
+import kotlinx.coroutines.test.TestCoroutineScheduler
+import kotlinx.coroutines.test.UnconfinedTestDispatcher
+import kotlinx.coroutines.test.advanceUntilIdle
+import kotlinx.coroutines.test.resetMain
+import kotlinx.coroutines.test.runTest
+import kotlinx.coroutines.test.setMain
+import kotlin.test.AfterTest
+import kotlin.test.BeforeTest
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertFalse
+import kotlin.test.assertNotNull
+import kotlin.test.assertTrue
+
+@OptIn(ExperimentalCoroutinesApi::class)
+class WorkoutTypeViewModelTest {
+    private val scheduler = TestCoroutineScheduler()
+
+    @BeforeTest fun setUp() { Dispatchers.setMain(StandardTestDispatcher(scheduler)) }
+    @AfterTest fun tearDown() { Dispatchers.resetMain() }
+
+    @Test
+    fun `loads existing type and saves selection`() = runTest(scheduler) {
+        val fake = FakeWorkoutsRepository().apply {
+            seed(listOf(Workout(1, "Run", "", null, type = WorkoutType.Cardio)))
+        }
+        val viewModel = WorkoutTypeViewModel(fake, WorkoutTypeParams(1), SavedStateHandle())
+        val effects = mutableListOf<WorkoutTypeUiEffect>()
+        backgroundScope.launch(UnconfinedTestDispatcher(scheduler)) { viewModel.effect.toList(effects) }
+
+        viewModel.onAction(WorkoutTypeUiAction.OnScreenStarted)
+        advanceUntilIdle()
+        assertEquals(WorkoutType.Cardio, viewModel.state.value.selectedType)
+
+        viewModel.onAction(WorkoutTypeUiAction.OnTypeClick(WorkoutType.Flexibility))
+        advanceUntilIdle()
+        assertEquals(1L to WorkoutType.Flexibility, fake.lastSelectedType)
+        assertEquals(WorkoutTypeUiEffect.NavigateBack, effects.single())
+    }
+
+    @Test
+    fun `save error stays visible and retry permits another selection`() = runTest(scheduler) {
+        val fake = FakeWorkoutsRepository().apply { seed(listOf(Workout(1, "Run", "", null))) }
+        val viewModel = WorkoutTypeViewModel(fake, WorkoutTypeParams(1), SavedStateHandle())
+        viewModel.onAction(WorkoutTypeUiAction.OnScreenStarted)
+        advanceUntilIdle()
+        fake.shouldThrow = NetworkException.Connection()
+        viewModel.onAction(WorkoutTypeUiAction.OnTypeClick(WorkoutType.Strength))
+        advanceUntilIdle()
+        assertNotNull(viewModel.state.value.error)
+        assertFalse(viewModel.state.value.isSaving)
+
+        fake.shouldThrow = null
+        viewModel.onAction(WorkoutTypeUiAction.OnRetryClick)
+        advanceUntilIdle()
+        viewModel.onAction(WorkoutTypeUiAction.OnTypeClick(WorkoutType.Strength))
+        advanceUntilIdle()
+        assertEquals(WorkoutType.Strength, fake.lastSelectedType?.second)
+    }
+
+    @Test
+    fun `missing workout cannot be selected`() = runTest(scheduler) {
+        val fake = FakeWorkoutsRepository()
+        val viewModel = WorkoutTypeViewModel(fake, WorkoutTypeParams(1), SavedStateHandle())
+        viewModel.onAction(WorkoutTypeUiAction.OnScreenStarted)
+        advanceUntilIdle()
+        assertTrue(viewModel.state.value.isMissing)
+        viewModel.onAction(WorkoutTypeUiAction.OnTypeClick(WorkoutType.Cardio))
+        advanceUntilIdle()
+        assertEquals(null, fake.lastSelectedType)
+    }
+
+    @Test
+    fun `process death resumes pending type write`() = runTest(scheduler) {
+        val fake = FakeWorkoutsRepository().apply { seed(listOf(Workout(1, "Run", "", null))) }
+        val handle = SavedStateHandle(mapOf("pendingType" to WorkoutType.Cardio.name))
+        val viewModel = WorkoutTypeViewModel(fake, WorkoutTypeParams(1), handle)
+
+        viewModel.onAction(WorkoutTypeUiAction.OnScreenStarted)
+        advanceUntilIdle()
+
+        assertEquals(1L to WorkoutType.Cardio, fake.lastSelectedType)
+        assertFalse(handle.contains("pendingType"))
+    }
+}
