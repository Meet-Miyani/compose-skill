+package com.example.feature.workouts.presentation.type
+
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.getValue
+import androidx.lifecycle.compose.LifecycleStartEffect
+import androidx.lifecycle.compose.collectAsStateWithLifecycle
+import com.example.core.mvi.CollectEffect
+import com.example.designsystem.error.HandleAppErrors
+
+@Composable
+fun WorkoutTypeRoute(
+    viewModel: WorkoutTypeViewModel,
+    workoutId: Long,
+    onEffect: suspend (WorkoutTypeUiEffect) -> Unit,
+) {
+    LifecycleStartEffect(workoutId) {
+        viewModel.onAction(WorkoutTypeUiAction.OnScreenStarted)
+        onStopOrDispose {}
+    }
+    val state by viewModel.state.collectAsStateWithLifecycle()
+    CollectEffect(viewModel.effect) { onEffect(it) }
+    HandleAppErrors(viewModel.errors)
+    WorkoutTypeScreen(
+        state = state,
+        onSelect = { viewModel.onAction(WorkoutTypeUiAction.OnTypeClick(it)) },
+        onRetry = { viewModel.onAction(WorkoutTypeUiAction.OnRetryClick) },
+        onBack = { viewModel.onAction(WorkoutTypeUiAction.OnBackClick) },
+    )
+}
