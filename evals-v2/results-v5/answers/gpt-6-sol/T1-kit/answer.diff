+package com.example.feature.workouts.data.local
+
+import com.example.core.error.StorageException
+import java.io.File
+import java.io.IOException
+import java.util.UUID
+
+internal actual fun createWorkoutPhotoStore(): WorkoutPhotoStore = object : WorkoutPhotoStore {
+    override fun save(workoutId: Long, bytes: ByteArray): String {
+        try {
+            val directory = File(System.getProperty("user.home"), ".workouts-app/photos").apply { mkdirs() }
+            val file = File(directory, "$workoutId-${UUID.randomUUID()}.image")
+            file.writeBytes(bytes)
+            return file.absolutePath
+        } catch (error: IOException) {
+            throw StorageException(error)
+        }
+    }
+}
