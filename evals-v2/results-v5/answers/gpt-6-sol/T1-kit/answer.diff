+package com.example.feature.workouts.presentation.workouts
+
+import androidx.compose.material3.Button
+import androidx.compose.material3.Text
+import androidx.compose.runtime.Composable
+import javax.swing.JFileChooser
+import javax.swing.filechooser.FileNameExtensionFilter
+import java.io.IOException
+
+@Composable
+internal actual fun WorkoutPhotoPicker(label: String, onPhotoSelected: (ByteArray) -> Unit, onPhotoSelectionFailed: () -> Unit, enabled: Boolean) {
+    Button(enabled = enabled, onClick = {
+        val chooser = JFileChooser().apply {
+            fileFilter = FileNameExtensionFilter("Images", "jpg", "jpeg", "png", "webp", "heic")
+        }
+        if (chooser.showOpenDialog(null) == JFileChooser.APPROVE_OPTION) {
+            try {
+                val bytes = chooser.selectedFile.readBytes()
+                if (bytes.isEmpty()) onPhotoSelectionFailed() else onPhotoSelected(bytes)
+            } catch (_: IOException) {
+                onPhotoSelectionFailed()
+            }
+        }
+    }) { Text(label) }
+}
