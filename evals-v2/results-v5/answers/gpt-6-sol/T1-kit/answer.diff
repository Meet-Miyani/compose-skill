+package com.example.feature.workouts.presentation.workouts
+
+import androidx.activity.compose.rememberLauncherForActivityResult
+import androidx.activity.result.PickVisualMediaRequest
+import androidx.activity.result.contract.ActivityResultContracts
+import androidx.compose.material3.Button
+import androidx.compose.material3.Text
+import androidx.compose.runtime.Composable
+import androidx.compose.ui.platform.LocalContext
+import java.io.IOException
+
+@Composable
+internal actual fun WorkoutPhotoPicker(label: String, onPhotoSelected: (ByteArray) -> Unit, onPhotoSelectionFailed: () -> Unit, enabled: Boolean) {
+    val context = LocalContext.current
+    val launcher = rememberLauncherForActivityResult(ActivityResultContracts.PickVisualMedia()) { uri ->
+        if (uri != null) {
+            try {
+                val bytes = context.contentResolver.openInputStream(uri)?.use { it.readBytes() }
+                if (bytes == null || bytes.isEmpty()) onPhotoSelectionFailed() else onPhotoSelected(bytes)
+            } catch (_: IOException) {
+                onPhotoSelectionFailed()
+            }
+        }
+    }
+    Button(enabled = enabled, onClick = { launcher.launch(PickVisualMediaRequest(ActivityResultContracts.PickVisualMedia.ImageOnly)) }) {
+        Text(label)
+    }
+}
