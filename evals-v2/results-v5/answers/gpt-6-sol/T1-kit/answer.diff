+package com.example.feature.workouts.presentation.workouts
+
+import androidx.compose.material3.Button
+import androidx.compose.material3.Text
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.remember
+import kotlinx.cinterop.ExperimentalForeignApi
+import kotlinx.cinterop.addressOf
+import kotlinx.cinterop.usePinned
+import platform.darwin.NSObject
+import platform.UIKit.UIApplication
+import platform.UIKit.UIImage
+import platform.UIKit.UIImageJPEGRepresentation
+import platform.UIKit.UIImagePickerController
+import platform.UIKit.UIImagePickerControllerDelegateProtocol
+import platform.UIKit.UIImagePickerControllerOriginalImage
+import platform.UIKit.UIImagePickerControllerSourceType
+import platform.UIKit.UINavigationControllerDelegateProtocol
+import platform.posix.memcpy
+
+private class PhotoPickerDelegate(
+    var onPhotoSelected: (ByteArray) -> Unit,
+    var onPhotoSelectionFailed: () -> Unit,
+) : NSObject(), UIImagePickerControllerDelegateProtocol, UINavigationControllerDelegateProtocol {
+    @OptIn(ExperimentalForeignApi::class)
+    override fun imagePickerController(picker: UIImagePickerController, didFinishPickingMediaWithInfo: Map<Any?, *>) {
+        val image = didFinishPickingMediaWithInfo[UIImagePickerControllerOriginalImage] as? UIImage
+        val data = image?.let { UIImageJPEGRepresentation(it, 0.85) }
+        if (data != null) {
+            val bytes = ByteArray(data.length.toInt())
+            bytes.usePinned { pinned -> memcpy(pinned.addressOf(0), data.bytes, data.length) }
+            onPhotoSelected(bytes)
+        } else {
+            onPhotoSelectionFailed()
+        }
+        picker.dismissViewControllerAnimated(true, null)
+    }
+
+    override fun imagePickerControllerDidCancel(picker: UIImagePickerController) {
+        picker.dismissViewControllerAnimated(true, null)
+    }
+}
+
+@Composable
+internal actual fun WorkoutPhotoPicker(label: String, onPhotoSelected: (ByteArray) -> Unit, onPhotoSelectionFailed: () -> Unit, enabled: Boolean) {
+    val delegate = remember { PhotoPickerDelegate(onPhotoSelected, onPhotoSelectionFailed) }
+    delegate.onPhotoSelected = onPhotoSelected
+    delegate.onPhotoSelectionFailed = onPhotoSelectionFailed
+    Button(enabled = enabled, onClick = {
+        val picker = UIImagePickerController().apply {
+            sourceType = UIImagePickerControllerSourceType.UIImagePickerControllerSourceTypePhotoLibrary
+            this.delegate = delegate
+        }
+        UIApplication.sharedApplication.keyWindow?.rootViewController?.presentViewController(picker, true, null)
+    }) { Text(label) }
+}
