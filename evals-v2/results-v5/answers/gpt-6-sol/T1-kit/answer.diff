+package com.example.feature.workouts.data.local
+
+import com.example.core.error.StorageException
+import kotlinx.cinterop.ExperimentalForeignApi
+import kotlinx.cinterop.addressOf
+import kotlinx.cinterop.usePinned
+import platform.Foundation.NSDocumentDirectory
+import platform.Foundation.NSFileManager
+import platform.Foundation.NSUUID
+import platform.Foundation.NSUserDomainMask
+import platform.posix.fclose
+import platform.posix.fopen
+import platform.posix.fwrite
+
+@OptIn(ExperimentalForeignApi::class)
+internal actual fun createWorkoutPhotoStore(): WorkoutPhotoStore = object : WorkoutPhotoStore {
+    override fun save(workoutId: Long, bytes: ByteArray): String {
+        val directory = NSFileManager.defaultManager.URLForDirectory(
+            NSDocumentDirectory, NSUserDomainMask, null, true, null,
+        )?.path ?: throw StorageException(IllegalStateException("Documents directory unavailable"))
+        val path = "$directory/$workoutId-${NSUUID().UUIDString}.image"
+        val file = fopen(path, "wb") ?: throw StorageException(IllegalStateException("Could not open photo file"))
+        val written = try {
+            bytes.usePinned { pinned -> fwrite(pinned.addressOf(0), 1u, bytes.size.toULong(), file) }
+        } finally {
+            fclose(file)
+        }
+        if (written != bytes.size.toULong()) {
+            throw StorageException(IllegalStateException("Could not save workout photo"))
+        }
+        return path
+    }
+}
