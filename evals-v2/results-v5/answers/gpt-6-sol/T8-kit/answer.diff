+package com.example.feature.workouts.presentation.list
+
+import androidx.lifecycle.SavedStateHandle
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertFalse
+
+class QuickAddViewModelTest {
+    @Test
+    fun `add clears the draft and ends loading without saving a workout`() {
+        val savedStateHandle = SavedStateHandle()
+        val viewModel = QuickAddViewModel(savedStateHandle)
+
+        viewModel.onAction(QuickAddUiAction.OnNameChanged("Morning run"))
+        assertEquals("Morning run", viewModel.state.value.name)
+
+        viewModel.onAction(QuickAddUiAction.OnAddClick)
+        assertEquals("", viewModel.state.value.name)
+        assertFalse(viewModel.state.value.isLoading)
+        assertEquals("", savedStateHandle.get<String>("quickAddName"))
+    }
+}
