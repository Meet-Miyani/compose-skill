+package com.example.feature.workouts.presentation.list
+import kotlin.test.Test
+import kotlin.test.assertEquals
+
+class QuickAddViewModelTest {
+    @Test
+    fun `add finishes loading and clears the draft`() {
+        val viewModel = QuickAddViewModel()
+
+        assertEquals(QuickAddUiState(), viewModel.state.value)
+        viewModel.onAction(QuickAddUiAction.OnNameChanged("Morning run"))
+        assertEquals("Morning run", viewModel.state.value.workoutName)
+
+        viewModel.onAction(QuickAddUiAction.OnAddClick)
+        assertEquals(QuickAddUiState(), viewModel.state.value)
+    }
+}
