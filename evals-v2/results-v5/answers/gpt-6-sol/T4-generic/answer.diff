+    @Test
+    fun `cleared draft stays empty after recreation and load`() = runTest(testScheduler) {
+        val fake = FakeWorkoutsRepository().apply { seed(listOf(workout())) }
+        val handle = SavedStateHandle()
+        val original = viewModel(fake, handle = handle)
+        original.onAction(WorkoutsUiAction.OnTitleChanged(""))
+
+        val restored = viewModel(fake, handle = handle)
+        restored.onAction(WorkoutsUiAction.OnScreenStarted)
+        advanceUntilIdle()
+
+        assertEquals("", restored.state.value.draftTitle)
+        assertEquals("Title", restored.state.value.items.single().title)
+    }
+
+    @Test
+    fun `typing during load is retained when load completes`() = runTest(testScheduler) {
+        val fake = FakeWorkoutsRepository().apply { seed(listOf(workout())) }
+        val gate = CompletableDeferred<Unit>().also { fake.gate = it }
+        val handle = SavedStateHandle()
+        val viewModel = viewModel(fake, handle = handle)
+
+        viewModel.onAction(WorkoutsUiAction.OnScreenStarted)
+        advanceUntilIdle()
+        viewModel.onAction(WorkoutsUiAction.OnTitleChanged("in progress"))
+        gate.complete(Unit)
+        advanceUntilIdle()
+
+        assertEquals("in progress", viewModel.state.value.draftTitle)
+        assertEquals("in progress", handle.get<String>("draftTitle"))
+    }
