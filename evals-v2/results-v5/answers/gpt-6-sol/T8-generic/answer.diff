+package com.example.feature.workouts.presentation.list
+
+import androidx.lifecycle.SavedStateHandle
+import com.example.core.mvi.BaseViewModel
+import org.koin.core.annotation.KoinViewModel
+
+@KoinViewModel
+class QuickAddViewModel(
+    private val savedStateHandle: SavedStateHandle,
+) : BaseViewModel<QuickAddUiAction, QuickAddUiState, QuickAddUiEffect>(
+    QuickAddUiState(text = savedStateHandle[TEXT_KEY] ?: ""),
+) {
+    override fun onAction(action: QuickAddUiAction) {
+        when (action) {
+            is QuickAddUiAction.OnTextChanged -> {
+                savedStateHandle[TEXT_KEY] = action.text
+                updateState { copy(text = action.text) }
+            }
+            QuickAddUiAction.OnAddClick -> {
+                updateState { copy(isLoading = true) }
+                // The previous presenter had no save operation; keep its immediate completion.
+                savedStateHandle[TEXT_KEY] = ""
+                updateState { copy(isLoading = false, text = "") }
+            }
+        }
+    }
+
+    private companion object {
+        const val TEXT_KEY = "quickAddText"
+    }
+}
