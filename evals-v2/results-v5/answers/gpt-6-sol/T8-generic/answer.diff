+package com.example.feature.workouts.presentation.workouts
+
+import androidx.lifecycle.SavedStateHandle
+import com.example.feature.workouts.presentation.list.QuickAddUiAction
+import com.example.feature.workouts.presentation.list.QuickAddUiState
+import com.example.feature.workouts.presentation.list.QuickAddViewModel
+import kotlin.test.Test
+import kotlin.test.assertEquals
+
+class QuickAddViewModelTest {
+    @Test fun `text survives ViewModel recreation and add clears it`() {
+        val handle = SavedStateHandle()
+        val first = QuickAddViewModel(handle)
+
+        first.onAction(QuickAddUiAction.OnTextChanged("Run"))
+        assertEquals("Run", first.state.value.text)
+        assertEquals("Run", QuickAddViewModel(handle).state.value.text)
+
+        first.onAction(QuickAddUiAction.OnAddClick)
+        assertEquals(QuickAddUiState(), first.state.value)
+        assertEquals(QuickAddUiState(), QuickAddViewModel(handle).state.value)
+    }
+}
