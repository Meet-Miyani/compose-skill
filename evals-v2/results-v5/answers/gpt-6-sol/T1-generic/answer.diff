+package com.example.feature.workouts.data.local
+
+import java.io.File
+
+internal actual class WorkoutPhotoStorage actual constructor() {
+    private val directory get() = File(workoutsApplicationContext().filesDir, "workout_photos")
+    private fun file(id: Long) = File(directory, "$id.image")
+
+    actual fun hasPhoto(id: Long): Boolean = file(id).isFile
+
+    actual fun save(id: Long, bytes: ByteArray) {
+        check(directory.isDirectory || directory.mkdirs()) { "Could not create photo directory" }
+        val temporary = File(directory, "$id.tmp")
+        try {
+            temporary.writeBytes(bytes)
+            check(temporary.renameTo(file(id))) { "Could not store workout photo" }
+        } finally {
+            temporary.delete()
+        }
+    }
+
+    actual fun delete(id: Long) {
+        val photo = file(id)
+        check(!photo.exists() || photo.delete()) { "Could not delete workout photo" }
+    }
+}
