+package com.example.feature.workouts.data.local
+
+import java.nio.file.Files
+import kotlin.test.Test
+import kotlin.test.assertFalse
+import kotlin.test.assertTrue
+
+class WorkoutPhotoStorageTest {
+    @Test
+    fun `photo survives a new storage instance and can be replaced and deleted`() {
+        val previousHome = System.getProperty("user.home")
+        val tempHome = Files.createTempDirectory("workout-photo-test").toFile()
+        try {
+            System.setProperty("user.home", tempHome.absolutePath)
+            val storage = WorkoutPhotoStorage()
+            assertFalse(storage.hasPhoto(4))
+
+            storage.save(4, byteArrayOf(1, 2))
+            assertTrue(WorkoutPhotoStorage().hasPhoto(4))
+            storage.save(4, byteArrayOf(3))
+            val file = tempHome.resolve(".workouts-app/photos/4.image")
+            assertTrue(file.readBytes().contentEquals(byteArrayOf(3)))
+
+            storage.delete(4)
+            assertFalse(WorkoutPhotoStorage().hasPhoto(4))
+        } finally {
+            System.setProperty("user.home", previousHome)
+            tempHome.deleteRecursively()
+        }
+    }
+}
