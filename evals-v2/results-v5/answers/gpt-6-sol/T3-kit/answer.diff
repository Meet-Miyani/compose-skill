+package com.example.feature.workouts.domain.export
+
+import com.example.feature.workouts.domain.model.Workout
+
+internal fun workoutsCsv(workouts: List<Workout>): String = buildString {
+    append("id,title,body,updatedAt,isArchived\r\n")
+    workouts.forEach { workout ->
+        append(workout.id)
+        append(',')
+        append(csvCell(workout.title.orEmpty()))
+        append(',')
+        append(csvCell(workout.body.orEmpty()))
+        append(',')
+        append(csvCell(workout.updatedAt?.toString().orEmpty()))
+        append(',')
+        append(workout.isArchived)
+        append("\r\n")
+    }
+}
+
+private fun csvCell(value: String): String {
+    val safe = if (value.firstOrNull() in listOf('=', '+', '-', '@', '\t', '\r')) "'$value" else value
+    return "\"${safe.replace("\"", "\"\"")}\""
+}
