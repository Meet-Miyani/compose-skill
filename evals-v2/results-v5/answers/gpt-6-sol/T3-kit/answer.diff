+package com.example.feature.workouts.domain.export
+
+import com.example.core.error.StorageException
+import com.example.feature.workouts.domain.repository.WorkoutsRepository
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.flow.first
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+import kotlinx.coroutines.CoroutineDispatcher
+import kotlin.time.Clock
+
+sealed interface WorkoutExportStatus {
+    data object Idle : WorkoutExportStatus
+    data object Running : WorkoutExportStatus
+    data class Complete(val location: String) : WorkoutExportStatus
+    data object Failed : WorkoutExportStatus
+}
+
+/** App-owned job: leaving the workout destination does not cancel an export. */
+class WorkoutExportManager(
+    private val repository: WorkoutsRepository,
+    private val writer: WorkoutExportWriter,
+    private val appScope: CoroutineScope,
+    private val workerDispatcher: CoroutineDispatcher,
+) {
+    private val _status = MutableStateFlow<WorkoutExportStatus>(WorkoutExportStatus.Idle)
+    val status: StateFlow<WorkoutExportStatus> = _status.asStateFlow()
+    private var job: Job? = null
+
+    fun export() {
+        if (job?.isActive == true) return
+        _status.value = WorkoutExportStatus.Running
+        job = appScope.launch {
+            try {
+                val location = withContext(workerDispatcher) {
+                    val workouts = repository.getWorkoutsStream().first()
+                    val name = "workouts-${Clock.System.now().toEpochMilliseconds()}.csv"
+                    writer.write(name, workoutsCsv(workouts))
+                }
+                _status.value = WorkoutExportStatus.Complete(location)
+            } catch (cancelled: CancellationException) {
+                throw cancelled
+            } catch (_: StorageException) {
+                _status.value = WorkoutExportStatus.Failed
+            }
+        }
+    }
+}
