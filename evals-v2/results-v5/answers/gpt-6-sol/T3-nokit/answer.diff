+package com.example.feature.workouts.domain.export
+
+import android.content.ContentValues
+import android.content.Context
+import android.os.Build
+import android.os.Environment
+import android.provider.MediaStore
+import androidx.work.CoroutineWorker
+import androidx.work.ExistingWorkPolicy
+import androidx.work.OneTimeWorkRequestBuilder
+import androidx.work.WorkerParameters
+import androidx.work.WorkManager
+import com.example.feature.workouts.data.local.createWorkoutsDatabase
+import com.example.feature.workouts.data.local.toDomain
+import com.example.feature.workouts.data.local.workoutsApplicationContext
+import com.example.feature.workouts.domain.repository.WorkoutsRepository
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.withContext
+import java.io.File
+import java.io.IOException
+
+internal actual fun createWorkoutsExportService(repository: WorkoutsRepository): WorkoutsExportService =
+    AndroidWorkoutsExportService(workoutsApplicationContext())
+
+private class AndroidWorkoutsExportService(private val context: Context) : WorkoutsExportService {
+    override fun enqueue() {
+        WorkManager.getInstance(context).enqueueUniqueWork(
+            "workouts-csv-export",
+            ExistingWorkPolicy.KEEP,
+            OneTimeWorkRequestBuilder<WorkoutsExportWorker>().build(),
+        )
+    }
+}
+
+/** WorkManager owns the database read and file write even after the list screen is gone. */
+class WorkoutsExportWorker(context: Context, params: WorkerParameters) : CoroutineWorker(context, params) {
+    override suspend fun doWork(): Result = withContext(Dispatchers.IO) {
+        try {
+            val workouts = createWorkoutsDatabase().workoutsDao().getAllWorkouts().map { it.toDomain() }
+            val csv = workoutsCsv(workouts)
+            val name = "workouts-${System.currentTimeMillis()}.csv"
+            saveCsv(applicationContext, name, csv)
+            Result.success()
+        } catch (e: CancellationException) {
+            throw e
+        } catch (e: Exception) {
+            if (runAttemptCount < 2) Result.retry() else Result.failure()
+        }
+    }
+
+    private fun saveCsv(context: Context, name: String, csv: String) {
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q) {
+            val resolver = context.contentResolver
+            val values = ContentValues().apply {
+                put(MediaStore.Downloads.DISPLAY_NAME, name)
+                put(MediaStore.Downloads.MIME_TYPE, "text/csv")
+                put(MediaStore.Downloads.RELATIVE_PATH, Environment.DIRECTORY_DOWNLOADS)
+                put(MediaStore.Downloads.IS_PENDING, 1)
+            }
+            val uri = resolver.insert(MediaStore.Downloads.EXTERNAL_CONTENT_URI, values)
+                ?: throw IOException("Could not create CSV in Downloads")
+            try {
+                resolver.openOutputStream(uri)?.bufferedWriter(Charsets.UTF_8)?.use { it.write(csv) }
+                    ?: throw IOException("Could not open CSV output")
+                values.clear()
+                values.put(MediaStore.Downloads.IS_PENDING, 0)
+                resolver.update(uri, values, null, null)
+            } catch (e: Exception) {
+                resolver.delete(uri, null, null)
+                throw e
+            }
+        } else {
+            val directory = context.getExternalFilesDir(Environment.DIRECTORY_DOWNLOADS)
+                ?: throw IOException("Downloads directory unavailable")
+            val temp = File(directory, "$name.tmp")
+            try {
+                temp.writeText(csv, Charsets.UTF_8)
+                if (!temp.renameTo(File(directory, name))) throw IOException("Could not finish CSV")
+            } finally {
+                temp.delete()
+            }
+        }
+    }
+}
