+package com.example.feature.workouts.domain.export
+
+import com.example.feature.workouts.domain.model.Workout
+
+/** RFC 4180 quoting keeps commas, quotes, and newlines inside a cell. */
+fun workoutsCsv(workouts: List<Workout>): String = buildString {
+    append("id,title,body,updated_at,is_archived\r\n")
+    workouts.forEach { workout ->
+        val cells = listOf(
+            workout.id.toString(),
+            workout.title.orEmpty(),
+            workout.body.orEmpty(),
+            workout.updatedAt?.toString().orEmpty(),
+            workout.isArchived.toString(),
+        )
+        append(cells.joinToString(",") { value -> "\"${value.replace("\"", "\"\"")}\"" })
+        append("\r\n")
+    }
+}
