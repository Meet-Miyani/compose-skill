+package com.example.feature.workouts.presentation.workouts
+
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.rememberUpdatedState
+import java.awt.FileDialog
+import java.awt.Frame
+import java.io.File
+
+@Composable
+internal actual fun rememberPhotoPicker(
+    onPhotoPicked: (ByteArray) -> Unit,
+    onError: () -> Unit,
+): () -> Unit {
+    val picked = rememberUpdatedState(onPhotoPicked)
+    val failed = rememberUpdatedState(onError)
+    return {
+        val dialog = FileDialog(null as Frame?, "Choose a workout photo", FileDialog.LOAD)
+        dialog.filenameFilter = java.io.FilenameFilter { _, name ->
+            name.substringAfterLast('.', "").lowercase() in setOf("jpg", "jpeg", "png", "webp", "gif")
+        }
+        try {
+            dialog.isVisible = true
+            val name = dialog.file
+            if (name != null) {
+                val bytes = File(dialog.directory, name).readBytes()
+                if (bytes.isEmpty()) failed.value() else picked.value(bytes)
+            }
+        } catch (_: Exception) {
+            failed.value()
+        } finally {
+            dialog.dispose()
+        }
+    }
+}
