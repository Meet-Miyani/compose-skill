+package com.example.feature.workouts.presentation.workouts
+
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.rememberUpdatedState
+import java.awt.FileDialog
+import java.awt.Frame
+import java.io.File
+
+private val imageExtensions = setOf("jpg", "jpeg", "png", "webp", "bmp", "gif")
+
+@Composable
+internal actual fun rememberPhotoPicker(onPicked: (ByteArray) -> Unit): () -> Unit {
+    val currentOnPicked by rememberUpdatedState(onPicked)
+    return {
+        val dialog = FileDialog(null as Frame?, "Select photo", FileDialog.LOAD).apply {
+            setFilenameFilter { _, name -> name.substringAfterLast('.', "").lowercase() in imageExtensions }
+            isVisible = true
+        }
+        val file = dialog.file?.let { File(dialog.directory, it) }
+        if (file != null) currentOnPicked(file.readBytes())
+    }
+}
