+package com.example.feature.workouts.data.local
+
+import com.example.core.error.StorageException
+import java.io.File
+import java.io.IOException
+
+private fun photosDirectory(): File = File(applicationContext.filesDir, "workout-photos").apply { mkdirs() }
+
+internal actual fun writeWorkoutPhotoFile(workoutId: Long, bytes: ByteArray): String = try {
+    File(photosDirectory(), "workout-$workoutId.photo").apply { writeBytes(bytes) }.absolutePath
+} catch (e: IOException) {
+    throw StorageException(e)
+}
+
+internal actual fun readWorkoutPhotoFile(path: String): ByteArray? = try {
+    File(path).takeIf(File::exists)?.readBytes()
+} catch (e: IOException) {
+    throw StorageException(e)
+}
+
+internal actual fun deleteWorkoutPhotoFile(path: String) {
+    File(path).delete()
+}
