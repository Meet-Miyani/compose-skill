+package com.example.feature.workouts.presentation.workouts
+
+import com.example.feature.workouts.domain.export.ExportStatus
+import com.example.feature.workouts.domain.export.WorkoutsExporter
+import kotlinx.coroutines.flow.Flow
+import kotlinx.coroutines.flow.MutableStateFlow
+
+/** Test-only exporter: enqueue flips to Running until the test calls [finish]. */
+class FakeWorkoutsExporter : WorkoutsExporter {
+    private val backing = MutableStateFlow<ExportStatus>(ExportStatus.Idle)
+    var enqueueCalls: Int = 0
+
+    override val status: Flow<ExportStatus> = backing
+
+    override fun enqueue() {
+        enqueueCalls += 1
+        backing.value = ExportStatus.Running
+    }
+
+    fun finish(result: ExportStatus) {
+        backing.value = result
+    }
+}
