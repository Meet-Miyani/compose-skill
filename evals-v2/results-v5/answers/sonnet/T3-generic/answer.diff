+package com.example.feature.workouts.data.export
+
+import com.example.feature.workouts.domain.model.Workout
+
+/** RFC 4180 CSV for workouts. */
+internal object WorkoutsCsv {
+    private const val HEADER = "id,title,body,is_archived,updated_at"
+    private const val LINE_END = "\r\n"
+
+    fun format(workouts: List<Workout>): String = buildString {
+        append(HEADER).append(LINE_END)
+        workouts.forEach { workout ->
+            append(workout.id).append(',')
+            append(escape(workout.title.orEmpty())).append(',')
+            append(escape(workout.body.orEmpty())).append(',')
+            append(workout.isArchived).append(',')
+            append(workout.updatedAt?.toString().orEmpty())
+            append(LINE_END)
+        }
+    }
+
+    /**
+     * Quotes fields that need it. Text that a spreadsheet would run as a formula
+     * (leading `=`, `+`, `-`, `@`, tab or CR) gets a leading `'`, since titles are user input.
+     */
+    private fun escape(text: String): String {
+        val safe = if (text.firstOrNull() in FORMULA_PREFIXES) "'$text" else text
+        val needsQuotes = safe.any { it == ',' || it == '"' || it == '\n' || it == '\r' }
+        return if (needsQuotes) "\"${safe.replace("\"", "\"\"")}\"" else safe
+    }
+
+    private val FORMULA_PREFIXES = setOf('=', '+', '-', '@', '\t', '\r')
+}
