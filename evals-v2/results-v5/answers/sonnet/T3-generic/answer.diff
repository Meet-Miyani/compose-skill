+package com.example.feature.workouts.data.export
+
+import com.example.feature.workouts.domain.model.Workout
+import kotlin.test.Test
+import kotlin.test.assertEquals
+
+class WorkoutsCsvTest {
+    private val header = "id,title,body,is_archived,updated_at\r\n"
+
+    @Test fun `empty list is header only`() {
+        assertEquals(header, WorkoutsCsv.format(emptyList()))
+    }
+
+    @Test fun `plain row and null fields`() {
+        val csv = WorkoutsCsv.format(listOf(Workout(1, "Squats", "3x5", null), Workout(2, null, null, null, isArchived = true)))
+        assertEquals(header + "1,Squats,3x5,false,\r\n2,,,true,\r\n", csv)
+    }
+
+    @Test fun `commas quotes and newlines are quoted`() {
+        val csv = WorkoutsCsv.format(listOf(Workout(1, "Legs, heavy", "say \"go\"\nnow", null)))
+        assertEquals(header + "1,\"Legs, heavy\",\"say \"\"go\"\"\nnow\",false,\r\n", csv)
+    }
+
+    @Test fun `formula prefixes are neutralised`() {
+        val csv = WorkoutsCsv.format(listOf(Workout(1, "=HYPERLINK(\"x\")", "@cmd", null)))
+        assertEquals(header + "1,\"'=HYPERLINK(\"\"x\"\")\",'@cmd,false,\r\n", csv)
+    }
+}
