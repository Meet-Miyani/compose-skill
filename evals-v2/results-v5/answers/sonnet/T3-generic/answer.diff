+/**
+ * Port for exporting every workout to a CSV file outside the screen's lifetime.
+ */
+package com.example.feature.workouts.domain.export
+
+import kotlinx.coroutines.flow.Flow
+
+/** Progress of the most recent export. */
+public sealed interface ExportStatus {
+    public data object Idle : ExportStatus
+    public data object Running : ExportStatus
+    public data class Succeeded(val fileName: String) : ExportStatus
+    public data object Failed : ExportStatus
+}
+
+/**
+ * Starts CSV exports that keep running when the screen is left.
+ */
+public interface WorkoutsExporter {
+    /** Status of the latest export; replays the current value to new collectors. */
+    public val status: Flow<ExportStatus>
+
+    /** Starts an export unless one is already running. Returns immediately. */
+    public fun enqueue()
+}
