+package com.example.feature.workouts.data.export
+
+import com.example.feature.workouts.domain.export.WorkoutsExporter
+import com.example.feature.workouts.domain.repository.WorkoutsRepository
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+import org.koin.core.annotation.Factory
+import kotlin.time.Clock
+
+/** Reads every workout, formats it as CSV and writes the file. Returns the file name. */
+@Factory
+internal class ExportWorkouts(private val repository: WorkoutsRepository) {
+    suspend operator fun invoke(): String {
+        val csv = WorkoutsCsv.format(repository.getAllWorkouts())
+        val stamp = Clock.System.now().toString().take(19).replace("-", "").replace(":", "")
+        val fileName = "workouts-$stamp.csv"
+        withContext(Dispatchers.IO) { writeExportFile(fileName, csv) }
+        return fileName
+    }
+}
+
+/** Saves [content] as a user-reachable file; throws on IO failure. Blocking, call off the main thread. */
+internal expect fun writeExportFile(fileName: String, content: String)
+
+/** Picks the platform's background mechanism: WorkManager on Android, an app-scoped coroutine elsewhere. */
+internal expect fun createWorkoutsExporter(export: ExportWorkouts): WorkoutsExporter
