+package com.example.feature.workouts.data.export
+
+import android.content.Context
+import androidx.work.CoroutineWorker
+import androidx.work.Data
+import androidx.work.ExistingWorkPolicy
+import androidx.work.OneTimeWorkRequestBuilder
+import androidx.work.WorkInfo
+import androidx.work.WorkManager
+import androidx.work.WorkerParameters
+import androidx.work.workDataOf
+import com.example.feature.workouts.data.local.workoutsApplicationContext
+import com.example.feature.workouts.domain.export.ExportStatus
+import com.example.feature.workouts.domain.export.WorkoutsExporter
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.flow.Flow
+import kotlinx.coroutines.flow.map
+import org.koin.core.component.KoinComponent
+import org.koin.core.component.inject
+
+private const val UNIQUE_WORK_NAME = "workouts_export"
+private const val KEY_FILE_NAME = "file_name"
+
+/**
+ * Runs exports in WorkManager, so they survive leaving the screen, process death and
+ * device restarts. The unique-work name keeps repeated taps from starting duplicates,
+ * and the persisted work state is the exported status.
+ */
+internal class WorkManagerWorkoutsExporter : WorkoutsExporter {
+    private val workManager: WorkManager get() = WorkManager.getInstance(workoutsApplicationContext())
+
+    override val status: Flow<ExportStatus> =
+        workManager.getWorkInfosForUniqueWorkFlow(UNIQUE_WORK_NAME).map { infos ->
+            infos.firstOrNull()?.toExportStatus() ?: ExportStatus.Idle
+        }
+
+    override fun enqueue() {
+        workManager.enqueueUniqueWork(
+            UNIQUE_WORK_NAME,
+            ExistingWorkPolicy.KEEP,
+            OneTimeWorkRequestBuilder<ExportWorkoutsWorker>().build(),
+        )
+    }
+}
+
+private fun WorkInfo.toExportStatus(): ExportStatus = when (state) {
+    WorkInfo.State.ENQUEUED, WorkInfo.State.RUNNING, WorkInfo.State.BLOCKED -> ExportStatus.Running
+    WorkInfo.State.SUCCEEDED -> ExportStatus.Succeeded(outputData.getString(KEY_FILE_NAME).orEmpty())
+    WorkInfo.State.FAILED, WorkInfo.State.CANCELLED -> ExportStatus.Failed
+}
+
+internal class ExportWorkoutsWorker(context: Context, params: WorkerParameters) :
+    CoroutineWorker(context, params), KoinComponent {
+    private val export: ExportWorkouts by inject()
+
+    override suspend fun doWork(): Result = try {
+        Result.success(workDataOf(KEY_FILE_NAME to export()))
+    } catch (e: CancellationException) {
+        throw e
+    } catch (e: Exception) {
+        Result.failure(Data.EMPTY)
+    }
+}
+
+internal actual fun createWorkoutsExporter(export: ExportWorkouts): WorkoutsExporter = WorkManagerWorkoutsExporter()
