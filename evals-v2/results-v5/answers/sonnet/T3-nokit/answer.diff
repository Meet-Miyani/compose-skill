+package com.example.feature.workouts.data.export
+
+import com.example.feature.workouts.data.local.workoutsAppContext
+import java.io.File
+
+internal actual fun writeWorkoutsExport(fileName: String, content: String): String {
+    val base = workoutsAppContext().getExternalFilesDir(null) ?: workoutsAppContext().filesDir
+    val directory = File(base, "exports").apply { mkdirs() }
+    return File(directory, fileName).apply { writeText(content) }.absolutePath
+}
