+package com.example.feature.workouts.data.export
+
+import com.example.feature.workouts.data.local.WorkoutEntity
+
+private const val HEADER = "id,title,body"
+
+/** Renders [workouts] as RFC 4180 CSV with a header row. */
+internal fun workoutsToCsv(workouts: List<WorkoutEntity>): String = buildString {
+    append(HEADER).append("\r\n")
+    workouts.forEach { append(it.id).append(',').append(it.title.csvField()).append(',').append(it.body.csvField()).append("\r\n") }
+}
+
+private fun String.csvField(): String =
+    if (any { it == ',' || it == '"' || it == '\n' || it == '\r' }) "\"${replace("\"", "\"\"")}\"" else this
+
+/** Writes [content] to [fileName] in the platform export directory and returns the absolute path. */
+internal expect fun writeWorkoutsExport(fileName: String, content: String): String
