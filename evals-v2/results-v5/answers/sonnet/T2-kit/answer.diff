+/**
+ * Stateless content for the workout type picker destination.
+ *
+ * Renders state only. No ViewModel, no Koin, no state reads beyond params.
+ */
+package com.example.feature.workouts.presentation.picker
+
+import androidx.compose.foundation.layout.Column
+import androidx.compose.foundation.layout.padding
+import androidx.compose.material3.Button
+import androidx.compose.material3.CircularProgressIndicator
+import androidx.compose.material3.RadioButton
+import androidx.compose.material3.Text
+import androidx.compose.runtime.Composable
+import androidx.compose.foundation.layout.Row
+import androidx.compose.foundation.selection.selectable
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.semantics.Role
+import androidx.compose.ui.unit.dp
+import com.example.feature.workouts.domain.model.WorkoutType
+import org.jetbrains.compose.resources.StringResource
+import org.jetbrains.compose.resources.stringResource
+import workouts.feature.workouts.generated.resources.Res
+import workouts.feature.workouts.generated.resources.back
+import workouts.feature.workouts.generated.resources.choose_type
+import workouts.feature.workouts.generated.resources.error_message
+import workouts.feature.workouts.generated.resources.missing_workout
+import workouts.feature.workouts.generated.resources.retry
+import workouts.feature.workouts.generated.resources.type_cardio
+import workouts.feature.workouts.generated.resources.type_flexibility
+import workouts.feature.workouts.generated.resources.type_strength
+
+/** String resource for a workout type; shared by the picker and the detail screen. */
+fun WorkoutType.label(): StringResource = when (this) {
+    WorkoutType.Cardio -> Res.string.type_cardio
+    WorkoutType.Strength -> Res.string.type_strength
+    WorkoutType.Flexibility -> Res.string.type_flexibility
+}
+
+@Composable
+fun WorkoutTypePickerScreen(
+    state: WorkoutTypePickerUiState,
+    onType: (WorkoutType) -> Unit,
+    onRetry: () -> Unit,
+    onBack: () -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    when {
+        state.isLoading -> CircularProgressIndicator(modifier = modifier)
+        state.error != null -> Column(modifier = modifier) {
+            Text(stringResource(Res.string.error_message))
+            Button(onClick = onRetry) { Text(stringResource(Res.string.retry)) }
+            Button(onClick = onBack) { Text(stringResource(Res.string.back)) }
+        }
+        state.isMissing -> Column(modifier = modifier) {
+            Text(stringResource(Res.string.missing_workout))
+            Button(onClick = onBack) { Text(stringResource(Res.string.back)) }
+        }
+        else -> Column(modifier = modifier.padding(16.dp)) {
+            Text(stringResource(Res.string.choose_type))
+            WorkoutType.entries.forEach { type ->
+                Row(
+                    modifier = Modifier.selectable(
+                        selected = type == state.selected,
+                        onClick = { onType(type) },
+                        role = Role.RadioButton,
+                    ),
+                ) {
+                    // The row owns the click and semantics; the button only draws.
+                    RadioButton(selected = type == state.selected, onClick = null)
+                    Text(stringResource(type.label()))
+                }
+            }
+            Button(onClick = onBack) { Text(stringResource(Res.string.back)) }
+        }
+    }
+}
