+/**
+ * MVI contract for the workout type picker destination.
+ *
+ * UiState holds the domain WorkoutType directly; no M-11 trigger fires here.
+ */
+package com.example.feature.workouts.presentation.picker
+
+import com.example.core.error.AppError
+import com.example.core.mvi.UiAction
+import com.example.core.mvi.UiEffect
+import com.example.core.mvi.UiState
+import com.example.feature.workouts.domain.model.WorkoutType
+
+data class WorkoutTypePickerUiState(
+    val selected: WorkoutType? = null,
+    val isLoading: Boolean = false,
+    val error: AppError? = null,
+    val isMissing: Boolean = false,
+) : UiState
+
+sealed interface WorkoutTypePickerUiAction : UiAction {
+    data object OnScreenStarted : WorkoutTypePickerUiAction
+    data class OnTypeClick(val type: WorkoutType) : WorkoutTypePickerUiAction
+    data class OnRetryClick(val error: AppError) : WorkoutTypePickerUiAction
+    data object OnBackClick : WorkoutTypePickerUiAction
+}
+
+sealed interface WorkoutTypePickerUiEffect : UiEffect {
+    data object Selected : WorkoutTypePickerUiEffect
+    data object NavigateBack : WorkoutTypePickerUiEffect
+}
