diff --git a/feature/workouts/src/commonTest/kotlin/com/example/feature/workouts/presentation/picker/WorkoutTypePickerViewModelTest.kt b/feature/workouts/src/commonTest/kotlin/com/example/feature/workouts/presentation/picker/WorkoutTypePickerViewModelTest.kt
