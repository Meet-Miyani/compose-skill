+++ b/feature/workouts/src/commonTest/kotlin/com/example/feature/workouts/presentation/picker/WorkoutTypePickerViewModelTest.kt
@@ -0,0 +1,189 @@
+/**
+ * State-matrix tests for the workout type picker ViewModel.
+ *
+ * Each test drives the public event API and asserts the public state API.
+ * Effects are collected with `backgroundScope` into a list; no Turbine.
+ */
+package com.example.feature.workouts.presentation.picker
+
+import com.example.core.error.NetworkException
+import com.example.core.mvi.UiEffect
+import com.example.feature.workouts.domain.model.Workout
+import com.example.feature.workouts.domain.model.WorkoutType
+import com.example.feature.workouts.presentation.workouts.FakeWorkoutsRepository
+import kotlinx.coroutines.CompletableDeferred
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.ExperimentalCoroutinesApi
+import kotlinx.coroutines.flow.toList
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.test.StandardTestDispatcher
+import kotlinx.coroutines.test.TestCoroutineScheduler
+import kotlinx.coroutines.test.UnconfinedTestDispatcher
+import kotlinx.coroutines.test.advanceUntilIdle
+import kotlinx.coroutines.test.resetMain
+import kotlinx.coroutines.test.runTest
+import kotlinx.coroutines.test.setMain
+import kotlin.test.AfterTest
+import kotlin.test.BeforeTest
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertFalse
+import kotlin.test.assertNotNull
+import kotlin.test.assertNull
+import kotlin.test.assertTrue
+
+/** ViewModel tests covering every observable picker state. */
+@OptIn(ExperimentalCoroutinesApi::class)
+class WorkoutTypePickerViewModelTest {
+    private val testScheduler = TestCoroutineScheduler()
+
+    @BeforeTest
+    fun setUp() {
+        Dispatchers.setMain(StandardTestDispatcher(testScheduler))
+    }
+
+    @AfterTest
+    fun tearDown() {
+        Dispatchers.resetMain()
+    }
+
+    private fun workout(id: Long = 1L, type: WorkoutType? = null) =
+        Workout(id = id, title = "Title", body = "Body", updatedAt = null, type = type)
+
+    private fun viewModel(fake: FakeWorkoutsRepository, id: Long = 1L) = WorkoutTypePickerViewModel(
+        repository = fake,
+        params = WorkoutTypePickerParams(workoutId = id),
+        // Separate instance on the shared scheduler, so withContext(ioDispatcher) suspends.
+        ioDispatcher = StandardTestDispatcher(testScheduler),
+    )
+
+    @Test
+    fun `cold load shows loading then current type`() = runTest(testScheduler) {
+        val fake = FakeWorkoutsRepository().apply { seed(listOf(workout(type = WorkoutType.Strength))) }
+        val viewModel = viewModel(fake)
+        val gate = CompletableDeferred<Unit>().also { fake.gate = it }
+
+        viewModel.onAction(WorkoutTypePickerUiAction.OnScreenStarted)
+        advanceUntilIdle()
+        assertTrue(viewModel.state.value.isLoading)
+
+        gate.complete(Unit)
+        advanceUntilIdle()
+
+        assertFalse(viewModel.state.value.isLoading)
+        assertEquals(WorkoutType.Strength, viewModel.state.value.selected)
+    }
+
+    @Test
+    fun `workout without a type loads with nothing selected`() = runTest(testScheduler) {
+        val fake = FakeWorkoutsRepository().apply { seed(listOf(workout())) }
+        val viewModel = viewModel(fake)
+
+        viewModel.onAction(WorkoutTypePickerUiAction.OnScreenStarted)
+        advanceUntilIdle()
+
+        assertNull(viewModel.state.value.selected)
+        assertFalse(viewModel.state.value.isMissing)
+    }
+
+    @Test
+    fun `selecting a type writes through repository and emits selected`() = runTest(testScheduler) {
+        val fake = FakeWorkoutsRepository().apply { seed(listOf(workout())) }
+        val viewModel = viewModel(fake)
+        val effects = mutableListOf<UiEffect>()
+        backgroundScope.launch(UnconfinedTestDispatcher(testScheduler)) { viewModel.effect.toList(effects) }
+
+        viewModel.onAction(WorkoutTypePickerUiAction.OnTypeClick(WorkoutType.Cardio))
+        advanceUntilIdle()
+
+        assertEquals(WorkoutType.Cardio, fake.getWorkout(1L)?.type)
+        assertEquals(WorkoutType.Cardio, viewModel.state.value.selected)
+        assertEquals(listOf<UiEffect>(WorkoutTypePickerUiEffect.Selected), effects)
+    }
+
+    @Test
+    fun `double tap makes one repository write`() = runTest(testScheduler) {
+        val fake = FakeWorkoutsRepository().apply { seed(listOf(workout())) }
+        val viewModel = viewModel(fake)
+
+        viewModel.onAction(WorkoutTypePickerUiAction.OnTypeClick(WorkoutType.Cardio))
+        viewModel.onAction(WorkoutTypePickerUiAction.OnTypeClick(WorkoutType.Strength))
+        advanceUntilIdle()
+
+        assertEquals(1, fake.typeCalls)
+    }
+
+    @Test
+    fun `write failure surfaces as popup error and does not navigate`() = runTest(testScheduler) {
+        val fake = FakeWorkoutsRepository().apply {
+            seed(listOf(workout()))
+            shouldThrow = NetworkException.Connection()
+        }
+        val viewModel = viewModel(fake)
+        val errors = mutableListOf<com.example.core.error.AppError>()
+        val effects = mutableListOf<UiEffect>()
+        backgroundScope.launch(UnconfinedTestDispatcher(testScheduler)) { viewModel.errors.toList(errors) }
+        backgroundScope.launch(UnconfinedTestDispatcher(testScheduler)) { viewModel.effect.toList(effects) }
+
+        viewModel.onAction(WorkoutTypePickerUiAction.OnTypeClick(WorkoutType.Cardio))
+        advanceUntilIdle()
+
+        assertEquals(1, errors.size)
+        assertTrue(effects.isEmpty())
+        assertNull(viewModel.state.value.selected)
+    }
+
+    @Test
+    fun `load failure shows inline error then retry succeeds`() = runTest(testScheduler) {
+        val fake = FakeWorkoutsRepository().apply { shouldThrow = NetworkException.Connection() }
+        val viewModel = viewModel(fake)
+
+        viewModel.onAction(WorkoutTypePickerUiAction.OnScreenStarted)
+        advanceUntilIdle()
+        assertNotNull(viewModel.state.value.error)
+
+        fake.shouldThrow = null
+        fake.seed(listOf(workout(type = WorkoutType.Flexibility)))
+        viewModel.onAction(WorkoutTypePickerUiAction.OnRetryClick(viewModel.state.value.error!!))
+        advanceUntilIdle()
+
+        assertNull(viewModel.state.value.error)
+        assertEquals(WorkoutType.Flexibility, viewModel.state.value.selected)
+    }
+
+    @Test
+    fun `unknown workout sets isMissing with no AppError`() = runTest(testScheduler) {
+        val fake = FakeWorkoutsRepository().apply { seed(listOf(workout(id = 2L))) }
+        val viewModel = viewModel(fake, id = 1L)
+
+        viewModel.onAction(WorkoutTypePickerUiAction.OnScreenStarted)
+        advanceUntilIdle()
+
+        assertTrue(viewModel.state.value.isMissing)
+        assertNull(viewModel.state.value.error)
+    }
+
+    @Test
+    fun `overlapping loads make one read`() = runTest(testScheduler) {
+        val fake = FakeWorkoutsRepository().apply { seed(listOf(workout())) }
+        val viewModel = viewModel(fake)
+
+        viewModel.onAction(WorkoutTypePickerUiAction.OnScreenStarted)
+        viewModel.onAction(WorkoutTypePickerUiAction.OnScreenStarted)
+        advanceUntilIdle()
+
+        assertEquals(1, fake.getCalls)
+    }
+
+    @Test
+    fun `back emits navigate back`() = runTest(testScheduler) {
+        val viewModel = viewModel(FakeWorkoutsRepository())
+        val effects = mutableListOf<UiEffect>()
+        backgroundScope.launch(UnconfinedTestDispatcher(testScheduler)) { viewModel.effect.toList(effects) }
+
+        viewModel.onAction(WorkoutTypePickerUiAction.OnBackClick)
+        advanceUntilIdle()
+
+        assertEquals(listOf<UiEffect>(WorkoutTypePickerUiEffect.NavigateBack), effects)
+    }
+}
