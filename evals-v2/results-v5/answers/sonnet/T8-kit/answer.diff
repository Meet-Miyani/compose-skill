+package com.example.feature.workouts.presentation.quickadd
+
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.getValue
+import androidx.lifecycle.compose.collectAsStateWithLifecycle
+import com.example.core.mvi.CollectEffect
+import com.example.designsystem.error.HandleAppErrors
+
+@Composable
+fun QuickAddRoute(viewModel: QuickAddViewModel, onEffect: suspend (QuickAddUiEffect) -> Unit) {
+    val state by viewModel.state.collectAsStateWithLifecycle()
+    CollectEffect(viewModel.effect) { onEffect(it) }
+    HandleAppErrors(viewModel.errors)
+    QuickAddScreen(
+        state = state,
+        onTextChange = { viewModel.onAction(QuickAddUiAction.OnTextChanged(it)) },
+        onAdd = { viewModel.onAction(QuickAddUiAction.OnAddClick) },
+    )
+}
