+package com.example.feature.workouts.presentation.quickadd
+
+import androidx.lifecycle.SavedStateHandle
+import com.example.core.mvi.BaseViewModel
+import kotlinx.coroutines.Job
+import org.koin.core.annotation.KoinViewModel
+
+@KoinViewModel
+class QuickAddViewModel(private val savedStateHandle: SavedStateHandle) :
+    BaseViewModel<QuickAddUiAction, QuickAddUiState, QuickAddUiEffect>(
+        QuickAddUiState(text = savedStateHandle[TEXT_KEY] ?: ""),
+    ) {
+    private var addJob: Job? = null
+
+    override fun onAction(action: QuickAddUiAction) {
+        when (action) {
+            is QuickAddUiAction.OnTextChanged -> setText(action.text)
+            QuickAddUiAction.OnAddClick -> add()
+        }
+    }
+
+    private fun add() {
+        if (addJob?.isActive == true) return
+        addJob = launchGuarded(
+            onError = ::emitError,
+            onStart = { updateState { copy(isLoading = true) } },
+            onComplete = { updateState { copy(isLoading = false) } },
+        ) {
+            // save logic...
+            setText("")
+        }
+    }
+
+    private fun setText(text: String) {
+        savedStateHandle[TEXT_KEY] = text
+        updateState { copy(text = text) }
+    }
+
+    private companion object {
+        const val TEXT_KEY = "quickAddText"
+    }
+}
