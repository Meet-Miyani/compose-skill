+package com.example.feature.workouts.data.export
+
+import com.example.core.error.StorageException
+import com.example.feature.workouts.data.local.applicationContext
+import java.io.File
+import java.io.IOException
+
+internal actual fun createWorkoutsExportFileWriter(): WorkoutsExportFileWriter = AndroidWorkoutsExportFileWriter()
+
+/** Saves into the app's external files folder, which needs no storage permission. */
+private class AndroidWorkoutsExportFileWriter : WorkoutsExportFileWriter {
+    override suspend fun write(fileName: String, content: String): String {
+        val file = File(applicationContext.getExternalFilesDir(null) ?: applicationContext.filesDir, fileName)
+        try {
+            file.writeText(content)
+        } catch (e: IOException) {
+            throw StorageException(e)
+        }
+        return file.absolutePath
+    }
+}
