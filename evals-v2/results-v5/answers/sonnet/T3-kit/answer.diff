@@ -0,0 +1,21 @@
+package com.example.feature.workouts.data.export
+
+import com.example.feature.workouts.domain.model.Workout
+
+private const val LINE_END = "\r\n"
+
+/** RFC 4180 CSV of the workouts: header row, then one row per workout. Absent fields are empty cells. */
+internal fun List<Workout>.toCsv(): String = buildString {
+    append("id,title,body").append(LINE_END)
+    for (workout in this@toCsv) {
+        append(workout.id).append(',')
+        append(workout.title.toCsvField()).append(',')
+        append(workout.body.toCsvField()).append(LINE_END)
+    }
+}
+
+private fun String?.toCsvField(): String = when {
+    this == null -> ""
+    any { it == ',' || it == '"' || it == '\n' || it == '\r' } -> "\"${replace("\"", "\"\"")}\""
+    else -> this
+}
