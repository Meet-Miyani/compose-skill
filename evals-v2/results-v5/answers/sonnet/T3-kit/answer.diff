+package com.example.feature.workouts.data.export
+
+import com.example.core.error.StorageException
+import com.example.core.error.toAppError
+import com.example.feature.workouts.domain.export.WorkoutsExportStatus
+import com.example.feature.workouts.domain.export.WorkoutsExporter
+import com.example.feature.workouts.domain.repository.WorkoutsRepository
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.launch
+import org.koin.core.annotation.Single
+
+internal const val EXPORT_FILE_NAME = "workouts.csv"
+
+/** Process-lifetime scope the export runs in, so it outlives any screen. */
+internal class WorkoutsExportScope(val scope: CoroutineScope)
+
+/**
+ * Reads all workouts and writes them as CSV on [WorkoutsExportScope].
+ *
+ * One export at a time. Work does not survive process death; the user re-taps export.
+ */
+@Single
+internal class DefaultWorkoutsExporter(
+    private val repository: WorkoutsRepository,
+    private val writer: WorkoutsExportFileWriter,
+    private val exportScope: WorkoutsExportScope,
+) : WorkoutsExporter {
+    private val _status = MutableStateFlow<WorkoutsExportStatus>(WorkoutsExportStatus.Idle)
+    override val status: StateFlow<WorkoutsExportStatus> = _status.asStateFlow()
+    private var exportJob: Job? = null
+
+    override fun start() {
+        if (exportJob?.isActive == true) return
+        _status.value = WorkoutsExportStatus.Running
+        exportJob = exportScope.scope.launch {
+            _status.value = try {
+                WorkoutsExportStatus.Done(writer.write(EXPORT_FILE_NAME, repository.getWorkouts().toCsv()))
+            } catch (e: StorageException) {
+                WorkoutsExportStatus.Failed(e.toAppError())
+            }
+        }
+    }
+}
