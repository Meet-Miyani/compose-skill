+package com.example.feature.workouts.domain.export
+
+import kotlinx.coroutines.flow.StateFlow
+
+/**
+ * Exports every workout to a CSV file in the background.
+ *
+ * The work outlives the screen that starts it: a screen calls [start] and
+ * observes [status], and leaving the screen does not cancel the export.
+ */
+interface WorkoutsExporter {
+    val status: StateFlow<WorkoutsExportStatus>
+
+    /** Starts an export. Does nothing while one is already running. */
+    fun start()
+}
