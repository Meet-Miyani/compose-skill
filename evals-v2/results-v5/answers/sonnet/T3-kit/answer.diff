+import kotlinx.coroutines.test.StandardTestDispatcher
+import kotlinx.coroutines.test.TestCoroutineScheduler
+import kotlinx.coroutines.test.advanceUntilIdle
+import kotlinx.coroutines.test.runTest
+import kotlinx.coroutines.CoroutineScope
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertIs
+
+@OptIn(ExperimentalCoroutinesApi::class)
+class DefaultWorkoutsExporterTest {
+    private val scheduler = TestCoroutineScheduler()
+
+    private class FakeFileWriter : WorkoutsExportFileWriter {
+        var failure: StorageException? = null
+        val writes = mutableListOf<Pair<String, String>>()
+
+        override suspend fun write(fileName: String, content: String): String {
+            failure?.let { throw it }
+            writes += fileName to content
+            return "/exports/$fileName"
+        }
+    }
+
+    // Queuing dispatcher on the shared scheduler, so the Running frame stays observable until the test advances.
+    private fun exporter(repository: FakeWorkoutsRepository, writer: FakeFileWriter) =
+        DefaultWorkoutsExporter(repository, writer, WorkoutsExportScope(CoroutineScope(StandardTestDispatcher(scheduler))))
+
+    @Test fun `export writes every workout and reports the location`() = runTest(scheduler) {
+        val repository = FakeWorkoutsRepository().apply { seed(listOf(Workout(2, "Run", "5k", null), Workout(1, "Squats", "3x5", null))) }
+        val writer = FakeFileWriter()
+        val exporter = exporter(repository, writer)
+
+        exporter.start()
+        assertEquals(WorkoutsExportStatus.Running, exporter.status.value)
+        advanceUntilIdle()
+
+        assertEquals(WorkoutsExportStatus.Done("/exports/workouts.csv"), exporter.status.value)
+        assertEquals("workouts.csv" to "id,title,body\r\n1,Squats,3x5\r\n2,Run,5k\r\n", writer.writes.single())
+    }
+
+    @Test fun `storage failure becomes Failed with the storage error`() = runTest(scheduler) {
+        val writer = FakeFileWriter().apply { failure = StorageException(RuntimeException("disk full")) }
+        val exporter = exporter(FakeWorkoutsRepository(), writer)
+
+        exporter.start()
+        advanceUntilIdle()
+
+        val failed = assertIs<WorkoutsExportStatus.Failed>(exporter.status.value)
+        assertEquals(AppErrorType.Storage, failed.error.type)
+    }
+
+    @Test fun `start while running does not export twice`() = runTest(scheduler) {
+        val repository = FakeWorkoutsRepository().apply { gate = CompletableDeferred() }
+        val writer = FakeFileWriter()
+        val exporter = exporter(repository, writer)
+
+        exporter.start()
+        exporter.start()
+        repository.gate?.complete(Unit)
+        advanceUntilIdle()
+
+        assertEquals(1, writer.writes.size)
+    }
+
+    @Test fun `export can run again after it finished`() = runTest(scheduler) {
+        val writer = FakeFileWriter()
+        val exporter = exporter(FakeWorkoutsRepository(), writer)
+
+        exporter.start()
