+import com.example.feature.workouts.domain.export.WorkoutsExporter
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+
+/** Test-only exporter: tests push [status] by hand and count [startCalls]. */
+class FakeWorkoutsExporter : WorkoutsExporter {
+    private val backing = MutableStateFlow<WorkoutsExportStatus>(WorkoutsExportStatus.Idle)
+    var startCalls: Int = 0
+
+    override val status: StateFlow<WorkoutsExportStatus> = backing
+
+    override fun start() {
+        startCalls += 1
+        backing.value = WorkoutsExportStatus.Running
+    }
+
+    fun emit(status: WorkoutsExportStatus) {
+        backing.value = status
+    }
+}
