+package com.example.feature.workouts.data.export
+
+import com.example.core.error.StorageException
+import java.io.File
+import java.io.IOException
+
+internal actual fun createWorkoutsExportFileWriter(): WorkoutsExportFileWriter = JvmWorkoutsExportFileWriter()
+
+/** Saves into the user's Downloads folder, or the home folder when there is none. */
+private class JvmWorkoutsExportFileWriter : WorkoutsExportFileWriter {
+    override suspend fun write(fileName: String, content: String): String {
+        val home = File(System.getProperty("user.home"))
+        val file = File(File(home, "Downloads").takeIf(File::isDirectory) ?: home, fileName)
+        try {
+            file.writeText(content)
+        } catch (e: IOException) {
+            throw StorageException(e)
+        }
+        return file.absolutePath
+    }
+}
