+/**
+ * Lifecycle-aware wrapper for the workout type picker destination.
+ *
+ * Koin-free: the composition root resolves the ViewModel and passes it in.
+ */
+package com.example.feature.workouts.presentation.type
+
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.LaunchedEffect
+import androidx.compose.runtime.getValue
+import androidx.lifecycle.compose.collectAsStateWithLifecycle
+import com.example.core.mvi.CollectEffect
+import com.example.designsystem.error.HandleAppErrors
+
+/** Entry for the type picker destination; owns start, effect collection, and error forwarding. */
+@Composable
+fun WorkoutTypeRoute(
+    viewModel: WorkoutTypeViewModel,
+    onEffect: suspend (WorkoutTypeUiEffect) -> Unit,
+) {
+    LaunchedEffect(Unit) { viewModel.onAction(WorkoutTypeUiAction.OnScreenStarted) }
+    val state by viewModel.state.collectAsStateWithLifecycle()
+    CollectEffect(viewModel.effect) { effect -> onEffect(effect) }
+    HandleAppErrors(viewModel.errors)
+    WorkoutTypeScreen(
+        state = state,
+        onType = { viewModel.onAction(WorkoutTypeUiAction.OnTypeClick(it)) },
+        onBack = { viewModel.onAction(WorkoutTypeUiAction.OnBackClick) },
+    )
+}
