+/**
+ * Stateless content for the workout type picker destination.
+ */
+package com.example.feature.workouts.presentation.type
+
+import androidx.compose.foundation.layout.Column
+import androidx.compose.foundation.layout.fillMaxSize
+import androidx.compose.foundation.layout.padding
+import androidx.compose.material3.Button
+import androidx.compose.material3.FilterChip
+import androidx.compose.material3.Text
+import androidx.compose.runtime.Composable
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.unit.dp
+import com.example.feature.workouts.domain.model.WorkoutType
+import org.jetbrains.compose.resources.StringResource
+import org.jetbrains.compose.resources.stringResource
+import workouts.feature.workouts.generated.resources.Res
+import workouts.feature.workouts.generated.resources.back
+import workouts.feature.workouts.generated.resources.pick_workout_type
+import workouts.feature.workouts.generated.resources.type_cardio
+import workouts.feature.workouts.generated.resources.type_flexibility
+import workouts.feature.workouts.generated.resources.type_strength
+
+/** Display label for a workout type. */
+fun WorkoutType.labelRes(): StringResource = when (this) {
+    WorkoutType.Cardio -> Res.string.type_cardio
+    WorkoutType.Strength -> Res.string.type_strength
+    WorkoutType.Flexibility -> Res.string.type_flexibility
+}
+
+@Composable
+fun WorkoutTypeScreen(
+    state: WorkoutTypeUiState,
+    onType: (WorkoutType) -> Unit,
+    onBack: () -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    Column(modifier.fillMaxSize().padding(16.dp)) {
+        Text(stringResource(Res.string.pick_workout_type))
+        state.options.forEach { type ->
+            FilterChip(
+                selected = type == state.selected,
+                onClick = { onType(type) },
+                label = { Text(stringResource(type.labelRes())) },
+            )
+        }
+        Button(onClick = onBack) { Text(stringResource(Res.string.back)) }
+    }
+}
