+
+    @Test
+    fun `typed title is written to saved state and survives recreation`() = runTest(testScheduler) {
+        val fake = FakeWorkoutsRepository().apply { seed(listOf(workout())) }
+        val handle = SavedStateHandle()
+        val first = viewModel(fake, handle = handle)
+        first.onAction(WorkoutsUiAction.OnScreenStarted)
+        advanceUntilIdle()
+
+        first.onAction(WorkoutsUiAction.OnTitleChanged("half-typed"))
+
+        assertEquals("half-typed", handle["draftTitle"])
+
+        // New ViewModel on the same handle, as after process death.
+        val second = viewModel(fake, handle = handle)
+        second.onAction(WorkoutsUiAction.OnScreenStarted)
+        advanceUntilIdle()
+
+        assertEquals("half-typed", second.state.value.draftTitle)
+    }
 }
