+package com.example.feature.workouts.presentation.workouts
+
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.rememberUpdatedState
+import java.awt.FileDialog
+import java.awt.Frame
+
+private val imageExtensions = setOf("jpg", "jpeg", "png", "gif", "bmp", "webp")
+
+@Composable
+internal actual fun rememberPhotoPicker(onPicked: (String) -> Unit): (() -> Unit)? {
+    val currentOnPicked = rememberUpdatedState(onPicked)
+    return remember {
+        {
+            val dialog = FileDialog(null as Frame?, "Select photo", FileDialog.LOAD).apply {
+                setFilenameFilter { _, name -> name.substringAfterLast('.', "").lowercase() in imageExtensions }
+                isVisible = true
+            }
+            val file = dialog.file
+            if (file != null) currentOnPicked.value(dialog.directory + file)
+        }
+    }
+}
