+package com.example.feature.workouts.data.local
+
+import com.example.core.error.StorageException
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+import java.io.File
+import java.io.IOException
+
+internal actual fun createWorkoutPhotoStore(): WorkoutPhotoStore = JvmWorkoutPhotoStore()
+
+/** Copies picked photos next to the database under `~/.workouts-app`. */
+private class JvmWorkoutPhotoStore : WorkoutPhotoStore {
+    override suspend fun save(workoutId: Long, sourceUri: String): String = withContext(Dispatchers.IO) {
+        val source = File(sourceUri)
+        val directory = File(System.getProperty("user.home"), ".workouts-app/photos")
+        val target = File(directory, "workout-$workoutId-${System.currentTimeMillis()}.${source.extension.ifEmpty { "jpg" }}")
+        try {
+            directory.mkdirs()
+            source.copyTo(target)
+            target.absolutePath
+        } catch (e: IOException) {
+            target.delete()
+            throw StorageException(e)
+        }
+    }
+
+    override suspend fun delete(path: String) {
+        withContext(Dispatchers.IO) { File(path).delete() }
+    }
+}
