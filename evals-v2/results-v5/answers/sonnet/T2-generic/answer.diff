+
+/** String resource naming a [WorkoutType]; shared by the picker, detail and list screens. */
+fun WorkoutType.labelRes(): StringResource = when (this) {
+    WorkoutType.Cardio -> Res.string.type_cardio
+    WorkoutType.Strength -> Res.string.type_strength
+    WorkoutType.Flexibility -> Res.string.type_flexibility
+}
+
+@Composable
+fun WorkoutTypeScreen(
+    state: WorkoutTypeUiState,
+    onType: (WorkoutType) -> Unit,
+    onRetry: () -> Unit,
+    onBack: () -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    Column(modifier.fillMaxSize().padding(16.dp)) {
+        Text(stringResource(Res.string.choose_type_title))
+        when {
+            state.isLoading -> CircularProgressIndicator()
+            state.error != null -> {
+                Text(stringResource(Res.string.error_message))
+                Button(onClick = onRetry) { Text(stringResource(Res.string.retry)) }
+            }
+            else -> Column(Modifier.selectableGroup()) {
+                WorkoutType.entries.forEach { type ->
+                    Row(
+                        Modifier
+                            .fillMaxWidth()
+                            .heightIn(min = 48.dp)
+                            .selectable(selected = state.selected == type, role = Role.RadioButton, onClick = { onType(type) }),
+                        verticalAlignment = Alignment.CenterVertically,
+                    ) {
+                        // The row owns the click and semantics; the radio only draws the state.
+                        RadioButton(selected = state.selected == type, onClick = null)
+                        Text(stringResource(type.labelRes()), Modifier.padding(start = 16.dp))
+                    }
+                }
+            }
+        }
+        Button(onClick = onBack) { Text(stringResource(Res.string.back)) }
+    }
+}
