@@ -0,0 +1,136 @@
+package com.example.feature.workouts.presentation.workouts
+
+import com.example.core.error.NetworkException
+import com.example.core.mvi.UiEffect
+import com.example.feature.workouts.domain.model.Workout
+import com.example.feature.workouts.domain.model.WorkoutType
+import com.example.feature.workouts.presentation.type.WorkoutTypeParams
+import com.example.feature.workouts.presentation.type.WorkoutTypeUiAction
+import com.example.feature.workouts.presentation.type.WorkoutTypeUiEffect
+import com.example.feature.workouts.presentation.type.WorkoutTypeViewModel
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.ExperimentalCoroutinesApi
+import kotlinx.coroutines.flow.toList
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.test.StandardTestDispatcher
+import kotlinx.coroutines.test.TestCoroutineScheduler
+import kotlinx.coroutines.test.UnconfinedTestDispatcher
+import kotlinx.coroutines.test.advanceUntilIdle
+import kotlinx.coroutines.test.resetMain
+import kotlinx.coroutines.test.runTest
+import kotlinx.coroutines.test.setMain
+import kotlin.test.AfterTest
+import kotlin.test.BeforeTest
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertFalse
+import kotlin.test.assertNotNull
+import kotlin.test.assertNull
+
+/** ViewModel tests for the workout type picker. */
+@OptIn(ExperimentalCoroutinesApi::class)
+class WorkoutTypeViewModelTest {
+    private val testScheduler = TestCoroutineScheduler()
+
+    @BeforeTest
+    fun setUp() {
+        Dispatchers.setMain(StandardTestDispatcher(testScheduler))
+    }
+
+    @AfterTest
+    fun tearDown() {
+        Dispatchers.resetMain()
+    }
+
+    private fun workout(type: WorkoutType? = null) = Workout(id = 1L, title = "T", body = "", updatedAt = null, type = type)
+
+    private fun viewModel(fake: FakeWorkoutsRepository) = WorkoutTypeViewModel(
+        repository = fake,
+        params = WorkoutTypeParams(workoutId = 1L),
+        ioDispatcher = StandardTestDispatcher(testScheduler),
+    )
+
+    @Test
+    fun `load preselects current type`() = runTest(testScheduler) {
+        val fake = FakeWorkoutsRepository().apply { seed(listOf(workout(WorkoutType.Strength))) }
+        val viewModel = viewModel(fake)
+
+        viewModel.onAction(WorkoutTypeUiAction.OnScreenStarted)
+        advanceUntilIdle()
+
+        assertEquals(WorkoutType.Strength, viewModel.state.value.selected)
+        assertFalse(viewModel.state.value.isLoading)
+    }
+
+    @Test
+    fun `workout without a type has no selection`() = runTest(testScheduler) {
+        val fake = FakeWorkoutsRepository().apply { seed(listOf(workout())) }
+        val viewModel = viewModel(fake)
+
+        viewModel.onAction(WorkoutTypeUiAction.OnScreenStarted)
+        advanceUntilIdle()
+
+        assertNull(viewModel.state.value.selected)
+    }
+
+    @Test
+    fun `selecting a type persists it and navigates back`() = runTest(testScheduler) {
+        val fake = FakeWorkoutsRepository().apply { seed(listOf(workout())) }
+        val viewModel = viewModel(fake)
+        val effects = mutableListOf<UiEffect>()
+        backgroundScope.launch(UnconfinedTestDispatcher(testScheduler)) { viewModel.effect.toList(effects) }
+
+        viewModel.onAction(WorkoutTypeUiAction.OnTypeClick(WorkoutType.Cardio))
+        advanceUntilIdle()
+
+        assertEquals(1L to WorkoutType.Cardio, fake.lastSavedType)
+        assertEquals(WorkoutType.Cardio, viewModel.state.value.selected)
+        assertEquals(listOf<UiEffect>(WorkoutTypeUiEffect.NavigateBack), effects)
+    }
+
+    @Test
+    fun `double tap makes one repository write`() = runTest(testScheduler) {
+        val fake = FakeWorkoutsRepository().apply { seed(listOf(workout())) }
+        val viewModel = viewModel(fake)
+
+        viewModel.onAction(WorkoutTypeUiAction.OnTypeClick(WorkoutType.Cardio))
+        viewModel.onAction(WorkoutTypeUiAction.OnTypeClick(WorkoutType.Strength))
+        advanceUntilIdle()
+
+        assertEquals(1, fake.typeCalls)
+    }
+
+    @Test
+    fun `failed save emits popup error and stays on screen`() = runTest(testScheduler) {
+        val fake = FakeWorkoutsRepository().apply { seed(listOf(workout())); shouldThrow = NetworkException.Connection() }
+        val viewModel = viewModel(fake)
+        val effects = mutableListOf<UiEffect>()
+        val errors = mutableListOf<com.example.core.error.AppError>()
+        backgroundScope.launch(UnconfinedTestDispatcher(testScheduler)) { viewModel.effect.toList(effects) }
+        backgroundScope.launch(UnconfinedTestDispatcher(testScheduler)) { viewModel.errors.toList(errors) }
+
+        viewModel.onAction(WorkoutTypeUiAction.OnTypeClick(WorkoutType.Cardio))
+        advanceUntilIdle()
+
+        assertEquals(1, errors.size)
+        assertEquals(emptyList<UiEffect>(), effects)
+        assertNull(viewModel.state.value.selected)
+    }
+
+    @Test
+    fun `load failure shows inline error then retry recovers`() = runTest(testScheduler) {
+        val fake = FakeWorkoutsRepository().apply { seed(listOf(workout(WorkoutType.Cardio))); shouldThrow = NetworkException.Connection() }
+        val viewModel = viewModel(fake)
+
+        viewModel.onAction(WorkoutTypeUiAction.OnScreenStarted)
+        advanceUntilIdle()
+        assertNotNull(viewModel.state.value.error)
+
+        fake.shouldThrow = null
+        viewModel.onAction(WorkoutTypeUiAction.OnRetryClick(viewModel.state.value.error!!))
+        advanceUntilIdle()
+
+        assertNull(viewModel.state.value.error)
+        assertEquals(WorkoutType.Cardio, viewModel.state.value.selected)
+    }
+}
