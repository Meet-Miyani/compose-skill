+/**
+ * MVI contract for the workout type picker destination.
+ */
+package com.example.feature.workouts.presentation.type
+
+import com.example.core.error.AppError
+import com.example.core.mvi.UiAction
+import com.example.core.mvi.UiEffect
+import com.example.core.mvi.UiState
+import com.example.feature.workouts.domain.model.WorkoutType
+
+data class WorkoutTypeUiState(
+    val selected: WorkoutType? = null,
+    val isLoading: Boolean = true,
+    val error: AppError? = null,
+) : UiState
+
+sealed interface WorkoutTypeUiAction : UiAction {
+    data object OnScreenStarted : WorkoutTypeUiAction
+    data class OnTypeClick(val type: WorkoutType) : WorkoutTypeUiAction
+    data class OnRetryClick(val error: AppError) : WorkoutTypeUiAction
+    data object OnBackClick : WorkoutTypeUiAction
+}
+
+sealed interface WorkoutTypeUiEffect : UiEffect {
+    data object NavigateBack : WorkoutTypeUiEffect
+}
