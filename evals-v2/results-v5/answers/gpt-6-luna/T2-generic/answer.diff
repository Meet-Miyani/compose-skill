+package com.example.feature.workouts.presentation.list
+
+import androidx.compose.runtime.Composable
+import com.example.core.mvi.CollectEffect
+import com.example.designsystem.error.HandleAppErrors
+import com.example.feature.workouts.navigation.WorkoutType
+
+@Composable
+fun WorkoutTypeSelectionRoute(
+    viewModel: WorkoutsListViewModel,
+    onEffect: suspend (WorkoutsListUiEffect) -> Unit,
+) {
+    CollectEffect(viewModel.effect) { onEffect(it) }
+    HandleAppErrors(viewModel.errors)
+    WorkoutTypeSelectionScreen(onSelect = viewModel::onWorkoutTypeSelected)
+}
