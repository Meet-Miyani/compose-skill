+package com.example.feature.workouts.presentation.list
+
+import androidx.lifecycle.SavedStateHandle
+import com.example.core.mvi.BaseViewModel
+import org.koin.core.annotation.KoinViewModel
+
+@KoinViewModel
+class QuickAddViewModel(
+    private val savedStateHandle: SavedStateHandle,
+) : BaseViewModel<QuickAddUiAction, QuickAddUiState, QuickAddUiEffect>(
+    QuickAddUiState(workoutName = savedStateHandle[WORKOUT_NAME_KEY] ?: ""),
+) {
+    override fun onAction(action: QuickAddUiAction) {
+        when (action) {
+            is QuickAddUiAction.OnWorkoutNameChanged -> {
+                savedStateHandle[WORKOUT_NAME_KEY] = action.name
+                updateState { copy(workoutName = action.name) }
+            }
+            QuickAddUiAction.OnAddClick -> add()
+        }
+    }
+
+    private fun add() {
+        updateState { copy(isLoading = true) }
+        // Preserve the existing Quick Add stub behavior: the add operation
+        // completes immediately and clears the input.
+        updateState { copy(isLoading = false, workoutName = "") }
+        savedStateHandle[WORKOUT_NAME_KEY] = ""
+    }
+
+    private companion object {
+        const val WORKOUT_NAME_KEY = "quickAddWorkoutName"
+    }
+}
