+package com.example.feature.workouts.presentation.list
+
+import androidx.lifecycle.SavedStateHandle
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertFalse
+
+class QuickAddViewModelTest {
+    @Test
+    fun `name is restored and add clears it`() {
+        val handle = SavedStateHandle()
+        val viewModel = QuickAddViewModel(handle)
+
+        viewModel.onAction(QuickAddUiAction.OnWorkoutNameChanged("Intervals"))
+        assertEquals("Intervals", viewModel.state.value.workoutName)
+
+        val recreatedViewModel = QuickAddViewModel(handle)
+        assertEquals("Intervals", recreatedViewModel.state.value.workoutName)
+
+        recreatedViewModel.onAction(QuickAddUiAction.OnAddClick)
+        assertEquals("", recreatedViewModel.state.value.workoutName)
+        assertFalse(recreatedViewModel.state.value.isLoading)
+    }
+}
