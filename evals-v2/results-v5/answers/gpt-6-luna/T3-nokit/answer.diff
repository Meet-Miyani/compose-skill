+        if (exportJob?.isActive == true) return
+        val workouts = currentState.items
+        exportJob = launchGuarded(
+            onError = { updateState { copy(isExporting = false) }; emitError(it) },
+            onStart = { updateState { copy(isExporting = true, exportedCsv = null) } },
+            onComplete = { updateState { copy(isExporting = false) } },
+        ) {
+            val csv = withContext(Dispatchers.Default) {
+                buildString {
+                    appendLine("id,title,body,updated_at,is_archived")
+                    workouts.forEach { workout ->
+                        append(workout.id).append(',')
+                        append(csvCell(workout.title)).append(',')
+                        append(csvCell(workout.body)).append(',')
+                        append(csvCell(workout.updatedAt?.toString())).append(',')
+                        append(workout.isArchived).appendLine()
+                    }
+                }
+            }
+            updateState { copy(exportedCsv = csv) }
+        }
+    }
+
+    private fun csvCell(value: String?): String {
