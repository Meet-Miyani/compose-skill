+package com.example.feature.workouts.presentation.typepicker
+
+import com.example.core.mvi.BaseViewModel
+import com.example.feature.workouts.domain.repository.WorkoutsRepository
+import org.koin.core.annotation.KoinViewModel
+
+@KoinViewModel
+class WorkoutTypePickerViewModel(private val repository: WorkoutsRepository) :
+    BaseViewModel<WorkoutTypePickerUiAction, WorkoutTypePickerUiState, WorkoutTypePickerUiEffect>(WorkoutTypePickerUiState()) {
+    private var createJob: kotlinx.coroutines.Job? = null
+
+    override fun onAction(action: WorkoutTypePickerUiAction) {
+        when (action) {
+            is WorkoutTypePickerUiAction.OnTypeSelected -> create(action.title)
+            WorkoutTypePickerUiAction.OnBackClick -> sendEffect(WorkoutTypePickerUiEffect.NavigateBack)
+        }
+    }
+
+    private fun create(title: String) {
+        if (createJob?.isActive == true) return
+        updateState { copy(isCreating = true) }
+        createJob = launchGuarded(
+            onError = { error -> updateState { copy(isCreating = false) }; emitError(error) },
+            onComplete = { updateState { copy(isCreating = false) } },
+        ) {
+            sendEffect(WorkoutTypePickerUiEffect.OpenWorkout(repository.addWorkout(title)))
+        }
+    }
+}
