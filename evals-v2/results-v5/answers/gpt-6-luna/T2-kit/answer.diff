+package com.example.feature.workouts.presentation.typepicker
+
+import androidx.compose.foundation.layout.Column
+import androidx.compose.foundation.layout.fillMaxSize
+import androidx.compose.foundation.layout.padding
+import androidx.compose.material3.Button
+import androidx.compose.material3.Text
+import androidx.compose.runtime.Composable
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.unit.dp
+import org.jetbrains.compose.resources.stringResource
+import workouts.feature.workouts.generated.resources.Res
+import workouts.feature.workouts.generated.resources.back
+import workouts.feature.workouts.generated.resources.cardio
+import workouts.feature.workouts.generated.resources.flexibility
+import workouts.feature.workouts.generated.resources.strength
+import workouts.feature.workouts.generated.resources.workout_type_title
+
+@Composable
+fun WorkoutTypePickerScreen(
+    state: WorkoutTypePickerUiState,
+    onTypeSelected: (String) -> Unit,
+    onBack: () -> Unit,
+) {
+    val cardioTitle = stringResource(Res.string.cardio)
+    val strengthTitle = stringResource(Res.string.strength)
+    val flexibilityTitle = stringResource(Res.string.flexibility)
+    Column(Modifier.fillMaxSize().padding(16.dp)) {
+        Text(stringResource(Res.string.workout_type_title))
+        Button(enabled = !state.isCreating, onClick = { onTypeSelected(cardioTitle) }) { Text(cardioTitle) }
+        Button(enabled = !state.isCreating, onClick = { onTypeSelected(strengthTitle) }) { Text(strengthTitle) }
+        Button(enabled = !state.isCreating, onClick = { onTypeSelected(flexibilityTitle) }) { Text(flexibilityTitle) }
+        Button(enabled = !state.isCreating, onClick = onBack) { Text(stringResource(Res.string.back)) }
+    }
+}
