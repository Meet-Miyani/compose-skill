+package com.example.feature.workouts.data.local
+
+import java.io.File
+
+internal actual suspend fun saveWorkoutPhoto(workoutId: Long, bytes: ByteArray): String {
+    val directory = File(System.getProperty("user.home"), ".workouts-app/workout-photos").apply { mkdirs() }
+    val file = File(directory, "$workoutId.jpg")
+    file.writeBytes(bytes)
+    return file.absolutePath
+}
