+package com.example.feature.workouts.data.local
+
+import kotlinx.cinterop.BetaInteropApi
+import kotlinx.cinterop.ExperimentalForeignApi
+import kotlinx.cinterop.addressOf
+import kotlinx.cinterop.usePinned
+import platform.Foundation.NSDocumentDirectory
+import platform.Foundation.NSData
+import platform.Foundation.NSFileManager
+import platform.Foundation.NSUserDomainMask
+import platform.Foundation.create
+
+@OptIn(ExperimentalForeignApi::class, BetaInteropApi::class)
+internal actual suspend fun saveWorkoutPhoto(workoutId: Long, bytes: ByteArray): String {
+    val directory = NSFileManager.defaultManager.URLForDirectory(
+        NSDocumentDirectory, NSUserDomainMask, null, true, null,
+    )?.path ?: error("Documents directory unavailable")
+    val folder = "$directory/workout-photos"
+    NSFileManager.defaultManager.createDirectoryAtPath(folder, true, null, null)
+    val path = "$folder/$workoutId.jpg"
+    val data = bytes.usePinned { pinned -> NSData.create(bytes = pinned.addressOf(0), length = bytes.size.toULong()) }
+    if (!NSFileManager.defaultManager.createFileAtPath(path, data, null)) error("Unable to save workout photo")
+    return path
+}
