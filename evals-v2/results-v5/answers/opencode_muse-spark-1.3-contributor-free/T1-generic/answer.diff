+package com.example.feature.workouts.data.local
+
+import com.example.core.error.StorageException
+import java.io.File
+
+internal actual fun createWorkoutPhotoStorage(): WorkoutPhotoStorage =
+    JvmWorkoutPhotoStorage(
+        directory = File(System.getProperty("user.home"), ".workouts-app/workout_photos"),
+    )
+
+internal class JvmWorkoutPhotoStorage(
+    private val directory: File,
+) : WorkoutPhotoStorage {
+    override suspend fun savePhoto(workoutId: Long, bytes: ByteArray): String {
+        try {
+            if (!directory.exists() && !directory.mkdirs() && !directory.exists()) {
+                throw StorageException(IllegalStateException("Cannot create $directory"))
+            }
+            val file = File(directory, "workout_$workoutId.jpg")
+            file.writeBytes(bytes)
+            return file.absolutePath
+        } catch (e: StorageException) {
+            throw e
+        } catch (e: Exception) {
+            throw StorageException(e)
+        }
+    }
+}
