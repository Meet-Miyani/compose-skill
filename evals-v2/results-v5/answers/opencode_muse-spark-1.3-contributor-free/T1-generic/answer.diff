@@ -0,0 +1,45 @@
+package com.example.feature.workouts.data.local
+
+import com.example.core.error.StorageException
+import kotlinx.cinterop.ExperimentalForeignApi
+import kotlinx.cinterop.addressOf
+import kotlinx.cinterop.usePinned
+import platform.Foundation.NSData
+import platform.Foundation.NSDocumentDirectory
+import platform.Foundation.NSFileManager
+import platform.Foundation.NSUserDomainMask
+import platform.Foundation.create
+import platform.Foundation.writeToFile
+
+@OptIn(ExperimentalForeignApi::class)
+internal actual fun createWorkoutPhotoStorage(): WorkoutPhotoStorage = IosWorkoutPhotoStorage()
+
+@OptIn(ExperimentalForeignApi::class)
+internal class IosWorkoutPhotoStorage : WorkoutPhotoStorage {
+    override suspend fun savePhoto(workoutId: Long, bytes: ByteArray): String {
+        try {
+            val documents = NSFileManager.defaultManager.URLForDirectory(
+                NSDocumentDirectory, NSUserDomainMask, null, true, null,
+            )?.path ?: throw StorageException(IllegalStateException("Documents directory unavailable"))
+            val directory = "$documents/workout_photos"
+            NSFileManager.defaultManager.createDirectoryAtPath(
+                directory, true, null, null,
+            )
+            val path = "$directory/workout_$workoutId.jpg"
+            val data = bytes.toNSData()
+            if (!data.writeToFile(path, true)) {
+                throw StorageException(IllegalStateException("Cannot write $path"))
+            }
+            return path
+        } catch (e: StorageException) {
+            throw e
+        } catch (e: Exception) {
+            throw StorageException(e)
+        }
+    }
+}
+
+@OptIn(ExperimentalForeignApi::class, kotlinx.cinterop.BetaInteropApi::class)
+internal fun ByteArray.toNSData(): NSData = usePinned { pinned ->
+    NSData.create(pinned.addressOf(0), size.toULong())
+}
