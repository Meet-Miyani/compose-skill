+package com.example.feature.workouts.presentation.quickadd
+
+import androidx.lifecycle.SavedStateHandle
+import com.example.core.mvi.BaseViewModel
+import org.koin.core.annotation.KoinViewModel
+
+/** ViewModel behind Quick Add; owns the draft and the loading flag. */
+@KoinViewModel
+class QuickAddViewModel(
+    private val savedStateHandle: SavedStateHandle,
+) : BaseViewModel<QuickAddUiAction, QuickAddUiState, QuickAddUiEffect>(
+    QuickAddUiState(draft = savedStateHandle["draft"] ?: ""),
+) {
+
+    override fun onAction(action: QuickAddUiAction) {
+        when (action) {
+            is QuickAddUiAction.OnTextChanged -> {
+                savedStateHandle["draft"] = action.text
+                updateState { copy(draft = action.text) }
+            }
+            QuickAddUiAction.OnAddClick -> add()
+        }
+    }
+
+    private fun add() {
+        if (currentState.isLoading) return
+        updateState { copy(isLoading = true) }
+        savedStateHandle["draft"] = ""
+        updateState { copy(draft = "", isLoading = false) }
+    }
+}
