+package com.example.feature.workouts.presentation.quickadd
+
+import com.example.core.mvi.UiAction
+import com.example.core.mvi.UiEffect
+import com.example.core.mvi.UiState
+
+data class QuickAddUiState(
+    val draft: String = "",
+    val isLoading: Boolean = false,
+) : UiState
+
+sealed interface QuickAddUiAction : UiAction {
+    data class OnTextChanged(val text: String) : QuickAddUiAction
+    data object OnAddClick : QuickAddUiAction
+}
+
+sealed interface QuickAddUiEffect : UiEffect
