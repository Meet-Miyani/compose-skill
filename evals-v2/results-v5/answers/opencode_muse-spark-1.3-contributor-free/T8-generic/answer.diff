+package com.example.feature.workouts.presentation.list
+
+import androidx.compose.foundation.layout.Column
+import androidx.compose.material3.Button
+import androidx.compose.material3.CircularProgressIndicator
+import androidx.compose.material3.OutlinedTextField
+import androidx.compose.material3.Text
+import androidx.compose.runtime.Composable
+import androidx.compose.ui.Modifier
+import org.jetbrains.compose.resources.stringResource
+import workouts.feature.workouts.generated.resources.Res
+import workouts.feature.workouts.generated.resources.add_workout
+import workouts.feature.workouts.generated.resources.workout_title
+
+@Composable
+fun QuickAddScreen(
+    state: QuickAddUiState,
+    onTextChanged: (String) -> Unit,
+    onAddClick: () -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    Column(modifier = modifier) {
+        OutlinedTextField(
+            value = state.text,
+            onValueChange = onTextChanged,
+            label = { Text(stringResource(Res.string.workout_title)) },
+            enabled = !state.isLoading,
+        )
+        Button(
+            onClick = onAddClick,
+            enabled = !state.isLoading,
+        ) {
+            Text(stringResource(Res.string.add_workout))
+        }
+        if (state.isLoading) {
+            CircularProgressIndicator()
+        }
+    }
+}
