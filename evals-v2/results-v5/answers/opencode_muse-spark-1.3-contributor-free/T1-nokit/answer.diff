+package com.example.feature.workouts.data.local
+
+import com.example.core.error.StorageException
+import kotlinx.cinterop.BetaInteropApi
+import kotlinx.cinterop.ExperimentalForeignApi
+import kotlinx.cinterop.addressOf
+import kotlinx.cinterop.usePinned
+import platform.Foundation.NSData
+import platform.Foundation.NSDocumentDirectory
+import platform.Foundation.NSFileManager
+import platform.Foundation.NSUserDomainMask
+import platform.Foundation.create
+import platform.Foundation.writeToFile
+
+@OptIn(ExperimentalForeignApi::class, BetaInteropApi::class)
+internal actual class WorkoutPhotoStorage {
+    actual suspend fun savePhoto(workoutId: Long, bytes: ByteArray): String {
+        try {
+            val directory = NSFileManager.defaultManager.URLForDirectory(
+                NSDocumentDirectory, NSUserDomainMask, null, true, null,
+            )?.path ?: throw IllegalStateException("Documents directory unavailable")
+            val dir = "$directory/workout_photos"
+            NSFileManager.defaultManager.createDirectoryAtPath(dir, true, null, null)
+            val path = "$dir/photo_$workoutId.jpg"
+            val data = bytes.usePinned { pinned ->
+                if (bytes.isEmpty()) {
+                    NSData()
+                } else {
+                    NSData.create(bytes = pinned.addressOf(0), length = bytes.size.toULong())
+                }
+            }
+            if (!data.writeToFile(path, true)) {
+                throw IllegalStateException("Failed to write photo to $path")
+            }
+            return path
+        } catch (e: StorageException) {
+            throw e
+        } catch (e: Exception) {
+            throw StorageException(e)
+        }
+    }
+}
