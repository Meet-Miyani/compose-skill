@@ -0,0 +1,20 @@
+package com.example.feature.workouts.data.local
+
+import com.example.core.error.StorageException
+import java.io.File
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+
+internal actual class WorkoutPhotoStorage {
+    actual suspend fun savePhoto(workoutId: Long, bytes: ByteArray): String =
+        withContext(Dispatchers.IO) {
+            try {
+                val dir = File(applicationContext.filesDir, "workout_photos").apply { mkdirs() }
+                val file = File(dir, "photo_$workoutId.jpg")
+                file.writeBytes(bytes)
+                file.absolutePath
+            } catch (e: Exception) {
+                throw StorageException(e)
+            }
+        }
+}
