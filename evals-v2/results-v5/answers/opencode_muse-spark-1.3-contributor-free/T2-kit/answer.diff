+/**
+ * Stateless content for the workout-type picker destination.
+ *
+ * Renders state only. No ViewModel, no Koin, no state reads beyond params.
+ * Every UiState field is read below.
+ */
+package com.example.feature.workouts.presentation.typepicker
+
+import androidx.compose.foundation.layout.Column
+import androidx.compose.foundation.layout.fillMaxSize
+import androidx.compose.foundation.layout.padding
+import androidx.compose.material3.Button
+import androidx.compose.material3.Text
+import androidx.compose.runtime.Composable
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.unit.dp
+import com.example.feature.workouts.domain.model.WorkoutType
+import org.jetbrains.compose.resources.stringResource
+import workouts.feature.workouts.generated.resources.Res
+import workouts.feature.workouts.generated.resources.back
+import workouts.feature.workouts.generated.resources.workout_type_cardio
+import workouts.feature.workouts.generated.resources.workout_type_flexibility
+import workouts.feature.workouts.generated.resources.workout_type_strength
+import workouts.feature.workouts.generated.resources.workout_type_title
+
+@Composable
+fun WorkoutTypePickerScreen(
+    state: WorkoutTypePickerUiState,
+    onTypeClick: (WorkoutType) -> Unit,
+    onBack: () -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    Column(modifier = modifier.fillMaxSize().padding(16.dp)) {
+        Text(stringResource(Res.string.workout_type_title))
+        state.types.forEach { type ->
+            val label = when (type) {
+                WorkoutType.CARDIO -> stringResource(Res.string.workout_type_cardio)
+                WorkoutType.STRENGTH -> stringResource(Res.string.workout_type_strength)
+                WorkoutType.FLEXIBILITY -> stringResource(Res.string.workout_type_flexibility)
+            }
+            val suffix = if (type == state.selectedType) " ✓" else ""
+            Button(onClick = { onTypeClick(type) }) { Text(label + suffix) }
+        }
+        Button(onClick = onBack) { Text(stringResource(Res.string.back)) }
+    }
+}
