+/**
+ * State-matrix tests for the workout-type picker ViewModel.
+ *
+ * Static content: no loading, error, or empty rows. Covers content,
+ * selection, back, and process-death restore of the selected draft.
+ */
+package com.example.feature.workouts.presentation.typepicker
+
+import androidx.lifecycle.SavedStateHandle
+import com.example.core.mvi.UiEffect
+import com.example.feature.workouts.domain.model.WorkoutType
+import kotlinx.coroutines.ExperimentalCoroutinesApi
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.flow.toList
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.test.StandardTestDispatcher
+import kotlinx.coroutines.test.TestCoroutineScheduler
+import kotlinx.coroutines.test.UnconfinedTestDispatcher
+import kotlinx.coroutines.test.advanceUntilIdle
+import kotlinx.coroutines.test.resetMain
+import kotlinx.coroutines.test.runTest
+import kotlinx.coroutines.test.setMain
+import kotlin.test.AfterTest
+import kotlin.test.BeforeTest
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertNull
+import kotlin.test.assertTrue
+
+/** Picker ViewModel tests covering selection and restore. */
+@OptIn(ExperimentalCoroutinesApi::class)
+class WorkoutTypePickerViewModelTest {
+    private val testScheduler = TestCoroutineScheduler()
+    private val mainDispatcher = StandardTestDispatcher(testScheduler)
+
+    @BeforeTest
+    fun setUp() {
+        Dispatchers.setMain(mainDispatcher)
+    }
+
+    @AfterTest
+    fun tearDown() {
+        Dispatchers.resetMain()
+    }
+
+    private fun viewModel(handle: SavedStateHandle = SavedStateHandle()): WorkoutTypePickerViewModel =
+        WorkoutTypePickerViewModel(savedStateHandle = handle)
+
+    @Test
+    fun `cold content lists all three types with no selection`() = runTest(testScheduler) {
+        val viewModel = viewModel()
+
+        assertEquals(listOf(WorkoutType.CARDIO, WorkoutType.STRENGTH, WorkoutType.FLEXIBILITY), viewModel.state.value.types)
+        assertNull(viewModel.state.value.selectedType)
+    }
+
+    @Test
+    fun `selecting cardio updates state and emits selected`() = runTest(testScheduler) {
+        val viewModel = viewModel()
+        val effects = mutableListOf<UiEffect>()
+        // Unconfined collector: trySend delivery resumes it without waiting on the queue.
+        backgroundScope.launch(UnconfinedTestDispatcher(testScheduler)) { viewModel.effect.toList(effects) }
+
+        viewModel.onAction(WorkoutTypePickerUiAction.OnTypeClick(WorkoutType.CARDIO))
+        advanceUntilIdle()
+
+        assertEquals(WorkoutType.CARDIO, viewModel.state.value.selectedType)
+        assertEquals(WorkoutTypePickerUiEffect.TypeSelected(WorkoutType.CARDIO), effects.single())
+    }
+
+    @Test
+    fun `selecting strength then flexibility keeps latest`() = runTest(testScheduler) {
+        val viewModel = viewModel()
+        val effects = mutableListOf<UiEffect>()
+        backgroundScope.launch(UnconfinedTestDispatcher(testScheduler)) { viewModel.effect.toList(effects) }
+
+        viewModel.onAction(WorkoutTypePickerUiAction.OnTypeClick(WorkoutType.STRENGTH))
+        viewModel.onAction(WorkoutTypePickerUiAction.OnTypeClick(WorkoutType.FLEXIBILITY))
+        advanceUntilIdle()
+
+        assertEquals(WorkoutType.FLEXIBILITY, viewModel.state.value.selectedType)
+        assertEquals(2, effects.filterIsInstance<WorkoutTypePickerUiEffect.TypeSelected>().size)
+    }
+
+    @Test
+    fun `back emits navigate back with no selection change`() = runTest(testScheduler) {
+        val viewModel = viewModel()
+        val effects = mutableListOf<UiEffect>()
+        backgroundScope.launch(UnconfinedTestDispatcher(testScheduler)) { viewModel.effect.toList(effects) }
+
+        viewModel.onAction(WorkoutTypePickerUiAction.OnBackClick)
+        advanceUntilIdle()
+
+        assertTrue(effects.single() is WorkoutTypePickerUiEffect.NavigateBack)
+        assertNull(viewModel.state.value.selectedType)
+    }
+
+    @Test
+    fun `process death restores selected type`() = runTest(testScheduler) {
+        val handle = SavedStateHandle()
+        handle["selectedType"] = WorkoutType.STRENGTH.name
+        val viewModel = viewModel(handle = handle)
+
+        assertEquals(WorkoutType.STRENGTH, viewModel.state.value.selectedType)
+    }
+}
