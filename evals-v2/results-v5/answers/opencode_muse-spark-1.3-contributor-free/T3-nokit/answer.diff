+package com.example.feature.workouts.domain.export
+
+import com.example.feature.workouts.domain.model.Workout
+
+/**
+ * Builds an RFC 4180 CSV document for the given workouts.
+ *
+ * Pure function: runs on any dispatcher. The ViewModel calls it inside
+ * `withContext(ioDispatcher)` so large lists never block the main thread.
+ */
+fun List<Workout>.toWorkoutsCsv(): String {
+    val builder = StringBuilder()
+    builder.append("id,title,body,updatedAt\n")
+    for (workout in this) {
+        builder.append(workout.id.toString())
+        builder.append(',')
+        builder.append(escapeCsvField(workout.title.orEmpty()))
+        builder.append(',')
+        builder.append(escapeCsvField(workout.body.orEmpty()))
+        builder.append(',')
+        builder.append(escapeCsvField(workout.updatedAt?.toString().orEmpty()))
+        builder.append('\n')
+    }
+    return builder.toString()
+}
+
+private fun escapeCsvField(value: String): String {
+    val needsQuotes = value.contains(',') ||
+        value.contains('"') ||
+        value.contains('\n') ||
+        value.contains('\r')
+    if (!needsQuotes) return value
+    return "\"" + value.replace("\"", "\"\"") + "\""
+}
