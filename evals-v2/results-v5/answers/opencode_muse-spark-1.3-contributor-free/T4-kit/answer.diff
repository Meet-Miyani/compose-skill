+    @Test
+    fun `typed title survives recreation via SavedStateHandle`() = runTest(testScheduler) {
+        val fake = FakeWorkoutsRepository().apply { seed(listOf(workout())) }
+        val handle = SavedStateHandle()
+        val viewModel = viewModel(fake, handle = handle)
+
+        viewModel.onAction(WorkoutsUiAction.OnTitleChanged("half-typed"))
+        advanceUntilIdle()
+
