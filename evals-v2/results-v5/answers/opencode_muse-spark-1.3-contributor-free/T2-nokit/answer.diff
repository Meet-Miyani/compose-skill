+/**
+ * Lifecycle-aware wrapper for the workout-type picker destination.
+ *
+ * Koin-free: the composition root resolves the ViewModel and passes it in.
+ */
+package com.example.feature.workouts.presentation.typepicker
+
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.getValue
+import androidx.lifecycle.compose.LifecycleStartEffect
+import androidx.lifecycle.compose.collectAsStateWithLifecycle
+import com.example.core.mvi.CollectEffect
+import com.example.designsystem.error.HandleAppErrors
+
+@Composable
+fun WorkoutTypePickerRoute(
+    viewModel: WorkoutTypePickerViewModel,
+    workoutId: Long,
+    onEffect: suspend (WorkoutTypePickerUiEffect) -> Unit,
+) {
+    LifecycleStartEffect(workoutId) {
+        viewModel.onAction(WorkoutTypePickerUiAction.OnScreenStarted)
+        onStopOrDispose {}
+    }
+    val state by viewModel.state.collectAsStateWithLifecycle()
+    CollectEffect(viewModel.effect) { effect -> onEffect(effect) }
+    HandleAppErrors(viewModel.errors)
+    WorkoutTypePickerScreen(
+        state = state,
+        onTypeClick = { viewModel.onAction(WorkoutTypePickerUiAction.OnTypeClick(it)) },
+        onRetry = { viewModel.onAction(WorkoutTypePickerUiAction.OnRetryClick) },
+        onBack = { viewModel.onAction(WorkoutTypePickerUiAction.OnBackClick) },
+    )
+}
