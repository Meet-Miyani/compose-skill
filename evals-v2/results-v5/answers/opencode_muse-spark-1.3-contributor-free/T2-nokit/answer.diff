+/**
+ * Stateless content for the separate workout-type picker destination.
+ *
+ * Renders state only. No ViewModel, no Koin, no state reads beyond params.
+ */
+package com.example.feature.workouts.presentation.typepicker
+
+import androidx.compose.foundation.layout.Column
+import androidx.compose.material3.Button
+import androidx.compose.material3.CircularProgressIndicator
+import androidx.compose.material3.Text
+import androidx.compose.runtime.Composable
+import androidx.compose.ui.Modifier
+import com.example.feature.workouts.domain.model.WorkoutType
+import org.jetbrains.compose.resources.stringResource
+import workouts.feature.workouts.generated.resources.Res
+import workouts.feature.workouts.generated.resources.back
+import workouts.feature.workouts.generated.resources.error_message
+import workouts.feature.workouts.generated.resources.pick_workout_type
+import workouts.feature.workouts.generated.resources.retry
+import workouts.feature.workouts.generated.resources.workout_type_cardio
+import workouts.feature.workouts.generated.resources.workout_type_flexibility
+import workouts.feature.workouts.generated.resources.workout_type_strength
+
+@Composable
+fun WorkoutTypePickerScreen(
+    state: WorkoutTypePickerUiState,
+    onTypeClick: (WorkoutType) -> Unit,
+    onRetry: () -> Unit,
+    onBack: () -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    when {
+        state.isLoading -> CircularProgressIndicator(modifier = modifier)
+        state.error != null -> Column(modifier = modifier) {
+            Text(stringResource(Res.string.error_message))
+            Button(onClick = onRetry) { Text(stringResource(Res.string.retry)) }
+            Button(onClick = onBack) { Text(stringResource(Res.string.back)) }
+        }
+        else -> Column(modifier = modifier) {
+            Text(stringResource(Res.string.pick_workout_type))
+            TypeButton(
+                selected = state.selected == WorkoutType.CARDIO,
+                label = stringResource(Res.string.workout_type_cardio),
+                onClick = { onTypeClick(WorkoutType.CARDIO) },
+            )
+            TypeButton(
+                selected = state.selected == WorkoutType.STRENGTH,
+                label = stringResource(Res.string.workout_type_strength),
+                onClick = { onTypeClick(WorkoutType.STRENGTH) },
+            )
+            TypeButton(
+                selected = state.selected == WorkoutType.FLEXIBILITY,
+                label = stringResource(Res.string.workout_type_flexibility),
+                onClick = { onTypeClick(WorkoutType.FLEXIBILITY) },
+            )
+            Button(onClick = onBack) { Text(stringResource(Res.string.back)) }
+        }
+    }
+}
+
+@Composable
+private fun TypeButton(selected: Boolean, label: String, onClick: () -> Unit) {
+    Button(onClick = onClick) {
+        Text(if (selected) "$label ✓" else label)
+    }
+}
