+/**
+ * ViewModel for the workout type picker destination.
+ *
+ * Owns the selected type (via SavedStateHandle) and persists it on confirm.
+ */
+package com.example.feature.workouts.presentation.typepicker
+
+import androidx.lifecycle.SavedStateHandle
+import com.example.core.mvi.BaseViewModel
+import com.example.feature.workouts.domain.model.WorkoutType
+import com.example.feature.workouts.domain.repository.WorkoutsRepository
+import kotlinx.coroutines.CoroutineDispatcher
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.withContext
+import org.koin.core.annotation.InjectedParam
+import org.koin.core.annotation.KoinViewModel
+
+/** Construction bag for the picker nav arguments. Top-level so entries and tests share it. */
+data class WorkoutTypePickerParams(val workoutId: Long)
+
+/** ViewModel behind the workout type picker; owns selection and save. */
+@KoinViewModel
+class WorkoutTypePickerViewModel(
+    private val repository: WorkoutsRepository,
+    @InjectedParam private val params: WorkoutTypePickerParams,
+    private val savedStateHandle: SavedStateHandle,
+    private val ioDispatcher: CoroutineDispatcher = Dispatchers.Default,
+) : BaseViewModel<WorkoutTypePickerUiAction, WorkoutTypePickerUiState, WorkoutTypePickerUiEffect>(
+    WorkoutTypePickerUiState(
+        selectedType = savedStateHandle.get<String>("selectedType")?.let {
+            runCatching { WorkoutType.valueOf(it) }.getOrNull()
+        },
+    ),
+) {
+    private var loadJob: Job? = null
+    private var saveJob: Job? = null
+    private var hasStarted: Boolean = false
+
+    override fun onAction(action: WorkoutTypePickerUiAction) {
+        when (action) {
+            WorkoutTypePickerUiAction.OnScreenStarted -> load()
+            is WorkoutTypePickerUiAction.OnTypeSelected -> {
+                savedStateHandle["selectedType"] = action.workoutType.name
+                updateState { copy(selectedType = action.workoutType) }
+            }
+            WorkoutTypePickerUiAction.OnConfirmClick -> save()
+            WorkoutTypePickerUiAction.OnRetryClick -> {
+                updateState { copy(error = null) }
+                load()
+            }
+            WorkoutTypePickerUiAction.OnBackClick -> sendEffect(WorkoutTypePickerUiEffect.NavigateBack)
+        }
+    }
+
+    private fun load() {
+        if (loadJob?.isActive == true) return
+        loadJob = launchGuarded(
+            onError = { error ->
+                if (hasStarted) emitError(error) else updateState { copy(error = error) }
+            },
+            onStart = { updateState { copy(isLoading = !hasStarted) } },
+            onComplete = { updateState { copy(isLoading = false) } },
+        ) {
+            val item = withContext(ioDispatcher) { repository.getWorkout(params.workoutId) }
+            updateState {
+                copy(
+                    isLoading = false,
+                    isMissing = item == null,
+                    selectedType = if (savedStateHandle.contains("selectedType")) {
+                        selectedType
+                    } else {
+                        item?.workoutType
+                    },
+                )
+            }
+            hasStarted = true
+        }
+    }
+
+    private fun save() {
+        if (saveJob?.isActive == true) return
+        val selected = currentState.selectedType ?: return
+        saveJob = launchGuarded(
+            onError = ::emitError,
+            onStart = { updateState { copy(isSaving = true) } },
+            onComplete = { updateState { copy(isSaving = false) } },
+        ) {
+            withContext(ioDispatcher) {
+                repository.saveWorkoutType(params.workoutId, selected)
+            }
+            sendEffect(WorkoutTypePickerUiEffect.TypeSaved(selected))
+        }
+    }
+}
