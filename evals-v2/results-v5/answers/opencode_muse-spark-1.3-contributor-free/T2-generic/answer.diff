@@ -0,0 +1,168 @@
+/**
+ * State-matrix tests for the workout type picker ViewModel.
+ */
+package com.example.feature.workouts.presentation.workouts
+
+import androidx.lifecycle.SavedStateHandle
+import com.example.core.mvi.UiEffect
+import com.example.feature.workouts.domain.model.Workout
+import com.example.feature.workouts.domain.model.WorkoutType
+import com.example.feature.workouts.presentation.typepicker.WorkoutTypePickerParams
+import com.example.feature.workouts.presentation.typepicker.WorkoutTypePickerUiAction
+import com.example.feature.workouts.presentation.typepicker.WorkoutTypePickerUiEffect
+import com.example.feature.workouts.presentation.typepicker.WorkoutTypePickerViewModel
+import kotlinx.coroutines.CoroutineDispatcher
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.ExperimentalCoroutinesApi
+import kotlinx.coroutines.flow.toList
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.test.StandardTestDispatcher
+import kotlinx.coroutines.test.TestCoroutineScheduler
+import kotlinx.coroutines.test.UnconfinedTestDispatcher
+import kotlinx.coroutines.test.advanceUntilIdle
+import kotlinx.coroutines.test.resetMain
+import kotlinx.coroutines.test.runTest
+import kotlinx.coroutines.test.setMain
+import kotlin.test.AfterTest
+import kotlin.test.BeforeTest
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertFalse
+import kotlin.test.assertNull
+import kotlin.test.assertTrue
+import kotlin.time.Clock
+
+@OptIn(ExperimentalCoroutinesApi::class)
+class WorkoutTypePickerViewModelTest {
+    private val testScheduler = TestCoroutineScheduler()
+    private val mainDispatcher = StandardTestDispatcher(testScheduler)
+
+    @BeforeTest
+    fun setUp() {
+        Dispatchers.setMain(mainDispatcher)
+    }
+
+    @AfterTest
+    fun tearDown() {
+        Dispatchers.resetMain()
+    }
+
+    private fun workout(id: Long = 1L, type: WorkoutType? = null): Workout = Workout(
+        id = id,
+        title = "Title",
+        body = "Body",
+        updatedAt = Clock.System.now(),
+        workoutType = type,
+    )
+
+    private fun viewModel(
+        fake: FakeWorkoutsRepository,
+        handle: SavedStateHandle = SavedStateHandle(),
+        id: Long = 1L,
+        ioDispatcher: CoroutineDispatcher = StandardTestDispatcher(testScheduler),
+    ): WorkoutTypePickerViewModel = WorkoutTypePickerViewModel(
+        repository = fake,
+        params = WorkoutTypePickerParams(workoutId = id),
+        savedStateHandle = handle,
+        ioDispatcher = ioDispatcher,
+    )
+
+    @Test
+    fun `cold load shows persisted type`() = runTest(testScheduler) {
+        val fake = FakeWorkoutsRepository().apply { seed(listOf(workout(type = WorkoutType.CARDIO))) }
+        val viewModel = viewModel(fake)
+
+        viewModel.onAction(WorkoutTypePickerUiAction.OnScreenStarted)
+        advanceUntilIdle()
+
+        assertEquals(WorkoutType.CARDIO, viewModel.state.value.selectedType)
+        assertFalse(viewModel.state.value.isLoading)
+    }
+
+    @Test
+    fun `selecting type updates state and survives process death`() = runTest(testScheduler) {
+        val fake = FakeWorkoutsRepository().apply { seed(listOf(workout())) }
+        val handle = SavedStateHandle()
+        val viewModel = viewModel(fake, handle = handle)
+
+        viewModel.onAction(WorkoutTypePickerUiAction.OnScreenStarted)
+        advanceUntilIdle()
+        viewModel.onAction(WorkoutTypePickerUiAction.OnTypeSelected(WorkoutType.STRENGTH))
+        advanceUntilIdle()
+
+        assertEquals(WorkoutType.STRENGTH, viewModel.state.value.selectedType)
+        assertEquals("STRENGTH", handle["selectedType"])
+
+        // Recreate from the same handle, as after process death.
+        val restored = viewModel(fake, handle = handle)
+        assertEquals(WorkoutType.STRENGTH, restored.state.value.selectedType)
+    }
+
+    @Test
+    fun `confirm persists type and emits saved`() = runTest(testScheduler) {
+        val fake = FakeWorkoutsRepository().apply { seed(listOf(workout())) }
+        val viewModel = viewModel(fake)
+        val effects = mutableListOf<UiEffect>()
+        backgroundScope.launch(UnconfinedTestDispatcher(testScheduler)) { viewModel.effect.toList(effects) }
+
+        viewModel.onAction(WorkoutTypePickerUiAction.OnScreenStarted)
+        advanceUntilIdle()
+        viewModel.onAction(WorkoutTypePickerUiAction.OnTypeSelected(WorkoutType.FLEXIBILITY))
+        viewModel.onAction(WorkoutTypePickerUiAction.OnConfirmClick)
+        advanceUntilIdle()
+
+        assertEquals(WorkoutType.FLEXIBILITY, fake.getWorkout(1L)?.workoutType)
+        assertEquals(
+            WorkoutTypePickerUiEffect.TypeSaved(WorkoutType.FLEXIBILITY),
+            effects.filterIsInstance<WorkoutTypePickerUiEffect.TypeSaved>().single(),
+        )
+    }
+
+    @Test
+    fun `confirm without selection does nothing`() = runTest(testScheduler) {
+        val fake = FakeWorkoutsRepository().apply { seed(listOf(workout())) }
+        val viewModel = viewModel(fake)
+        val effects = mutableListOf<UiEffect>()
+        backgroundScope.launch(UnconfinedTestDispatcher(testScheduler)) { viewModel.effect.toList(effects) }
+
+        viewModel.onAction(WorkoutTypePickerUiAction.OnScreenStarted)
+        advanceUntilIdle()
+        assertNull(viewModel.state.value.selectedType)
+
+        viewModel.onAction(WorkoutTypePickerUiAction.OnConfirmClick)
+        advanceUntilIdle()
+
+        assertTrue(effects.isEmpty())
+        assertNull(fake.getWorkout(1L)?.workoutType)
+    }
+
+    @Test
+    fun `not found sets isMissing`() = runTest(testScheduler) {
+        val fake = FakeWorkoutsRepository().apply { seed(listOf(workout(id = 2L))) }
+        val viewModel = viewModel(fake, id = 1L)
+
+        viewModel.onAction(WorkoutTypePickerUiAction.OnScreenStarted)
+        advanceUntilIdle()
+
+        assertTrue(viewModel.state.value.isMissing)
+        assertNull(viewModel.state.value.error)
+    }
+
+    @Test
+    fun `pick action opens type picker from detail`() = runTest(testScheduler) {
+        val fake = FakeWorkoutsRepository().apply { seed(listOf(workout())) }
+        val detail = WorkoutsViewModel(
+            repository = fake,
+            params = WorkoutsParams(workoutId = 1L),
+            savedStateHandle = SavedStateHandle(),
+            ioDispatcher = StandardTestDispatcher(testScheduler),
+        )
+        val effects = mutableListOf<UiEffect>()
+        backgroundScope.launch(UnconfinedTestDispatcher(testScheduler)) { detail.effect.toList(effects) }
+
+        detail.onAction(WorkoutsUiAction.OnPickWorkoutTypeClick)
+        advanceUntilIdle()
+
+        assertEquals(WorkoutsUiEffect.OpenWorkoutTypePicker(1L), effects.single())
+    }
+}
