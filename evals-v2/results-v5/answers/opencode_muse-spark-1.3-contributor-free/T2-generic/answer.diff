+/**
+ * Stateless content for the workout type picker destination.
+ *
+ * Renders state only. No ViewModel, no Koin, no state reads beyond params.
+ */
+package com.example.feature.workouts.presentation.typepicker
+
+import androidx.compose.foundation.clickable
+import androidx.compose.foundation.layout.Column
+import androidx.compose.foundation.layout.Row
+import androidx.compose.foundation.layout.fillMaxSize
+import androidx.compose.foundation.layout.padding
+import androidx.compose.material3.Button
+import androidx.compose.material3.CircularProgressIndicator
+import androidx.compose.material3.RadioButton
+import androidx.compose.material3.Text
+import androidx.compose.runtime.Composable
+import androidx.compose.ui.Alignment
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.semantics.Role
+import androidx.compose.ui.unit.dp
+import com.example.feature.workouts.domain.model.WorkoutType
+import org.jetbrains.compose.resources.stringResource
+import workouts.feature.workouts.generated.resources.Res
+import workouts.feature.workouts.generated.resources.back
+import workouts.feature.workouts.generated.resources.confirm
+import workouts.feature.workouts.generated.resources.error_message
+import workouts.feature.workouts.generated.resources.missing_workout
+import workouts.feature.workouts.generated.resources.pick_workout_type_title
+import workouts.feature.workouts.generated.resources.retry
+import workouts.feature.workouts.generated.resources.workout_type_cardio
+import workouts.feature.workouts.generated.resources.workout_type_flexibility
+import workouts.feature.workouts.generated.resources.workout_type_strength
+
+@Composable
+fun WorkoutTypePickerScreen(
+    state: WorkoutTypePickerUiState,
+    onTypeSelected: (WorkoutType) -> Unit,
+    onConfirm: () -> Unit,
+    onRetry: () -> Unit,
+    onBack: () -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    when {
+        state.isLoading -> CircularProgressIndicator(modifier = modifier)
+        state.error != null -> Column(modifier = modifier) {
+            Text(stringResource(Res.string.error_message))
+            Button(onClick = onRetry) { Text(stringResource(Res.string.retry)) }
+            Button(onClick = onBack) { Text(stringResource(Res.string.back)) }
+        }
+        state.isMissing -> Column(modifier = modifier) {
+            Text(stringResource(Res.string.missing_workout))
+            Button(onClick = onBack) { Text(stringResource(Res.string.back)) }
+        }
+        else -> Column(modifier.fillMaxSize().padding(16.dp)) {
+            Text(stringResource(Res.string.pick_workout_type_title))
+            WorkoutType.entries.forEach { workoutType ->
+                val label = when (workoutType) {
+                    WorkoutType.CARDIO -> stringResource(Res.string.workout_type_cardio)
+                    WorkoutType.STRENGTH -> stringResource(Res.string.workout_type_strength)
+                    WorkoutType.FLEXIBILITY -> stringResource(Res.string.workout_type_flexibility)
+                }
+                Row(
+                    verticalAlignment = Alignment.CenterVertically,
+                    modifier = Modifier
+                        .clickable(
+                            role = Role.RadioButton,
+                            onClick = { onTypeSelected(workoutType) },
+                        ),
+                ) {
+                    RadioButton(
+                        selected = state.selectedType == workoutType,
+                        onClick = { onTypeSelected(workoutType) },
+                    )
+                    Text(label, modifier = Modifier.padding(start = 8.dp))
+                }
+            }
+            Button(
+                onClick = onConfirm,
+                enabled = state.selectedType != null && !state.isSaving,
+            ) {
+                Text(stringResource(Res.string.confirm))
+            }
+            Button(onClick = onBack) { Text(stringResource(Res.string.back)) }
+        }
+    }
+}
