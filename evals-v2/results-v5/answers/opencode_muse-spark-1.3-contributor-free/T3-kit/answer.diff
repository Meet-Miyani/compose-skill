+import kotlinx.coroutines.test.advanceUntilIdle
+import kotlinx.coroutines.test.resetMain
+import kotlinx.coroutines.test.runTest
+import kotlinx.coroutines.test.setMain
+import kotlin.test.AfterTest
+import kotlin.test.BeforeTest
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertFalse
+import kotlin.test.assertNull
+import kotlin.test.assertTrue
+
+@OptIn(ExperimentalCoroutinesApi::class)
+class WorkoutsExportViewModelTest {
+    private val scheduler = TestCoroutineScheduler()
+
+    @BeforeTest fun setUp() { Dispatchers.setMain(StandardTestDispatcher(scheduler)) }
+    @AfterTest fun tearDown() { Dispatchers.resetMain() }
+
+    @Test fun `export builds csv in background without blocking the list`() = runTest(scheduler) {
+        val fake = FakeWorkoutsRepository()
+        fake.seed(listOf(Workout(7, "First", "", null)))
+        // Separate instance on the shared scheduler, so withContext suspends
+        // and the exporting frame stays observable.
+        val viewModel = WorkoutsListViewModel(fake, StandardTestDispatcher(scheduler))
+        val errors = mutableListOf<AppError>()
+        // Unconfined collector, so trySend delivery resumes it without waiting on the queue.
+        backgroundScope.launch(UnconfinedTestDispatcher(scheduler)) { viewModel.errors.toList(errors) }
+        viewModel.onAction(WorkoutsListUiAction.OnScreenStarted)
+        viewModel.onAction(WorkoutsListUiAction.OnExportClick)
+        advanceUntilIdle()
+        assertFalse(viewModel.state.value.isExporting)
+        assertEquals("id,title,body,updatedAt,isArchived\n7,First,,,false\n", viewModel.state.value.exportedCsv)
+        assertEquals(listOf(Workout(7, "First", "", null)), viewModel.state.value.items)
+        assertTrue(errors.isEmpty())
+    }
+
+    @Test fun `empty export yields header only`() = runTest(scheduler) {
+        val viewModel = WorkoutsListViewModel(FakeWorkoutsRepository(), StandardTestDispatcher(scheduler))
+        viewModel.onAction(WorkoutsListUiAction.OnExportClick)
+        advanceUntilIdle()
+        assertEquals("id,title,body,updatedAt,isArchived\n", viewModel.state.value.exportedCsv)
+        assertFalse(viewModel.state.value.isExporting)
+    }
+
+    @Test fun `overlapping exports keep a single snapshot read`() = runTest(scheduler) {
+        val fake = FakeWorkoutsRepository()
+        fake.seed(listOf(Workout(7, "First", "", null)))
+        fake.snapshotGate = CompletableDeferred()
+        val viewModel = WorkoutsListViewModel(fake, StandardTestDispatcher(scheduler))
+        viewModel.onAction(WorkoutsListUiAction.OnExportClick)
+        viewModel.onAction(WorkoutsListUiAction.OnExportClick)
+        advanceUntilIdle()
+        assertTrue(viewModel.state.value.isExporting)
+        assertNull(viewModel.state.value.exportedCsv)
+        fake.snapshotGate?.complete(Unit)
+        advanceUntilIdle()
+        assertEquals(1, fake.snapshotCalls)
+        assertFalse(viewModel.state.value.isExporting)
+        assertEquals("id,title,body,updatedAt,isArchived\n7,First,,,false\n", viewModel.state.value.exportedCsv)
+    }
+
+    @Test fun `export failure emits popup and clears exporting`() = runTest(scheduler) {
+        val fake = FakeWorkoutsRepository()
+        fake.snapshotShouldThrow = StorageException(IllegalStateException("disk full"))
+        val viewModel = WorkoutsListViewModel(fake, StandardTestDispatcher(scheduler))
+        val errors = mutableListOf<AppError>()
+        // Unconfined collector, so trySend delivery resumes it without waiting on the queue.
+        backgroundScope.launch(UnconfinedTestDispatcher(scheduler)) { viewModel.errors.toList(errors) }
+        viewModel.onAction(WorkoutsListUiAction.OnExportClick)
+        advanceUntilIdle()
+        assertFalse(viewModel.state.value.isExporting)
+        assertNull(viewModel.state.value.exportedCsv)
+        assertEquals(AppErrorType.Storage, errors.single().type)
+    }
+}
