+package com.example.feature.workouts.domain.export
+
+import com.example.feature.workouts.domain.model.Workout
+import kotlin.test.Test
+import kotlin.test.assertEquals
+
+class WorkoutCsvTest {
+    @Test fun `empty list yields header only`() {
+        assertEquals("id,title,body,updatedAt,isArchived\n", emptyList<Workout>().toCsv())
+    }
+
+    @Test fun `plain row writes every field`() {
+        val csv = listOf(Workout(7, "First", "", null)).toCsv()
+        assertEquals("id,title,body,updatedAt,isArchived\n7,First,,,false\n", csv)
+    }
+
+    @Test fun `commas quotes and line breaks are escaped`() {
+        val csv = listOf(Workout(1, "Morning, run", "5k \"fast\"\ncool", null)).toCsv()
+        assertEquals(
+            "id,title,body,updatedAt,isArchived\n1,\"Morning, run\",\"5k \"\"fast\"\"\ncool\",,false\n",
+            csv,
+        )
+    }
+
+    @Test fun `nulls stay empty and the row is kept`() {
+        val csv = listOf(Workout(2, null, null, null, isArchived = true)).toCsv()
+        assertEquals("id,title,body,updatedAt,isArchived\n2,,,,true\n", csv)
+    }
+}
