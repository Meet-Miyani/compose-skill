+package com.example.feature.workouts.domain.export
+
+import com.example.feature.workouts.domain.model.Workout
+
+/**
+ * Builds an RFC-4180 style CSV snapshot of [Workout] rows.
+ *
+ * Nulls stay empty through the export; rows are never dropped. Fields
+ * containing a comma, quote, or line break are quoted with inner quotes
+ * doubled.
+ */
+fun List<Workout>.toCsv(): String {
+    val header = "id,title,body,updatedAt,isArchived"
+    if (isEmpty()) return "$header\n"
+    return buildString {
+        append(header).append('\n')
+        this@toCsv.forEach { workout ->
+            append(workout.id.toString()).append(',')
+            appendCsvField(workout.title).append(',')
+            appendCsvField(workout.body).append(',')
+            appendCsvField(workout.updatedAt?.toString()).append(',')
+            append(if (workout.isArchived) "true" else "false").append('\n')
+        }
+    }
+}
+
+private fun StringBuilder.appendCsvField(value: String?): StringBuilder {
+    if (value == null) return this
+    if (value.none { it == ',' || it == '"' || it == '\n' || it == '\r' }) return append(value)
+    append('"')
+    value.forEach { append(if (it == '"') "\"\"" else it.toString()) }
+    return append('"')
+}
