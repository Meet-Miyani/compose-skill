+package com.example.feature.workouts.presentation.workouts
+
+import com.example.core.error.NetworkException
+import com.example.feature.workouts.domain.export.workoutsToCsv
+import com.example.feature.workouts.domain.model.Workout
+import com.example.feature.workouts.domain.repository.WorkoutsRepository
+import com.example.feature.workouts.presentation.list.WorkoutsListUiAction
+import com.example.feature.workouts.presentation.list.WorkoutsListViewModel
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.ExperimentalCoroutinesApi
+import kotlinx.coroutines.flow.Flow
+import kotlinx.coroutines.flow.flow
+import kotlinx.coroutines.test.StandardTestDispatcher
+import kotlinx.coroutines.test.TestCoroutineScheduler
+import kotlinx.coroutines.test.advanceUntilIdle
+import kotlinx.coroutines.test.resetMain
+import kotlinx.coroutines.test.runTest
+import kotlinx.coroutines.test.setMain
+import kotlin.test.AfterTest
+import kotlin.test.BeforeTest
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertFalse
+import kotlin.test.assertNotNull
+import kotlin.test.assertNull
+import kotlin.test.assertTrue
+
+@OptIn(ExperimentalCoroutinesApi::class)
+class WorkoutsExportTest {
+    private val scheduler = TestCoroutineScheduler()
+
+    @BeforeTest fun setUp() { Dispatchers.setMain(StandardTestDispatcher(scheduler)) }
+    @AfterTest fun tearDown() { Dispatchers.resetMain() }
+
+    @Test fun `empty list exports header only`() {
+        assertEquals("id,title,body,updatedAt,isArchived", workoutsToCsv(emptyList()))
+    }
+
+    @Test fun `fields with commas quotes and newlines are escaped`() {
+        val csv = workoutsToCsv(
+            listOf(
+                Workout(1, "Morning, run", "Said \"fast\"\nagain", null),
+            ),
+        )
+        val lines = csv.lines()
+        assertEquals("id,title,body,updatedAt,isArchived", lines.first())
+        assertEquals("1,\"Morning, run\",\"Said \"\"fast\"\"\nagain\",,false", lines.drop(1).joinToString("\n"))
+    }
+
+    @Test fun `export success stores csv and clears exporting`() = runTest(scheduler) {
+        val fake = FakeWorkoutsRepository().apply {
+            seed(listOf(Workout(1, "First", "Body", null), Workout(2, "Second", "", null)))
+        }
+        val viewModel = WorkoutsListViewModel(fake, StandardTestDispatcher(scheduler))
+        viewModel.onAction(WorkoutsListUiAction.OnScreenStarted)
+        advanceUntilIdle()
+
+        viewModel.onAction(WorkoutsListUiAction.OnExportClick)
+        advanceUntilIdle()
+
+        assertFalse(viewModel.state.value.isExporting)
+        assertNull(viewModel.state.value.exportError)
+        assertNotNull(viewModel.state.value.exportCsv)
+        assertTrue(viewModel.state.value.exportCsv!!.lines().size == 3)
+    }
+
+    @Test fun `export failure surfaces recoverable error`() = runTest(scheduler) {
+        val failing = object : WorkoutsRepository by FakeWorkoutsRepository() {
+            override fun getWorkoutsStream(): Flow<List<Workout>> = flow { throw NetworkException.Connection() }
+        }
+        val viewModel = WorkoutsListViewModel(failing, StandardTestDispatcher(scheduler))
+
+        viewModel.onAction(WorkoutsListUiAction.OnExportClick)
+        advanceUntilIdle()
+
+        assertFalse(viewModel.state.value.isExporting)
+        assertNotNull(viewModel.state.value.exportError)
+        assertNull(viewModel.state.value.exportCsv)
+    }
+
+    @Test fun `dismiss clears export result and error`() = runTest(scheduler) {
+        val fake = FakeWorkoutsRepository().apply { seed(listOf(Workout(1, "First", "", null))) }
+        val viewModel = WorkoutsListViewModel(fake, StandardTestDispatcher(scheduler))
+
+        viewModel.onAction(WorkoutsListUiAction.OnExportClick)
+        advanceUntilIdle()
+        assertNotNull(viewModel.state.value.exportCsv)
+
+        viewModel.onAction(WorkoutsListUiAction.OnExportDismiss)
+        assertNull(viewModel.state.value.exportCsv)
+        assertNull(viewModel.state.value.exportError)
+    }
+}
