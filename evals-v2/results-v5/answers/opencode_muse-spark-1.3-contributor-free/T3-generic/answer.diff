+package com.example.feature.workouts.domain.export
+
+import com.example.feature.workouts.domain.model.Workout
+
+/**
+ * Builds an RFC 4180 style CSV snapshot of [workouts].
+ *
+ * Pure and synchronous; callers run it off the main thread.
+ */
+public fun workoutsToCsv(workouts: List<Workout>): String {
+    val header = "id,title,body,updatedAt,isArchived"
+    if (workouts.isEmpty()) return header
+    val rows = workouts.map { workout ->
+        listOf(
+            workout.id.toString(),
+            escapeCsvField(workout.title.orEmpty()),
+            escapeCsvField(workout.body.orEmpty()),
+            escapeCsvField(workout.updatedAt?.toString().orEmpty()),
+            workout.isArchived.toString(),
+        ).joinToString(",")
+    }
+    return (listOf(header) + rows).joinToString("\n")
+}
+
+private fun escapeCsvField(value: String): String {
+    val needsQuotes = value.contains(',') ||
+        value.contains('"') ||
+        value.contains('\n') ||
+        value.contains('\r')
+    if (!needsQuotes) return value
+    return "\"" + value.replace("\"", "\"\"") + "\""
+}
